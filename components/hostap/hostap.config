# Linux nl80211 后端，用于 BE200；重新编译 hostap 生效。
CONFIG_DRIVER_NL80211=y
# nl80211 使用 libnl 3.x，构建机需目标架构开发库。
CONFIG_LIBNL32=y
# Unix 控制接口，由 wifiawared 管理进程和协议状态。
CONFIG_CTRL_IFACE=y
# 配对等持久状态使用 hostap 原生文件后端。
CONFIG_BACKEND=file
# TLS 和密码算法实现，目标需要 OpenSSL。
CONFIG_TLS=openssl
# NAN 复用的接入点协议支持。
CONFIG_AP=y
# 首次配对使用的 SAE 认证支持。
CONFIG_SAE=y
# 缓存身份验证使用的 PASN 支持。
CONFIG_PASN=y
# NAN 发现、配对及数据路径协议。
CONFIG_NAN=y
# NAN 无同步发现支持。
CONFIG_NAN_USD=y
# 支持按 hostap 原生方式输出诊断日志。
CONFIG_DEBUG_FILE=y
# RTL 私有 UAPI 后端；静态库由同一目标构建提供。
CONFIG_DRIVER_RTL_NAN=y
