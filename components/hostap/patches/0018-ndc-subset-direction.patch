Subject: NAN：修正 NDC 覆盖检查的集合方向

--- a/src/nan/nan_util.c
+++ b/src/nan/nan_util.c
@@ -1850,7 +1850,8 @@
 		available = nan_tbm_to_bf(nan, &schedule->chans[i].committed);
 		if (!available)
