@@ -4,13 +4,18 @@
 
 #include <stddef.h>
 
-/* Project availability onto nl80211's repeating 32 x 16 TU schedule. */
+/*
+ * Keep the availability shared by every 32 x 16 TU cycle. The firmware
+ * repeats this schedule, so a slot must be available in every peer cycle.
+ * Return 1 if the projection removes slots, 0 if exact, or -1 if invalid.
+ */
 static inline int nan_bitmap_512(const unsigned char *src, size_t len,
 				unsigned int duration, unsigned int period,
 				unsigned int offset, unsigned char out[4])
 {
 	unsigned char slots[512] = { 0 };
 	unsigned int step, width, start, bit, sub, i;
+	int reduced = 0;
 
 	if (len > 64 || duration > 3 || !period || period > 7)
 		return -1;
@@ -36,7 +41,8 @@
 	}
 	for (i = 32; i < 512; i++) {
 		if (slots[i] != slots[i % 32])
-			return -1;
+			reduced = 1;
+		slots[i % 32] &= slots[i];
 	}
 	for (i = 0; i < 4; i++)
 		out[i] = 0;
@@ -44,6 +50,6 @@
 		if (slots[i])
 			out[i / 8] |= 1U << (i % 8);
 	}
-	return 0;
+	return reduced;
 }
 #endif
