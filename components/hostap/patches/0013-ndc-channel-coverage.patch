+bool nan_schedule_covers_ndc(struct nan_data *nan,
+                            const struct nan_schedule *schedule, int freq,
+                            const struct nan_time_bitmap *ndc)
+{
+	struct bitfield *required = nan_tbm_to_bf(nan, ndc);
+	bool covered = false;
+	unsigned int i;
+
+	if (!required)
+		return false;
+	for (i = 0; i < schedule->n_chans; i++) {
+		struct bitfield *available;
+
+		if (schedule->chans[i].chan.freq != freq)
+			continue;
+		available = nan_tbm_to_bf(nan, &schedule->chans[i].committed);
+		if (!available)
+			continue;
+		covered = bitfield_is_subset(required, available);
+		bitfield_free(available);
+		if (covered)
+			break;
+	}
+	bitfield_free(required);
+	return covered;
+}
+
