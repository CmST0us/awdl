 		   MAC2STR(peer->nmi_addr),
 		   nan_ndl_state_str(peer->ndl->state), peer->ndl->state);
 
-	nan_clear_peer_schedule(nan, peer);
+	if (!peer->previous_ndl)
+		nan_clear_peer_schedule(nan, peer);
 
 	os_free(ndl->ndc_sched);
 	ndl->ndc_sched = NULL;
@@ -141,26 +142,43 @@
 }
 
 
-/*
- * nan_ndl_reset - Reset the NDL state
- *
- * @nan: NAN module context from nan_init()
- * @peer: The peer that requires NDL setup reset
- */
+static void nan_ndl_free(struct nan_ndl *ndl)
+{
+	if (!ndl)
+		return;
+	os_free(ndl->ndc_sched);
+	os_free(ndl->immut_sched);
+	os_free(ndl);
+}
+
+
 void nan_ndl_reset(struct nan_data *nan, struct nan_peer *peer)
 {
-	wpa_printf(MSG_DEBUG, "NAN: NDL: Reset state for peer=" MACSTR,
-		   MAC2STR(peer->nmi_addr));
-
-	if (!peer->ndl) {
-		wpa_printf(MSG_DEBUG, "NAN: NDL: Reset: no NDL");
+	if (!peer->ndl && !peer->previous_ndl)
 		return;
-	}
-
-	nan_ndl_clear(nan, peer);
-
-	os_free(peer->ndl);
+	nan_clear_peer_schedule(nan, peer);
+	nan_ndl_free(peer->ndl);
+	nan_ndl_free(peer->previous_ndl);
 	peer->ndl = NULL;
+	peer->previous_ndl = NULL;
+}
+
+
+void nan_ndl_finish(struct nan_data *nan, struct nan_peer *peer, bool success)
+{
+	if (!peer->previous_ndl)
+		return;
+
+	if (success) {
+		nan_ndl_free(peer->previous_ndl);
+	} else {
+		nan_ndl_free(peer->ndl);
+		peer->ndl = peer->previous_ndl;
+		/* Restore scheduling for the NDPs that are still connected. */
+		if (!dl_list_empty(&peer->ndps))
+			nan_configure_peer_schedule(nan, peer, &nan->sched);
+	}
+	peer->previous_ndl = NULL;
 }
 
 
