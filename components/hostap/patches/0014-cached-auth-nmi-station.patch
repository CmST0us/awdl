+static int wpas_nan_set_peer_station_cb(void *ctx, const u8 *nmi_addr,
+					bool present)
+{
+	struct wpa_supplicant *wpa_s = ctx;
+	struct hostapd_sta_add_params params;
+
+	if (!present) {
+		nan_pairing_unpair_peer(wpa_s->nan, nmi_addr);
+		return wpa_drv_sta_remove(wpa_s, nmi_addr);
+	}
+
+	os_memset(&params, 0, sizeof(params));
+	params.addr = nmi_addr;
+	params.flags = WPA_STA_AUTHENTICATED | WPA_STA_ASSOCIATED;
+	params.flags_mask = params.flags;
+	return wpa_drv_sta_add(wpa_s, &params);
+}
+
