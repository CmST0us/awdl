 static bool
-nan_peer_channel_in_local_sched(const struct nan_data *nan,
-				int peer_ctrl_freq,
-				const struct nan_schedule *local_sched)
-{
-	unsigned int i;
-
-	/* It's enough to compare the control freqs to ensure compatibility */
+nan_peer_intersect_local_avail(struct nan_data *nan, int peer_ctrl_freq,
+			      const struct nan_time_bitmap *peer_tbm,
+			      const struct nan_schedule *local_sched,
+			      struct nan_time_bitmap *tbm)
+{
+	struct bitfield *peer_bf;
+	unsigned int i, slot;
+	bool available = false;
+
+	peer_bf = nan_tbm_to_bf(nan, peer_tbm);
+	if (!peer_bf)
+		return false;
+
+	os_memset(tbm, 0, sizeof(*tbm));
+	tbm->period = 7;
+	tbm->len = NAN_TIME_BITMAP_MAX_LEN;
+
+	/* Project the peer's radios onto our actual channel availability. */
 	for (i = 0; i < local_sched->n_chans; i++) {
-		if (peer_ctrl_freq == local_sched->chans[i].chan.freq)
-			return true;
-	}
-
-	return false;
+		struct bitfield *local_bf;
+		u8 map_id, op_class;
+		u16 cbm, pcbm;
+
+		if (peer_ctrl_freq != local_sched->chans[i].chan.freq)
+			continue;
+
+		if (nan_convert_chan_sched_to_bf(nan, &local_sched->chans[i],
+					       &local_bf, &map_id, &op_class,
+					       &cbm, &pcbm))
+			continue;
+
+		for (slot = 0; slot < NAN_MAX_TIME_BITMAP_SLOTS; slot++) {
+			if (!bitfield_is_set(peer_bf, slot) ||
+			    !bitfield_is_set(local_bf, slot))
+				continue;
+
+			tbm->bitmap[slot / 8] |= BIT(slot % 8);
+			available = true;
+		}
+		bitfield_free(local_bf);
+	}
+
+	bitfield_free(peer_bf);
+	return available;
 }
 
 
