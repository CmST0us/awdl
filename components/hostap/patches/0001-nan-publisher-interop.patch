+/* SPDX-License-Identifier: BSD-3-Clause */
+#ifndef NAN_BITMAP_H
+#define NAN_BITMAP_H
+
+#include <stddef.h>
+
+/* Project availability onto nl80211's repeating 32 x 16 TU schedule. */
+static inline int nan_bitmap_512(const unsigned char *src, size_t len,
+				unsigned int duration, unsigned int period,
+				unsigned int offset, unsigned char out[4])
+{
+	unsigned char slots[512] = { 0 };
+	unsigned int step, width, start, bit, sub, i;
+
+	if (len > 64 || duration > 3 || !period || period > 7)
+		return -1;
+	step = 4U << period;
+	width = 1U << duration;
+	if (offset >= step || len * 8 * width > step)
+		return -1;
+	if (!len) {
+		for (i = 0; i < 4; i++)
+			out[i] = 255;
+		return 0;
+	}
+	for (start = offset; start < 512; start += step) {
+		for (bit = 0; bit < len * 8; bit++) {
+			if (!(src[bit / 8] & (1U << (bit % 8))))
+				continue;
+			for (sub = 0; sub < width; sub++) {
+				i = start + bit * width + sub;
+				if (i < 512)
+					slots[i] = 1;
+			}
+		}
+	}
+	for (i = 32; i < 512; i++) {
+		if (slots[i] != slots[i % 32])
+			return -1;
+	}
+	for (i = 0; i < 4; i++)
+		out[i] = 0;
+	for (i = 0; i < 32; i++) {
+		if (slots[i])
+			out[i / 8] |= 1U << (i % 8);
+	}
+	return 0;
+}
+#endif
