+static int wpas_nan_pairing_key_cb(void *ctx, const u8 *peer_addr,
+				   int cipher, struct wpa_ptk *ptk)
+{
+	struct wpa_supplicant *wpa_s = ctx;
+	enum wpa_alg alg;
+	u8 seq[6] = { 0 };
+
+	if (!ptk)
+		return wpa_drv_set_key(wpa_s, -1, WPA_ALG_NONE, peer_addr, 0,
+				       0, NULL, 0, NULL, 0,
+				       KEY_FLAG_PAIRWISE);
+	/* Never reset replay counters by reinstalling the same PTK. */
+	if (ptk->installed)
+		return 0;
+	if ((cipher != WPA_CIPHER_CCMP && cipher != WPA_CIPHER_GCMP_256) ||
+	    ptk->tk_len != (cipher == WPA_CIPHER_CCMP ? 16 : 32))
+		return -1;
+	/* The driver snapshots MFP into the firmware key at installation.
+	 * Updating the station after Auth2 is too late for a prepared NM-TK.
+	 * This enables frame protection, not peer authorization.
+	 */
+	if (wpa_drv_sta_set_flags(wpa_s, peer_addr, WPA_STA_MFP,
+				 WPA_STA_MFP, ~0)) {
+		wpa_printf(MSG_INFO, "NAN: Failed to enable NMI frame protection");
+		return -1;
+	}
+	wpa_printf(MSG_DEBUG, "NAN: NMI MFP enabled before NM-TK installation");
+	alg = cipher == WPA_CIPHER_CCMP ? WPA_ALG_CCMP : WPA_ALG_GCMP_256;
+	if (wpa_drv_set_key(wpa_s, -1, alg, peer_addr, 0, 1, seq, sizeof(seq),
+			    ptk->tk, ptk->tk_len, KEY_FLAG_PAIRWISE_RX_TX)) {
+		wpa_printf(MSG_INFO, "NAN: Failed to install NM-TK for peer "
+			   MACSTR, MAC2STR(peer_addr));
+		return -1;
+	}
+	ptk->installed = 1;
+	return 0;
+}
