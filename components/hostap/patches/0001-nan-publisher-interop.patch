+/* SPDX-License-Identifier: BSD-3-Clause */
+#ifndef NAN_HE_H
+#define NAN_HE_H
+
+#include "common/ieee802_11_defs.h"
+
+/* The variable HE body layout is shared by NDP capability advertisement and
+ * station installation. These sizes follow the HE capability element layout. */
+static inline size_t nan_he_mcs_len(const u8 *phy)
+{
+	size_t len = 4;
+	if (phy[HE_PHYCAP_CHANNEL_WIDTH_SET_IDX] &
+	    HE_PHYCAP_CHANNEL_WIDTH_SET_160MHZ_IN_5G)
+		len += 4;
+	if (phy[HE_PHYCAP_CHANNEL_WIDTH_SET_IDX] &
+	    HE_PHYCAP_CHANNEL_WIDTH_SET_80PLUS80MHZ_IN_5G)
+		len += 4;
+	return len;
+}
+
+static inline size_t nan_he_ppe_len(const u8 *phy, u8 header)
+{
+	size_t ru_count = 0;
+	u8 ru;
+	if (!(phy[HE_PHYCAP_PPE_THRESHOLD_PRESENT_IDX] &
+	      HE_PHYCAP_PPE_THRESHOLD_PRESENT))
+		return 0;
+	ru = (header >> HE_PPE_THRES_RU_INDEX_BITMASK_SHIFT) &
+		HE_PPE_THRES_RU_INDEX_BITMASK_MASK;
+	for (; ru; ru >>= 1)
+		ru_count += ru & 1;
+	return (7 + 6 * ru_count * (1 + (header & HE_PPE_THRES_NSS_MASK)) + 7) / 8;
+}
+
+static inline bool nan_he_cap_valid(const u8 *body, size_t len)
+{
+	const u8 *phy;
+	size_t base;
+	if (len < IEEE80211_HE_CAPAB_MIN_LEN)
+		return false;
+	phy = body + 6;
+	base = IEEE80211_HE_CAPAB_MIN_LEN + nan_he_mcs_len(phy);
+	if (len < base)
+		return false;
+	if (!(phy[HE_PHYCAP_PPE_THRESHOLD_PRESENT_IDX] &
+	      HE_PHYCAP_PPE_THRESHOLD_PRESENT))
+		return true;
+	return len > base && len >= base + nan_he_ppe_len(phy, body[base]);
+}
+#endif
