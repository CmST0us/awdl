+/* SPDX-License-Identifier: BSD-3-Clause */
+#ifndef NAN_SDF_H
+#define NAN_SDF_H
+
+#include <stddef.h>
+
+/* The terminal MME is an 802.11 element, outside the NAN attribute stream.
+ * This locates the parser boundary only; it does not authenticate the frame.
+ * Malformed attributes remain intact for the normal parser to reject.
+ */
+static inline size_t nan_sdf_attributes_len(const unsigned char *data, size_t len)
+{
+	size_t offset = 0;
+
+	while (len - offset >= 3) {
+		const unsigned char *pos = data + offset;
+		size_t remaining = len - offset;
+		size_t size;
+
+		if ((remaining == 18 || remaining == 26) && pos[0] == 76 &&
+		    pos[1] == remaining - 2 &&
+		    (pos[2] == 4 || pos[2] == 5) && pos[3] == 0)
+			return offset;
+
+		size = 3 + pos[1] + ((size_t) pos[2] << 8);
+		if (size > remaining)
+			return len;
+		offset += size;
+	}
+
+	return len;
+}
+#endif
