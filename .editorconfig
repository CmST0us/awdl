root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,swift}]
indent_style = space
indent_size = 4

[*.{c,h,sh}]
indent_style = tab
indent_size = 8

[components/*/src/*.{c,h}]
indent_style = space
indent_size = 4

[{Makefile*,*.mk}]
indent_style = tab
