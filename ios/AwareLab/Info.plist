<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<!-- 主屏幕显示名，由所选 xcconfig 提供。 -->
<key>CFBundleDisplayName</key><string>$(AWARE_DISPLAY_NAME)</string>
<!-- 允许 AccessorySetupKit 通过 Wi-Fi 发现和授权配件。 -->
<key>NSAccessorySetupKitSupports</key><array><string>WiFi</string></array>
<!-- 服务名由公共文件服务契约生成，重新构建应用生效。 -->
<key>AwareFileService</key><string>__AWARE_FILE_SERVICE__</string>
<!-- 诊断厂商名称，来自 config/wirelessd.toml 的 identity.vendor_name；AWARE_VENDOR_NAME 可覆盖。 -->
<key>AwareVendorName</key><string>__AWARE_VENDOR_NAME__</string>
<!-- 诊断型号名称，来自 identity.model_name；AWARE_MODEL_NAME 可覆盖。 -->
<key>AwareModelName</key><string>__AWARE_MODEL_NAME__</string>
<!-- 诊断配对目标名称，来自 identity.pairing_name；AWARE_TARGET_NAME 可覆盖。 -->
<key>AwarePairingName</key><string>__AWARE_PAIRING_NAME__</string>
<!-- 通用客户端测试的既有 bundle ID，来自 AwareClient.xcconfig；AWARE_CLIENT_BUNDLE_ID 可指定另一安装。 -->
<key>AwareClientBundle</key><string>__AWARE_CLIENT_BUNDLE__</string>
<!-- 客户端在“文件”App 中的目录显示名，来自 AwareClient.xcconfig；AWARE_CLIENT_FOLDER 可覆盖。 -->
<key>AwareClientDisplayName</key><string>__AWARE_CLIENT_DISPLAY__</string>
<!-- 向系统声明可订阅的服务；Subscribable 空字典表示订阅者角色。 -->
<key>WiFiAwareServices</key><dict><key>__AWARE_FILE_SERVICE__</key><dict><key>Subscribable</key><dict/></dict></dict>
</dict></plist>
