{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aware Lab observation result v1",
  "type": "object",
  "required": ["schemaVersion", "runID", "source", "status", "stage", "state", "reason", "wirelessVerified", "throughputVerified"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "runID": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,100}$"},
    "source": {"const": "ipad.app"},
    "status": {"const": "BLOCKED"},
    "stage": {"enum": ["G1-observation", "M4-discovery-observation", "M5-pairing-observation"]},
    "state": {"type": "string"},
    "reason": {"type": "string"},
    "wirelessVerified": {"const": false},
    "throughputVerified": {"const": false}
  }
}
