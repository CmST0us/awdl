Subject: [PATCH] BCM43752 A2: 原生 NAN 独占控制和数据入口

保留物理命令节点，禁用额外模式和接口；NDI 沿用真实固件资源。

--- a/wl_cfg80211.c
+++ b/wl_cfg80211.c
@@ -12024,6 +12024,17 @@
 }
 #endif /* !DISABLE_CFG_GET_CHANNEL && LINUX_VERSION_CODE >= KERNEL_VERSION (3, 8, 0) */
 
+#ifdef WL_NAN
+/* The physical netdev is only a vendor-command endpoint. Linux 6.1 NAN
+ * cannot represent an Ethernet NDI; no STA/AP/P2P/monitor operations are
+ * offered by this endpoint. Firmware owns the real NMI and NDI roles. */
+static const struct cfg80211_ops wl_nan_host_control_ops = {
+	.get_station = wl_cfg80211_get_station,
+	.dump_station = wl_cfg80211_dump_station,
+	.get_tx_power = wl_cfg80211_get_tx_power,
+};
+#endif
+
 static struct cfg80211_ops wl_cfg80211_ops = {
