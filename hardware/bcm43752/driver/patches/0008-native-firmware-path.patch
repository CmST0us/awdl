Subject: [PATCH] BCM43752 A2: 保留固件目录并禁用内部扫描扩展

request_firmware 使用明确的独立目录，避免加载原装同名镜像。

--- a/Makefile
+++ b/Makefile
@@ -384,6 +384,9 @@
 ifneq ($(CONFIG_BCMDHD_NAN),)
 	DHDCFLAGS += -DWL_NAN -DWL_NAN_DISC_CACHE -DWL_NANP2P -DWL_NAN_ENABLE_MERGE
 	DHDOFILES += wl_cfgnan.o bcmbloom.o wl_nan_host.o wl_nan_ndi.o
+	# Native NAN has no infrastructure/P2P scan or AP+STA extension owner.
+	DHDCFLAGS := $(filter-out -DWL_EXT_IAPSTA -DWL_ESCAN -DWL_NANP2P -DWL_WIRELESS_EXT -DUSE_IW -DSOFTAP,$(DHDCFLAGS))
+	DHDOFILES := $(filter-out wl_iapsta.o wl_escan.o wl_iw.o,$(DHDOFILES))
 endif
 
 # For Module auto-selection
--- a/dhd_config.c
+++ b/dhd_config.c
@@ -17,6 +17,9 @@
 #endif /* DHDTCPACK_SUPPRESS */
 #ifdef WL_CFG80211
 #include <wl_cfg80211.h>
+#ifdef WL_NAN
+#include "wl_nan_host.h"
+#endif
 #endif
 
 #include <dhd_config.h>
@@ -1525,11 +1528,17 @@
 	dhd_conf_preinit(dhd);
 
 #ifdef DHD_REQUEST_FW_PATH
-	// preprocess the filename to only left 'name'
-	dhd_conf_get_filename(fw_path);
-	dhd_conf_get_filename(nv_path);
-	dhd_conf_get_filename(dhd->clm_path);
-	dhd_conf_get_filename(dhd->conf_path);
+	/* Keep the caller's firmware-class-relative directory for native NAN.
+	 * Dropping it silently loads the distribution's unpatched image. */
+#ifdef WL_NAN
+	if (!wl_nan_host_device(dhd))
+#endif
+	{
+		dhd_conf_get_filename(fw_path);
+		dhd_conf_get_filename(nv_path);
+		dhd_conf_get_filename(dhd->clm_path);
+		dhd_conf_get_filename(dhd->conf_path);
+	}
 #endif
 
 	if (dhd->conf_path[0] == '\0') {
@@ -1551,10 +1560,15 @@
 #endif
 
 #ifdef DHD_REQUEST_FW_PATH
-	dhd_conf_add_filepath(dhd, fw_path);
-	dhd_conf_add_filepath(dhd, nv_path);
-	dhd_conf_add_filepath(dhd, dhd->clm_path);
-	dhd_conf_add_filepath(dhd, dhd->conf_path);
+#ifdef WL_NAN
+	if (!wl_nan_host_device(dhd))
+#endif
+	{
+		dhd_conf_add_filepath(dhd, fw_path);
+		dhd_conf_add_filepath(dhd, nv_path);
+		dhd_conf_add_filepath(dhd, dhd->clm_path);
+		dhd_conf_add_filepath(dhd, dhd->conf_path);
+	}
 #endif
 
 	CONFIG_MSG("Final fw_path=%s\n", fw_path);
--- a/wl_cfg80211.c
+++ b/wl_cfg80211.c
@@ -7335,7 +7335,9 @@
 	if (assoc_info.reassoc) {
 		/* Handle roam to same ESS */
 #ifdef DHD_LOSSLESS_ROAMING
+#ifdef WL_EXT_IAPSTA
 		wl_ext_send_event_msg(dev, WLC_E_ROAM_PREP, WLC_E_STATUS_SUCCESS, WLC_E_REASON_LOW_RSSI);
+#endif
 #endif
 		if ((err = wl_handle_reassoc(cfg, dev, &assoc_info)) != BCME_OK) {
 			goto fail;
--- a/wl_cfgvif.c
+++ b/wl_cfgvif.c
@@ -5181,10 +5181,12 @@
 		(reason == WLC_E_REASON_INITIAL_ASSOC) &&
 		(wl_get_mode_by_netdev(cfg, ndev) == WL_MODE_AP)) {
 		if (!wl_get_drv_status(cfg, AP_CREATED, ndev)) {
+#ifdef WL_EXT_IAPSTA
 			char chan_str[64];
 			/* AP/GO brought up successfull in firmware */
 			wl_ext_get_chan_str(ndev, chan_str, sizeof(chan_str));
 			WL_MSG(ndev->name, "AP/GO Link up (%s)\n", chan_str);
+#endif
 			wl_set_drv_status(cfg, AP_CREATED, ndev);
 			if (delayed_work_pending(&cfg->ap_work)) {
 				cancel_delayed_work_sync(&cfg->ap_work);
@@ -5234,7 +5236,7 @@
 		wl_ext_in4way_sync(ndev, AP_WAIT_STA_RECONNECT,
 			WL_EXT_STATUS_STA_CONNECTED, (void *)&e->addr);
 #endif
-#ifdef STA_MGMT
+#if defined(STA_MGMT) && defined(WL_EXT_IAPSTA)
 		if (!wl_ext_add_sta_info(ndev, (u8 *)&e->addr)) {
 			return -EINVAL;
 		}
@@ -5261,7 +5263,7 @@
 		wl_ext_in4way_sync(ndev, AP_WAIT_STA_RECONNECT,
 			WL_EXT_STATUS_STA_DISCONNECTED, (void *)&e->addr);
 #endif
-#ifdef STA_MGMT
+#if defined(STA_MGMT) && defined(WL_EXT_IAPSTA)
 		if (!wl_ext_del_sta_info(ndev, (u8 *)&e->addr)) {
 			return -EINVAL;
 		}
--- a/dhd_linux_lb.c
+++ b/dhd_linux_lb.c
@@ -1232,7 +1232,7 @@
 		dhd_napi_schedule(dhd);
 		return;
 	}
-#ifdef TPUT_MONITOR
+#if defined(TPUT_MONITOR) && defined(WL_EXT_IAPSTA)
 	if (wl_ext_tput_get(dhdp) < dhdp->conf->napi_tput_thresh) {
 		dhd_napi_schedule(dhd);
 		return;
