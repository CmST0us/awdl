--- a/dhd_linux.c
+++ b/dhd_linux.c
@@ -14184,7 +14184,21 @@
 
 /* Reuse the native PCIe data path; no private STA ioctls, MAC rewrite,
  * wireless_dev, scan extension, AP/P2P role or firmware power transition. */
+/* AWDL's native firmware adds an Apple MSDU header after host checksum
+ * preparation. Software GSO/checksum retains the native PCIe completion path
+ * and socket ownership; no global offload changes for unrelated interfaces. */
+static netdev_features_t dhd_nan_ndi_features_check(struct sk_buff *skb,
+	struct net_device *net, netdev_features_t features)
+{
+	dhd_info_t *dhd = DHD_DEV_INFO(net);
+	struct bcm_cfg80211 *cfg = wl_get_cfg(dhd_linux_get_primary_netdev(&dhd->pub));
+	if (wl_nan_host_awdl_active(cfg, DHD_DEV_IFIDX(net)))
+		features &= ~(NETIF_F_CSUM_MASK | NETIF_F_GSO_MASK);
+	return features;
+}
+
 static const struct net_device_ops dhd_nan_ndi_ops = {
+	.ndo_features_check = dhd_nan_ndi_features_check,
 	.ndo_open = dhd_nan_ndi_open,
 	.ndo_stop = dhd_nan_ndi_stop,
 	.ndo_get_stats = dhd_get_stats,
