+#ifdef WL_NAN
+static int dhd_nan_ndi_open(struct net_device *net)
+{
+	dhd_info_t *dhd = DHD_DEV_INFO(net);
+	dhd_if_t *ifp = dhd->iflist[DHD_DEV_IFIDX(net)];
+	if (!ifp || !ifp->native_nan || ifp->del_in_progress ||
+	    !dhd->pub.up || dhd->pub.busstate != DHD_BUS_DATA)
+		return -ENODEV;
+	netif_start_queue(net);
+	return 0;
+}
+
+static int dhd_nan_ndi_stop(struct net_device *net)
+{
+	netif_stop_queue(net);
+	return 0;
+}
+
+/* Reuse the native PCIe data path; no private STA ioctls, MAC rewrite,
+ * wireless_dev, scan extension, AP/P2P role or firmware power transition. */
+static const struct net_device_ops dhd_nan_ndi_ops = {
+	.ndo_open = dhd_nan_ndi_open,
+	.ndo_stop = dhd_nan_ndi_stop,
+	.ndo_get_stats = dhd_get_stats,
+#ifdef DHD_PCIE_NATIVE_RUNTIMEPM
+	.ndo_start_xmit = dhd_start_xmit_wrapper,
+#else
+	.ndo_start_xmit = dhd_start_xmit,
+#endif
+	.ndo_set_rx_mode = dhd_set_multicast_list,
+};
+
+bool dhd_nan_ndi_event(dhd_pub_t *dhdp, const wl_event_data_if_t *event,
+                      const char *name, const u8 *mac)
+{
+	struct net_device *primary = dhd_linux_get_primary_netdev(dhdp);
+	return primary && wl_nan_host_ndi_if_event(wl_get_cfg(primary), event, name, mac);
+}
+
+void dhd_nan_ndi_flow_complete(dhd_pub_t *dhdp, u8 ifidx, u16 flowid,
+                              u32 status, u32 operation)
+{
+	struct net_device *primary = dhd_linux_get_primary_netdev(dhdp);
+	if (primary)
+		wl_nan_host_ndi_flow_completion(wl_get_cfg(primary), ifidx, flowid, status, operation);
+}
+
+int dhd_nan_ndi_flow_event(dhd_pub_t *dhdp, const wl_event_data_if_t *event,
+                          const u8 *mac)
+{
+	dhd_info_t *dhd = dhdp->info;
+	dhd_if_t *ifp;
+	if (!event->ifidx || event->ifidx >= DHD_MAX_IFS)
+		return -EINVAL;
+	ifp = dhd->iflist[event->ifidx];
+	if (ifp && (!ifp->native_nan || ifp->bssidx != event->bssidx ||
+	            memcmp(ifp->mac_addr, mac, ETHER_ADDR_LEN)))
+		return -EEXIST;
+#ifdef PCIE_FULL_DONGLE
+	dhd_update_interface_flow_info(dhdp, event->ifidx, event->opcode, event->role);
+#endif
+	if (event->opcode == WLC_E_IF_DEL) {
+		if (ifp && ifp->net) {
+			dhd_set_del_in_progress(dhdp, ifp->net);
+			netif_tx_disable(ifp->net);
+		}
+#ifdef PCIE_FULL_DONGLE
+		/* The event is authoritative; use its checked index, not name lookup
+		 * which maps an unregistered interface to primary index zero. */
+		dhd_flow_rings_delete(dhdp, event->ifidx);
+#endif
+	}
+	return 0;
+}
+
+int dhd_nan_ndi_register(dhd_pub_t *dhdp, int ifidx, int bssidx,
+                        const u8 *mac, const char *name, const char *firmware_name)
+{
+	dhd_info_t *dhd = dhdp->info;
+	dhd_if_t *ifp;
+	struct net_device *net, *primary = dhd_linux_get_primary_netdev(dhdp);
+	int result;
+	ASSERT_RTNL();
+	if (!primary || ifidx <= 0 || ifidx >= DHD_MAX_IFS || !bssidx)
+		return -EINVAL;
+	ifp = dhd->iflist[ifidx];
+	/* dhd_allocate_if otherwise destroys the current virtual slot. */
+	if (ifp) {
+		if (!ifp->native_nan || ifp->bssidx != bssidx || !ifp->net ||
+		    memcmp(ifp->mac_addr, mac, ETHER_ADDR_LEN) || strcmp(ifp->net->name, name))
+			return -EEXIST;
+		net = ifp->net;
+		if (net->reg_state == NETREG_REGISTERED)
+			return net->ifindex;
+		if (net->reg_state != NETREG_UNINITIALIZED)
+			return -EBUSY;
+	} else {
+		net = dhd_allocate_if_impl(dhdp, ifidx, name, (uint8 *)mac, bssidx,
+			FALSE, firmware_name, true);
+		if (!net)
+			return -ENOMEM;
+		ifp = dhd->iflist[ifidx];
+		/* register_netdevice calls priv_destructor on some failures; an
+		 * auto-free destructor would leave a dangling DHD owner. */
+		net->priv_destructor = NULL;
+		net->needs_free_netdev = false;
+		dev_net_set(net, dev_net(primary));
+		SET_NETDEV_DEV(net, primary->dev.parent);
+		net->netdev_ops = &dhd_nan_ndi_ops;
+		net->hard_header_len = ETH_HLEN + dhdp->hdrlen;
+		DEV_ADDR_SET(net, mac);
+	}
+	/* Failure retains the allocated native owner for retry or IF_DEL. */
+	result = register_netdevice(net);
+	if (!result)
+		net->needs_free_netdev = true;
+	return result ? result : net->ifindex;
+}
+
+bool dhd_nan_ndi_closing(dhd_pub_t *dhdp, int ifidx)
+{
+	dhd_if_t *ifp;
+	if (ifidx <= 0 || ifidx >= DHD_MAX_IFS)
+		return false;
+	ifp = dhdp->info->iflist[ifidx];
+	return ifp && ifp->native_nan && READ_ONCE(ifp->del_in_progress);
+}
+
+static bool dhd_nan_ndi_rings_idle(dhd_pub_t *dhdp, int ifidx)
+{
+#ifdef PCIE_FULL_DONGLE
+	flow_ring_table_t *table = dhdp->flow_ring_table;
+	unsigned long flags;
+	unsigned int id;
+	bool active;
+	if (!table)
+		return true;
+	for (id = 0; id < dhdp->num_h2d_rings; ++id) {
+		DHD_FLOWRING_LOCK(table[id].lock, flags);
+		active = table[id].active && table[id].flow_info.ifindex == ifidx;
+		DHD_FLOWRING_UNLOCK(table[id].lock, flags);
+		if (active)
+			return false;
+	}
+#endif
+	return true;
+}
+
+void dhd_nan_ndi_flow_failure(dhd_pub_t *dhdp, int ifidx, int error)
+{
+	dhd_if_t *ifp;
+	if (!dhd_nan_ndi_closing(dhdp, ifidx))
+		return;
+	ifp = dhdp->info->iflist[ifidx];
+	WRITE_ONCE(ifp->nan_flow_error, error);
+	wake_up_all(&dhdp->tx_completion_wait);
+}
+
+int dhd_nan_ndi_quiesce(dhd_pub_t *dhdp, int ifidx, int bssidx, const u8 *mac,
+                       int *firmware_error)
+{
+	dhd_if_t *ifp;
+	unsigned long flags;
+	long completed;
+	*firmware_error = 0;
+	if (ifidx <= 0 || ifidx >= DHD_MAX_IFS || dhdp->busstate != DHD_BUS_DATA)
+		return -ENODEV;
+	ifp = dhdp->info->iflist[ifidx];
+	if (ifp) {
+		if (!ifp->native_nan || ifp->bssidx != bssidx ||
+		    memcmp(ifp->mac_addr, mac, ETHER_ADDR_LEN))
+			return -EEXIST;
+		WRITE_ONCE(ifp->nan_flow_error, 0);
+		DHD_GENERAL_LOCK(dhdp, flags);
+		ifp->del_in_progress = TRUE;
+		DHD_GENERAL_UNLOCK(dhdp, flags);
+		if (ifp->net)
+			netif_tx_disable(ifp->net);
+		completed = wait_event_timeout(dhdp->tx_completion_wait,
+			!READ_ONCE(ifp->tx_paths_active), msecs_to_jiffies(DHD_TX_COMPLETION_TIMEOUT));
+		if (!completed)
+			return -ETIMEDOUT;
+	}
+#ifdef PCIE_FULL_DONGLE
+	dhd_flow_rings_delete(dhdp, ifidx);
+#endif
+	completed = wait_event_timeout(dhdp->tx_completion_wait,
+		(ifp && READ_ONCE(ifp->nan_flow_error)) || dhd_nan_ndi_rings_idle(dhdp, ifidx),
+		msecs_to_jiffies(DHD_TX_COMPLETION_TIMEOUT));
+	if (ifp && READ_ONCE(ifp->nan_flow_error)) {
+		*firmware_error = READ_ONCE(ifp->nan_flow_error);
+		return -EIO;
+	}
+	if (dhdp->busstate != DHD_BUS_DATA)
+		return -ENODEV;
+	return completed ? 0 : -ETIMEDOUT;
+}
+
+/* Caller holds the native owner lock and if_sync; IF_DEL and Linux removal
+ * cannot race this transition. No wait, allocation, RTNL or IOVAR here. */
+int dhd_nan_ndi_resume(dhd_pub_t *dhdp, int ifidx, int bssidx, const u8 *mac)
+{
+	dhd_if_t *ifp;
+	unsigned long flags;
+	bool closing, active;
+	if (ifidx <= 0 || ifidx >= DHD_MAX_IFS || !dhdp->up ||
+	    dhdp->busstate != DHD_BUS_DATA || dhdp->stop_in_progress)
+		return -ENODEV;
+	ifp = dhdp->info->iflist[ifidx];
+	if (!ifp || !ifp->native_nan || ifp->bssidx != bssidx || !ifp->net ||
+	    ifp->net->reg_state != NETREG_REGISTERED ||
+	    memcmp(ifp->mac_addr, mac, ETHER_ADDR_LEN))
+		return -ESTALE;
+	DHD_GENERAL_LOCK(dhdp, flags);
+	closing = ifp->del_in_progress;
+	active = DHD_IF_IS_TX_ACTIVE(ifp);
+	DHD_GENERAL_UNLOCK(dhdp, flags);
+	/* Repeating a completed RESUME must not stall other live NDPs. */
+	if (!closing)
+		return 0;
+	if (active || READ_ONCE(ifp->nan_flow_error) ||
+	    !dhd_nan_ndi_rings_idle(dhdp, ifidx))
+		return -EBUSY;
+	/* del_in_progress has kept new TX out while each ring was checked. */
+	DHD_GENERAL_LOCK(dhdp, flags);
+	if (DHD_IF_IS_TX_ACTIVE(ifp)) {
+		DHD_GENERAL_UNLOCK(dhdp, flags);
+		return -EBUSY;
+	}
+	ifp->del_in_progress = FALSE;
+	DHD_GENERAL_UNLOCK(dhdp, flags);
+	if (netif_running(ifp->net))
+		netif_tx_wake_all_queues(ifp->net);
+	return 0;
+}
+
+int dhd_nan_ndi_remove(dhd_pub_t *dhdp, int ifidx, int bssidx, const u8 *mac)
+{
+	dhd_info_t *dhd = dhdp->info;
+	dhd_if_t *ifp;
+	unsigned long flags;
+	bool active;
+	ASSERT_RTNL();
+	if (ifidx <= 0 || ifidx >= DHD_MAX_IFS)
+		return -EINVAL;
+	ifp = dhd->iflist[ifidx];
+	if (!ifp)
+		return dhd_nan_ndi_rings_idle(dhdp, ifidx) ? 0 : -EBUSY;
+	if (!ifp->native_nan || ifp->bssidx != bssidx ||
+	    memcmp(ifp->mac_addr, mac, ETHER_ADDR_LEN))
+		return -EEXIST;
+	if (ifp->net && ifp->net->reg_state == NETREG_UNREGISTERING)
+		return -EBUSY;
+	if (ifp->net)
+		netif_tx_disable(ifp->net);
+	DHD_GENERAL_LOCK(dhdp, flags);
+	ifp->del_in_progress = TRUE;
+	active = DHD_IF_IS_TX_ACTIVE(ifp);
+	DHD_GENERAL_UNLOCK(dhdp, flags);
+	/* Generic removal cleans resources before its timeout and then frees
+	 * even on timeout. Enter it only after TX has actually relinquished them. */
+	if (active)
+		return -EBUSY;
+	if (!dhd_nan_ndi_rings_idle(dhdp, ifidx))
+		return -EBUSY;
+	return dhd_remove_if(dhdp, ifidx, FALSE);
+}
