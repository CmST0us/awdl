+
+u32 mac_process_c2h(struct mac_ax_adapter *adapter, u8 *buf, u32 len, u8 *ret)
+{
+ u32 h0, h1, total, cat, cls, func, need = 0, rc;
+ bool observe;
+ if (!buf || len < FWCMD_HDR_LEN) {
+  wa_obs_record("c2h-short-header", buf, buf ? len : 0, MACBUFSZ);
+  return MACBUFSZ;
+ }
+ h0 = get_unaligned_le32(buf); h1 = get_unaligned_le32(buf + 4);
+ if (GET_FIELD(h0, C2H_HDR_DEL_TYPE) != FWCMD_TYPE_C2H) {
+  wa_obs_record("c2h-wrong-type", buf, 8, MACNOITEM);
+  return MACNOITEM;
+ }
+ total = GET_FIELD(h1, C2H_HDR_TOTAL_LEN);
+ cat = GET_FIELD(h0, C2H_HDR_CAT); cls = GET_FIELD(h0, C2H_HDR_CLASS);
+ func = GET_FIELD(h0, C2H_HDR_FUNC);
+ observe = cat == FWCMD_C2H_CAT_MAC && (cls == FWCMD_C2H_CL_NAN || (cls == FWCMD_C2H_CL_FW_INFO && (func <= 1 || func == FWCMD_C2H_FUNC_BCN_CNT)));
+ if (total < FWCMD_HDR_LEN || total > len) {
+  wa_obs_record("c2h-invalid-total", buf, len < 8 ? len : 8, MACBUFSZ);
+  return MACBUFSZ;
+ }
+ if (cat == FWCMD_C2H_CAT_MAC && cls == FWCMD_C2H_CL_FW_INFO && func <= 1 && total < FWCMD_HDR_LEN + 4) {
+  wa_obs_record("c2h-short-ack", buf, total, MACBUFSZ);
+  return MACBUFSZ;
+ }
+ if (cat == FWCMD_C2H_CAT_MAC && cls == FWCMD_C2H_CL_FW_INFO &&
+     func == FWCMD_C2H_FUNC_BCN_CNT && total < FWCMD_HDR_LEN + 7) {
+  wa_obs_record("c2h-short-bcn-count", buf, total, MACBUFSZ);
+  return MACBUFSZ;
+ }
+ if (cat == FWCMD_C2H_CAT_MAC && cls == FWCMD_C2H_CL_NAN) {
+  if (func <= 5) need = 8;
+  else if (func == 6) need = 28;
+  else if (func == 7) need = 12;
+  if (total - FWCMD_HDR_LEN < need) {
+   wa_obs_record("c2h-short-nan", buf, total, MACBUFSZ);
+   return MACBUFSZ;
+  }
+ }
+ if (observe) wa_obs_record("c2h-received", buf, total, 0);
+ rc = wa_original_process_c2h(adapter, buf, total, ret);
+ if (observe) wa_obs_record("c2h-dispatched", buf, total, rc);
+ return rc;
 }
 
