+
+/* A NO_LINK self entry matches A1 alone and otherwise shadows the AWDL
+ * peer's A1/A2 entry. Keep its allocation, restoring its saved admission bit. */
+int rtw_hal_awdl_self_match(void *hal, u8 macid, bool pause, bool *saved)
+{
+ struct hal_info_t *h=hal;
+ struct mac_role_tbl *role=mac_role_srch(h->mac,macid);
+ u32 result;
+ if (!role) return -ENOENT;
+ if (pause) *saved=role->info.a_info.valid;
+ role->info.a_info.valid=pause ? false:*saved;
+ result=mac_upd_addr_cam(h->mac,&role->info,CHG);
+ pr_info("AWDL_SELF_MATCH macid=%u enabled=%u result=%u\n",macid,role->info.a_info.valid,result);
+ return result==MACSUCCESS ? 0:-EIO;
 }
 
