+ return 0;
+fail:
+ free_netdev(dev);module_put(THIS_MODULE);return ret;
+}
+static int wa_awdl_net_delete(void)
+{
+ struct wa_awdl_net *n=wa_awdl_net;
+ if (!n) return 0;
+ if (!rtnl_trylock()) return -EBUSY;
+ spin_lock_bh(&wa_awdl_net_lock);n->stopping=true;wa_awdl_net=NULL;spin_unlock_bh(&wa_awdl_net_lock);
+ netif_tx_disable(n->dev);hrtimer_cancel(&n->timer);cancel_work_sync(&n->work);
+ pr_info("AWDL_NET stop tx=%lu tx_errors=%lu rx=%lu rx_drop=%lu queued=%u\n",
+  n->dev->stats.tx_packets,n->dev->stats.tx_errors,n->dev->stats.rx_packets,n->dev->stats.rx_dropped,skb_queue_len(&n->queue));
+ skb_queue_purge(&n->queue);unregister_netdevice(n->dev);rtnl_unlock();
+ free_netdev(n->dev);module_put(THIS_MODULE);return 0;
+}
+static int wa_awdl_net_window(const u8 *data,u16 len)
+{
+ struct wa_awdl_net *n=wa_awdl_net;
+ u64 open,close;
+ if (!n) return -ENODEV;
+ if (len!=16) return -EINVAL;
+ open=get_unaligned_le64(data);close=get_unaligned_le64(data+8);
+ if (open>close) return -EINVAL;
+ hrtimer_cancel(&n->timer);
+ spin_lock_bh(&wa_awdl_net_lock);n->opens=open;n->closes=close;spin_unlock_bh(&wa_awdl_net_lock);
+ if (close>ktime_get_ns()) {
+  if (open>ktime_get_ns()) hrtimer_start(&n->timer,ns_to_ktime(open),HRTIMER_MODE_ABS);
+  else schedule_work(&n->work);
+ }
+ return 0;
+}
+bool rtw_phl_awdl_net_rx(void *phl,const u8 *f,u32 len,u32 flags)
+{
+ struct wa_awdl_net *n;
+ struct sk_buff *skb;
+ unsigned long irq;
+ u32 h,iplen;
+ u16 seq;
+ u8 tid;
+ bool handled=false;
+ if (len<24 || (f[0]&0x0c)!=8) return false;
+ spin_lock_irqsave(&wa_awdl_net_lock,irq);n=wa_awdl_net;
+ if (!n || n->phl!=phl) goto out;
