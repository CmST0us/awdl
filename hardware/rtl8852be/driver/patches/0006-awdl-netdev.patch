+ n->dev->stats.rx_packets++;n->dev->stats.rx_bytes+=iplen+ETH_HLEN;
+ netif_rx(skb);goto out;
+drop:
+ n->dev->stats.rx_dropped++;
+out:
+ spin_unlock_irqrestore(&wa_awdl_net_lock,irq);return handled;
+}
