+     (!(f[4]&1) && memcmp(f+4,n->dev->dev_addr,6)) ||
+     (h==26 && (f[24]&0x80)) || memcmp(f+h,wa_awdl_snap,10) ||
+     f[h+14]!=0x86 || f[h+15]!=0xdd || (f[h+16]>>4)!=6) goto drop;
