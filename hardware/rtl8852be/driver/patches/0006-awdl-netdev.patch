+struct wa_awdl_net {
+ struct net_device *dev;
+ void *phl;
+ struct sk_buff_head queue;
+ struct work_struct work;
+ struct hrtimer timer;
+ u64 opens, closes;
+ u16 sequence, rx_sequence[17];
+ unsigned long rx_seen;
+ u8 peer[6];
+ bool stopping;
+};
+static DEFINE_SPINLOCK(wa_awdl_net_lock);
+static struct wa_awdl_net *wa_awdl_net;
+static const u8 wa_awdl_snap[10]={0xaa,0xaa,3,0,0x17,0xf2,8,0,3,4};
+
+static void wa_awdl_net_done(bool data, u16 len, u32 status)
+{
+ unsigned long flags;
+ struct wa_awdl_net *n;
+ spin_lock_irqsave(&wa_awdl_net_lock,flags);
+ n=wa_awdl_net;
+ if (n && !n->stopping) {
+  if (data) {
+   if (status==TX_STATUS_TX_DONE) {
+    n->dev->stats.tx_packets++;
+    n->dev->stats.tx_bytes+=len-40+ETH_HLEN;
+   } else n->dev->stats.tx_errors++;
+  }
+  schedule_work(&n->work);
+ }
+ spin_unlock_irqrestore(&wa_awdl_net_lock,flags);
+}
+
+static void wa_awdl_net_work(struct work_struct *work)
+{
+ struct wa_awdl_net *n=container_of(work,struct wa_awdl_net,work);
+ struct sk_buff *skb;
+ u8 *frame;
+ u64 cookie, now, close;
+ int ret;
+ unsigned long flags;
+ if (READ_ONCE(n->stopping) || !netif_running(n->dev)) return;
+ spin_lock_irqsave(&wa_awdl_net_lock,flags);
+ now=ktime_get_ns(); close=n->closes;
+ ret=now>=n->opens && now+3000000<close;
+ spin_unlock_irqrestore(&wa_awdl_net_lock,flags);
+ if (!ret || atomic_read(&wa_sdf_state.outstanding)) return;
+ skb=skb_dequeue(&n->queue);
+ if (!skb) return;
+ frame=kmalloc(skb->len-ETH_HLEN+40,GFP_KERNEL);
+ if (!frame) {n->dev->stats.tx_dropped++;goto free_skb;}
+ memset(frame,0,40);frame[0]=8;
+ memcpy(frame+4,skb->data,6);memcpy(frame+10,n->dev->dev_addr,6);
+ memcpy(frame+16,wa_awdl_bssid,6);memcpy(frame+24,wa_awdl_snap,10);
+ frame[34]=n->sequence;frame[35]=n->sequence>>8;frame[38]=0x86;frame[39]=0xdd;
+ memcpy(frame+40,skb->data+ETH_HLEN,skb->len-ETH_HLEN);
+ ret=wa_nan_tx(n->phl,frame,skb->len-ETH_HLEN+40,&cookie,0,0,0,NULL,0);
+ kfree(frame);
+ if (ret==-EBUSY) {skb_queue_head(&n->queue,skb);return;}
+ if (ret) n->dev->stats.tx_errors++;
+ else n->sequence++;
+free_skb:
+ dev_kfree_skb(skb);
+ if (skb_queue_len(&n->queue)<32 && !READ_ONCE(n->stopping)) netif_wake_queue(n->dev);
+ if (!atomic_read(&wa_sdf_state.outstanding) && !skb_queue_empty(&n->queue)) schedule_work(&n->work);
+}
+static enum hrtimer_restart wa_awdl_net_timer(struct hrtimer *timer)
+{
+ struct wa_awdl_net *n=container_of(timer,struct wa_awdl_net,timer);
+ if (!READ_ONCE(n->stopping)) schedule_work(&n->work);
+ return HRTIMER_NORESTART;
+}
+static netdev_tx_t wa_awdl_net_xmit(struct sk_buff *skb,struct net_device *dev)
+{
+ struct wa_awdl_net *n=netdev_priv(dev);
+ if (skb->len<ETH_HLEN+40 || skb->protocol!=htons(ETH_P_IPV6) ||
+     (!(skb->data[0]&1) && memcmp(skb->data,n->peer,6)) ||
+     READ_ONCE(n->stopping) || skb_linearize(skb)) {
+  dev->stats.tx_dropped++;dev_kfree_skb_any(skb);return NETDEV_TX_OK;
+ }
+ if (skb_queue_len(&n->queue)>=64) {
+  netif_stop_queue(dev);
+  if (skb_queue_len(&n->queue)<32) netif_wake_queue(dev);
+  return NETDEV_TX_BUSY;
+ }
+ skb_queue_tail(&n->queue,skb);
+ if (skb_queue_len(&n->queue)>=64) {
+  netif_stop_queue(dev);
+  if (skb_queue_len(&n->queue)<32) netif_wake_queue(dev);
+ }
+ schedule_work(&n->work);
+ return NETDEV_TX_OK;
+}
+static int wa_awdl_net_open(struct net_device *dev) {netif_start_queue(dev);return 0;}
+static int wa_awdl_net_close(struct net_device *dev) {netif_stop_queue(dev);return 0;}
+static const struct net_device_ops wa_awdl_net_ops={
+ .ndo_open=wa_awdl_net_open,.ndo_stop=wa_awdl_net_close,.ndo_start_xmit=wa_awdl_net_xmit,
+ .ndo_validate_addr=eth_validate_addr,
+};
+static int wa_awdl_net_create(void *phl,const u8 *local,const u8 *peer)
+{
+ struct net_device *dev;
+ struct wa_awdl_net *n;
+ int ret;
+ if (wa_awdl_net) return -EEXIST;
+ if (!try_module_get(THIS_MODULE)) return -ENODEV;
+ dev=alloc_etherdev(sizeof(*n));
+ if (!dev) {module_put(THIS_MODULE);return -ENOMEM;}
+ strcpy(dev->name,"awdl0");eth_hw_addr_set(dev,local);
+ dev->netdev_ops=&wa_awdl_net_ops;dev->mtu=1280;dev->min_mtu=1280;dev->max_mtu=1500;
+ dev->tx_queue_len=64;dev->features=0;
+ n=netdev_priv(dev);n->dev=dev;n->phl=phl;memcpy(n->peer,peer,6);
+ skb_queue_head_init(&n->queue);INIT_WORK(&n->work,wa_awdl_net_work);
+ hrtimer_init(&n->timer,CLOCK_MONOTONIC,HRTIMER_MODE_ABS);n->timer.function=wa_awdl_net_timer;
+ if (!rtnl_trylock()) {ret=-EBUSY;goto fail;}
+ ret=register_netdevice(dev);rtnl_unlock();
+ if (ret) goto fail;
+ spin_lock_bh(&wa_awdl_net_lock);wa_awdl_net=n;spin_unlock_bh(&wa_awdl_net_lock);
+ netif_carrier_on(dev);
