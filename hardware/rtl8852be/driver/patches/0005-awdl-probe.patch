+/* SPDX-License-Identifier: GPL-2.0 */
+/* Fixed-channel AWDL hardware probe. The existing U2 image is unchanged. */
+#ifndef WA_AWDL_PROBE_H
+#define WA_AWDL_PROBE_H
+static u32 wa_awdl_ctrl_before, wa_awdl_cam_before, wa_awdl_dis_before;
+static void wa_awdl_control_diag(void *hal, bool start)
+{
+ if (start) {
+  wa_awdl_ctrl_before=rtw_hal_read32(hal,0xce24);
+  wa_awdl_cam_before=rtw_hal_read32(hal,0xce34);
+  wa_awdl_dis_before=rtw_hal_read32(hal,0xce38);
+  /* CTRL_FLTR: route RTS, CTS and ACK to host, retaining normal RX admission. */
+  rtw_hal_write32(hal,0xce24,(wa_awdl_ctrl_before & ~0x0fc00000) | 0x05400000);
+ } else {
+  pr_info("AWDL_RESPONSE final_cam=%08x\n",rtw_hal_read32(hal,0xce34));
+  rtw_hal_write32(hal,0xce34,wa_awdl_cam_before);
+  rtw_hal_write32(hal,0xce38,wa_awdl_dis_before);
+  rtw_hal_write32(hal,0xce24,wa_awdl_ctrl_before);
+ }
+ pr_info("AWDL_CONTROL_DIAG start=%u filter=%08x ack_cam=%08x\n",
+  start,rtw_hal_read32(hal,0xce24),rtw_hal_read32(hal,0xce34));
+}
+static const u8 wa_awdl_bssid[6] = {0x00,0x25,0x00,0xff,0x94,0x73};
+
+static int wa_awdl_start(void *phl, struct rtw_wifi_role_t *role,
+ struct rtw_wifi_role_link_t *link, u32 freq)
+{
+ struct wa_nan_stageb_ctx *ctx = &wa_nan_stageb;
+ struct rtw_chan_def ch;
+ enum role_type type = PHL_RTYPE_NAN;
+ u32 before, after;
+ int ret, cleanup;
+ if (!mutex_trylock(&wa_nan_lifecycle_lock)) return -EBUSY;
+ if (atomic_read(&wa_nan_stageb_state)) { ret=-EBUSY; goto unlock; }
+ ret=rtw_hal_wa_nan_command_begin(((struct phl_info_t *)phl)->hal);
+ if (ret) goto unlock;
+ ret=rtw_phl_wa_nan_radio_acquire(phl);
+ if (ret) goto command_end;
+ memset(ctx,0,sizeof(*ctx));
+ ctx->phl=phl;
+ atomic_set(&wa_nan_stageb_state,1);
+ ret=wa_nan_stageb_precondition(ctx,role,link);
+ if (ret) goto fail;
+ ctx->rx_before=rtw_hal_get_rxfltr_opt_mode(ctx->phl->hal,ctx->band);
+ if (ctx->rx_before!=RX_FLTR_OPT_MODE_STA_NORMAL) { ret=-EBUSY; goto fail; }
+ ctx->channel_before=GET_PRIMARY_LINK(dvobj_get_primary_adapter(
+   (struct dvobj_priv *)ctx->phl->phl_com->drv_priv))->mlmeextpriv.chandef;
+ ch=ctx->channel_before;
+ ch.chan=ch.center_ch=freq==2437 ? 6 : (freq-5000)/5;
+ ch.band=freq==2437 ? BAND_ON_24G : BAND_ON_5G;
+ ch.bw=CHANNEL_WIDTH_20; ch.offset=CHAN_OFFSET_NO_EXT; ch.is_dfs=false;
+ ctx->channel_changed=true;
+ ret=wa_nan_restore_channel(phl,&ch);
+ if (ret) goto fail;
+ ret=phl_wifi_role_change(ctx->phl,role,link,WR_CHG_TYPE,&type);
+ ctx->role_changed=role->type==PHL_RTYPE_NAN;
+ if (ret!=RTW_PHL_STATUS_SUCCESS) { ret=-EIO; goto fail; }
+ ctx->rx_changed=true;
+ ret=rtw_hal_wa_nan_rx_filter(ctx->phl->hal,ctx->band,1,&before,&after);
+ if (ret) goto fail;
+ /* RX_FLTR_OPT bit0 is SNIFFER_MODE on 8852B. */
+ if (after&1) { ret=-EPERM; goto fail; }
+ ctx->mgmt=wa_nan_mgmt_alloc(ctx->phl,role,link,&ctx->mgmt_ready);
+ if (!ctx->mgmt) { ret=-ENOMEM; goto fail; }
+ ctx->mgmt_allocated=true;
+ if (!ctx->mgmt_ready) { ret=-EIO; goto fail; }
+ ctx->plan.macid_mgn=ctx->mgmt->macid;
+ memcpy(ctx->plan.nmi,link->mac_addr,6);
+ memcpy(ctx->plan.cluster,wa_awdl_bssid,6);
+ rtw_phl_wa_nan_sdf_set_macid(ctx->mgmt->macid);
+ wa_awdl_peer_macid=ctx->mgmt->macid;
+ wa_awdl_phl=phl;
+ ctx->entered=true;
+ wa_nan_host_owned=true;
+ wa_nan_sdf_open();
+ wa_awdl_control_diag(ctx->phl->hal,true);
+ WRITE_ONCE(wa_awdl_active,true);
+ pr_info("AWDL_START freq=%u rx_filter=%08x sniffer=0 macid=%u local=%pM bssid=%pM nan_fw_started=0\n",
+   freq,after,ctx->mgmt->macid,link->mac_addr,wa_awdl_bssid);
+ ret=0;
+ goto command_end;
+fail:
+ cleanup=wa_nan_host_cleanup(phl);
+ if (cleanup) { ctx->held=true; ret=-EUCLEAN; }
+command_end:
+ rtw_hal_wa_nan_command_end();
+unlock:
+ mutex_unlock(&wa_nan_lifecycle_lock);
+ return ret;
+}
+
+int rtw_phl_awdl_probe(void *phl, struct rtw_wifi_role_t *role,
+ struct rtw_wifi_role_link_t *link, u32 op, u32 freq,
+ const u8 *frame, u16 len, u64 cookie)
+{
+ struct wa_nan_stageb_ctx *ctx=&wa_nan_stageb;
+ int ret;
+ u64 internal_cookie;
+ if (op==0x100) return wa_awdl_start(phl,role,link,freq);
+ if (!rtw_phl_awdl_probe_active(phl)) return -ENETDOWN;
+ if (op==0x101) { wa_awdl_control_diag(ctx->phl->hal,false); return rtw_phl_wa_nan_host_stop(phl); }
+ if (op==0x104) {
+  u32 ctrl=rtw_hal_read32(ctx->phl->hal,0xce34);
+  u32 dis=rtw_hal_read32(ctx->phl->hal,0xce38);
+  if (freq>1) return -EINVAL;
+  /* mac_ax/addr_cam.c::_set_mac_resp_ack: disable ACK via address CAM. */
+  if (!freq) {
+   rtw_hal_write32(ctx->phl->hal,0xce34,ctrl & ~BIT(0));
+   rtw_hal_write32(ctx->phl->hal,0xce38,(dis & ~0x3ff) | 0xff);
+  } else {
+   rtw_hal_write32(ctx->phl->hal,0xce38,wa_awdl_dis_before);
+   rtw_hal_write32(ctx->phl->hal,0xce34,ctrl | BIT(0));
+  }
+  ctrl=rtw_hal_read32(ctx->phl->hal,0xce34);
+  pr_info("AWDL_RESPONSE enabled=%u cam=%08x dis=%08x\n",freq,ctrl,rtw_hal_read32(ctx->phl->hal,0xce38));
+  return !!(ctrl & BIT(0))==freq ? 0 : -EIO;
+ }
+ if (op==0x103) {
+  if (len!=6 || !is_valid_ether_addr(frame)) return -EINVAL;
+  ret=rtw_hal_wa_nan_command_begin(ctx->phl->hal);
+  if (ret) return ret;
+  ret=rtw_phl_wa_nan_peer(phl,frame,true);
+  if (!ret) ret=rtw_hal_wa_nan_data_rx_mode(ctx->phl->hal,ctx->peer->macid,wa_awdl_bssid);
+  if (!ret) ret=rtw_hal_wa_nan_mgmt_match(ctx->phl->hal,ctx->mgmt->macid,false);
+  if (!ret) wa_awdl_peer_macid=ctx->peer->macid;
+  rtw_hal_wa_nan_command_end();
+  pr_info("AWDL_PEER peer=%pM macid=%u result=%d\n",frame,wa_awdl_peer_macid,ret);
+  return ret;
+ }
+ if (op!=0x102 || !cookie || !frame || len<30 || len>WA_NAN_FRAME_MAX)
+  return -EINVAL;
+ if ((frame[1]&0x43) || memcmp(frame+10,link->mac_addr,6) ||
+     memcmp(frame+16,wa_awdl_bssid,6)) return -EINVAL;
+ if (frame[0]!=0xd0 && frame[0]!=0x08 && frame[0]!=0x88) return -EINVAL;
+ if ((frame[0]&0x0c)==8 && !(frame[4]&1) &&
+     (!ctx->peer_ready || memcmp(frame+4,ctx->peer->mac_addr,6))) return -ENOTCONN;
+ return wa_nan_tx(phl,frame,len,&internal_cookie,cookie,freq,0,NULL,0);
+}
+#endif
