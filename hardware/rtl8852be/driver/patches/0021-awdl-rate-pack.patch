+++ b/phl/wa_awdl_pack.h
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Move the first MSDU between CPU-owned prepared MPDUs, preserving wire order. */
+static u16 wa_awdl_pack_one(u8 *dst,u32 *dst_len,u8 *src,u32 *src_len,u16 limit)
+{
+ bool da=!!(dst[24]&0x80),sa=!!(src[24]&0x80);
+ u32 size=sa ? get_unaligned_be16(src+38):*src_len-26;
+ u32 body=*dst_len-26+(da ? 0:14),at=ALIGN(body,4),end=at+14+size;
+ u32 consumed=sa ? 14+size:size;
+ if(end>limit)return 0;
+ if(!da) {
+  memmove(dst+40,dst+26,*dst_len-26);
+  memcpy(dst+26,dst+4,6);memcpy(dst+32,dst+10,6);
+  put_unaligned_be16(*dst_len-26,dst+38);dst[24]|=0x80;
+ }
+ memset(dst+26+body,0,at-body);
+ if(sa)memcpy(dst+26+at,src+26,14+size);
+ else {
+  memcpy(dst+26+at,src+4,6);memcpy(dst+32+at,src+10,6);
+  put_unaligned_be16(size,dst+38+at);memcpy(dst+40+at,src+26,size);
+ }
+ if(consumed<*src_len-26)consumed=ALIGN(consumed,4);
+ memmove(src+26,src+26+consumed,*src_len-26-consumed);
+ *src_len-=consumed;*dst_len=26+end;
+ return size-16+ETH_HLEN;
+}
