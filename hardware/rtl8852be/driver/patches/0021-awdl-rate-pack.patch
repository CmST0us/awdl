--- /dev/null
+++ b/phl/wa_awdl_rate.h
@@ -0,0 +1,66 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* CCX-weighted HE selection; each descriptor retains fixed-rate MAC retries. */
+struct wa_awdl_rate_sample {
+ u32 reports, mpdu, ok, attempts, score, probe_gap, probe_after;
+ u64 all_reports, all_mpdu, all_ok, all_attempts;
+};
+struct wa_awdl_rate_control {
+ struct wa_awdl_rate_sample samples[3];
+ u32 rates[3], epochs, sample_epoch, changes;
+ u8 cap, selected, best, measured, probe_next;
+ bool probing;
+};
+static void wa_awdl_rate_init(struct wa_awdl_rate_control *r,u8 nss,bool short_symbol,u8 cap)
+{
+ const u8 coding[3]={80,90,100};
+ memset(r,0,sizeof(*r));r->cap=cap;r->selected=r->best=cap;r->probe_next=9;r->probing=true;
+ for(u8 i=0;i<3;i++) {
+  r->rates[i]=980*coding[i]*nss*100/(12*(short_symbol ? 136:144));r->samples[i].probe_gap=8;
+ }
+}
+static bool wa_awdl_rate_observe(struct wa_awdl_rate_control *r,u8 mcs,u32 total,u32 ok,u32 tries)
+{
+ struct wa_awdl_rate_sample *s;u32 score;u8 next,best;bool first;
+ if(r->cap<9 || mcs<9 || mcs>r->cap || !total || !tries || ok>total)return false;
+ first=r->measured!=((1U<<(r->cap-8))-1);
+ s=&r->samples[mcs-9];
+ s->all_reports++;s->all_mpdu+=total;s->all_ok+=ok;s->all_attempts+=total*tries;
+ s->reports++;s->mpdu+=total;s->ok+=ok;s->attempts+=total*tries;
+ if(s->reports<8 || s->mpdu<256)return false;
+ /* Throughput proxy, not measured airtime: successful MPDUs per PHY cost. */
+ score=(u64)r->rates[mcs-9]*s->ok/s->attempts;
+ s->score=(r->measured&BIT(mcs-9)) ? (3*s->score+score)/4:score;
+ r->measured|=BIT(mcs-9);s->reports=s->mpdu=s->ok=s->attempts=0;
+ if(mcs!=r->selected)return false;
+ r->sample_epoch++;next=r->selected;
+ for(u8 rate=r->cap;rate>=9;rate--)if(!(r->measured&BIT(rate-9))) {next=rate;goto select;}
+ best=r->best;
+ for(u8 rate=9;rate<=r->cap;rate++)
+  if((u64)r->samples[rate-9].score*100>(u64)r->samples[best-9].score*103)best=rate;
+ r->best=best;next=best;
+ if(first) {
+  for(u8 rate=9;rate<=r->cap;rate++) {
+   struct wa_awdl_rate_sample *p=&r->samples[rate-9];
+   p->probe_gap=(u64)p->score*4<(u64)r->samples[best-9].score*3 ? 32:8;
+   p->probe_after=r->sample_epoch+p->probe_gap;
+  }
+ }
+ if(r->probing) {
+  if(!first && mcs!=best) {
+   s->probe_gap=(u64)s->score*4<(u64)r->samples[best-9].score*3 ? min_t(u32,128,s->probe_gap*4):8;
+   s->probe_after=r->sample_epoch+s->probe_gap;
+  }
+  r->probing=false;r->epochs=0;
+ } else if(++r->epochs>=8 && r->cap>9) {
+  r->epochs=0;
+  for(u8 i=9;i<=r->cap;i++) {
+   u8 candidate=r->probe_next;r->probe_next=candidate==r->cap ? 9:candidate+1;
+   if(candidate!=best && r->sample_epoch>=r->samples[candidate-9].probe_after) {
+    next=candidate;r->probing=true;break;
+   }
+  }
+ }
+select:
+ if(next==r->selected)return false;
+ r->selected=next;r->changes++;return true;
+}
