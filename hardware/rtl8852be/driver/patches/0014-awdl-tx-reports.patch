+ if(((word>>8)&15)!=15)return;
+ spin_lock_irqsave(&wa_awdl_net_lock,flags);n=wa_awdl_net;
+ if(n && ((word>>16)&127)==n->sta->macid) {
+  n->ccx_reports++;
