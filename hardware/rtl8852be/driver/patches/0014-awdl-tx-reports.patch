+/* Only the AWDL owner redirects special reports; ordinary RA reports remain native. */
+void rtw_hal_awdl_reports(void *hal,u8 band,bool enable,u32 *saved)
+{
+ struct hal_info_t *h=hal;
+ u32 reg=band ? R_AX_PTCLRPT_FULL_HDL_C1:R_AX_PTCLRPT_FULL_HDL;
+ u32 mask=B_AX_FWD_TX_RPT_MSK<<B_AX_FWD_TX_RPT_SH;
+ u32 forward=hal_read32(h->hal_com,R_AX_HW_RPT_FWD);
+ u8 path=hal_read8(h->hal_com,reg);
+ if(enable) {
+  saved[0]=forward&mask;saved[1]=path&GET_MSK(B_AX_SPE_RPT_PATH);
+  forward=(forward&~mask)|(MAC_AX_FWD_TO_HOST<<B_AX_FWD_TX_RPT_SH);
+  path=SET_CLR_WORD(path,FWD_TO_HOST,B_AX_SPE_RPT_PATH);
+ } else {
+  forward=(forward&~mask)|saved[0];
+  path=(path&~GET_MSK(B_AX_SPE_RPT_PATH))|saved[1];
+ }
+ hal_write32(h->hal_com,R_AX_HW_RPT_FWD,forward);hal_write8(h->hal_com,reg,path);
+ pr_info("AWDL_CCX_ROUTE enabled=%u band=%u path=%02x forward=%08x\n",
+  enable,band,hal_read8(h->hal_com,reg),hal_read32(h->hal_com,R_AX_HW_RPT_FWD));
 }
 
