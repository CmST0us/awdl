+/* SPDX-License-Identifier: GPL-2.0 */
+/* Included by rtw_cfgvendor.c; commands run under cfg80211's wiphy lock. */
+#include "wa_nan_vendor.h"
+#include "wa_nan_mgmt_rx.h"
+
+static atomic_t wa_nan_event_drops = ATOMIC_INIT(0);
+static atomic_t wa_nan_rx_oversize = ATOMIC_INIT(0);
+static void wa_nan_emit(_adapter *adapter, u32 event, u64 cookie,
+			const u8 *frame, u32 len, u32 freq, u32 flags,
+			u32 counter, u32 tx_status, u8 acked, const struct wa_nan_verified_rx *verified);
+
+static const struct nla_policy wa_nan_policy[WA_NAN_ATTR_MAX + 1] = {
+	[WA_NAN_ATTR_VERSION] = { .type = NLA_U32 },
+	[WA_NAN_ATTR_OP] = { .type = NLA_U32 },
+	[WA_NAN_ATTR_COOKIE] = { .type = NLA_U64 },
+	[WA_NAN_ATTR_FRAME] = { .type = NLA_BINARY },
+	[WA_NAN_ATTR_PEER_ADDR] = { .type = NLA_BINARY, .len = 6 },
+	[WA_NAN_ATTR_CLUSTER_ID] = { .type = NLA_BINARY, .len = 6 },
+	[WA_NAN_ATTR_KEY_OWNER] = { .type = NLA_U32 },
+	[WA_NAN_ATTR_KEY_CIPHER] = { .type = NLA_U32 },
+	[WA_NAN_ATTR_KEY_INDEX] = { .type = NLA_U32 },
+	[WA_NAN_ATTR_KEY_DATA] = { .type = NLA_BINARY, .len = 16 },
+	[WA_NAN_ATTR_TX_PROTECTION] = { .type = NLA_U32 },
+	[WA_NAN_ATTR_KEY_COOKIE] = { .type = NLA_U64 },
+	[WA_NAN_ATTR_FREQ] = { .type = NLA_U32 },
+	[WA_NAN_ATTR_SCHEDULE_ACTION] = { .type = NLA_U32 },
+	[WA_NAN_ATTR_SCHEDULE] = { .type = NLA_BINARY, .len = WA_NAN_SCHEDULE_SIZE },
+	[WA_NAN_ATTR_TX_PN] = { .type = NLA_BINARY, .len = 6 },
+	[WA_NAN_ATTR_NDI_ADDR] = { .type = NLA_BINARY, .len = 6 },
+	[WA_NAN_ATTR_NDI_CONFIG] = { .type = NLA_BINARY, .len = sizeof(struct wa_nan_ndi_config) },
+	[WA_NAN_ATTR_DATA_CHANNEL] = { .type = NLA_BINARY, .len = sizeof(struct wa_nan_channel) },
+};
+
+static u32 wa_nan_frequency(u8 channel)
+{
+	if (channel == 14) return 2484;
+	if (channel >= 1 && channel <= 13) return 2407 + channel * 5;
+	if (channel >= 36 && channel <= 177) return 5000 + channel * 5;
+	return 0;
+}
+
+static bool wa_nan_channel_usable(struct wiphy *wiphy, const struct wa_nan_channel *c)
+{
+	struct cfg80211_chan_def d = {0};
+	if (c->width > 2 || !wa_nan_frequency(c->primary) || !wa_nan_frequency(c->center))
+		return false;
+	d.chan = ieee80211_get_channel(wiphy, wa_nan_frequency(c->primary));
+	if (!d.chan) return false;
+	d.width = c->width == 2 ? NL80211_CHAN_WIDTH_80 :
+		c->width == 1 ? NL80211_CHAN_WIDTH_40 : NL80211_CHAN_WIDTH_20;
+	d.center_freq1 = wa_nan_frequency(c->center);
+	return cfg80211_chandef_valid(&d) && cfg80211_chandef_usable(wiphy, &d,
+		IEEE80211_CHAN_DISABLED | IEEE80211_CHAN_NO_IR | IEEE80211_CHAN_RADAR);
+}
+
+static int wa_nan_data_caps(struct wiphy *wiphy, struct sk_buff *reply)
+{
+	struct ieee80211_supported_band *band = wiphy->bands[NL80211_BAND_5GHZ];
+	struct ieee80211_ht_cap ht = {0};
+	struct ieee80211_vht_cap vht = {0};
+	struct wa_nan_channel channels[WA_NAN_CHANNEL_MAX];
+	unsigned int i, n = 0;
+	if (!band || !band->ht_cap.ht_supported) return 0;
+	ht.cap_info = cpu_to_le16(band->ht_cap.cap);
+	ht.ampdu_params_info = band->ht_cap.ampdu_factor | (band->ht_cap.ampdu_density << 2);
+	ht.mcs = band->ht_cap.mcs;
+	if (nla_put(reply, WA_NAN_ATTR_HT_CAP_5G, sizeof(ht), &ht)) return -EMSGSIZE;
+	if (band->vht_cap.vht_supported) {
+		vht.vht_cap_info = cpu_to_le32(band->vht_cap.cap);
+		vht.supp_mcs = band->vht_cap.vht_mcs;
+		if (nla_put(reply, WA_NAN_ATTR_VHT_CAP, sizeof(vht), &vht)) return -EMSGSIZE;
+	}
+	{
+		const struct ieee80211_sta_he_cap *raw =
+			ieee80211_get_he_iftype_cap(band, NL80211_IFTYPE_STATION);
+		if (raw && raw->has_he) {
+			u8 he[WA_NAN_HE_CAP_SIZE] = {0};
+			/* Native SU data only: no TWT, trigger, sounding or >80 MHz.
+			 * Fixed 16us RX packet extension replaces optional PPE. */
+			he[6] = raw->he_cap_elem.phy_cap_info[0] & BIT(2);
+			he[7] = raw->he_cap_elem.phy_cap_info[1] & (BIT(5)|BIT(6));
+			he[13] = raw->he_cap_elem.phy_cap_info[7] & BIT(2);
+			he[15] = 2 << 6;
+			put_unaligned_le16(le16_to_cpu(raw->he_mcs_nss_supp.rx_mcs_80) | 0xfff0, he+17);
+			put_unaligned_le16(le16_to_cpu(raw->he_mcs_nss_supp.tx_mcs_80) | 0xfff0, he+19);
+			if (nla_put(reply, WA_NAN_ATTR_HE_CAP, sizeof(he), he)) return -EMSGSIZE;
+		}
+	}
+	for (i = 0; i < band->n_channels; i++) {
+		u8 ch = ieee80211_frequency_to_channel(band->channels[i].center_freq);
+		u8 base = ch >= 149 ? 149 : ch >= 100 ? 100 : 36;
+		u8 width;
+		for (width = 0; width <= (band->vht_cap.vht_supported ? 2 : 1); width++) {
+			struct wa_nan_channel c = { ch, ch, width };
+			if (width == 1) c.center = ch + (((ch-base)/4 & 1) ? -2 : 2);
+			if (width == 2) c.center = base + ((ch-base)/16)*16 + 6;
+			if (n < WA_NAN_CHANNEL_MAX && wa_nan_channel_usable(wiphy, &c))
+				channels[n++] = c;
+		}
+	}
+	return nla_put(reply, WA_NAN_ATTR_CHANNELS, n * sizeof(channels[0]), channels) ? -EMSGSIZE : 0;
+}
+
+static int wa_nan_vendor_command(struct wiphy *wiphy,
+		struct wireless_dev *wdev, const void *data, int len)
+{
+	struct nlattr *tb[WA_NAN_ATTR_MAX + 1];
+	_adapter *adapter = (_adapter *)rtw_netdev_priv(wdev->netdev);
+	struct _ADAPTER_LINK *link = GET_PRIMARY_LINK(adapter);
+	void *phl = GET_PHL_INFO(adapter_to_dvobj(adapter));
+	struct sk_buff *reply;
+	u32 op;
+	int ret;
+
+	ret = nla_parse(tb, WA_NAN_ATTR_MAX, data, len, wa_nan_policy, NULL);
+	if (ret) return ret;
+	if (!tb[WA_NAN_ATTR_VERSION] || !tb[WA_NAN_ATTR_OP]) return -EINVAL;
+	if (nla_get_u32(tb[WA_NAN_ATTR_VERSION]) != WA_NAN_ABI_VERSION)
+		return -EPROTONOSUPPORT;
+	op = nla_get_u32(tb[WA_NAN_ATTR_OP]);
+	if (!link || !link->wrlink || !adapter->phl_role) return -ENODEV;
+	if (op == WA_NAN_OP_GET_CAPS) {
+		u8 cluster[6] = {0x50,0x6f,0x9a,0x01,0,0};
+		struct ieee80211_supported_band *band = wiphy->bands[NL80211_BAND_2GHZ];
+		struct ieee80211_ht_cap ht = {0};
+		u32 bigtk = rtw_phl_wa_nan_bigtk_supported(phl) ? WA_NAN_FEAT_LOCAL_BIGTK_TX : 0;
+		u32 ndi = rtw_phl_wa_nan_ndi_supported(phl) ?
+			WA_NAN_FEAT_NDI | WA_NAN_FEAT_PERSISTENT_NDI | WA_NAN_FEAT_NDI_STA | WA_NAN_FEAT_LOCAL_DATA_SCHEDULE : 0;
+		if (band && band->ht_cap.ht_supported) {
+			ht.cap_info = cpu_to_le16(band->ht_cap.cap);
+			ht.ampdu_params_info = band->ht_cap.ampdu_factor |
+				(band->ht_cap.ampdu_density << 2);
+			ht.mcs = band->ht_cap.mcs;
+		}
+		ret = rtw_phl_wa_nan_get_cluster(phl, cluster);
+		if (ret) return ret;
+		reply = cfg80211_vendor_cmd_alloc_reply_skb(wiphy, 768);
+		if (!reply) return -ENOMEM;
+		ret = wa_nan_data_caps(wiphy, reply);
+		if (ret) { kfree_skb(reply); return ret; }
+		if (band && band->ht_cap.ht_supported &&
+		    nla_put(reply, WA_NAN_ATTR_HT_CAP, sizeof(ht), &ht)) {
+			kfree_skb(reply); return -EMSGSIZE;
+		}
+		if (nla_put_u32(reply, WA_NAN_ATTR_VERSION, WA_NAN_ABI_VERSION) ||
+		    nla_put_u32(reply, WA_NAN_ATTR_FEATURES, WA_NAN_FEAT_MGMT_TX |
+			WA_NAN_FEAT_MGMT_RX | WA_NAN_FEAT_RX_RAW | WA_NAN_FEAT_PEER |
+			WA_NAN_FEAT_PAIRWISE_CCMP128 | WA_NAN_FEAT_LOCAL_IGTK_CAM |
+			WA_NAN_FEAT_MGMT_PAIRWISE_CCMP128 | bigtk | ndi) ||
+		    nla_put_u32(reply, WA_NAN_ATTR_MAX_FRAME, WA_NAN_FRAME_MAX) ||
+		    nla_put(reply, WA_NAN_ATTR_NMI_ADDR, 6, link->wrlink->mac_addr) ||
+		    nla_put(reply, WA_NAN_ATTR_CLUSTER_ID, 6, cluster) ||
+		    nla_put_u32(reply, WA_NAN_ATTR_FREQ,
+			wa_nan_frequency(link->mlmeextpriv.chandef.chan)) ||
+		    nla_put_u32(reply, WA_NAN_ATTR_EVENT_DROPS, atomic_read(&wa_nan_event_drops)) ||
+		    nla_put_u32(reply, WA_NAN_ATTR_RX_OVERSIZE, atomic_read(&wa_nan_rx_oversize))) {
+			kfree_skb(reply); return -EMSGSIZE;
+		}
+		return cfg80211_vendor_cmd_reply(reply);
+	}
+	if (op == WA_NAN_OP_GET_SEQ) {
+		u8 pn[6];
+		u32 index;
+		if (!tb[WA_NAN_ATTR_KEY_OWNER] || !tb[WA_NAN_ATTR_KEY_INDEX] ||
+		    (tb[WA_NAN_ATTR_NDI_ADDR] && nla_len(tb[WA_NAN_ATTR_NDI_ADDR]) != 6)) return -EINVAL;
+		index = nla_get_u32(tb[WA_NAN_ATTR_KEY_INDEX]);
+		if (index > 7) return -EINVAL;
+		ret = rtw_phl_wa_nan_group_seq(phl, nla_get_u32(tb[WA_NAN_ATTR_KEY_OWNER]), index,
+			tb[WA_NAN_ATTR_NDI_ADDR] ? nla_data(tb[WA_NAN_ATTR_NDI_ADDR]) : NULL, pn);
+		if (ret) return ret;
+		reply = cfg80211_vendor_cmd_alloc_reply_skb(wiphy, 64);
+		if (!reply) return -ENOMEM;
+		if (nla_put(reply, WA_NAN_ATTR_TX_PN, 6, pn)) { kfree_skb(reply); return -EMSGSIZE; }
+		return cfg80211_vendor_cmd_reply(reply);
+	}
+	if (op == WA_NAN_OP_NDI_ADD || op == WA_NAN_OP_NDI_STA_ADD || op == WA_NAN_OP_NDI_CONNECT ||
+	    op == WA_NAN_OP_NDI_DEL || op == WA_NAN_OP_NDI_IF_ADD || op == WA_NAN_OP_NDI_IF_DEL) {
+		struct wa_nan_ndi_config config;
+		u32 ifindex = 0;
+		if ((op == WA_NAN_OP_NDI_ADD || op == WA_NAN_OP_NDI_STA_ADD || op == WA_NAN_OP_NDI_CONNECT) && (!tb[WA_NAN_ATTR_NDI_CONFIG] ||
+		    nla_len(tb[WA_NAN_ATTR_NDI_CONFIG]) != sizeof(config))) return -EINVAL;
+		memset(&config, 0, sizeof(config));
+		if (op == WA_NAN_OP_NDI_ADD || op == WA_NAN_OP_NDI_STA_ADD || op == WA_NAN_OP_NDI_CONNECT) memcpy(&config, nla_data(tb[WA_NAN_ATTR_NDI_CONFIG]), sizeof(config));
+		if ((op == WA_NAN_OP_NDI_ADD || op == WA_NAN_OP_NDI_STA_ADD || op == WA_NAN_OP_NDI_CONNECT) && !wa_nan_channel_usable(wiphy, &config.channel)) {
+			memzero_explicit(&config, sizeof(config)); return -EOPNOTSUPP;
+		}
+		ret = rtw_phl_wa_nan_ndi(phl, op, (op == WA_NAN_OP_NDI_ADD || op == WA_NAN_OP_NDI_STA_ADD || op == WA_NAN_OP_NDI_CONNECT) ? &config : NULL, &ifindex);
+		memzero_explicit(&config, sizeof(config));
+		if (ret || op == WA_NAN_OP_NDI_DEL || op == WA_NAN_OP_NDI_IF_DEL) return ret;
+		reply = cfg80211_vendor_cmd_alloc_reply_skb(wiphy, 64);
+		if (!reply) return -ENOMEM;
+		if (nla_put_u32(reply, WA_NAN_ATTR_NDI_IFINDEX, ifindex)) { kfree_skb(reply); return -EMSGSIZE; }
+		return cfg80211_vendor_cmd_reply(reply);
+	}
+	if (op == WA_NAN_OP_SCHEDULE_PROBE) {
+		if (!tb[WA_NAN_ATTR_SCHEDULE_ACTION]) return -EINVAL;
+		return rtw_phl_wa_nan_schedule_probe(phl, adapter->phl_role, link->wrlink,
+			nla_get_u32(tb[WA_NAN_ATTR_SCHEDULE_ACTION]));
+	}
+	if (op == WA_NAN_OP_SET_SCHEDULE) {
+		if (!tb[WA_NAN_ATTR_SCHEDULE] ||
+		    nla_len(tb[WA_NAN_ATTR_SCHEDULE]) != WA_NAN_SCHEDULE_SIZE ||
+		    !tb[WA_NAN_ATTR_CLUSTER_ID] ||
+		    nla_len(tb[WA_NAN_ATTR_CLUSTER_ID]) != 6) return -EINVAL;
+		const u8 *s=nla_data(tb[WA_NAN_ATTR_SCHEDULE]);
+		u32 slots=get_unaligned_le32(s+8);
+		if (tb[WA_NAN_ATTR_PEER_ADDR] || tb[WA_NAN_ATTR_DATA_CHANNEL]) {
+			struct wa_nan_channel channel;
+			if (tb[WA_NAN_ATTR_PEER_ADDR] && nla_len(tb[WA_NAN_ATTR_PEER_ADDR])!=6) return -EINVAL;
+			if (!tb[WA_NAN_ATTR_DATA_CHANNEL] ||
+			    nla_len(tb[WA_NAN_ATTR_DATA_CHANNEL]) != sizeof(channel)) return -EINVAL;
+			memcpy(&channel, nla_data(tb[WA_NAN_ATTR_DATA_CHANNEL]), sizeof(channel));
+			if (!wa_nan_channel_usable(wiphy, &channel)) return -EOPNOTSUPP;
+			if (s[0] || s[1]!=2 || s[2]!=16 || s[3]!=4 || s[4] || s[5] ||
+			    s[6]!=channel.center || s[7]!=channel.width || (slots&3)!=2 ||
+			    memchr_inv(s+12,0,12)) return -EOPNOTSUPP;
+			ret=rtw_phl_wa_nan_local_schedule(phl,adapter->phl_role,link->wrlink,
+				nla_data(tb[WA_NAN_ATTR_CLUSTER_ID]), 2, 1);
+			if (!ret) ret=rtw_phl_wa_nan_peer_schedule(phl,
+				tb[WA_NAN_ATTR_PEER_ADDR] ? nla_data(tb[WA_NAN_ATTR_PEER_ADDR]) : NULL,slots,&channel);
+		} else {
+			u8 length=s[3];
+			if (s[0] || s[1]!=2 || s[2]!=16 || s[4] || s[5] ||
+			    s[6]!=6 || s[7] || (length!=1 && length!=4) ||
+			    (length==1 && slots!=2) ||
+			    (length==4 && (slots&3)!=2) ||
+			    memchr_inv(s+8+length,0,16-length)) return -EOPNOTSUPP;
+			ret=rtw_phl_wa_nan_local_schedule(phl,adapter->phl_role,link->wrlink,
+				nla_data(tb[WA_NAN_ATTR_CLUSTER_ID]),slots,length);
+		}
+		return ret;
+	}
+	if (op == WA_NAN_OP_STOP) return rtw_phl_wa_nan_host_stop(phl);
+	if (op == WA_NAN_OP_KEY_ADD || op == WA_NAN_OP_KEY_DEL) {
+		u64 key_cookie = tb[WA_NAN_ATTR_KEY_COOKIE] ? nla_get_u64(tb[WA_NAN_ATTR_KEY_COOKIE]) : 0;
+		u32 owner = tb[WA_NAN_ATTR_KEY_OWNER] ?
+			nla_get_u32(tb[WA_NAN_ATTR_KEY_OWNER]) : WA_NAN_KEY_OWNER_PAIRWISE;
+		struct nlattr *attr;
+		int remaining;
