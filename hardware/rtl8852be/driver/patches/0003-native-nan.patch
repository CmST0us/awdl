+/* SPDX-License-Identifier: GPL-2.0 */
+/* Protected BlockAck actions on the NDP peer's native FAW queue. */
+#ifndef WA_NAN_BA_H
+#define WA_NAN_BA_H
+
+static bool wa_ndi_aggregate_ready(struct wa_nan_ndi *n);
+
+/* Response expiry is failure detection, never a release timer for data. */
+static void wa_ndi_ba_expired(struct work_struct *work)
+{
+ struct wa_nan_ndi *n=container_of(to_delayed_work(work),struct wa_nan_ndi,ba_expiry);
+ if (READ_ONCE(n->ready)) schedule_work(&n->work);
+}
+
+struct wa_ndi_ba_tx {
+ struct rtw_txfb_t feedback;
+ struct wa_nan_ndi *owner;
+ bool shared;
+ u8 action, token;
+};
+
+static void wa_ndi_ba_feedback(struct rtw_txfb_t *feedback)
+{
+ struct wa_ndi_ba_tx *tx=feedback->ctx;
+ struct wa_nan_ndi *n=tx->owner;
+ pr_info("WA_PROBE ndi-ba-tx-done action=%u status=%u\n",tx->action,feedback->txsts);
+ if (tx->action==0 && tx->token==READ_ONCE(n->ba_token) && feedback->txsts!=TX_STATUS_TX_DONE) {
+  WRITE_ONCE(n->ba_requested,false);
+  if (READ_ONCE(n->ready)) schedule_work(&n->work);
+ }
+ if (tx->shared) wa_ccmp_put();
+ kfree(tx);
+ wa_ndi_put(n);
+}
+
+static int wa_ndi_ba_send(struct wa_nan_ndi *n, const u8 *body, size_t length)
+{
+ struct xmit_frame *x;
+ struct wa_ndi_ba_tx *tx;
+ unsigned long flags;
+ u64 pn;
+ u8 *f;
+ int ret=-EIO;
+ bool shared=n->shared_peer;
+ if (shared) {
+  spin_lock_irqsave(&wa_ccmp_lock,flags);
+  if (!wa_ccmp.ready || wa_ccmp.tx_pn==WA_NAN_PN_MAX) {
+   spin_unlock_irqrestore(&wa_ccmp_lock,flags); return -ENOKEY;
+  }
+  pn=++wa_ccmp.tx_pn; wa_ccmp.refs++;
+  spin_unlock_irqrestore(&wa_ccmp_lock,flags);
+ } else {
+  if (n->ba_tx_pn==WA_NAN_PN_MAX) return -EOVERFLOW;
+  pn=++n->ba_tx_pn;
+ }
+ x=rtw_core_wa_nan_alloc(n->adapter,32+length);
+ if (!x) { ret=-ENOMEM; goto put_key; }
+ tx=kzalloc(sizeof(*tx),GFP_KERNEL);
+ if (!tx) { ret=-ENOMEM; goto free_frame; }
+ f=x->buf_addr;
+ memset(f,0,32); f[0]=0xd0; f[1]=0x40;
+ memcpy(f+4,n->config.peer,6); memcpy(f+10,n->config.local,6);
+ memcpy(f+16,wa_nan_stageb.plan.cluster,6);
+ x->attrib.seqnum=n->adapter->mlmeextpriv.mgnt_seq++ & 4095;
+ SetSeqNum(f,x->attrib.seqnum);
+ wa_ccmp_iv(f+24,pn); memcpy(f+32,body,length);
+ x->phl_txreq->mdata.wdinfo_en=1;
+ x->phl_txreq->mdata.type=RTW_PHL_PKT_TYPE_MGNT;
+ x->phl_txreq->mdata.cat=RTW_PHL_RING_CAT_MGNT;
+ x->phl_txreq->mdata.macid=n->sta->macid;
+ x->phl_txreq->mdata.sw_seq=x->attrib.seqnum;
+ x->phl_txreq->mdata.bk=1;
+ x->phl_txreq->mdata.f_rate=RTW_DATA_RATE_OFDM6;
+ x->phl_txreq->mdata.userate_sel=1;
+ x->phl_txreq->mdata.hdr_len=12;
+ x->phl_txreq->mdata.sec_hw_enc=1;
+ x->phl_txreq->mdata.sec_type=RTW_ENC_CCMP;
+ x->phl_txreq->mdata.sec_cam_idx=n->pairwise_cam;
+ x->phl_txreq->mdata.force_key_en=1;
+ tx->owner=n; tx->shared=shared; tx->action=body[1]; tx->token=body[2];
+ tx->feedback.ctx=tx; tx->feedback.txfb_cb=wa_ndi_ba_feedback;
+ x->phl_txreq->txfb=&tx->feedback;
+ rtw_core_wa_nan_map(n->adapter,x);
+ atomic_inc(&n->refs);
+ if (rtw_phl_add_tx_req(n->phl,x->phl_txreq)!=RTW_PHL_STATUS_SUCCESS) {
+  wa_ndi_put(n); core_recycle_txreq_phyaddr(n->adapter,x->phl_txreq);
+  kfree(tx); ret=-ENOBUFS; goto free_frame;
+ }
+ rtw_phl_tx_req_notify(n->phl);
+ return 0;
+free_frame:
+ core_tx_free_xmitframe(n->adapter,x);
+put_key:
+ if (shared) wa_ccmp_put();
+ return ret;
+}
+
+/* Actions share the management PN domain when NMI and NDI share the TK.
+ * Unknown action categories remain available to the NAN management path. */
+static bool wa_ndi_ba_rx(struct wa_nan_ndi *n, const u8 *f, u32 len, u32 rxflags)
+{
+ u8 plain[64], scratch[64];
+ struct sk_buff *event;
+ unsigned long flags;
+ u64 pn;
+ int ret;
+ if ((len!=46 && len!=49) || !wa_ccmp_header(f,len) ||
+     memcmp(f+16,wa_nan_stageb.plan.cluster,6) ||
+     (rxflags&(WA_NAN_RX_ICV_ERROR|WA_NAN_RX_CRC_ERROR))) return false;
+ ret=wa_ccmp_verify(n->config.tk,f,len,
+       (rxflags&WA_NAN_RX_HW_DEC) && !(rxflags&WA_NAN_RX_SW_DEC),plain,scratch);
+ if (ret || plain[24]!=3 || plain[25]>2) return false;
+ if ((plain[25]==2 ? 46 : 49)!=len) return true;
+ pn=wa_ccmp_pn(f+24);
+ event=alloc_skb(len-40,GFP_ATOMIC);
+ if (!event) return true;
+ memcpy(skb_put(event,len-40),plain+24,len-40);
+ if (n->shared_peer) {
+  spin_lock_irqsave(&wa_ccmp_lock,flags);
+  ret=!wa_ccmp.ready || pn<=wa_ccmp.rx_pn ? -EALREADY : 0;
+  if (!ret) wa_ccmp.rx_pn=pn;
+  spin_unlock_irqrestore(&wa_ccmp_lock,flags);
+ } else {
+  spin_lock_irqsave(&wa_ndi_lock,flags);
+  ret=pn<=n->ba_rx_pn ? -EALREADY : 0;
+  if (!ret) n->ba_rx_pn=pn;
+  spin_unlock_irqrestore(&wa_ndi_lock,flags);
+ }
+ if (ret || skb_queue_len(&n->ba_queue)>=16) dev_kfree_skb_any(event);
+ else { skb_queue_tail(&n->ba_queue,event); schedule_work(&n->work); }
+ return true;
+}
+
+static void wa_ndi_ba_work(struct wa_nan_ndi *n)
+{
+ struct sk_buff *event;
+ u8 response[9]={3,1};
+ if (!READ_ONCE(n->ready) || !n->rate_ready) return;
+ while ((event=skb_dequeue(&n->ba_queue))) {
+  const u8 *b=event->data;
+  u16 param, size, tid, status=37;
+  int ret=0;
+  if (b[1]==0) {
+   param=get_unaligned_le16(b+3); tid=(param>>2)&15; size=param>>6;
+   size=!size || size>64 ? 64 : size;
+   ret=rtw_hal_wa_nan_command_begin(n->phl->hal);
+   if (!ret) {
+    if ((param&2) && rtw_phl_start_rx_ba_session(n->phl,n->sta,b[2],0,
+          get_unaligned_le16(b+7)>>4,0,tid,size)==RTW_PHL_STATUS_SUCCESS) {
+     n->rx_ba_mask|=1U<<tid; status=0;
+    }
+    rtw_hal_wa_nan_command_end();
+   }
+   response[2]=b[2]; put_unaligned_le16(status,response+3);
+   put_unaligned_le16((size<<6)|(tid<<2)|3,response+5);
+   ret=wa_ndi_ba_send(n,response,sizeof(response));
+   pr_info("WA_PROBE ndi-ba-rx tid=%u size=%u status=%u response=%d\n",tid,size,status,ret);
+  } else if (b[1]==1) {
+   param=get_unaligned_le16(b+5); tid=(param>>2)&15; size=param>>6;
+   status=get_unaligned_le16(b+3);
+   bool expected=n->ba_requested && b[2]==n->ba_token && !tid;
+   if (expected) {
+    n->ba_requested=false;
+    cancel_delayed_work(&n->ba_expiry);
+   }
+   if (expected && !status && (param&2) && size) {
+    /* Include the largest supported MPDU and its delimiter in the limit. */
+    u32 max_frames=((1U<<(13+n->config.ampdu_exp))-1)/(wa_ndi_amsdu_limit(n)+46);
+    n->sta->asoc_cap.num_ampdu=min_t(u32,min_t(u16,size,64),max_frames);
+    ret=rtw_hal_wa_nan_command_begin(n->phl->hal);
+    if (!ret) {
+     ret=rtw_phl_cmd_cfg_ampdu(n->phl,n->sta->wrole,n->sta,PHL_CMD_DIRECTLY,0)==
+         RTW_PHL_STATUS_SUCCESS ? 0 : -EIO;
+     rtw_hal_wa_nan_command_end();
+    }
+    n->tx_ba=!ret; n->tx_ba_amsdu=!!(param&1);
+    if (!ret) { n->ba_attempts=0; n->ba_generation++; }
+   }
+   pr_info("WA_PROBE ndi-ba-tx tid=%u token=%u status=%u enabled=%u size=%u result=%d\n",
+           tid,b[2],status,n->tx_ba,n->sta->asoc_cap.num_ampdu,ret);
+  } else {
+   param=get_unaligned_le16(b+2); tid=param>>12;
+   if (param&(1U<<11)) {
+    rtw_phl_stop_rx_ba_session(n->phl,n->sta,tid); n->rx_ba_mask&=~(1U<<tid);
+   } else if (!tid) {
+    n->tx_ba=false; n->ba_requested=false; n->ba_attempts=0;
+   }
+   pr_info("WA_PROBE ndi-ba-delete tid=%u initiator=%u\n",tid,!!(param&(1U<<11)));
+  }
+  dev_kfree_skb(event);
+ }
+ /* A response may span two 512-TU opportunities. Expiry marks a failed
+  * request and wakes the worker for a bounded retry. */
+ if (n->ba_requested && ktime_get_ns()-n->ba_requested_ns>=1048576000ULL)
+  n->ba_requested=false;
+ n->ba_draining=false;
+ if (!n->tx_ba && !n->ba_requested && n->ba_attempts<3 &&
+     (n->rx_hw_count || n->rx_sw_count || n->rx_ba_mask)) {
+  u8 request[9]={3,0};
+  int ret;
+  /* Completion callbacks wake the worker when the old sequence domain drains. */
+  if (atomic_read(&n->outstanding)) { n->ba_draining=true; return; }
+  n->ba_requested=true; request[2]=++n->ba_token; n->ba_attempts++;
+  n->ba_requested_ns=ktime_get_ns();
+  put_unaligned_le16((64<<6)|3,request+3);
+  put_unaligned_le16((n->sequence&4095)<<4,request+7);
+  ret=wa_ndi_ba_send(n,request,sizeof(request));
+  if (ret) n->ba_requested=false;
+  else mod_delayed_work(system_wq,&n->ba_expiry,msecs_to_jiffies(1049));
+  pr_info("WA_PROBE ndi-ba-request token=%u attempt=%u ssn=%u outstanding=%d result=%d\n",
+          n->ba_token,n->ba_attempts,n->sequence&4095,atomic_read(&n->outstanding),ret);
+ }
+}
+
+static void wa_ndi_ba_stop(struct wa_nan_ndi *n)
+{
+ unsigned int tid;
+ for (tid=0;tid<16;tid++) if (n->rx_ba_mask&(1U<<tid))
+  rtw_phl_stop_rx_ba_session(n->phl,n->sta,tid);
+ n->rx_ba_mask=0; n->tx_ba=false;
+}
