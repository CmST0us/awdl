+
+/* Read-only software C2H counters; defined in fwcmd.c. */
+u32 mac_get_wa_c2h_counters(u32 *total, u32 *nan, u32 *drop, u32 *done_ack);
+u32 mac_get_wa_nan_done_ack(u32 func);
+void mac_reset_wa_nan_done_ack(void);
+
+/* The local management entry has no transmitter key. Once NDP is connected,
+ * let the peer's A1/A2 entry own reception and security lookup. Its firmware
+ * MACID and DW queue remain allocated independently of address matching. */
+int rtw_hal_wa_nan_mgmt_match(void *hal, u8 macid, bool enable)
+{
+ struct hal_info_t *h=hal;
+ struct mac_role_tbl *role=mac_role_srch(h->mac,macid);
+ u32 result;
+ if (!role || role->info.wifi_role!=MAC_AX_WIFI_ROLE_NAN) return -ENOENT;
+ role->info.a_info.valid=enable;
+ result=mac_upd_addr_cam(h->mac,&role->info,CHG);
+ pr_info("WA_PROBE ndi-mgmt-match macid=%u enabled=%u result=%u\n",macid,enable,result);
+ return result==MACSUCCESS ? 0 : -EIO;
+}
+
+int rtw_hal_wa_nan_data_drop(void *hal, struct rtw_phl_stainfo_t *sta)
+{
+ struct hal_info_t *h=hal;
+ enum rtw_hal_status status=rtw_hal_mac_data_drop_once(h->hal_com,sta);
+ pr_info("WA_PROBE ndi-data-drop macid=%u status=%u\n",sta->macid,status);
+ return status==RTW_HAL_STATUS_SUCCESS ? 0 : -EIO;
+}
+
+int rtw_hal_wa_nan_data_rx_mode(void *hal, u8 macid, const u8 *cluster)
+{
+ struct hal_info_t *h=hal;
+ struct mac_role_tbl *role=mac_role_srch(h->mac,macid);
+ u32 result;
+ if (!role || role->info.wifi_role!=MAC_AX_WIFI_ROLE_NAN) return -ENOENT;
+ /* Only the address-CAM classifier changes: NDP uses three-address
+  * direct frames. The NAN role, firmware port and FAW remain NO_LINK. */
+ role->info.a_info.net_type=cluster ? MAC_AX_NET_TYPE_ADHOC : MAC_AX_NET_TYPE_NO_LINK;
+ memcpy(role->info.bssid,cluster ? cluster : (const u8 *)"\x50\x6f\x9a\x01\0\0",6);
+ memcpy(role->info.b_info.bssid,role->info.bssid,6);
+ result=mac_upd_addr_cam(h->mac,&role->info,CHG);
+ pr_info("WA_PROBE ndi-rx-mode macid=%u mode=%u cluster=%pM result=%u\n",
+         macid,role->info.a_info.net_type,role->info.bssid,result);
+ return result==MACSUCCESS ? 0 : -EIO;
+}
+
+/* Publish the NAN peer's data lifecycle to the firmware rate engine.
+ * The role and port remain NAN/NO_LINK; CAM and keys keep their owners. */
+static int wa_nan_rate_media(struct hal_info_t *hal,
+                            struct rtw_phl_stainfo_t *sta, bool connected)
+{
+ struct h2c_info info = {0};
+ struct fwcmd_joininfo command = {0};
+ struct rtw_wifi_role_link_t *link=sta->rlink;
+ u32 mode=connected ? MAC_AX_ROLE_CONNECT : MAC_AX_ROLE_DISCONN;
+ u32 wmm=(link->hw_band ? MAC_AX_ACTUAL_WMM_BAND : 0) |
+         (link->hw_wmm ? MAC_AX_ACTUAL_WMM_DRV_WMM : 0);
+ info.content_len=sizeof(command);
+ info.h2c_cat=FWCMD_H2C_CAT_MAC;
+ info.h2c_class=FWCMD_H2C_CL_MEDIA_RPT;
+ info.h2c_func=FWCMD_H2C_FUNC_JOININFO;
+ info.done_ack=1;
+ command.dword0=cpu_to_le32(
+   SET_WORD(sta->macid,FWCMD_H2C_JOININFO_MACID) |
+   (mode ? FWCMD_H2C_JOININFO_OPMODE : 0) |
+   (link->hw_band ? FWCMD_H2C_JOININFO_BAND : 0) |
+   SET_WORD(wmm,FWCMD_H2C_JOININFO_WMM) |
+   SET_WORD(sta->chandef.bw,FWCMD_H2C_JOININFO_DL_BW) |
+   SET_WORD(link->hw_port,FWCMD_H2C_JOININFO_PORT_ID) |
+   SET_WORD(MAC_AX_NET_TYPE_NO_LINK,FWCMD_H2C_JOININFO_NET_TYPE) |
+   SET_WORD(MAC_AX_WIFI_ROLE_NAN,FWCMD_H2C_JOININFO_WIFI_ROLE) |
+   SET_WORD(MAC_AX_SELF_ROLE_CLIENT,FWCMD_H2C_JOININFO_SELF_ROLE));
+ return mac_h2c_common(hal->mac,&info,(u32 *)&command)==MACSUCCESS ? 0 : -EIO;
+}
+
+/* Program the peer's encoding before the firmware rate table becomes live.
+ * This update does not change the NAN role, CAM, key or scheduler owners. */
+static int wa_nan_rate_encoding(struct hal_info_t *hal,
+                                struct rtw_phl_stainfo_t *sta,
+                                const struct wa_nan_ndi_config *p)
+{
+ struct rtw_hal_mac_ax_cctl_info c={0}, mask={0};
+ c.data_ldpc=p->he ? sta->asoc_cap.he_ldpc :
+             p->vht ? sta->asoc_cap.vht_ldpc : sta->asoc_cap.ht_ldpc;
+ c.bsr_queue_size_format=p->he;
+ c.nominal_pkt_padding=p->he ? p->he_padding[0] : 0;
+ c.nominal_pkt_padding40=p->he ? p->he_padding[1] : 0;
+ c.nominal_pkt_padding80=p->he ? p->he_padding[2] : 0;
+ mask.data_ldpc=mask.bsr_queue_size_format=1;
+ mask.nominal_pkt_padding=mask.nominal_pkt_padding40=mask.nominal_pkt_padding80=3;
+ return rtw_hal_cmc_tbl_cfg(hal,&c,&mask,sta->macid)==RTW_HAL_STATUS_SUCCESS ? 0 : -EIO;
+}
+
+int rtw_hal_wa_nan_rate(void *hal, struct rtw_phl_stainfo_t *sta,
+                       const struct wa_nan_ndi_config *p, bool enable)
+{
+ struct hal_info_t *h=hal;
+ const u8 *mcs=p ? p->ht_mcs : NULL, *info=p ? p->ht_info : NULL;
+ int ret;
+ if (!enable) {
+  struct rtw_rate_info *r=&sta->hal_sta->ra_info.rpt_rt_i;
+  u32 cctl[8];
+  u64 started=ktime_get_ns();
+  for (u8 i=0;i<8;i++)
+   cctl[i]=mac_sram_dbg_read(h->mac,sta->macid*CCTL_INFO_SIZE+i*4,CMAC_TBL_SEL);
+  pr_info("WA_PROBE ndi-cctrl macid=%u port=%u ampdu=%u density=%u words=%08x/%08x/%08x/%08x/%08x/%08x/%08x/%08x read_us=%llu\n",
+          sta->macid,sta->rlink->hw_port,sta->asoc_cap.num_ampdu,sta->asoc_cap.ampdu_density,
+          cctl[0],cctl[1],cctl[2],cctl[3],cctl[4],cctl[5],cctl[6],cctl[7],
+          (ktime_get_ns()-started)/1000);
+  pr_info("WA_PROBE ndi-rate macid=%u mode=%u bw=%u mcs=%u nss=%u rate=%u retry=%u\n",
+          sta->macid,r->mode,r->bw,r->mcs_idx,r->ss+1,
+          sta->hal_sta->ra_info.curr_tx_rate,sta->hal_sta->ra_info.curr_retry_ratio);
+  ret=wa_nan_rate_media(h,sta,false);
+  if (ret) return ret;
+  if (sta->hal_sta->ra_info.ra_registered) {
+   h->hal_com->assoc_sta_cnt--;
+   h->hal_com->band[sta->rlink->hw_band].assoc_sta_cnt--;
+   rtw_hal_bb_media_status_update(h,sta,false);
+  }
+  return rtw_hal_bb_ra_deregister(h,sta)==RTW_HAL_STATUS_SUCCESS ? 0 : -EIO;
+ }
+ if (!mcs || !info || !(mcs[0]|mcs[1])) return -EINVAL;
+ if (p->channel.width>2 || (p->channel.width && !p->vht && !p->he && !(info[0]&BIT(1))) ||
+     (p->channel.width==2 && !p->vht && !p->he) ||
+     ((p->vht || p->he) && p->channel.primary<36)) return -EINVAL;
+ sta->wmode=(p->channel.primary>14 ? WLAN_MD_11A : WLAN_MD_11G)|WLAN_MD_11N;
+ sta->chandef.band=p->channel.primary>14 ? BAND_ON_5G : BAND_ON_24G;
+ sta->chandef.chan=p->channel.primary; sta->chandef.center_ch=p->channel.center;
+ sta->chandef.bw=p->channel.width;
+ sta->chandef.offset=CHAN_OFFSET_NO_EXT;
+ if (p->channel.width) {
+  u8 low=p->channel.center-(p->channel.width==2 ? 6 : 2);
+  sta->chandef.offset=((p->channel.primary-low)/4 & 1) ? CHAN_OFFSET_LOWER : CHAN_OFFSET_UPPER;
+ }
+ sta->chandef.center_freq1=(p->channel.primary>14 ? 5000 : 2407)+5*p->channel.center;
+ memset(&sta->asoc_cap,0,sizeof(sta->asoc_cap));
+ memcpy(sta->asoc_cap.supported_rates,"\x0c\x12\x18\x24\x30\x48\x60\x6c",8);
+ memcpy(sta->asoc_cap.ht_rx_mcs,mcs,2);
+ sta->asoc_cap.nss_rx=mcs[1] ? 2 : 1;
+ sta->asoc_cap.nss_tx=sta->asoc_cap.nss_rx;
+ sta->asoc_cap.sgi_20=!!(info[0] & BIT(5));
+ sta->asoc_cap.ht_ldpc=!!(info[0] & BIT(0));
+ sta->asoc_cap.sgi_40=!!(info[0] & BIT(6));
+ sta->asoc_cap.num_ampdu=64;
+ sta->asoc_cap.ampdu_density=p->ampdu_density;
+ sta->asoc_cap.ampdu_len_exp=p->ampdu_exp;
+ if (p->vht) {
+  u16 map=get_unaligned_le16(p->vht_mcs);
+  if ((map&3)==3 || (map&0xfff0)!=0xfff0) return -EINVAL;
+  sta->wmode|=WLAN_MD_11AC;
+  memcpy(sta->asoc_cap.vht_rx_mcs,p->vht_mcs,2);
+  sta->asoc_cap.nss_rx=((map>>2)&3)==3 ? 1 : 2;
+  sta->asoc_cap.nss_tx=sta->asoc_cap.nss_rx;
+  sta->asoc_cap.sgi_80=!!(p->vht_info[0]&BIT(5));
+  sta->asoc_cap.vht_ldpc=!!(p->vht_info[0]&BIT(4));
+ }
+ if (p->he) {
+  u16 map=get_unaligned_le16(p->he_mcs);
+  if ((map&3)==3 || (map&0xfff0)!=0xfff0 || p->he_ldpc>1 || p->he_gi>3 ||
+      p->he_padding[0]>2 || p->he_padding[1]>2 || p->he_padding[2]>2) return -EINVAL;
+  sta->wmode|=WLAN_MD_11AX;
+  memset(sta->asoc_cap.he_rx_mcs,0xff,sizeof(sta->asoc_cap.he_rx_mcs));
+  memcpy(sta->asoc_cap.he_rx_mcs,p->he_mcs,2);
+  sta->asoc_cap.nss_rx=((map>>2)&3)==3 ? 1 : 2;
+  sta->asoc_cap.nss_tx=sta->asoc_cap.nss_rx;
+  sta->asoc_cap.he_ldpc=p->he_ldpc;
+  sta->asoc_cap.ltf_gi=BIT(RTW_GILTF_2XHE16)|BIT(RTW_GILTF_2XHE08)|BIT(RTW_GILTF_1XHE16);
+  if (p->he_gi&1) sta->asoc_cap.ltf_gi|=BIT(RTW_GILTF_1XHE08);
+  if (p->he_gi&2) sta->asoc_cap.ltf_gi|=BIT(RTW_GILTF_SGI_4XHE08);
+ }
+ sta->hal_sta->ra_info.dis_ra=false;
+ ret=wa_nan_rate_encoding(h,sta,p);
+ if (!ret) ret=wa_nan_rate_media(h,sta,true);
+ if (!ret) ret=rtw_hal_bb_upt_ramask(h,sta)==RTW_HAL_STATUS_SUCCESS ? 0 : -EIO;
+ if (!ret) ret=rtw_hal_bb_ra_register(h,sta)==RTW_HAL_STATUS_SUCCESS ? 0 : -EIO;
+ if (!ret) {
+  h->hal_com->assoc_sta_cnt++;
+  h->hal_com->band[sta->rlink->hw_band].assoc_sta_cnt++;
+  rtw_hal_bb_media_status_update(h,sta,true);
+ }
+ pr_info("WA_PROBE ndi-rate-register macid=%u mcs=%02x%02x sgi20=%u ldpc=%u mask=%llx result=%d primary=%u center=%u width=%u vht=%u he=%u he_mcs=%04x he_ldpc=%u gi=%u pe=%u/%u/%u\n",
+         sta->macid,mcs[1],mcs[0],sta->asoc_cap.sgi_20,sta->asoc_cap.ht_ldpc,
+         (unsigned long long)sta->hal_sta->ra_info.cur_ra_mask,ret,
+         p->channel.primary,p->channel.center,p->channel.width,p->vht,p->he,
+         get_unaligned_le16(p->he_mcs),p->he_ldpc,sta->asoc_cap.ltf_gi,
+         p->he_padding[0],p->he_padding[1],p->he_padding[2]);
+ return ret;
+}
+
+int rtw_hal_wa_nan_command_begin(void *hal)
+{
+	return mac_wa_nan_command_begin(((struct hal_info_t *)hal)->mac);
+}
+
+void rtw_hal_wa_nan_command_end(void)
+{
+	mac_wa_nan_command_end();
+}
+
+int rtw_hal_wa_nan_disable(void *hal, const struct wa_nan_h2c_plan *plan)
+{
+	struct mac_ax_nan_func_info stop = {0};
+	struct hal_info_t *info = hal;
+	rtw_hal_wa_nan_rf_reset();
+	/* U2 func2 options must be exactly zero to run the stop handler. */
+	stop.port_idx = plan->port[0];
+	stop.mac_id_bcn = plan->macid_bcn;
+	stop.mac_id_mgn = plan->macid_mgn;
+	return mac_nan_func_ctrl(info->mac, &stop) == MACSUCCESS ? 0 : -EIO;
+}
+
+int rtw_hal_wa_nan_port_disable(void *hal, u8 port, u8 band)
+{
+	struct hal_info_t *info = hal;
+	struct mac_ax_adapter *mac = info->mac;
+	struct mac_ax_port_cfg_para cfg = { .port = port, .band = band, .val = 0 };
+	if (mac->ops->port_cfg(mac, MAC_AX_PCFG_TX_SW, &cfg) ||
+	    mac->ops->port_cfg(mac, MAC_AX_PCFG_TX_RPT, &cfg) ||
+	    mac->ops->port_cfg(mac, MAC_AX_PCFG_FUNC_SW, &cfg))
+		return -EIO;
+	return 0;
+}
+
+int rtw_hal_wa_nan_port_init(void *hal, u8 port, u8 band)
+{
+	struct hal_info_t *info = (struct hal_info_t *)hal;
+	struct mac_ax_adapter *mac = info->mac;
+	struct mac_ax_port_init_para para = {0};
+	struct mac_ax_port_cfg_para cfg = {0};
+
+	if (!mac || !mac->ops || !mac->ops->port_init || !mac->ops->port_cfg)
+		return -EIO;
+	para.port_idx = (enum mac_ax_port)port;
+	para.band_idx = (enum mac_ax_band)band;
+	para.net_type = MAC_AX_NET_TYPE_NO_LINK;
+	para.bcn_interval = 100;
+	if (mac->ops->port_init(mac, &para) != MACSUCCESS)
+		return -EIO;
+	cfg.port = port;
+	cfg.band = band;
+	cfg.val = 1;
+	if (mac->ops->port_cfg(mac, MAC_AX_PCFG_TX_SW, &cfg) != MACSUCCESS)
+		return -EIO;
+	if (mac->ops->port_cfg(mac, MAC_AX_PCFG_TX_RPT, &cfg) != MACSUCCESS)
+		return -EIO;
+	return 0;
+}
+
+int rtw_hal_wa_nan_port_enable(void *hal, u8 port, u8 band)
+{
+	struct hal_info_t *info = (struct hal_info_t *)hal;
+	struct mac_ax_adapter *mac = info->mac;
+	struct mac_ax_port_cfg_para cfg = {0};
+
+	if (!mac || !mac->ops || !mac->ops->port_cfg)
+		return -EIO;
+	cfg.port = port;
+	cfg.band = band;
+	/* The role's default 100 TU TBTT does not align with the NAN DW.
+	 * Match the synchronization beacon and native 512 TU DW before TX. */
+	cfg.val = 512;
+	if (mac->ops->port_cfg(mac, MAC_AX_PCFG_BCN_INTV, &cfg) != MACSUCCESS)
+		return -EIO;
+	cfg.val = 1;
+	if (mac->ops->port_cfg(mac, MAC_AX_PCFG_BCN_PRCT, &cfg) != MACSUCCESS)
+		return -EIO;
+	if (mac->ops->port_cfg(mac, MAC_AX_PCFG_TX_SW, &cfg) != MACSUCCESS)
+		return -EIO;
+	if (mac->ops->port_cfg(mac, MAC_AX_PCFG_TX_RPT, &cfg) != MACSUCCESS)
+		return -EIO;
+	return 0;
+}
+
+int rtw_hal_wa_nan_rx_filter(void *hal, u8 band, u8 nan,
+			     u32 *before, u32 *after)
+{
+	struct hal_info_t *info = (struct hal_info_t *)hal;
+	u32 reg = band ? R_AX_RX_FLTR_OPT_C1 : R_AX_RX_FLTR_OPT;
+	enum rtw_rx_fltr_opt_mode mode = nan ? RX_FLTR_OPT_MODE_NAN :
+					       RX_FLTR_OPT_MODE_STA_NORMAL;
+
+	if (before)
+		*before = hal_read32(info->hal_com, reg);
+	if (rtw_hal_set_rxfltr_opt_by_mode(hal, band, mode) !=
+	    RTW_HAL_STATUS_SUCCESS)
+		return -EIO;
+	if (after)
+		*after = hal_read32(info->hal_com, reg);
+	return 0;
+}
