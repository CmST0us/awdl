+++ b/phl/hal_g6/wa_nan_bcn_template.h
@@ -0,0 +1,53 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* C1: fixed 63-byte DW-port-0 NAN beacon template builder. */
+#ifndef WA_NAN_BCN_TEMPLATE_H
+#define WA_NAN_BCN_TEMPLATE_H
+
+#include <linux/types.h>
+#include <linux/string.h>
+
+#define WA_NAN_BCN_TEMPLATE_LEN 63
+#define WA_NAN_BCN_VENDOR_LEN 25
+
+/*
+ * NAN beacon body: a vendor IE (OUI 50:6f:9a, type 0x13) carrying the
+ * Master Indication attribute (id 0, length 2) and the Cluster attribute
+ * (id 1, length 13). Attribute lengths are little-endian, as in every NAN
+ * attribute; the 13-byte Cluster body is the Anchor Master Information.
+ */
+static inline void wa_nan_bcn_template_build_interval(u8 *frame,
+						      const u8 *nmi,
+						      const u8 *cluster,
+						      u16 interval)
+{
+	static const u8 oui_type[4] = {0x50, 0x6f, 0x9a, 0x13};
+
+	memset(frame, 0, WA_NAN_BCN_TEMPLATE_LEN);
+	frame[0] = 0x80;
+	memset(frame + 4, 0xff, 6);
+	memcpy(frame + 10, nmi, 6);
+	memcpy(frame + 16, cluster, 6);
+	frame[32] = interval & 0xff;
+	frame[33] = interval >> 8;
+	frame[34] = 0x20;
+	frame[35] = 0x04;
+	frame[36] = 0xdd;
+	frame[37] = WA_NAN_BCN_VENDOR_LEN;
+	memcpy(frame + 38, oui_type, 4);
+	/* Master Indication: id 0, length 2, preference 0, random factor 0. */
+	frame[42] = 0x00;
+	frame[43] = 0x02;
+	frame[44] = 0x00;
+	/* Cluster: id 1, length 13, Anchor Master Information. */
+	frame[47] = 0x01;
+	frame[48] = 0x0d;
+}
+
+static inline void wa_nan_bcn_template_build(u8 *frame,
+					     const u8 *nmi,
+					     const u8 *cluster)
+{
+	wa_nan_bcn_template_build_interval(frame, nmi, cluster, 512);
+}
+
+#endif /* WA_NAN_BCN_TEMPLATE_H */
--- /dev/null
+++ b/phl/hal_g6/wa_nan_bigtk_hal.h
@@ -0,0 +1,130 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef WA_NAN_BIGTK_HAL_H
+#define WA_NAN_BIGTK_HAL_H
+#define WA_BIGTK_STATE 0xb8e11ce8U
+
+#ifdef __KERNEL__
+/* op7 records these public bytes while holding the firmware critical section. */
+static void wa_nan_rfk_refusal(void *hal)
+{
+ struct mac_ax_adapter *mac = ((struct hal_info_t *)hal)->mac;
+ u32 state = wa_schedule_word(mac, WA_BIGTK_STATE + 12);
+ pr_info("WA_PROBE nan-rfk-refused snapshot_active=%u snapshot_pending=%u\n",
+         state >> 24, (state >> 16) & 255);
+}
+
+#endif
+
+static int wa_bigtk_command(struct mac_ax_adapter *mac, u8 payload[32])
+{
+	struct h2c_info info = {
+		.h2c_cat = FWCMD_H2C_CAT_MAC, .h2c_class = FWCMD_H2C_CL_NAN,
+		.h2c_func = 8, .done_ack = 1, .content_len = 32,
+	};
+	u32 words[8], ret;
+	memcpy(words, payload, sizeof(words));
+	ret = mac_h2c_common(mac, &info, words);
+	memzero_explicit(words, sizeof(words));
+	return ret == MACSUCCESS ? 0 : -EIO;
+}
+bool rtw_hal_wa_nan_bigtk_supported(void *hal)
+{
+	struct mac_ax_adapter *mac = ((struct hal_info_t *)hal)->mac;
+	u8 payload[32] = {0};
+	int ret = mac_wa_nan_command_begin(mac);
+	if (ret) return false;
+	ret = wa_bigtk_command(mac, payload);
+	mac_wa_nan_command_end();
+	return !ret;
+}
+bool rtw_hal_wa_nan_ndi_supported(void *hal)
+{
+	struct mac_ax_adapter *mac = ((struct hal_info_t *)hal)->mac;
+	u8 payload[32] = {5};
+	int ret = mac_wa_nan_command_begin(mac);
+	if (ret) return false;
+	ret = wa_bigtk_command(mac, payload);
+	mac_wa_nan_command_end();
+	return !ret;
+}
+int rtw_hal_wa_nan_bigtk_seq(void *hal, const struct wa_nan_h2c_plan *plan,
+		u8 index, u8 pn[6])
+{
+	struct mac_ax_adapter *mac = ((struct hal_info_t *)hal)->mac;
+	u8 payload[32] = {2, index}, snapshot[36];
+	u32 i;
+	int ret;
+	memcpy(payload + 2, plan->nmi, 6);
+	ret = wa_bigtk_command(mac, payload);
+	if (ret) return ret;
+	for (i = 0; i < sizeof(snapshot); i += 4)
+		put_unaligned_le32(wa_schedule_word(mac, WA_BIGTK_STATE + i), snapshot + i);
+	if (snapshot[1] != index || memcmp(snapshot + 2, plan->nmi, 6) ||
+	    snapshot[15] != 1 || get_unaligned_le32(snapshot + 28)) return -EIO;
+	/* Allocation is consumed before signing, including an in-flight beacon.
+	 * A later beacon always has a larger PN; this is not a TX ACK counter. */
+	memcpy(pn, snapshot + 8, 6);
+	return 0;
+}
+int rtw_hal_wa_nan_faw_members(void *hal, const struct wa_nan_h2c_plan *plan,
+		u8 index, const u8 *members, u8 count, u8 budget_macid)
+{
+	struct mac_ax_adapter *mac = ((struct hal_info_t *)hal)->mac;
+	u8 payload[32] = {3, index}, snapshot[4];
+	int ret;
+	if (count > 2) return -EINVAL;
+	memcpy(payload + 2, plan->nmi, 6);
+	payload[8] = count;
+	payload[11] = budget_macid == 0xff ? 0 : budget_macid + 1;
+	if (count) memcpy(payload + 9, members, count);
+	ret = wa_bigtk_command(mac, payload);
+	if (ret) return ret;
+	payload[0] = 4;
+	ret = wa_bigtk_command(mac, payload);
+	if (ret) return ret;
+	put_unaligned_le32(wa_schedule_word(mac, WA_BIGTK_STATE + 440), snapshot);
+	if (snapshot[0] != count || (count && memcmp(snapshot + 1, members, count)))
+		return -EIO;
+	pr_info("WA_PROBE faw-members count=%u macid0=%u macid1=%u open=%u\n",
+		count, snapshot[1], snapshot[2], snapshot[3]);
+	return 0;
+}
+int rtw_hal_wa_nan_bigtk_install(void *hal, const struct wa_nan_h2c_plan *plan,
+		u8 index, const u8 *pn, const u8 *key)
+{
+	struct mac_ax_adapter *mac = ((struct hal_info_t *)hal)->mac;
+	u8 payload[32] = {1, index}, snapshot[36];
+	u32 i, value;
+	int ret;
+	memcpy(payload+2, plan->nmi, 6);
+	memcpy(payload+8, pn, 6);
+	memcpy(payload+14, plan->port, 2);
+	memcpy(payload+16, key, 16);
+	ret = wa_bigtk_command(mac, payload);
+	memzero_explicit(payload+16, 16);
+	if (ret) return ret;
+	payload[0] = 2;
+	ret = wa_bigtk_command(mac, payload);
+	if (ret) return ret;
+	for (i=0;i<sizeof(snapshot);i+=4) {
+		value = wa_schedule_word(mac, WA_BIGTK_STATE+i);
+		put_unaligned_le32(value, snapshot+i);
+	}
+	if (snapshot[1] != index || memcmp(snapshot+2, plan->nmi, 6) ||
+	    snapshot[15] != 1 || get_unaligned_le32(snapshot+28)) return -EIO;
+	return 0;
+}
+int rtw_hal_wa_nan_bigtk_clean(void *hal)
+{
+	struct mac_ax_adapter *mac = ((struct hal_info_t *)hal)->mac;
+	u32 i;
+	/* The complete native STOP wipes the owner and BIGTK key. */
+	for (i=204;i<224;i+=4)
+		if (wa_schedule_word(mac, WA_BIGTK_STATE+i)) return -EUCLEAN;
+	for (i=244;i<260;i+=4)
+		if (wa_schedule_word(mac, WA_BIGTK_STATE+i)) return -EUCLEAN;
+	for (i=436;i<444;i+=4)
+		if (wa_schedule_word(mac, WA_BIGTK_STATE+i)) return -EUCLEAN;
+	return 0;
+}
