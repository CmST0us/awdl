+int rtw_phl_wa_nan_rx_drain(void *phl, char *out, size_t cap)
+{
+	struct wa_nan_mgmt_rx_frame *f;
+	unsigned long flags;
+	size_t used = 0;
+	int n, i;
+
+	if (!out || !cap)
+		return -EINVAL;
+	f = kmalloc(sizeof(*f), GFP_KERNEL);
+	if (!f) return -ENOMEM;
+	while (1) {
+		spin_lock_irqsave(&wa_nan_rx_lock, flags);
+		n = wa_nan_mgmt_rx_pop(&wa_nan_rx_ring, f);
+		spin_unlock_irqrestore(&wa_nan_rx_lock, flags);
+		if (n)
+			break;
+		{
+			char hex[81];
+			int h = f->len < 40 ? f->len : 40;
+			for (i = 0; i < h; i++)
+				snprintf(hex + i * 2, 3, "%02x", f->data[i]);
+			hex[h * 2] = 0;
+			used += scnprintf(out + used, cap > used ? cap - used : 0,
+				"WA_PROBE nan-rx type=%u a1=%02x:%02x:%02x:%02x:%02x:%02x a2=%02x:%02x:%02x:%02x:%02x:%02x len=%u channel=%u first40=%s\n",
+				f->data[29], f->data[4], f->data[5], f->data[6], f->data[7], f->data[8], f->data[9],
+				f->data[10], f->data[11], f->data[12], f->data[13], f->data[14], f->data[15],
+				f->len, f->channel, hex);
+		}
+	}
+	kfree(f);
+	return used ? (int)used : -ENODATA;
+}
