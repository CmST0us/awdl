@@ -0,0 +1,145 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* NAN schedule/beacon/function H2C sequence shared by the MAC and PHL probes. */
+#ifndef WA_NAN_H2C_H
+#define WA_NAN_H2C_H
+
+#include <linux/bitops.h>
+#include <linux/ktime.h>
+#include <linux/printk.h>
+#include "nan.h"
+#include "../../../wa_nan_stageb_api.h"
+
+#define WA_NAN_H2C_CHANNEL 6
+#define WA_NAN_H2C_OP_CH_5G 149
+#define WA_NAN_H2C_MASTER_PREF 200
+#define WA_NAN_H2C_TIME_PERIOD 4
+#define WA_NAN_H2C_OPTIONS 0x81
+#define WA_NAN_H2C_PARA_OPTIONS 0xfc
+
+static u32 wa_nan_h2c_schedule(struct mac_ax_adapter *adapter, u64 op,
+			       u32 step, u8 module,
+			       const struct wa_nan_h2c_plan *plan)
+{
+	struct mac_ax_nan_sched_info info = {0};
+	u32 ret;
+	u64 begin, end;
+
+	info.module_id = module;
+	info.tsf_idx = plan->port[module];
+	info.channel = WA_NAN_H2C_CHANNEL;
+	begin = ktime_get_ns();
+	pr_info("WA_PROBE nan-step phase=begin op=%llu step=%u func=0 module=%u begin_ns=%llu port=%u tsf_idx=%u channel=%u bw=%u primary=%u priority=%u options=%u faw_en=%u duration=%u period=%u\n",
+		(unsigned long long)op, step, (unsigned int)module,
+		(unsigned long long)begin, (unsigned int)plan->port[module],
+		(unsigned int)info.tsf_idx, (unsigned int)info.channel,
+		(unsigned int)info.bw, (unsigned int)info.primary_ch_idx,
+		(unsigned int)info.priority, (unsigned int)info.options,
+		(unsigned int)info.faw_en,
+		(unsigned int)info.duration, (unsigned int)info.period);
+	ret = mac_nan_act_schedule_req(adapter, &info);
+	end = ktime_get_ns();
+	pr_info("WA_PROBE nan-step phase=end op=%llu step=%u func=0 module=%u end_ns=%llu elapsed_ns=%llu host_result=%u\n",
+		(unsigned long long)op, step, (unsigned int)module,
+		(unsigned long long)end, (unsigned long long)(end - begin), ret);
+	return ret;
+}
+
+static u32 wa_nan_h2c_bcn(struct mac_ax_adapter *adapter, u64 op,
+			  u32 step, u8 module,
+			  const struct wa_nan_h2c_plan *plan)
+{
+	struct mac_ax_nan_bcn info = {0};
+	u32 ret;
+	u64 begin, end;
+
+	info.module_id = module;
+	info.port_idx = plan->port[module];
+	begin = ktime_get_ns();
+	pr_info("WA_PROBE nan-step phase=begin op=%llu step=%u func=1 module=%u begin_ns=%llu port=%u bcn_intvl_ms=%u priority=%u bcn_offset_us=%u cur_tbtt=%u cur_tbtt_fr=%u prohibit_before_ms=%u prohibit_after_ms=%u options=%u\n",
+		(unsigned long long)op, step, (unsigned int)module,
+		(unsigned long long)begin, (unsigned int)plan->port[module],
+		(unsigned int)info.bcn_intvl_ms, (unsigned int)info.priority,
+		(unsigned int)info.bcn_offset_us, (unsigned int)info.cur_tbtt,
+		(unsigned int)info.cur_tbtt_fr,
+		(unsigned int)info.prohibit_before_ms,
+		(unsigned int)info.prohibit_after_ms,
+		(unsigned int)info.options);
+	ret = mac_nan_bcn_req(adapter, &info);
+	end = ktime_get_ns();
+	pr_info("WA_PROBE nan-step phase=end op=%llu step=%u func=1 module=%u end_ns=%llu elapsed_ns=%llu host_result=%u\n",
+		(unsigned long long)op, step, (unsigned int)module,
+		(unsigned long long)end, (unsigned long long)(end - begin), ret);
+	return ret;
+}
+
+static u32 wa_nan_h2c_ctrl(struct mac_ax_adapter *adapter, u64 op,
+			   u32 step, const struct wa_nan_h2c_plan *plan)
+{
+	struct mac_ax_nan_func_info info = {0};
+	u32 ret;
+	u64 begin, end;
+
+	info.port_idx = plan->port[0];
+	info.master_pref = WA_NAN_H2C_MASTER_PREF;
+	info.random_factor = plan->random_factor;
+	info.op_ch_24g = WA_NAN_H2C_CHANNEL;
+	info.op_ch_5g = WA_NAN_H2C_OP_CH_5G;
+	info.options = WA_NAN_H2C_OPTIONS;
+	info.time_indicate_period = WA_NAN_H2C_TIME_PERIOD;
+	PLTFM_MEMCPY(info.cluster_id, plan->cluster, 6);
+	info.para_options = WA_NAN_H2C_PARA_OPTIONS;
+	info.mac_id_bcn = plan->macid_bcn;
+	info.mac_id_mgn = plan->macid_mgn;
+	begin = ktime_get_ns();
+	pr_info("WA_PROBE nan-step phase=begin op=%llu step=%u func=2 module=0 begin_ns=%llu port=%u master_pref=%u random_factor=%u op_ch_24g=%u op_ch_5g=%u options=%u time_indicate_period=%u cluster="
+		WA_NAN_ADDR_FMT " para_options=%u mac_id_bcn=%u mac_id_mgn=%u\n",
+		(unsigned long long)op, step, (unsigned long long)begin,
+		(unsigned int)plan->port[0], (unsigned int)info.master_pref,
+		(unsigned int)info.random_factor, (unsigned int)info.op_ch_24g,
+		(unsigned int)info.op_ch_5g, (unsigned int)info.options,
+		(unsigned int)info.time_indicate_period,
+		WA_NAN_ADDR_ARGS(info.cluster_id),
+		(unsigned int)info.para_options,
+		(unsigned int)info.mac_id_bcn, (unsigned int)info.mac_id_mgn);
+	ret = mac_nan_func_ctrl(adapter, &info);
+	end = ktime_get_ns();
+	pr_info("WA_PROBE nan-step phase=end op=%llu step=%u func=2 module=0 end_ns=%llu elapsed_ns=%llu host_result=%u\n",
+		(unsigned long long)op, step, (unsigned long long)end,
+		(unsigned long long)(end - begin), ret);
+	return ret;
+}
+
+static u32 wa_nan_h2c_run(struct mac_ax_adapter *adapter, u64 op,
+			  const struct wa_nan_h2c_plan *plan, u32 *fail_step)
+{
+	u32 ret, step;
+
+	*fail_step = 0;
+	step = 1;
+	ret = wa_nan_h2c_schedule(adapter, op, step, 0, plan);
+	if (ret)
+		goto abort;
+	step = 2;
+	ret = wa_nan_h2c_schedule(adapter, op, step, 1, plan);
+	if (ret)
+		goto abort;
+	step = 3;
+	ret = wa_nan_h2c_bcn(adapter, op, step, 0, plan);
+	if (ret)
+		goto abort;
+	step = 4;
+	ret = wa_nan_h2c_bcn(adapter, op, step, 1, plan);
+	if (ret)
+		goto abort;
+	step = 5;
+	ret = wa_nan_h2c_ctrl(adapter, op, step, plan);
+	if (ret)
+		goto abort;
+	return MACSUCCESS;
+
+abort:
+	*fail_step = step;
+	return ret;
+}
+
+#endif /* WA_NAN_H2C_H */
