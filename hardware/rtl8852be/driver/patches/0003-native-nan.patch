+	u32 ret;
+
+	cfg.level = MAC_AX_FL_LV_TR;
+	cfg.output = MAC_AX_FL_LV_C2H;
+	cfg.comp = BIT(26);
+	ret = mac_fw_log_cfg(info->mac, &cfg);
+	pr_info("WA_PROBE nan-logcfg op=%llu ns=%llu result=%u request_level=%u request_output=%u request_comp=%08x\n",
+		(unsigned long long)op, (unsigned long long)ktime_get_ns(), ret,
+		(unsigned int)cfg.level, (unsigned int)cfg.output,
+		(unsigned int)cfg.comp);
+	return ret == MACSUCCESS ? 0 : -EIO;
+}
