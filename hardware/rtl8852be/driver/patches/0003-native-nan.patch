@@ -0,0 +1,223 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* M4-A1: fixed NAN Publish service discovery frame builder. */
+#ifndef WA_NAN_SDF_H
+#define WA_NAN_SDF_H
+
+#include <linux/types.h>
+#include <linux/string.h>
+#include <linux/errno.h>
+
+/* 802.11 Public Action header plus category/action/OUI/type prefix. */
+#define WA_NAN_SDF_HDR_LEN	24
+#define WA_NAN_SDF_ACTION_LEN	6
+#define WA_NAN_SDF_ATTR_HDR_LEN	3
+
+/* NAN attribute IDs, Wi-Fi Aware Specification v4.0 section 9.5. */
+#define WA_NAN_ATTR_SDA		0x03
+#define WA_NAN_ATTR_COUNTRY_CODE	0x0b
+#define WA_NAN_ATTR_SDEA	0x0e
+#define WA_NAN_ATTR_CSIA	0x22
+#define WA_NAN_ATTR_DCEA	0x2a
+#define WA_NAN_ATTR_NIRA	0x2b
+#define WA_NAN_ATTR_NPBA	0x2c
+
+/* Service identity and pairing-mode strings for the M4 publisher. */
+#define WA_NAN_SDF_SERVICE_NAME	"_rtl8852be-test._tcp"
+#define WA_NAN_SDF_VENDOR_NAME	"vendorName=Radxa"
+#define WA_NAN_SDF_MODEL_NAME	"modelName=ROCK 5B"
+#define WA_NAN_SDF_PAIRING_NAME	"pairingName=ROCK5B-M4"
+
+/* SDEA control: Data Path Required (b2), Security Required (b6),
+ * GTK Required (b10). The first two describe the data path the service
+ * asks for; GTK Required is what Apple checks for multicast protection.
+ */
+#define WA_NAN_SDF_SDEA_CONTROL	0x0444
+#define WA_NAN_SDF_CSIA_CAPAB	0x04	/* GTKSA, IGTKSA and BIGTKSA */
+#define WA_NAN_SDF_CSIA_NCS_GTK	0x05
+#define WA_NAN_SDF_CSIA_NCS_PK	0x07
+#define WA_NAN_SDF_NPBA_METHOD	0x0002	/* pin-code display */
+#define WA_NAN_SDF_COUNTRY	"CN"
+
+#define WA_NAN_SDF_STR_LEN(s)	(sizeof(s) - 1)
+
+/* TXT records are RFC 6763 strings: one length octet plus the key=value text. */
+#define WA_NAN_SDF_TXT_LEN	(1 + WA_NAN_SDF_STR_LEN(WA_NAN_SDF_VENDOR_NAME) + \
+				 1 + WA_NAN_SDF_STR_LEN(WA_NAN_SDF_MODEL_NAME) + \
+				 1 + WA_NAN_SDF_STR_LEN(WA_NAN_SDF_PAIRING_NAME))
+
+/* SSI: sub-attribute 2 (service name) then sub-attribute 4 (TXT records). */
+#define WA_NAN_SDF_SSI_LEN	(3 + WA_NAN_SDF_STR_LEN(WA_NAN_SDF_SERVICE_NAME) + \
+				 3 + WA_NAN_SDF_TXT_LEN)
+
+/* SDEA body: instance id, control, service info length, OUI/protocol, SSI. */
+#define WA_NAN_SDF_SDEA_BODY_LEN	(1 + 2 + 2 + 4 + WA_NAN_SDF_SSI_LEN)
+
+#define WA_NAN_SDF_SDA_LEN	(WA_NAN_SDF_ATTR_HDR_LEN + 6 + 1 + 1 + 1)
+#define WA_NAN_SDF_SDEA_LEN	(WA_NAN_SDF_ATTR_HDR_LEN + WA_NAN_SDF_SDEA_BODY_LEN)
+#define WA_NAN_SDF_DCEA_LEN	(WA_NAN_SDF_ATTR_HDR_LEN + 2)
+#define WA_NAN_SDF_CSIA_LEN	(WA_NAN_SDF_ATTR_HDR_LEN + 1 + 2 * 2)
+#define WA_NAN_SDF_NPBA_LEN	(WA_NAN_SDF_ATTR_HDR_LEN + 5)
+#define WA_NAN_SDF_COUNTRY_LEN	(WA_NAN_SDF_ATTR_HDR_LEN + 2)
+#define WA_NAN_SDF_NIRA_LEN	17
+#define WA_NAN_SDF_NIRA_ATTR_LEN \
+	(WA_NAN_SDF_ATTR_HDR_LEN + WA_NAN_SDF_NIRA_LEN)
+
+/* Attribute order: SDA, SDEA, DCEA, CSIA, NPBA, Country, optional NIRA. */
+#define WA_NAN_SDF_BASE_LEN	(WA_NAN_SDF_HDR_LEN + WA_NAN_SDF_ACTION_LEN + \
+				 WA_NAN_SDF_SDA_LEN + WA_NAN_SDF_SDEA_LEN + \
+				 WA_NAN_SDF_DCEA_LEN + WA_NAN_SDF_CSIA_LEN + \
+				 WA_NAN_SDF_NPBA_LEN + WA_NAN_SDF_COUNTRY_LEN)
+#define WA_NAN_SDF_MAX_LEN	(WA_NAN_SDF_BASE_LEN + WA_NAN_SDF_NIRA_ATTR_LEN)
+
+/* Software NMI, cluster and NAN Network ID used by the offline vectors. */
+#define WA_NAN_SDF_TEST_NMI	{ 0x02, 0x00, 0x00, 0x00, 0x00, 0x05 }
+#define WA_NAN_SDF_TEST_CLUSTER	{ 0x50, 0x6f, 0x9a, 0x01, 0x00, 0x00 }
+#define WA_NAN_SDF_NAN_NETWORK_ID \
+	{ 0x51, 0x6f, 0x9a, 0x01, 0x00, 0x00 }
+
+struct wa_nan_sdf_params {
+	const u8 *a1;		/* NAN Network ID or the subscriber NMI */
+	const u8 *nmi;		/* publisher NMI, also the A2 address */
+	const u8 *cluster;	/* cluster ID, also the A3 address */
+	u8 instance_id;		/* publish ID, zero is reserved */
+	/* Optional NIRA body: cipher version, 8-byte nonce, 8-byte tag. */
+	const u8 *nira;
+	/* Optional TXT record "pairingName=<value>". NULL keeps the M4 name.
+	 * The replacement must have the same length so the fixed 183 B layout
+	 * stays byte-for-byte aligned with the M4 vectors.
+	 */
+	const char *pairing_name;
+};
+
+static inline u8 *wa_nan_sdf_put_attr(u8 *p, u8 id, u16 len)
+{
+	p[0] = id;
+	p[1] = len & 0xff;
+	p[2] = len >> 8;
+	return p + WA_NAN_SDF_ATTR_HDR_LEN;
+}
+
+static inline u8 *wa_nan_sdf_put_txt(u8 *p, const char *text, size_t len)
+{
+	p[0] = (u8)len;
+	memcpy(p + 1, text, len);
+	return p + 1 + len;
+}
+
+static inline u8 *wa_nan_sdf_put_ssi(u8 *p, const char *pairing_name)
+{
+	u16 len = WA_NAN_SDF_TXT_LEN;
+
+	p[0] = 0x02;
+	p[1] = WA_NAN_SDF_STR_LEN(WA_NAN_SDF_SERVICE_NAME) & 0xff;
+	p[2] = WA_NAN_SDF_STR_LEN(WA_NAN_SDF_SERVICE_NAME) >> 8;
+	p += WA_NAN_SDF_ATTR_HDR_LEN;
+	memcpy(p, WA_NAN_SDF_SERVICE_NAME,
+	       WA_NAN_SDF_STR_LEN(WA_NAN_SDF_SERVICE_NAME));
+	p += WA_NAN_SDF_STR_LEN(WA_NAN_SDF_SERVICE_NAME);
+
+	p[0] = 0x04;
+	p[1] = len & 0xff;
+	p[2] = len >> 8;
+	p += WA_NAN_SDF_ATTR_HDR_LEN;
+	p = wa_nan_sdf_put_txt(p, WA_NAN_SDF_VENDOR_NAME,
+			       WA_NAN_SDF_STR_LEN(WA_NAN_SDF_VENDOR_NAME));
+	p = wa_nan_sdf_put_txt(p, WA_NAN_SDF_MODEL_NAME,
+			       WA_NAN_SDF_STR_LEN(WA_NAN_SDF_MODEL_NAME));
+	p = wa_nan_sdf_put_txt(p, pairing_name,
+			       WA_NAN_SDF_STR_LEN(WA_NAN_SDF_PAIRING_NAME));
+	return p;
+}
+
+/*
+ * Build a complete 802.11 Public Action frame carrying a NAN Publish SDF.
+ * Returns the frame length, or -EINVAL for a missing address/instance and
+ * -ENOSPC when cap cannot hold the fixed attributes.
+ */
+static inline int wa_nan_sdf_build(u8 *frame, size_t cap,
+				   const struct wa_nan_sdf_params *params)
+{
+	static const u8 service_id[6] = {0x18, 0x98, 0x28, 0x19, 0x48, 0x47};
+	static const u8 vendor_type[4] = {0x50, 0x6f, 0x9a, 0x13};
+	static const u8 service_oui_proto[4] = {0x50, 0x6f, 0x9a, 0x02};
+	const char *pairing_name;
+	u8 *p;
+	size_t total;
+	u16 len;
+
+	if (!frame || !params || !params->a1 || !params->nmi ||
+	    !params->cluster || !params->instance_id)
+		return -EINVAL;
+	pairing_name = params->pairing_name ? params->pairing_name :
+					      WA_NAN_SDF_PAIRING_NAME;
+	if (strlen(pairing_name) != WA_NAN_SDF_STR_LEN(WA_NAN_SDF_PAIRING_NAME))
+		return -EINVAL;
+	total = WA_NAN_SDF_BASE_LEN;
+	if (params->nira)
+		total += WA_NAN_SDF_NIRA_ATTR_LEN;
+	if (cap < total)
+		return -ENOSPC;
+	memset(frame, 0, total);
+	frame[0] = 0xd0;	/* management, action, public action */
+	frame[1] = 0x00;
+	memcpy(frame + 4, params->a1, 6);
+	memcpy(frame + 10, params->nmi, 6);
+	memcpy(frame + 16, params->cluster, 6);
+
+	p = frame + WA_NAN_SDF_HDR_LEN;
+	p[0] = 0x04;	/* public action */
+	p[1] = 0x09;	/* vendor specific */
+	memcpy(p + 2, vendor_type, 4);
+	p += WA_NAN_SDF_ACTION_LEN;
+
+	p = wa_nan_sdf_put_attr(p, WA_NAN_ATTR_SDA, 6 + 1 + 1 + 1);
+	memcpy(p, service_id, 6);
+	p += 6;
+	*p++ = params->instance_id;
+	*p++ = 0x00;	/* requestor instance id: unsolicited publish */
+	*p++ = 0x00;	/* service control: publish, no optional fields */
+
+	len = WA_NAN_SDF_SDEA_BODY_LEN;
+	p = wa_nan_sdf_put_attr(p, WA_NAN_ATTR_SDEA, len);
+	*p++ = params->instance_id;
+	*p++ = WA_NAN_SDF_SDEA_CONTROL & 0xff;
+	*p++ = WA_NAN_SDF_SDEA_CONTROL >> 8;
+	len = 4 + WA_NAN_SDF_SSI_LEN;
+	*p++ = len & 0xff;
+	*p++ = len >> 8;
+	memcpy(p, service_oui_proto, 4);
+	p += 4;
+	p = wa_nan_sdf_put_ssi(p, pairing_name);
+
+	p = wa_nan_sdf_put_attr(p, WA_NAN_ATTR_DCEA, 2);
+	*p++ = 0x00;
+	*p++ = 0x03;	/* Capability Info 0x0300: pairing setup b8, caching b9 */
+
+	p = wa_nan_sdf_put_attr(p, WA_NAN_ATTR_CSIA, 1 + 2 * 2);
+	*p++ = WA_NAN_SDF_CSIA_CAPAB;
+	*p++ = WA_NAN_SDF_CSIA_NCS_GTK;
+	*p++ = params->instance_id;
+	*p++ = WA_NAN_SDF_CSIA_NCS_PK;
+	*p++ = params->instance_id;
+
+	p = wa_nan_sdf_put_attr(p, WA_NAN_ATTR_NPBA, 5);
+	*p++ = 0x00;	/* dialog token: reserved for advertise */
+	*p++ = 0x00;	/* type advertise, status accepted */
+	*p++ = 0x00;	/* reason: reserved */
+	*p++ = WA_NAN_SDF_NPBA_METHOD & 0xff;
+	*p++ = WA_NAN_SDF_NPBA_METHOD >> 8;
+
+	p = wa_nan_sdf_put_attr(p, WA_NAN_ATTR_COUNTRY_CODE, 2);
+	*p++ = WA_NAN_SDF_COUNTRY[0];
+	*p++ = WA_NAN_SDF_COUNTRY[1];
+
+	if (params->nira) {
+		p = wa_nan_sdf_put_attr(p, WA_NAN_ATTR_NIRA,
+					WA_NAN_SDF_NIRA_LEN);
+		memcpy(p, params->nira, WA_NAN_SDF_NIRA_LEN);
+		p += WA_NAN_SDF_NIRA_LEN;
+	}
+	return (int)(p - frame);
+}
+
+#endif /* WA_NAN_SDF_H */
