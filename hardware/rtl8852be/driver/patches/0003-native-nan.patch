+/* SPDX-License-Identifier: GPL-2.0 */
+#include <linux/ktime.h>
+
+/* Native watchdog snapshots; averages retain their vendor fixed-point units. */
+static void wa_nan_cfo_snapshot(struct bb_info *bb, const char *phase)
+{
+ struct bb_cfo_trk_info *cfo = &bb->bb_cfo_trk_i;
+ struct bb_cfo_trk_cr_info *cr = &cfo->bb_cfo_trk_cr_i;
+ unsigned int i;
+ bool active = false;
+ u64 begin;
+ u32 comp;
+ for (i = 0; i < PHL_MAX_STA_NUM; i++) {
+  struct rtw_phl_stainfo_t *sta = bb->phl_sta_info[i];
+  if (bb->sta_exist[i] && sta && sta->wrole &&
+      sta->wrole->type == PHL_RTYPE_NAN && sta->hal_sta &&
+      sta->hal_sta->ra_info.ra_registered) {
+   active = true;
+   break;
+  }
+ }
+ if (!active) return;
+ begin = ktime_get_ns();
+ comp = halbb_get_reg(bb, cr->r_cfo_comp_seg0_312p5khz,
+                     cr->r_cfo_comp_seg0_312p5khz_m);
+ pr_info("WA_NAN_CFO phase=%s linked=%u one=%u timer=%u packets=%u no_packets=%u cap=%u default_cap=%u offset=%d avg_q2=%d digital_avg=%d digital_shift=%u comp=%x lock=%u read_us=%llu\n",
+         phase, bb->bb_link_i.is_linked, bb->bb_link_i.is_one_entry_only,
+         cfo->cfo_trig_by_timer_en, cfo->cfo_pkt_cnt, cfo->no_pkt_cnt,
+         cfo->crystal_cap, cfo->def_x_cap, cfo->x_cap_ofst,
+         cfo->cfo_avg_pre, cfo->cfo_avg_4dcfo_pre, cfo->shift4dcfo,
+         comp, cfo->bb_cfo_div_i.divergence_lock_en,
+         (unsigned long long)((ktime_get_ns() - begin) / 1000));
+}
