+		WA_NAN_ADDR_FMT " cluster=" WA_NAN_ADDR_FMT "\n",
+		(unsigned long long)ktime_get_ns(),
+		(unsigned long long)ktime_get_ns(), ret,
+		(unsigned int)WA_NAN_BCN_TEMPLATE_LEN,
+		(unsigned int)port, (unsigned int)plan->port[0],
+		(unsigned int)plan->template_port_disc,
+		(unsigned int)interval, (unsigned int)frame[0],
+		WA_NAN_ADDR_ARGS(plan->nmi), WA_NAN_ADDR_ARGS(plan->cluster));
