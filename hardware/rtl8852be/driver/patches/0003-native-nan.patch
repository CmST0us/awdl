+/* SPDX-License-Identifier: GPL-2.0 */
+/* Scan admission and native NAN share the physical radio until completion. */
+#ifndef WA_NAN_RADIO_H
+#define WA_NAN_RADIO_H
+#include <linux/spinlock.h>
+
+static DEFINE_SPINLOCK(wa_nan_radio_lock);
+
+int rtw_phl_wa_nan_radio_acquire(void *phl)
+{
+	struct phl_info_t *p = phl;
+	unsigned long flags;
+	int ret = 0;
+	spin_lock_irqsave(&wa_nan_radio_lock, flags);
+	if (p->wa_nan_radio_owned || p->wa_scan_count)
+		ret = -EBUSY;
+	else
+		p->wa_nan_radio_owned = true;
+	spin_unlock_irqrestore(&wa_nan_radio_lock, flags);
+	pr_info("WA_PROBE radio-nan-acquire result=%d\n", ret);
+	return ret;
+}
+
+void rtw_phl_wa_nan_radio_release(void *phl)
+{
+	struct phl_info_t *p = phl;
+	unsigned long flags;
+	spin_lock_irqsave(&wa_nan_radio_lock, flags);
+	p->wa_nan_radio_owned = false;
+	spin_unlock_irqrestore(&wa_nan_radio_lock, flags);
+	pr_info("WA_PROBE radio-nan-release\n");
+}
+
+bool rtw_phl_wa_scan_prepare(void *phl)
+{
+	struct phl_info_t *p = phl;
+	unsigned long flags;
+	bool accepted;
+	spin_lock_irqsave(&wa_nan_radio_lock, flags);
+	accepted = !p->wa_nan_radio_owned;
+	if (accepted) p->wa_scan_count++;
+	spin_unlock_irqrestore(&wa_nan_radio_lock, flags);
+	if (!accepted) pr_info("WA_PROBE radio-scan-reject result=%d\n", -EBUSY);
+	return accepted;
+}
+
+bool rtw_phl_wa_scan_admit(void *phl, struct rtw_phl_scan_param *param)
+{
+	struct phl_info_t *p = phl;
+	unsigned long flags;
+	bool accepted;
+	spin_lock_irqsave(&wa_nan_radio_lock, flags);
+	accepted = !p->wa_nan_radio_owned;
+	if (accepted) {
+		param->wa_radio_owned = true;
+		p->wa_scan_count++;
+	}
+	spin_unlock_irqrestore(&wa_nan_radio_lock, flags);
+	pr_info("WA_PROBE radio-scan-admit result=%d\n", accepted ? 0 : -EBUSY);
+	return accepted;
+}
+
+/* Detach before a callback which may free param; keep the count until it returns. */
+static bool wa_scan_detach(struct rtw_phl_scan_param *param)
+{
+	unsigned long flags;
+	bool owned;
+	spin_lock_irqsave(&wa_nan_radio_lock, flags);
+	owned = param->wa_radio_owned;
+	param->wa_radio_owned = false;
+	spin_unlock_irqrestore(&wa_nan_radio_lock, flags);
+	return owned;
+}
+
+void rtw_phl_wa_scan_finish(void *phl)
+{
+	struct phl_info_t *p = phl;
+	unsigned long flags;
+	spin_lock_irqsave(&wa_nan_radio_lock, flags);
+	p->wa_scan_count--;
+	spin_unlock_irqrestore(&wa_nan_radio_lock, flags);
+	pr_info("WA_PROBE radio-scan-release\n");
+}
+
+void rtw_phl_wa_scan_release(void *phl, struct rtw_phl_scan_param *param)
+{
+	if (wa_scan_detach(param)) rtw_phl_wa_scan_finish(phl);
+}
+
+void rtw_phl_wa_scan_complete(void *phl, struct rtw_phl_scan_param *param)
+{
+	bool owned = wa_scan_detach(param);
+	if (param->ops->scan_complete)
+		param->ops->scan_complete(param->priv, param);
+	if (owned) rtw_phl_wa_scan_finish(phl);
+}
+#endif
