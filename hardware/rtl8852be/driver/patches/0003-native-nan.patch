+ x->phl_txreq->mdata.sw_seq = a->seqnum;
+ x->phl_txreq->mdata.f_rate = RTW_DATA_RATE_OFDM6;
+ x->phl_txreq->mdata.bk = 1;
+ if (!group && n->tx_ba && wa_ndi_aggregate_ready(n)) {
+  x->phl_txreq->mdata.ampdu_en = 1;
+  x->phl_txreq->mdata.bk = 0;
+  x->phl_txreq->mdata.max_agg_num = wa_ndi_aggregate_count(n,a->pktlen);
+  x->phl_txreq->mdata.ampdu_density = n->config.ampdu_density;
+  n->tx_ampdu_count++;
+ }
+ x->phl_txreq->mdata.mc = group;
+ x->phl_txreq->mdata.f_bw = n->config.channel.width;
+ x->phl_txreq->mdata.type = RTW_PHL_PKT_TYPE_DATA;
+ x->phl_txreq->mdata.cat = rtw_phl_cvt_tid_to_cat(0);
+ x->phl_txreq->mdata.tid = 0;
+ x->phl_txreq->mdata.macid = n->sta->macid;
+ x->phl_txreq->mdata.hw_sec_iv = 0;
+ x->phl_txreq->mdata.sw_sec_iv = 0;
+ x->phl_txreq->mdata.sec_hw_enc = 1;
+ x->phl_txreq->mdata.sec_type = RTW_ENC_CCMP;
+ x->phl_txreq->mdata.sec_cam_idx = group ? n->local_group_cam : n->pairwise_cam;
+ x->phl_txreq->mdata.force_key_en = 1;
+ x->phl_txreq->mdata.hdr_len = 13;
+ x->phl_txreq->mdata.smh_en = 0;
+ x->phl_txreq->mdata.no_ack = group;
+ if (!group) {
+  struct registry_priv *reg = &n->adapter->registrypriv;
+  x->phl_txreq->mdata.hw_rts_en = reg->hw_rts_en == 1;
+  x->phl_txreq->mdata.rts_en = reg->vrtl_carrier_sense == 1 && reg->vcs_type == 1;
+  x->phl_txreq->mdata.cts2self = reg->vrtl_carrier_sense == 1 && reg->vcs_type != 1;
+ }
+ /* Only A-MSDU requires HT; single MSDUs retain the native OFDM retry floor. */
+ x->phl_txreq->mdata.data_rty_lowest_rate = count>1 ?
+     RTW_DATA_RATE_MCS0 : RTW_DATA_RATE_OFDM6;
+ x->phl_txreq->mdata.userate_sel = group || !n->rate_ready;
+ tx = kmalloc(sizeof(*tx), GFP_KERNEL);
+ if (!tx) { n->tx_alloc_failed++; ret = -ENOMEM; goto fail; }
+ memset(tx, 0, sizeof(*tx));
+ for (u8 i=0;i<count;i++) wa_ndi_tcp_meta(&tx->tcp[i],packets[i]);
+ tx->sequence = a->seqnum;
+ tx->group=group; tx->ba_generation=n->ba_generation;
+ INIT_LIST_HEAD(&tx->live);
+ tx->owner = n; tx->pn = pn; tx->packets=count; tx->submitted_ns = ktime_get_ns();
+ n->prepare_ns += tx->submitted_ns - prepare_start;
+ if ((pn&63)==1) {
+  u32 high=0, low=0;
+  tx->phase_valid=rtw_hal_get_tsf(n->phl->hal,HW_BAND_0,wa_nan_stageb.plan.port[0],&high,&low)==RTW_HAL_STATUS_SUCCESS;
+  tx->submit_phase=low&0x7ffff;
+ }
+ tx->request = x->phl_txreq; tx->submitted_ms = _os_get_cur_time_ms();
+ tx->feedback.ctx = tx; tx->feedback.txfb_cb = wa_ndi_feedback;
+ x->phl_txreq->txfb = &tx->feedback;
