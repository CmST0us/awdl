+++ b/phl/hal_g6/mac/mac_ax/wa_nan_cycle.h
@@ -0,0 +1,319 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Included by dbg_cmd.c after wa_native_probe.h: one-shot NAN enable-command probe. */
+#ifndef WA_NAN_CYCLE_H
+#define WA_NAN_CYCLE_H
+
+#include <linux/bitops.h>
+#include <linux/ktime.h>
+#include <linux/printk.h>
+#include <linux/string.h>
+#include <linux/random.h>
+#include "nan.h"
+#include "fwofld.h"
+#include "twt.h"
+#include "wa_observe.h"
+#include "wa_nan_h2c.h"
+
+#define WA_NAN_CYCLE_PORT 0
+#define WA_NAN_CYCLE_LOG_COMP BIT(26)
+#define WA_NAN_CYCLE_LOG_LEVEL MAC_AX_FL_LV_TR
+#define WA_NAN_CYCLE_LOG_OUTPUT MAC_AX_FL_LV_C2H
+#define WA_NAN_CYCLE_ROLE_MAX 8
+
+struct wa_nan_cycle_plan {
+	u8 port;
+	u8 macid_bcn;
+	u8 macid_mgn;
+	u8 random_factor;
+	u8 nmi[6];
+	u8 cluster[6];
+	u16 roles;
+	u8 truncated;
+	u8 used[16];
+};
+
+static atomic_t wa_nan_cycle_state = ATOMIC_INIT(0);
+static atomic64_t wa_nan_cycle_ops = ATOMIC64_INIT(0);
+static const u8 wa_nan_cycle_cluster[6] = {0x50, 0x6f, 0x9a, 0x01, 0x00, 0x00};
+
+static u32 wa_nan_cycle_roles(struct mac_ax_adapter *adapter,
+			      struct wa_nan_cycle_plan *plan)
+{
+	struct mac_role_tbl_head *head = adapter->role_tbl;
+	struct mac_role_tbl *role;
+	struct {
+		u8 macid;
+		u8 port;
+		u8 net_type;
+		u8 self[6];
+	} snap[WA_NAN_CYCLE_ROLE_MAX];
+	u32 count = 0, limit, i, idx;
+	bool port0 = false;
+	int bcn = -1, mgn = -1;
+
+	PLTFM_MEMSET(plan, 0, sizeof(*plan));
+	if (!head || !head->next)
+		return MACNOITEM;
+
+	PLTFM_MUTEX_LOCK(&head->lock);
+	for (role = head->next; role != (struct mac_role_tbl *)head; role = role->next) {
+		if (role->macid < 128)
+			plan->used[role->macid >> 3] |= BIT(role->macid & 7);
+		if (role->info.port == WA_NAN_CYCLE_PORT && !port0) {
+			PLTFM_MEMCPY(plan->nmi, role->info.self_mac, 6);
+			port0 = true;
+		}
+		if (count < WA_NAN_CYCLE_ROLE_MAX) {
+			snap[count].macid = role->macid;
+			snap[count].port = role->info.port;
+			snap[count].net_type = role->info.net_type;
+			PLTFM_MEMCPY(snap[count].self, role->info.self_mac, 6);
+		}
+		count++;
+	}
+	PLTFM_MUTEX_UNLOCK(&head->lock);
+
+	plan->roles = count > 0xffff ? 0xffff : count;
+	plan->truncated = count > WA_NAN_CYCLE_ROLE_MAX;
+	for (idx = 0; idx < count && idx < WA_NAN_CYCLE_ROLE_MAX; idx++)
+		pr_info("WA_PROBE nan-role index=%u macid=%u port=%u net_type=%u self="
+			WA_NAN_ADDR_FMT "\n",
+			idx, (unsigned int)snap[idx].macid,
+			(unsigned int)snap[idx].port,
+			(unsigned int)snap[idx].net_type,
+			WA_NAN_ADDR_ARGS(snap[idx].self));
+	if (plan->truncated)
+		pr_info("WA_PROBE nan-role-truncated roles=%u shown=%u\n",
+			(unsigned int)plan->roles, (unsigned int)WA_NAN_CYCLE_ROLE_MAX);
+
+	if (!count || !port0)
+		return MACNOITEM;
+	for (i = 0; i < 6; i++)
+		if (plan->nmi[i])
+			break;
+	if (i == 6)
+		return MACNOITEM;
+
+	limit = adapter->hw_info->macid_num;
+	if (limit > 128)
+		limit = 128;
+	for (i = limit; i > 0; i--) {
+		u8 macid = (u8)(i - 1);
+
+		if (plan->used[macid >> 3] & BIT(macid & 7))
+			continue;
+		if (bcn < 0)
+			bcn = macid;
+		else {
+			mgn = macid;
+			break;
+		}
+	}
+	if (bcn < 0 || mgn < 0)
+		return MACNOITEM;
+
+	plan->port = WA_NAN_CYCLE_PORT;
+	plan->macid_bcn = (u8)bcn;
+	plan->macid_mgn = (u8)mgn;
+	plan->random_factor = plan->nmi[5] ^ 0x5a;
+	PLTFM_MEMCPY(plan->cluster, wa_nan_cycle_cluster, 6);
+	get_random_bytes(plan->cluster + 4, 2);
+	return MACSUCCESS;
+}
+
+static u32 wa_nan_cycle_tsf(struct mac_ax_adapter *adapter, u8 port, u64 *value)
+{
+	struct mac_ax_port_tsf first = {0}, second = {0};
+	u32 attempt;
+
+	first.port = port;
+	second.port = port;
+	for (attempt = 0; attempt < 3; attempt++) {
+		if (mac_get_tsf(adapter, &first) != MACSUCCESS ||
+		    mac_get_tsf(adapter, &second) != MACSUCCESS)
+			return MACPROCERR;
+		if (first.tsf_h == second.tsf_h) {
+			*value = ((u64)first.tsf_h << 32) | first.tsf_l;
+			return MACSUCCESS;
+		}
+	}
+	return MACPROCERR;
+}
+
+static u32 wa_nan_cycle_log_tsf(struct mac_ax_adapter *adapter,
+				const char *phase, u64 op)
+{
+	u64 tsf0 = 0, tsf1 = 0;
+	u32 r0, r1;
+
+	r0 = wa_nan_cycle_tsf(adapter, 0, &tsf0);
+	r1 = wa_nan_cycle_tsf(adapter, 1, &tsf1);
+	pr_info("WA_PROBE nan-tsf phase=%s op=%llu ns=%llu port0_result=%u port0=%llu port1_result=%u port1=%llu\n",
+		phase, (unsigned long long)op, (unsigned long long)ktime_get_ns(),
+		r0, (unsigned long long)tsf0, r1, (unsigned long long)tsf1);
+	return (r0 == MACSUCCESS && r1 == MACSUCCESS) ? MACSUCCESS : MACPROCERR;
+}
+
+static void wa_nan_cycle_state_dump(struct mac_ax_adapter *adapter,
+				    const char *phase, u64 op)
+{
+	struct mac_ax_nan_info info = {0};
+	u32 ret;
+
+	ret = mac_check_cluster_info(adapter, &info);
+	pr_info("WA_PROBE nan-state phase=%s op=%llu ns=%llu result=%u c2h_type=%u schedule_id=%u cluster="
+		WA_NAN_ADDR_FMT " master_pref=%u random_factor=%u amr=%llu ambtt=%u hop=%u\n",
+		phase, (unsigned long long)op, (unsigned long long)ktime_get_ns(),
+		ret, (unsigned int)info.rpt_nan_c2h_type,
+		(unsigned int)info.nan_act_ack_info.schedule_id,
+		WA_NAN_ADDR_ARGS(info.rpt_cluster_id),
+		(unsigned int)info.rpt_master_pref,
+		(unsigned int)info.rpt_random_factor,
+		(unsigned long long)info.rpt_amr,
+		(unsigned int)info.rpt_ambtt, (unsigned int)info.rpt_hop_count);
+}
+
+static void wa_nan_cycle_logcfg(struct mac_ax_adapter *adapter, u64 op)
+{
+	struct mac_ax_fw_log cfg = {0};
+	u32 ret;
+
+	cfg.level = WA_NAN_CYCLE_LOG_LEVEL;
+	cfg.output = WA_NAN_CYCLE_LOG_OUTPUT;
+	cfg.comp = WA_NAN_CYCLE_LOG_COMP;
+	ret = mac_fw_log_cfg(adapter, &cfg);
+	pr_info("WA_PROBE nan-logcfg op=%llu ns=%llu result=%u request_level=%u request_output=%u request_comp=%08x cached_level=%u cached_output=%u cached_comp=%08x cached_comp_ext=%08x\n",
+		(unsigned long long)op, (unsigned long long)ktime_get_ns(), ret,
+		(unsigned int)cfg.level, (unsigned int)cfg.output,
+		(unsigned int)cfg.comp,
+		(unsigned int)adapter->log_cfg.level,
+		(unsigned int)adapter->log_cfg.output,
+		(unsigned int)adapter->log_cfg.comp,
+		(unsigned int)adapter->log_cfg.comp_ext);
+}
+
+static u32 wa_nan_cycle_start(struct mac_ax_adapter *adapter, u64 op)
+{
+	struct wa_nan_cycle_plan plan;
+	struct wa_nan_h2c_plan h2c;
+	struct rtw_wcpu_cap_t cap = {0};
+	u32 ret, fail_step = 0;
+	u64 begin = ktime_get_ns();
+	u64 enable_ns = 0;
+
+	ret = wa_probe_ready(adapter);
+	pr_info("WA_PROBE nan-cycle phase=ready op=%llu ns=%llu status=%u\n",
+		(unsigned long long)op, (unsigned long long)begin, ret);
+	if (ret != MACSUCCESS) {
+		pr_info("WA_PROBE nan-cycle phase=precondition op=%llu ns=%llu status=%u reason=ready\n",
+			(unsigned long long)op, (unsigned long long)ktime_get_ns(), ret);
+		return ret;
+	}
+
+	ret = mac_get_wlanfw_cap(adapter, &cap);
+	pr_info("WA_PROBE nan-cap op=%llu ns=%llu result=%u valid=%u nan=%u\n",
+		(unsigned long long)op, (unsigned long long)ktime_get_ns(), ret,
+		(unsigned int)cap.valid, (unsigned int)cap.mac_ofld_cap.nan);
+	if (ret != MACSUCCESS || !cap.valid || !cap.mac_ofld_cap.nan) {
+		u32 status = ret == MACSUCCESS ? MACNOITEM : ret;
+
+		pr_info("WA_PROBE nan-cycle phase=precondition op=%llu ns=%llu status=%u reason=fwcap result=%u valid=%u nan=%u\n",
+			(unsigned long long)op, (unsigned long long)ktime_get_ns(),
+			status, ret, (unsigned int)cap.valid,
+			(unsigned int)cap.mac_ofld_cap.nan);
+		return status;
+	}
+
+	ret = wa_nan_cycle_roles(adapter, &plan);
+	if (ret != MACSUCCESS) {
+		pr_info("WA_PROBE nan-cycle phase=precondition op=%llu ns=%llu status=%u reason=role-or-macid\n",
+			(unsigned long long)op, (unsigned long long)ktime_get_ns(), ret);
+		return ret;
+	}
+
+	if (atomic_cmpxchg(&wa_nan_cycle_state, 0, 1) != 0) {
+		pr_info("WA_PROBE nan-cycle phase=reject op=%llu ns=%llu reason=already-started\n",
+			(unsigned long long)op, (unsigned long long)ktime_get_ns());
+		return MACPROCERR;
+	}
+
+	pr_info("WA_PROBE nan-cycle phase=start op=%llu ns=%llu port=%u macid_bcn=%u macid_mgn=%u random_factor=%u nmi="
+		WA_NAN_ADDR_FMT " cluster=" WA_NAN_ADDR_FMT " roles=%u truncated=%u state=%d\n",
+		(unsigned long long)op, (unsigned long long)begin,
+		(unsigned int)plan.port, (unsigned int)plan.macid_bcn,
+		(unsigned int)plan.macid_mgn, (unsigned int)plan.random_factor,
+		WA_NAN_ADDR_ARGS(plan.nmi),
+		WA_NAN_ADDR_ARGS(plan.cluster),
+		(unsigned int)plan.roles, (unsigned int)plan.truncated,
+		atomic_read(&wa_nan_cycle_state));
+
+	wa_nan_cycle_logcfg(adapter, op);
+
+	PLTFM_MEMSET(&h2c, 0, sizeof(h2c));
+	h2c.port[0] = plan.port;
+	h2c.port[1] = plan.port;
+	h2c.macid_bcn = plan.macid_bcn;
+	h2c.macid_mgn = plan.macid_mgn;
+	h2c.random_factor = plan.random_factor;
+	PLTFM_MEMCPY(h2c.nmi, plan.nmi, 6);
+	PLTFM_MEMCPY(h2c.cluster, plan.cluster, 6);
+	ret = wa_nan_h2c_run(adapter, op, &h2c, &fail_step);
+
+	if (ret) {
+		pr_info("WA_PROBE nan-cycle phase=abort op=%llu ns=%llu step=%u host_result=%u remaining=0\n",
+			(unsigned long long)op, (unsigned long long)ktime_get_ns(),
+			fail_step, ret);
+		wa_nan_cycle_state_dump(adapter, "abort", op);
+		return ret;
+	}
+
+	enable_ns = ktime_get_ns();
+	pr_info("WA_PROBE nan-cycle phase=done op=%llu ns=%llu enable_ns=%llu steps=5 host_result=0\n",
+		(unsigned long long)op, (unsigned long long)ktime_get_ns(),
+		(unsigned long long)enable_ns);
+	wa_nan_cycle_log_tsf(adapter, "done", op);
+	wa_nan_cycle_state_dump(adapter, "done", op);
+	return MACSUCCESS;
+}
+
+static u32 wa_nan_cycle_status(struct mac_ax_adapter *adapter, u64 op)
+{
+	u32 ret, tsf_ret;
+
+	ret = wa_probe_ready(adapter);
+	pr_info("WA_PROBE nan-status phase=ready op=%llu ns=%llu status=%u state=%d\n",
+		(unsigned long long)op, (unsigned long long)ktime_get_ns(), ret,
+		atomic_read(&wa_nan_cycle_state));
+	if (ret != MACSUCCESS)
+		return ret;
+	tsf_ret = wa_nan_cycle_log_tsf(adapter, "status", op);
+	wa_nan_cycle_state_dump(adapter, "status", op);
+	return tsf_ret;
+}
+
+static u32 cmd_wa_nan_cycle(struct mac_ax_adapter *adapter,
+			    char input[][MAC_MAX_ARGV], u32 input_num,
+			    char *output, u32 out_len, u32 *used)
+{
+	u64 op = atomic64_inc_return(&wa_nan_cycle_ops);
+	u32 ret;
+
+	if (input_num == 2 && PLTFM_STRCMP(input[1], "start") == 0) {
+		ret = wa_nan_cycle_start(adapter, op);
+	} else if (input_num == 2 && PLTFM_STRCMP(input[1], "status") == 0) {
+		ret = wa_nan_cycle_status(adapter, op);
+	} else {
+		pr_info("WA_PROBE nan-command phase=reject op=%llu ns=%llu input_num=%u command=unsupported\n",
+			(unsigned long long)op, (unsigned long long)ktime_get_ns(),
+			input_num);
+		MAC_DBG_MSG(out_len, *used, output + *used, out_len - *used,
+			"WA_NAN_CYCLE usage: mac wa_nan_cycle start|status\n");
+		return MACFUNCINPUT;
+	}
+	MAC_DBG_MSG(out_len, *used, output + *used, out_len - *used,
+		"WA_NAN_CYCLE op=%llu host_result=%u\n",
+		(unsigned long long)op, ret);
+	return ret;
+}
+
+#endif /* WA_NAN_CYCLE_H */
