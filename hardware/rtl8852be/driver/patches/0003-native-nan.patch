+}
+int rtw_phl_wa_nan_peer_schedule(void *phl, const u8 *peer, u32 slots,
+                               const struct wa_nan_channel *channel)
+{
+	struct wa_nan_stageb_ctx *ctx = &wa_nan_stageb;
+	struct wa_nan_channel previous = {0};
+	/* Public authentication may use the peer schedule before its key exists.
+	 * NDI and protected management TX retain their separate key checks. */
+	u8 macid;
+	bool rebind = false;
+	int ret;
+	if (!mutex_trylock(&wa_nan_lifecycle_lock)) return -EBUSY;
+	if (!ctx->entered || ctx->held || ctx->phl != phl || !ctx->mgmt_ready ||
+	    !ctx->bigtk_ready || !ctx->schedule_record ||
+	    (peer && (!ctx->peer || memcmp(peer, ctx->peer->mac_addr, 6)))) { ret = -ENODEV; goto out; }
+	if (!peer && ctx->ndi && ctx->ndi->sta) { ret = -EBUSY; goto out; }
+	macid = peer ? (ctx->ndi && ctx->ndi->sta ? ctx->ndi->sta->macid : ctx->peer->macid) : ctx->plan.macid_mgn;
+	if (!channel) { ret = -EINVAL; goto out; }
+	if (ctx->ndi && ctx->ndi->ready) {
+		previous = ctx->ndi->config.channel;
+		rebind = memcmp(channel, &previous, sizeof(*channel)) != 0;
+	}
+	ret = rtw_hal_wa_nan_command_begin(ctx->phl->hal);
+	if (!ret) {
+		if ((slots & 3)!=2) ret=-EINVAL;
+		else if (ctx->data_slots != (slots & ~3U) || ctx->data_macid != macid ||
+			 memcmp(channel, &ctx->data_channel, sizeof(*channel))) {
+			ret=rtw_hal_wa_nan_data_schedule(ctx->phl->hal,macid,slots & ~3U,channel);
+			if (!ret) {
+				ctx->data_slots=slots & ~3U; ctx->data_macid=macid;
+				ctx->data_channel=*channel;
+			}
+		}
+		if (!ret) ret = wa_ndi_members(ctx, ctx->ndi && ctx->ndi->ready);
+		if (!ret && rebind) {
+			ctx->ndi->config.channel = *channel;
+			pr_info("WA_PROBE ndi-rebind from=%u/%u/%u to=%u/%u/%u\n",
+				previous.primary, previous.center, previous.width,
+				channel->primary, channel->center, channel->width);
+		}
+		pr_info("WA_PROBE data-schedule slots=%08x result=%d macid=%u primary=%u center=%u width=%u\n",
+			slots,ret,macid,channel->primary,channel->center,channel->width);
+		rtw_hal_wa_nan_command_end();
+	}
+out:
+	mutex_unlock(&wa_nan_lifecycle_lock);
+	return ret;
+}
+int rtw_phl_wa_nan_group_seq(void *phl, u32 owner, u8 index,
+		const u8 *ndi, u8 pn[6])
+{
+	struct wa_nan_stageb_ctx *ctx = &wa_nan_stageb;
+	unsigned long flags;
+	u64 value;
+	int ret = 0, i;
+	if (!mutex_trylock(&wa_nan_lifecycle_lock)) return -EBUSY;
+	if (!ctx->entered || ctx->held || ctx->phl != phl) { ret = -ENODEV; goto out; }
+	if (owner == WA_NAN_KEY_OWNER_LOCAL_NMI_BIGTK) {
+		if (ndi || !ctx->bigtk_ready || index != ctx->bigtk_index) {
+			ret = -ENOKEY; goto out;
+		}
+		ret = rtw_hal_wa_nan_command_begin(ctx->phl->hal);
+		if (!ret) {
+			ret = rtw_hal_wa_nan_bigtk_seq(ctx->phl->hal, &ctx->plan, index, pn);
+			rtw_hal_wa_nan_command_end();
+		}
+	} else if (owner == WA_NAN_KEY_OWNER_LOCAL_NDI_GTK) {
+		if (!ctx->ndi || !ctx->ndi->session || !ctx->ndi->local_group_attempted ||
+		    !ndi || index != ctx->ndi->config.gtk_index ||
+		    memcmp(ndi, ctx->ndi->config.local, 6)) { ret = -ENOKEY; goto out; }
+		spin_lock_irqsave(&wa_ndi_lock, flags);
+		value = ctx->ndi->gtk_pn;
+		spin_unlock_irqrestore(&wa_ndi_lock, flags);
+		for (i=0; i<6; i++) pn[i] = value >> (8*i);
+	} else ret = -EOPNOTSUPP;
+out:
+	mutex_unlock(&wa_nan_lifecycle_lock);
+	return ret;
+}
+int rtw_phl_wa_nan_bigtk(void *phl, u8 index, const u8 *pn, const u8 *key)
+{
+	struct wa_nan_stageb_ctx *ctx = &wa_nan_stageb;
+	int ret, cleanup = 0;
+	if (index != 6 && index != 7) return -EOPNOTSUPP;
+	if (!mutex_trylock(&wa_nan_lifecycle_lock)) return -EBUSY;
+	if (!wa_nan_host_owned || !ctx->entered || ctx->held || ctx->phl != phl ||
+	    !ctx->mgmt_ready || !ctx->schedule_ready || !ctx->schedule_record) {
+		ret = -ENODEV;
+		goto out;
+	}
+	if (ctx->band) { ret = -EOPNOTSUPP; goto out; }
+	if (ctx->bigtk_attempted) { ret = -EEXIST; goto out; }
+	ret = rtw_hal_wa_nan_command_begin(ctx->phl->hal);
+	if (ret) goto out;
+	ctx->bigtk_attempted = true;
+	ctx->bigtk_index = index;
+	ret = rtw_hal_wa_nan_bigtk_install(ctx->phl->hal, &ctx->plan, index, pn, key);
+	rtw_hal_wa_nan_command_end();
+	if (!ret) ctx->bigtk_ready = true;
+	else {
+		cleanup = wa_nan_host_stop_locked(phl);
+		if (cleanup) ret = -EUCLEAN;
+	}
+out:
+	pr_info("WA_PROBE bigtk-install index=%u result=%d cleanup=%d attempted=%u ready=%u\n",
+		index, ret, cleanup, ctx->bigtk_attempted, ctx->bigtk_ready);
+	mutex_unlock(&wa_nan_lifecycle_lock);
+	return ret;
+}
+#endif
