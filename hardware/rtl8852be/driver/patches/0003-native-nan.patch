+int rtw_hal_wa_nan_status(void *hal, const struct wa_nan_h2c_plan *plan,
+			  const char *phase)
+{
+	struct hal_info_t *info = (struct hal_info_t *)hal;
+	struct mac_ax_adapter *mac = info->mac;
+	struct mac_ax_port_tsf first = {0}, second = {0};
+	struct mac_ax_nan_info nan = {0};
+	u64 tsf[2] = {0, 0};
+	u32 result[2] = {MACPROCERR, MACPROCERR};
+	u32 ret, i, attempt;
+
+	for (i = 0; i < 2; i++) {
+		first.port = plan->port[i];
+		second.port = plan->port[i];
+		for (attempt = 0; attempt < 3; attempt++) {
+			if (mac_get_tsf(mac, &first) != MACSUCCESS ||
+			    mac_get_tsf(mac, &second) != MACSUCCESS)
+				break;
+			if (first.tsf_h == second.tsf_h) {
+				tsf[i] = ((u64)first.tsf_h << 32) | first.tsf_l;
+				result[i] = MACSUCCESS;
+				break;
+			}
+		}
+	}
+	pr_info("WA_PROBE nan-tsf phase=%s port0_result=%u port0=%llu port1_result=%u port1=%llu\n",
+		phase, result[0], (unsigned long long)tsf[0],
+		result[1], (unsigned long long)tsf[1]);
+	ret = mac_check_cluster_info(mac, &nan);
+	pr_info("WA_PROBE nan-state phase=%s result=%u c2h_type=%u schedule_id=%u cluster="
+		WA_NAN_ADDR_FMT " master_pref=%u random_factor=%u amr=%llu ambtt=%u hop=%u\n",
+		phase, ret, (unsigned int)nan.rpt_nan_c2h_type,
+		(unsigned int)nan.nan_act_ack_info.schedule_id,
+		WA_NAN_ADDR_ARGS(nan.rpt_cluster_id),
+		(unsigned int)nan.rpt_master_pref,
+		(unsigned int)nan.rpt_random_factor,
+		(unsigned long long)nan.rpt_amr,
+		(unsigned int)nan.rpt_ambtt,
+		(unsigned int)nan.rpt_hop_count);
+	return (result[0] == MACSUCCESS && result[1] == MACSUCCESS &&
+		ret == MACSUCCESS) ? 0 : -EIO;
+}
+
