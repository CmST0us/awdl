+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef WA_NAN_PEER_H
+#define WA_NAN_PEER_H
+
+/* Pairwise CCMP-128 slot zero; callers validate the UAPI parameters. */
+static int wa_nan_key_change(void *phl, const u8 *address, const u8 *key,
+ bool add, u64 cookie, bool internal)
+{
+	struct wa_nan_stageb_ctx *ctx = &wa_nan_stageb;
+	struct phl_sec_param_h crypt = {
+		.keyid = 0, .enc_type = RTW_ENC_CCMP,
+		.key_type = RTW_SEC_KEY_UNICAST, .key_len = 16,
+	};
+	enum rtw_phl_status status;
+	u8 temporary[16];
+	u32 cam;
+	int ret;
+
+	if (!ctx->entered || ctx->phl != phl) return -ENETDOWN;
+	if (add && ctx->held) return -EUCLEAN;
+	if (!ctx->peer || memcmp(address, ctx->peer->mac_addr, 6)) return -ENOENT;
+	if (add) {
+		if (!ctx->peer_ready) return -EIO;
+		if (ctx->key_attempted) return ctx->key_ready ? -EEXIST : -EIO;
+		memcpy(temporary, key, sizeof(temporary));
+		ctx->key_attempted = true;
+		status = rtw_phl_cmd_add_key(phl, ctx->peer, &crypt, temporary,
+			PHL_CMD_DIRECTLY, 0);
+		memzero_explicit(temporary, sizeof(temporary));
+		if (status != RTW_PHL_STATUS_SUCCESS) return -EIO;
+		if (cookie) {
+			cam = rtw_phl_get_sec_cam_idx(phl, ctx->peer, 0, RTW_SEC_KEY_UNICAST);
+			if (cam >= 128) return -EIO;
+			wa_ccmp_install(phl, ctx->plan.nmi, address, key, cookie,
+				ctx->peer->macid, cam);
+		}
+		ctx->key_ready = true;
+		return 0;
+	}
+	ret = wa_ccmp_delete_begin(cookie, internal);
+	if (ret) return ret;
+	if (!ctx->key_attempted) { wa_ccmp_clear(); return 0; }
+	ctx->key_ready = false;
+	status = rtw_phl_cmd_del_key(phl, ctx->peer, &crypt, PHL_CMD_DIRECTLY, 0);
+	if (status != RTW_PHL_STATUS_SUCCESS) return -EIO;
+	ctx->key_attempted = ctx->key_ready = false;
+	wa_ccmp_clear();
+	return 0;
+}
+
+int rtw_phl_wa_nan_key(void *phl, const u8 *address, const u8 *key, bool add)
+{
+ return wa_nan_key_change(phl, address, key, add, 0, true);
+}
+
+int rtw_phl_wa_nan_key_owned(void *phl, const u8 *address,
+                           const u8 *key, bool add, u64 cookie)
+{
+ return wa_nan_key_change(phl, address, key, add, cookie, false);
+}
+
+/* Called under the vendor command's wiphy lock. */
+int rtw_phl_wa_nan_peer(void *phl, const u8 *address, bool add)
+{
+	struct wa_nan_stageb_ctx *ctx = &wa_nan_stageb;
+	enum rtw_phl_status status;
+	u8 peer_address[6];
+	int ret;
+
+	if (!ctx->entered || ctx->phl != phl ||
+	    ctx->wrole->type != PHL_RTYPE_NAN) return -ENETDOWN;
+	if (add && ctx->held) return -EUCLEAN;
+	if (!is_valid_ether_addr(address) ||
+	    !memcmp(address, ctx->plan.nmi, 6)) return -EINVAL;
+	if (ctx->peer && memcmp(address, ctx->peer->mac_addr, 6))
+		return add ? -ENOSPC : -ENOENT;
+	if (!add) {
+		if (!ctx->peer) return 0;
+		if (wa_ndi_has_session(ctx)) return -EBUSY;
+		if (ctx->fw_touched && ctx->bigtk_ready) {
+			ret = rtw_hal_wa_nan_command_begin(ctx->phl->hal);
+			if (ret) return ret;
+			if (ctx->data_slots) {
+				ret = rtw_hal_wa_nan_data_schedule(ctx->phl->hal, ctx->data_macid, 0, &ctx->data_channel);
+				if (!ret) { ctx->data_slots = 0; ctx->data_macid = 0; }
+			}
+			if (!ret) ret = rtw_hal_wa_nan_faw_members(ctx->phl->hal, &ctx->plan,
+				ctx->bigtk_index, NULL, 0, 0xff);
+			rtw_hal_wa_nan_command_end();
+			if (ret) return ret;
+		}
+		if (ctx->key_attempted) {
+			ret = rtw_phl_wa_nan_key(phl, address, NULL, false);
+			if (ret) return ret;
+		}
+		status = rtw_phl_cmd_alloc_stainfo(phl, &ctx->peer, NULL,
+			ctx->wrole, DEV_TYPE_LEGACY, 0, ctx->rlink,
+			false, true, PHL_CMD_DIRECTLY, 0);
+		if (status != RTW_PHL_STATUS_SUCCESS) return -EIO;
+		if (rtw_phl_free_stainfo_sw(phl, ctx->peer) != RTW_PHL_STATUS_SUCCESS)
+			return -EIO;
+		ctx->peer = NULL;
+		ctx->peer_ready = false;
+		return 0;
+	}
+	if (ctx->peer) return ctx->peer_ready ? 0 : -EIO;
+	memcpy(peer_address, address, sizeof(peer_address));
+	ctx->peer = rtw_phl_alloc_stainfo_sw(phl, peer_address,
+		ctx->wrole, DEV_TYPE_LEGACY, 0, ctx->rlink);
+	if (!ctx->peer) return -ENOMEM;
+	ctx->peer->sec_mode = RTW_SEC_ENT_MODE_2;
+	status = rtw_phl_cmd_alloc_stainfo(phl, &ctx->peer, peer_address,
+		ctx->wrole, DEV_TYPE_LEGACY, 0, ctx->rlink,
+		true, true, PHL_CMD_DIRECTLY, 0);
+	/* Keep the allocation until DEL if hardware completion failed. */
+	if (status != RTW_PHL_STATUS_SUCCESS) return -EIO;
+	ctx->peer_ready = true;
+	return 0;
+}
+#endif
