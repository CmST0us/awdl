+/* SPDX-License-Identifier: GPL-2.0 */
+/* M5-A2: NAN pairing-mode Publish SDF, NIRA, PIN and pairing bootstrap.
+ *
+ * Offline construction and parsing only. The modules here produce and consume
+ * the bytes defined by Wi-Fi Aware Specification v4.0 section 7.6 and 9.5, and
+ * by Apple Accessory Design Guidelines section 56. They do not send frames,
+ * install keys, or run PASN.
+ */
+#ifndef WA_NAN_PAIRING_H
+#define WA_NAN_PAIRING_H
+
+#include <linux/types.h>
+#include <linux/string.h>
+#include <linux/errno.h>
+#include "wa_nan_sha256.h"
+#include "wa_nan_sdf.h"
+
+/* Wi-Fi Aware v4.0 Table 22: cipher version 0, 128-bit NIK, 64-bit nonce /
+ * tag, Tag = Truncate-64(HMAC-SHA-256(NIK, "NIR" || NMI || Nonce)).
+ */
+#define WA_NAN_NIK_LEN		16
+#define WA_NAN_NIRA_NONCE_LEN	8
+#define WA_NAN_NIRA_TAG_LEN	8
+#define WA_NAN_NIRA_CIPHER_VER	0
+#define WA_NAN_NIRA_BODY_LEN	(1 + WA_NAN_NIRA_NONCE_LEN + WA_NAN_NIRA_TAG_LEN)
+
+/* Pairing-mode TXT value. Same length as the M4 value so the 183 B layout is
+ * unchanged; the M5 plan sets pairingName=ROCK5B-M5 for the ASK target.
+ */
+#define WA_NAN_PAIRING_TXT_NAME	"pairingName=ROCK5B-M5"
+
+/* 6-digit PIN without a leading zero: 100000..999999. Apple section 56.3 /
+ * 56.4 states the 6-digit PIN is the current pairing method.
+ */
+#define WA_NAN_PIN_MIN		100000
+#define WA_NAN_PIN_MAX		999999
+#define WA_NAN_PIN_SPAN		(WA_NAN_PIN_MAX - WA_NAN_PIN_MIN + 1)
+#define WA_NAN_PIN_TTL_NS	(300ULL * 1000000000ULL)
+
+/* NAN SDF / NAF header constants used by the parser. */
+#define WA_NAN_SDF_FRAME_MIN_LEN	30
+#define WA_NAN_NPBA_TYPE_ADVERTISE	0
+#define WA_NAN_NPBA_TYPE_REQUEST	1
+#define WA_NAN_NPBA_TYPE_RESPONSE	2
+#define WA_NAN_NPBA_STATUS_ACCEPTED	0
+#define WA_NAN_NPBA_STATUS_REJECTED	1
+#define WA_NAN_NPBA_STATUS_COMEBACK	2
+#define WA_NAN_NPBA_METHOD_PIN_DISPLAY	0x0002	/* b1 */
+#define WA_NAN_NPBA_METHOD_PIN_KEYPAD	0x0020	/* b5 */
+#define WA_NAN_DCEA_PAIRING_SETUP	0x0100	/* Capability Info b8 */
+#define WA_NAN_DCEA_NPK_NIK_CACHING	0x0200	/* Capability Info b9 */
+
+/* Service Control type values from Table 50. */
+#define WA_NAN_SRV_CTRL_TYPE_MASK	0x03
+#define WA_NAN_SRV_CTRL_FOLLOW_UP	0x02
+
+/* ------------------------------------------------------------------------- */
+/* NIRA                                                                      */
+/* ------------------------------------------------------------------------- */
+
+/*
+ * Fill the 17-byte NIRA body: cipher version (0), nonce (8), tag (8).
+ * Returns 0, or -EINVAL for a missing argument.
+ */
+static inline int wa_nan_nira_body(const u8 nik[WA_NAN_NIK_LEN],
+				   const u8 nmi[6],
+				   const u8 nonce[WA_NAN_NIRA_NONCE_LEN],
+				   u8 body[WA_NAN_NIRA_BODY_LEN])
+{
+	u8 data[3 + 6 + WA_NAN_NIRA_NONCE_LEN];
+	u8 tag[WA_SHA256_DIGEST_LEN];
+
+	if (!nik || !nmi || !nonce || !body)
+		return -EINVAL;
+	data[0] = 'N';
+	data[1] = 'I';
+	data[2] = 'R';
+	memcpy(data + 3, nmi, 6);
+	memcpy(data + 9, nonce, WA_NAN_NIRA_NONCE_LEN);
+	wa_hmac_sha256(nik, WA_NAN_NIK_LEN, data, sizeof(data), tag);
+	body[0] = WA_NAN_NIRA_CIPHER_VER;
+	memcpy(body + 1, nonce, WA_NAN_NIRA_NONCE_LEN);
+	memcpy(body + 1 + WA_NAN_NIRA_NONCE_LEN, tag, WA_NAN_NIRA_TAG_LEN);
+	memset(tag, 0, sizeof(tag));
+	return 0;
+}
+
+struct wa_nan_pairing_sdf_params {
+	const u8 *a1;		/* NAN Network ID */
+	const u8 *nmi;		/* publisher NMI */
+	const u8 *cluster;	/* NAN Cluster ID */
+	u8 instance_id;		/* publish ID */
+	const u8 *nik;		/* 16-byte NIK; required in pairing mode */
+	const u8 *nonce;	/* 8-byte NIRA nonce */
+};
+
+/*
+ * Build the 183 B pairing-mode Publish SDF: the M4 layout with the M5 TXT
+ * pairingName and a NIRA appended after Country. Returns the frame length or
+ * a negative errno. The SSI carries only service name and device TXT records;
+ * it carries no PIN or pairing method.
+ */
+static inline int wa_nan_pairing_sdf_build(u8 *frame, size_t cap,
+					   const struct wa_nan_pairing_sdf_params *p)
+{
+	struct wa_nan_sdf_params sdf;
+	u8 nira[WA_NAN_NIRA_BODY_LEN];
+
+	if (!frame || !p)
+		return -EINVAL;
+	if (!p->nik || !p->nonce)
+		return -EINVAL;
+	if (wa_nan_nira_body(p->nik, p->nmi, p->nonce, nira) != 0)
+		return -EINVAL;
+	memset(&sdf, 0, sizeof(sdf));
+	sdf.a1 = p->a1;
+	sdf.nmi = p->nmi;
+	sdf.cluster = p->cluster;
+	sdf.instance_id = p->instance_id;
+	sdf.nira = nira;
+	sdf.pairing_name = WA_NAN_PAIRING_TXT_NAME;
+	return wa_nan_sdf_build(frame, cap, &sdf);
+}
+
+/* ------------------------------------------------------------------------- */
+/* PIN                                                                       */
+/* ------------------------------------------------------------------------- */
+
+struct wa_nan_pin {
+	u32 value;
+	u32 generation;
+	u64 deadline_ns;
+	bool armed;
+};
+
+static inline u32 wa_nan_pin_from_random(u32 random)
+{
+	return WA_NAN_PIN_MIN + random % WA_NAN_PIN_SPAN;
+}
+
+/*
+ * Arm a PIN. Called once when the publisher enters pairing mode, or again
+ * after a failed attempt when the user re-enters pairing mode. The caller
+ * moves get_random_u32() into @random; this helper stays deterministic so the
+ * offline tests can pin the vector.
+ */
+static inline int wa_nan_pin_arm(struct wa_nan_pin *pin, u32 random,
+				 u64 now_ns, u64 ttl_ns)
+{
+	if (!pin || !ttl_ns)
+		return -EINVAL;
+	pin->value = wa_nan_pin_from_random(random);
+	pin->generation++;
+	pin->deadline_ns = now_ns + ttl_ns;
+	pin->armed = true;
+	return 0;
+}
+
+/*
+ * Check a PIN typed by the subscriber. Returns 0 on match, -EACCES when the
+ * state is unarmed or the value differs, -ETIMEDOUT when the lifetime elapsed.
+ */
+static inline int wa_nan_pin_verify(const struct wa_nan_pin *pin,
+				    u32 candidate, u64 now_ns)
+{
+	if (!pin)
+		return -EINVAL;
+	if (!pin->armed)
+		return -EACCES;
+	if (now_ns >= pin->deadline_ns)
+		return -ETIMEDOUT;
+	return candidate == pin->value ? 0 : -EACCES;
+}
+
+/* Wipe the PIN value; the generation survives for the log transition. */
+static inline void wa_nan_pin_clear(struct wa_nan_pin *pin)
+{
+	if (!pin)
+		return;
+	pin->value = 0;
+	pin->deadline_ns = 0;
+	pin->armed = false;
+}
+
+static inline char *wa_nan_put_str(char *p, const char *s)
+{
+	while (*s)
+		*p++ = *s++;
+	return p;
+}
+
+/* Decimal without libc; zero-pads to min_width (6 for the PIN field). */
+static inline char *wa_nan_put_dec(char *p, u32 v, unsigned int min_width)
+{
+	char tmp[10];
+	unsigned int n = 0;
+	unsigned int pad;
+
+	do {
+		tmp[n++] = '0' + v % 10;
+		v /= 10;
+	} while (v);
+	for (pad = min_width > n ? min_width - n : 0; pad; pad--)
+		*p++ = '0';
+	while (n)
+		*p++ = tmp[--n];
+	return p;
+}
+
+#define WA_NAN_PIN_LOG_MAX	96
+
+/*
+ * One-line PIN log for netconsole/kmsg. This is the only place the PIN is
+ * printed; the test orchestrator parses "value=%06u". Reports must not copy
+ * the value.
+ */
+static inline int wa_nan_pin_log_armed(char *buf, size_t cap,
+				       const struct wa_nan_pin *pin, u64 now_ns)
+{
+	static const char head[] =
+		"WA_PROBE nan-pair phase=pin state=armed value=";
+	static const char mid[] = " generation=";
+	static const char tail[] = " ttl_s=";
+	u64 left;
+	u32 ttl_s;
+	char *p;
+
+	if (!buf || !pin || !pin->armed || cap < WA_NAN_PIN_LOG_MAX)
+		return -ENOSPC;
+	left = pin->deadline_ns > now_ns ? pin->deadline_ns - now_ns : 0;
+	ttl_s = (u32)((left + 999999999ULL) / 1000000000ULL);
+	p = wa_nan_put_str(buf, head);
+	p = wa_nan_put_dec(p, pin->value, 6);
+	p = wa_nan_put_str(p, mid);
+	p = wa_nan_put_dec(p, pin->generation, 1);
+	p = wa_nan_put_str(p, tail);
+	p = wa_nan_put_dec(p, ttl_s, 1);
+	*p++ = '\n';
+	*p = 0;
+	return (int)(p - buf);
+}
+
+/* "state=cleared" / "state=expired" transition without the PIN value. */
+static inline int wa_nan_pin_log_state(char *buf, size_t cap,
+				       const struct wa_nan_pin *pin,
+				       const char *state)
+{
+	static const char head[] = "WA_PROBE nan-pair phase=pin state=";
+	static const char mid[] = " generation=";
+	char *p;
+
+	if (!buf || !pin || !state || cap < 64)
+		return -ENOSPC;
+	if (sizeof(head) - 1 + strlen(state) + sizeof(mid) - 1 + 10 + 2 > cap)
+		return -ENOSPC;
+	p = wa_nan_put_str(buf, head);
+	p = wa_nan_put_str(p, state);
+	p = wa_nan_put_str(p, mid);
+	p = wa_nan_put_dec(p, pin->generation, 1);
+	*p++ = '\n';
+	*p = 0;
+	return (int)(p - buf);
+}
+
+/* ------------------------------------------------------------------------- */
+/* Pairing bootstrap request (subscriber -> publisher follow-up SDF)          */
+/* ------------------------------------------------------------------------- */
+
+struct wa_nan_txt_view {
+	const u8 *value;
+	u16 len;
+};
+
+struct wa_nan_bootstrap_req {
+	u8 a1[6];		/* publisher NMI */
+	u8 a2[6];		/* subscriber NMI */
+	u8 a3[6];		/* cluster */
+	u8 dialog_token;
+	u8 type;
+	u8 status;
+	u8 reason;
+	u16 method_bitmap;
+	u8 service_id[6];
+	u8 sda_instance;
+	u8 sda_requestor_instance;
+	u8 sda_control;
+	u8 has_sdea;
+	u8 sdea_instance;
+	u16 sdea_control;
+	const u8 *ssi;
+	u16 ssi_len;
+	u8 has_dcea;
+	u8 dcea_len;
+	u16 dcea_cap;
+	u8 has_txt;
+	struct wa_nan_txt_view vendor_name;
+	struct wa_nan_txt_view model_name;
+	struct wa_nan_txt_view pairing_name;
+	const u8 *cookie;
+	u8 cookie_len;
+	u16 comeback_after;
+	u16 unknown_attrs;
+};
+
+static inline u16 wa_nan_get_le16(const u8 *p)
+{
+	return (u16)(p[0] | ((u16)p[1] << 8));
+}
+
+static inline int wa_nan_txt_find(const u8 *txt, u16 len, const char *key,
+				  struct wa_nan_txt_view *out)
+{
+	size_t klen = strlen(key);
+	u16 off = 0;
+
+	while (off < len) {
+		u8 l = txt[off];
+
+		if (l == 0 || l > len - off - 1)
+			return -EMSGSIZE;
+		if (l > klen && memcmp(txt + off + 1, key, klen) == 0 &&
+		    txt[off + 1 + klen] == '=') {
+			out->value = txt + off + 1 + klen + 1;
+			out->len = l - klen - 1;
+			return 0;
+		}
+		off += 1 + l;
+	}
+	return -ENOENT;
+}
+
+static inline int wa_nan_ssi_parse(const u8 *ssi, u16 len,
+				   struct wa_nan_bootstrap_req *out)
+{
+	u16 off = 0;
+
+	out->ssi = ssi;
+	out->ssi_len = len;
+	while (off < len) {
+		u8 sid;
+		u16 slen;
+
+		if (len - off < 3)
+			return -EMSGSIZE;
+		sid = ssi[off];
+		slen = wa_nan_get_le16(ssi + off + 1);
+		if (slen > len - off - 3)
+			return -EMSGSIZE;
+		if (sid == 4) {
+			const u8 *txt = ssi + off + 3;
+			int ret;
+
+			if (out->has_txt)
+				return -EINVAL;
+			out->has_txt = 1;
+			ret = wa_nan_txt_find(txt, slen, "vendorName",
+					      &out->vendor_name);
+			if (ret == -EMSGSIZE)
+				return ret;
+			ret = wa_nan_txt_find(txt, slen, "modelName",
+					      &out->model_name);
+			if (ret == -EMSGSIZE)
+				return ret;
+			ret = wa_nan_txt_find(txt, slen, "pairingName",
+					      &out->pairing_name);
+			if (ret == -EMSGSIZE)
+				return ret;
+			/* Missing keys are reported by the policy check. */
+		}
+		off += 3 + slen;
+	}
+	return 0;
+}
+
+static inline int wa_nan_sda_skip_optional(const u8 *v, u16 alen, u16 *off)
+{
+	u8 ctrl = v[8];
+
+	if (ctrl & 0x40) {	/* Binding Bitmap */
+		if (alen - *off < 2)
+			return -EMSGSIZE;
+		*off += 2;
+	}
+	if (ctrl & 0x04) {	/* Matching Filter */
+		u8 l;
+
+		if (alen - *off < 1)
+			return -EMSGSIZE;
+		l = v[*off];
+		if (alen - *off - 1 < l)
+			return -EMSGSIZE;
+		*off += 1 + l;
+	}
+	if (ctrl & 0x08) {	/* Service Response Filter */
+		u8 l;
+
+		if (alen - *off < 1)
+			return -EMSGSIZE;
+		l = v[*off];
+		if (alen - *off - 1 < l)
+			return -EMSGSIZE;
+		*off += 1 + l;
+	}
+	if (ctrl & 0x10) {	/* Service Info */
+		u8 l;
+
+		if (alen - *off < 1)
+			return -EMSGSIZE;
+		l = v[*off];
+		if (alen - *off - 1 < l)
+			return -EMSGSIZE;
+		*off += 1 + l;
+	}
+	return 0;
+}
+
+/*
+ * Parse a complete 802.11 Public Action frame carrying a pairing bootstrap
+ * request. Returns 0 on a structurally valid request, -EPROTO for a non-NAN
+ * or non-bootstrap frame, -EMSGSIZE for truncated attributes, -EINVAL for a
+ * duplicate or malformed known attribute, -ENOENT when SDA or NPBA is absent.
+ */
+static inline int wa_nan_bootstrap_parse(const u8 *frame, size_t len,
+					 struct wa_nan_bootstrap_req *out)
+{
+	static const u8 vendor_type[4] = {0x50, 0x6f, 0x9a, 0x13};
+	u8 seen_sda = 0, seen_sdea = 0, seen_dcea = 0, seen_npba = 0;
+	u16 off;
+
+	if (!frame || !out)
+		return -EINVAL;
+	memset(out, 0, sizeof(*out));
+	if (len < WA_NAN_SDF_FRAME_MIN_LEN + 3 + 9 + 3 + 5)
+		return -EMSGSIZE;
+	if (frame[0] != 0xd0 || frame[1] != 0x00)
+		return -EPROTO;
+	if (frame[24] != 0x04 || frame[25] != 0x09 ||
+	    memcmp(frame + 26, vendor_type, 4) != 0)
+		return -EPROTO;
+	memcpy(out->a1, frame + 4, 6);
+	memcpy(out->a2, frame + 10, 6);
+	memcpy(out->a3, frame + 16, 6);
+
+	off = WA_NAN_SDF_HDR_LEN + WA_NAN_SDF_ACTION_LEN;
+	while (off < len) {
+		u8 aid;
+		u16 alen;
+		const u8 *v;
+
+		if (len - off < 3)
+			return -EMSGSIZE;
+		aid = frame[off];
+		alen = wa_nan_get_le16(frame + off + 1);
+		if (alen > len - off - 3)
+			return -EMSGSIZE;
+		v = frame + off + 3;
+		switch (aid) {
+		case WA_NAN_ATTR_SDA: {
+			u16 sda_off = 9;
+			int ret;
+
+			if (seen_sda++)
+				return -EINVAL;
+			if (alen < 9)
+				return -EMSGSIZE;
+			memcpy(out->service_id, v, 6);
+			out->sda_instance = v[6];
+			out->sda_requestor_instance = v[7];
+			out->sda_control = v[8];
+			if ((out->sda_control & WA_NAN_SRV_CTRL_TYPE_MASK) !=
+			    WA_NAN_SRV_CTRL_FOLLOW_UP)
+				return -EPROTO;
+			ret = wa_nan_sda_skip_optional(v, alen, &sda_off);
+			if (ret || sda_off != alen)
+				return -EMSGSIZE;
+			break;
+		}
+		case WA_NAN_ATTR_SDEA: {
+			u16 si_len;
+
+			if (seen_sdea++)
+				return -EINVAL;
+			if (alen < 5)
+				return -EMSGSIZE;
+			out->has_sdea = 1;
+			out->sdea_instance = v[0];
+			out->sdea_control = wa_nan_get_le16(v + 1);
+			si_len = wa_nan_get_le16(v + 3);
+			if (si_len > alen - 5)
+				return -EMSGSIZE;
+			if (si_len >= 4 && memcmp(v + 5, "\x50\x6f\x9a", 3) == 0) {
+				int ret = wa_nan_ssi_parse(v + 9, si_len - 4, out);
+
+				if (ret)
+					return ret;
+			}
+			break;
+		}
+		case WA_NAN_ATTR_DCEA:
+			if (seen_dcea++)
+				return -EINVAL;
+			if (alen < 1)
+				return -EMSGSIZE;
+			out->has_dcea = 1;
+			out->dcea_len = alen > 0xff ? 0xff : (u8)alen;
+			out->dcea_cap = alen >= 2 ? wa_nan_get_le16(v) : v[0];
+			break;
+		case WA_NAN_ATTR_NPBA: {
+			u16 npba_off = 3;
+
+			if (seen_npba++)
+				return -EINVAL;
+			if (alen < 5)
+				return -EMSGSIZE;
+			out->dialog_token = v[0];
+			out->type = v[1] & 0x0f;
+			out->status = (v[1] >> 4) & 0x0f;
+			out->reason = v[2];
+			if (out->status == WA_NAN_NPBA_STATUS_COMEBACK) {
+				if (out->type == WA_NAN_NPBA_TYPE_RESPONSE) {
+					if (alen - npba_off < 2)
+						return -EMSGSIZE;
+					out->comeback_after =
+						wa_nan_get_le16(v + npba_off);
+					npba_off += 2;
+				}
+				if (alen - npba_off < 1)
+					return -EMSGSIZE;
+				out->cookie_len = v[npba_off++];
+				if (out->cookie_len > alen - npba_off)
+					return -EMSGSIZE;
+				out->cookie = v + npba_off;
+				npba_off += out->cookie_len;
+			}
+			if (alen - npba_off != 2)
+				return -EMSGSIZE;
+			out->method_bitmap = wa_nan_get_le16(v + npba_off);
+			break;
+		}
+		default:
+			out->unknown_attrs++;
+			break;
+		}
+		off += 3 + alen;
+	}
+	if (off != len)
+		return -EMSGSIZE;
+	if (!seen_sda || !seen_npba)
+		return -ENOENT;
+	return 0;
+}
+
+/*
+ * Apple section 56.3 request policy: keypad PIN method, DCEA with NPK/NIK
+ * caching, and an SDEA/SSI TXT record with all three device fields. Returns 0
+ * when the request can be answered, or a negative errno with the first
+ * missing/invalid item.
+ */
+static inline int wa_nan_bootstrap_validate(const struct wa_nan_bootstrap_req *req,
+					    const u8 expected_service_id[6],
+					    u8 publish_instance)
+{
+	if (!req)
+		return -EINVAL;
+	if (expected_service_id &&
+	    memcmp(req->service_id, expected_service_id, 6) != 0)
+		return -ENOENT;
+	if (req->type != WA_NAN_NPBA_TYPE_REQUEST)
+		return -EPROTO;
+	if (req->status != WA_NAN_NPBA_STATUS_ACCEPTED)
+		return -EPROTO;
+	if (!(req->method_bitmap & WA_NAN_NPBA_METHOD_PIN_KEYPAD))
+		return -EPROTO;
+	if (publish_instance && req->sda_requestor_instance != publish_instance)
+		return -EPROTO;
+	if (!req->has_dcea ||
+	    !(req->dcea_cap & WA_NAN_DCEA_NPK_NIK_CACHING))
+		return -ENOENT;
+	if (!req->has_sdea || !req->has_txt)
+		return -ENOENT;
+	if (!req->vendor_name.len || !req->model_name.len ||
+	    !req->pairing_name.len)
+		return -ENOENT;
+	return 0;
+}
+
+/*
+ * Bootstrap methods are complementary: the subscriber advertises keypad (b5)
+ * and the publisher answers with PIN display (b1). Wi-Fi Aware v4.0 section
+ * 7.6.4.1 requires the response method to match the selected method; the
+ * complement mapping follows wpa_supplicant 2.12 nan_complement_pbm().
+ */
+static inline u16 wa_nan_bootstrap_complement_method(u16 method)
+{
+	if (method & WA_NAN_NPBA_METHOD_PIN_KEYPAD)
+		return WA_NAN_NPBA_METHOD_PIN_DISPLAY;
+	if (method & WA_NAN_NPBA_METHOD_PIN_DISPLAY)
+		return WA_NAN_NPBA_METHOD_PIN_KEYPAD;
+	return 0;
+}
+
+/* 24 B header + 6 B action prefix + SDA + SDEA + NPBA. */
+#define WA_NAN_BOOTSTRAP_RSP_LEN \
+	(WA_NAN_SDF_HDR_LEN + WA_NAN_SDF_ACTION_LEN + \
+	 WA_NAN_SDF_SDA_LEN + WA_NAN_SDF_SDEA_LEN + WA_NAN_SDF_NPBA_LEN)
+
+struct wa_nan_bootstrap_rsp_params {
+	const u8 *nmi;		/* publisher NMI, the A2 address */
+	u8 instance_id;		/* publisher publish ID */
+	u8 status;		/* 0 accepted, 1 rejected */
+	u8 reason;
+	u16 method_bitmap;	/* 0 derives the complement of the request */
+};
+
+/*
+ * Build the bootstrap response follow-up SDF. A1 is the requesting NMI, A2 is
+ * the publisher NMI, A3 is copied from the request follow-up (Wi-Fi Aware v4.0
+ * Table 5). The NPBA echoes the dialog token and either accepts or rejects.
+ */
+static inline int wa_nan_bootstrap_build_response(
+	u8 *frame, size_t cap, const struct wa_nan_bootstrap_req *req,
+	const struct wa_nan_bootstrap_rsp_params *rsp)
+{
+	static const u8 vendor_type[4] = {0x50, 0x6f, 0x9a, 0x13};
+	static const u8 service_oui_proto[4] = {0x50, 0x6f, 0x9a, 0x02};
+	u16 method;
+	u16 len;
+	u8 *p;
+
+	if (!frame || !req || !rsp || !rsp->nmi || !rsp->instance_id)
+		return -EINVAL;
+	if (rsp->status > WA_NAN_NPBA_STATUS_REJECTED)
+		return -EOPNOTSUPP;
+	method = rsp->method_bitmap ? rsp->method_bitmap :
+				      wa_nan_bootstrap_complement_method(
+					      req->method_bitmap);
+	if (rsp->status == WA_NAN_NPBA_STATUS_ACCEPTED && !method)
+		return -EPROTO;
+	if (rsp->status != WA_NAN_NPBA_STATUS_ACCEPTED)
+		method = 0;	/* ignored for a rejection or comeback */
+	if (cap < WA_NAN_BOOTSTRAP_RSP_LEN)
+		return -ENOSPC;
+
+	memset(frame, 0, WA_NAN_BOOTSTRAP_RSP_LEN);
+	frame[0] = 0xd0;
+	frame[1] = 0x00;
+	memcpy(frame + 4, req->a2, 6);
+	memcpy(frame + 10, rsp->nmi, 6);
+	memcpy(frame + 16, req->a3, 6);
+	p = frame + WA_NAN_SDF_HDR_LEN;
+	*p++ = 0x04;
+	*p++ = 0x09;
+	memcpy(p, vendor_type, 4);
+	p += 4;
+
+	/* SDA: follow-up, requestor instance is the subscriber's instance. */
+	p = wa_nan_sdf_put_attr(p, WA_NAN_ATTR_SDA, 9);
+	memcpy(p, req->service_id, 6);
+	p += 6;
+	*p++ = rsp->instance_id;
+	*p++ = req->sda_instance;
+	*p++ = WA_NAN_SRV_CTRL_FOLLOW_UP;
+
+	/* SDEA: same fixed SSI as the publish SDF, no optional fields. */
+	p = wa_nan_sdf_put_attr(p, WA_NAN_ATTR_SDEA,
+				WA_NAN_SDF_SDEA_BODY_LEN);
+	*p++ = rsp->instance_id;
+	*p++ = 0;
+	*p++ = 0;
+	len = 4 + WA_NAN_SDF_SSI_LEN;
+	*p++ = len & 0xff;
+	*p++ = len >> 8;
+	memcpy(p, service_oui_proto, 4);
+	p += 4;
+	p = wa_nan_sdf_put_ssi(p, WA_NAN_PAIRING_TXT_NAME);
+
+	/* NPBA response: echo the dialog token and the selected method pair. */
+	p = wa_nan_sdf_put_attr(p, WA_NAN_ATTR_NPBA, 5);
+	*p++ = req->dialog_token;
+	*p++ = WA_NAN_NPBA_TYPE_RESPONSE |
+	       (rsp->status << 4);
+	*p++ = rsp->reason;
+	*p++ = method & 0xff;
+	*p++ = method >> 8;
+
+	return (int)(p - frame);
+}
+
+#endif /* WA_NAN_PAIRING_H */
