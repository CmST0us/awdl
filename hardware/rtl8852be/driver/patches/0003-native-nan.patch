+/* SPDX-License-Identifier: GPL-2.0 */
+/* M5-A2: self-contained SHA-256 and HMAC-SHA-256 for the offline NIRA tag.
+ *
+ * NIRA tag generation is a single 17-byte HMAC, called once per publish SDF
+ * rebuild. Keeping it in a small, allocation-free helper avoids tying the NAN
+ * pairing builder to crypto_shash setup on the probe path. The implementation
+ * is checked against the FIPS 180-4 and RFC 4231 vectors in
+ * test_nan_sha256.py.
+ */
+#ifndef WA_NAN_SHA256_H
+#define WA_NAN_SHA256_H
+
+#include <linux/types.h>
+#include <linux/string.h>
+
+#define WA_SHA256_BLOCK_LEN	64
+#define WA_SHA256_DIGEST_LEN	32
+
+struct wa_sha256_ctx {
+	u32 h[8];
+	u64 total;
+	u8 buf[WA_SHA256_BLOCK_LEN];
+	size_t used;
+};
+
+static inline u32 wa_sha256_rotr(u32 x, unsigned int n)
+{
+	return (x >> n) | (x << (32 - n));
+}
+
+static inline u32 wa_sha256_be32(const u8 *p)
+{
+	return ((u32)p[0] << 24) | ((u32)p[1] << 16) |
+	       ((u32)p[2] << 8) | (u32)p[3];
+}
+
+static inline void wa_sha256_put_be32(u8 *p, u32 v)
+{
+	p[0] = v >> 24;
+	p[1] = v >> 16;
+	p[2] = v >> 8;
+	p[3] = v;
+}
+
+static inline void wa_sha256_init(struct wa_sha256_ctx *c)
+{
+	static const u32 iv[8] = {
+		0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
+		0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
+	};
+
+	memcpy(c->h, iv, sizeof(iv));
+	c->total = 0;
+	c->used = 0;
+}
+
+static inline void wa_sha256_block(struct wa_sha256_ctx *c, const u8 *p)
+{
+	static const u32 k[64] = {
+		0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
+		0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
+		0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
+		0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
+		0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
+		0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+		0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
+		0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
+		0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
+		0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
+		0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
+		0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+		0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
+		0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
+		0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
+		0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
+	};
+	u32 w[64];
+	u32 a, b, cc, d, e, f, g, h, t1, t2, s0, s1;
+	unsigned int i;
+
+	for (i = 0; i < 16; i++)
+		w[i] = wa_sha256_be32(p + 4 * i);
+	for (i = 16; i < 64; i++) {
+		s0 = wa_sha256_rotr(w[i - 15], 7) ^
+		     wa_sha256_rotr(w[i - 15], 18) ^ (w[i - 15] >> 3);
+		s1 = wa_sha256_rotr(w[i - 2], 17) ^
+		     wa_sha256_rotr(w[i - 2], 19) ^ (w[i - 2] >> 10);
+		w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+	}
+
+	a = c->h[0];
+	b = c->h[1];
+	cc = c->h[2];
+	d = c->h[3];
+	e = c->h[4];
+	f = c->h[5];
+	g = c->h[6];
+	h = c->h[7];
+
+	for (i = 0; i < 64; i++) {
+		s1 = wa_sha256_rotr(e, 6) ^ wa_sha256_rotr(e, 11) ^
+		     wa_sha256_rotr(e, 25);
+		t1 = h + s1 + ((e & f) ^ (~e & g)) + k[i] + w[i];
+		s0 = wa_sha256_rotr(a, 2) ^ wa_sha256_rotr(a, 13) ^
+		     wa_sha256_rotr(a, 22);
+		t2 = s0 + ((a & b) ^ (a & cc) ^ (b & cc));
+		h = g;
+		g = f;
+		f = e;
+		e = d + t1;
+		d = cc;
+		cc = b;
+		b = a;
+		a = t1 + t2;
+	}
+
+	c->h[0] += a;
+	c->h[1] += b;
+	c->h[2] += cc;
+	c->h[3] += d;
+	c->h[4] += e;
+	c->h[5] += f;
+	c->h[6] += g;
+	c->h[7] += h;
+}
+
+static inline void wa_sha256_update(struct wa_sha256_ctx *c, const u8 *data,
+				    size_t len)
+{
+	size_t left = WA_SHA256_BLOCK_LEN - c->used;
+	size_t take;
+
+	c->total += len;
+	while (len) {
+		take = len < left ? len : left;
+		memcpy(c->buf + c->used, data, take);
+		c->used += take;
+		data += take;
+		len -= take;
+		if (c->used == WA_SHA256_BLOCK_LEN) {
+			wa_sha256_block(c, c->buf);
+			c->used = 0;
+			left = WA_SHA256_BLOCK_LEN;
+		} else {
+			left = WA_SHA256_BLOCK_LEN - c->used;
+		}
+	}
+}
+
+static inline void wa_sha256_final(struct wa_sha256_ctx *c, u8 out[32])
+{
+	u64 bits = c->total * 8;
+	unsigned int i;
+
+	c->buf[c->used++] = 0x80;
+	if (c->used > 56) {
+		memset(c->buf + c->used, 0, WA_SHA256_BLOCK_LEN - c->used);
+		wa_sha256_block(c, c->buf);
+		c->used = 0;
+	}
+	memset(c->buf + c->used, 0, 56 - c->used);
+	wa_sha256_put_be32(c->buf + 56, (u32)(bits >> 32));
+	wa_sha256_put_be32(c->buf + 60, (u32)bits);
+	wa_sha256_block(c, c->buf);
+
+	for (i = 0; i < 8; i++)
+		wa_sha256_put_be32(out + 4 * i, c->h[i]);
+	memset(c, 0, sizeof(*c));
+}
+
+static inline void wa_sha256(const u8 *data, size_t len, u8 out[32])
+{
+	struct wa_sha256_ctx c;
+
+	wa_sha256_init(&c);
+	wa_sha256_update(&c, data, len);
+	wa_sha256_final(&c, out);
+}
+
+static inline void wa_hmac_sha256(const u8 *key, size_t key_len,
+				  const u8 *data, size_t len, u8 out[32])
+{
+	struct wa_sha256_ctx c;
+	u8 pad[WA_SHA256_BLOCK_LEN];
+	u8 inner[WA_SHA256_DIGEST_LEN];
+	u8 kh[WA_SHA256_DIGEST_LEN];
+	const u8 *k = key;
+	size_t klen = key_len;
+	unsigned int i;
+
+	if (klen > WA_SHA256_BLOCK_LEN) {
+		wa_sha256(key, key_len, kh);
+		k = kh;
+		klen = WA_SHA256_DIGEST_LEN;
+	}
+
+	for (i = 0; i < WA_SHA256_BLOCK_LEN; i++)
+		pad[i] = (i < klen ? k[i] : 0) ^ 0x36;
+	wa_sha256_init(&c);
+	wa_sha256_update(&c, pad, sizeof(pad));
+	wa_sha256_update(&c, data, len);
+	wa_sha256_final(&c, inner);
+
+	for (i = 0; i < WA_SHA256_BLOCK_LEN; i++)
+		pad[i] = (i < klen ? k[i] : 0) ^ 0x5c;
+	wa_sha256_init(&c);
+	wa_sha256_update(&c, pad, sizeof(pad));
+	wa_sha256_update(&c, inner, sizeof(inner));
+	wa_sha256_final(&c, out);
+
+	memset(pad, 0, sizeof(pad));
+	memset(inner, 0, sizeof(inner));
+}
+
+#endif /* WA_NAN_SHA256_H */
