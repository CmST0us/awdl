+/* Observe native host-delivered BlockAck frames without changing RX ownership. */
+static void wa_nan_rx_ba_trace(struct phl_info_t *phl,
+                              struct rtw_phl_rx_pkt *pkt)
+{
+ unsigned long flags;
+ const u8 *f;
+ struct rtw_phl_stainfo_t *sta;
+ u32 length, seen;
+ u64 observed_ns;
+ u16 control;
+ if (!READ_ONCE(phl->wa_nan_radio_owned) || !pkt->r.pkt_cnt)
+  return;
+ pr_info_once("WA_NAN_BA_ROUTE control=%08x\n",
+              rtw_hal_read32(phl->hal, 0xce24));
+ f = pkt->r.pkt_list[0].vir_addr;
+ length = pkt->r.pkt_list[0].length;
+ if (!f || length < 20 || f[0] != 0x94)
+  return;
+ sta = rtw_phl_get_stainfo_by_addr_ex(phl, (u8 *)f + 10);
+ if (!sta || !sta->wrole || sta->wrole->type != PHL_RTYPE_NAN ||
+     !sta->rlink || memcmp(f + 4, sta->rlink->mac_addr, 6))
+  return;
+ control = get_unaligned_le16(f + 16);
+ observed_ns = ktime_get_ns();
+ if (!pkt->r.mdata.crc32 && length==28 && (control&6)==4)
+  rtw_phl_wa_nan_tx_ba_observe(sta,control>>12,
+      get_unaligned_le16(f+18)>>4,get_unaligned_le32(f+20),
+      get_unaligned_le32(f+24),observed_ns);
+ spin_lock_irqsave(&wa_nan_ba_observed_lock, flags);
+ seen = ++wa_nan_ba_observed.count;
+ if (pkt->r.mdata.crc32) {
+  wa_nan_ba_observed.bad_crc++;
+ } else if (length == 28 && (control & 6) == 4) {
+  wa_nan_ba_observed.good++;
+  wa_nan_ba_observed.last_ns = observed_ns;
+  wa_nan_ba_observed.macid = sta->macid;
+  wa_nan_ba_observed.control = control;
+  wa_nan_ba_observed.ssn = get_unaligned_le16(f + 18) >> 4;
+  wa_nan_ba_observed.bitmap_high = get_unaligned_le32(f + 24);
+  wa_nan_ba_observed.bitmap_low = get_unaligned_le32(f + 20);
+ } else {
+  wa_nan_ba_observed.other++;
+ }
+ spin_unlock_irqrestore(&wa_nan_ba_observed_lock, flags);
+ if ((seen & 63) != 1)
+  return;
