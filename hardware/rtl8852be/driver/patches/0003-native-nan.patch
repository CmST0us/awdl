+void rtw_hal_wa_nan_bcn_snapshot(void *hal, const struct wa_nan_h2c_plan *plan,
+				 u64 op, const char *phase)
+{
+	struct hal_info_t *info = (struct hal_info_t *)hal;
+	struct mac_ax_adapter *mac = info->mac;
+	struct mac_ax_port_tsf tsf = {0};
+	int tsf_ret = MACPROCERR;
+	u32 c2h_total = 0, c2h_nan = 0, c2h_drop = 0, c2h_done_ack = 0;
+
+	if (!mac) {
+		pr_info("WA_PROBE nan-bcn-snapshot phase=%s op=%llu available=0 reason=no-mac\n",
+			phase, (unsigned long long)op);
+		return;
+	}
+	{
+		struct mac_ax_adapter *adapter = mac;
+		struct mac_ax_intf_ops *ops = adapter_to_intf_ops(adapter);
+		pr_info("WA_PROBE nan-bcn-reg phase=%s dw_port=%u disc_port=%u dw_cfg=%08x disc_cfg=%08x sleep=%08x pause=%08x txen=%08x\n",
+			phase, plan->port[0], plan->port[1],
+			MAC_REG_R32(R_AX_PORT_CFG_P0 + plan->port[0] * PORT_CFG_OFFSET),
+			MAC_REG_R32(R_AX_PORT_CFG_P0 + plan->port[1] * PORT_CFG_OFFSET),
+			MAC_REG_R32(R_AX_MACID_SLEEP_0), MAC_REG_R32(R_AX_SS_MACID_PAUSE_0),
+			MAC_REG_R32(R_AX_CTN_TXEN));
+	}
+	tsf.port = plan->port[0];
+	tsf_ret = mac_get_tsf(mac, &tsf);
+	mac_get_wa_c2h_counters(&c2h_total, &c2h_nan, &c2h_drop, &c2h_done_ack);
+	pr_info("WA_PROBE nan-bcn-snapshot phase=%s op=%llu port=0 tsf_result=%d tsf=%llu c2h_total=%u c2h_nan=%u c2h_drop=%u c2h_done_ack=%u\n",
+		phase, (unsigned long long)op, tsf_ret,
+		(unsigned long long)(tsf_ret == MACSUCCESS ?
+			(((u64)tsf.tsf_h << 32) | tsf.tsf_l) : 0),
+		(unsigned int)c2h_total, (unsigned int)c2h_nan,
+		(unsigned int)c2h_drop, (unsigned int)c2h_done_ack);
+}
