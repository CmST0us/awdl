@@ -0,0 +1,51 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef WA_NAN_DATA_CCMP_H
+#define WA_NAN_DATA_CCMP_H
+
+/* Three-address NDP data. QoS A-MSDUs are parsed only after CCMP verification. */
+static int wa_data_header(const u8 *f, size_t n)
+{
+ if (n < 24 || (f[0] != 0x08 && f[0] != 0x88) ||
+     (f[1] & 0x87) || (f[22] & 15)) return -EINVAL;
+ if (f[0] == 0x88) {
+  if (n < 26 || f[25]) return -EOPNOTSUPP;
+  return 26;
+ }
+ return 24;
+}
+static void wa_data_aad(const u8 *f, int header, u8 aad[24], u8 nonce[13])
+{
+ const u8 *iv = f + header;
+ aad[0] = f[0] & 0x8f;
+ aad[1] = (f[1] & 0xc7) | 0x40;
+ memcpy(aad + 2, f + 4, 18);
+ aad[20] = f[22] & 15; aad[21] = 0;
+ aad[22] = header == 26 ? f[24] & 15 : 0; aad[23] = 0;
+ nonce[0] = aad[22];
+ memcpy(nonce + 1, f + 10, 6);
+ nonce[7] = iv[7]; nonce[8] = iv[6]; nonce[9] = iv[5];
+ nonce[10] = iv[4]; nonce[11] = iv[1]; nonce[12] = iv[0];
+}
+static int wa_data_decrypt(const u8 *key, const u8 *f, size_t n,
+                          bool hw_plain, u8 *plain, u8 *scratch)
+{
+ u8 aad[24], nonce[13], mic[8], diff = 0;
+ int h = wa_data_header(f, n), ret;
+ size_t payload, i;
+ if (h < 0) return h;
+ if (n < h + 16 || !(f[1] & 0x40) || f[h+2] ||
+     (f[h+3] & 0x3f) != 0x20 || !wa_ccmp_pn(f+h)) return -EINVAL;
+ payload = n - h - 16;
+ wa_data_aad(f, h, aad, nonce);
+ if (hw_plain) {
+  ret = aes_ccm_ae(key, 16, nonce, 8, f+h+8, payload,
+                   aad, h-2, scratch, mic);
+  if (ret) return -EIO;
+  for (i=0; i<8; i++) diff |= mic[i] ^ f[n-8+i];
+  if (diff) return -EBADMSG;
+  memcpy(plain, f+h+8, payload);
+ } else if (aes_ccm_ad(key, 16, nonce, 8, f+h+8, payload,
+                       aad, h-2, f+n-8, plain)) return -EBADMSG;
+ return payload;
+}
+#endif
