+/* SPDX-License-Identifier: GPL-2.0 */
+#include <linux/ktime.h>
+
+/* Attribute a NAN SU PHY report to its transmitter rather than the NMI CAM. */
+struct rtw_phl_stainfo_t *rtw_phl_get_stainfo_by_addr_ex(void *phl, u8 *addr);
+
+static bool wa_nan_phy_peer(struct rtw_phl_com_t *phl,
+                            struct rtw_r_meta_data *meta,
+                            struct physts_rxd *desc)
+{
+ struct rtw_phl_ppdu_sts_info *ppdu=&phl->ppdu_sts_info;
+ unsigned int band=meta->bb_sel ? HW_BAND_1 : HW_BAND_0;
+ struct rtw_phl_ppdu_sts_ent *entry=&ppdu->sts_ent[band][meta->ppdu_cnt];
+ struct rtw_phl_stainfo_t *sta;
+ static unsigned long long reports, rejected[8], accepted;
+ static unsigned long long not_self_peer, not_self_other, not_self_unmatched;
+ static u64 reported_ns;
+ unsigned int reason = 0;
+ u64 now;
+ /* Each report has one first rejection reason; no packet policy changes. */
+ if (!desc->is_su || desc->user_num != 1) reason = 1;
+ else if (!desc->is_to_self) reason = 2;
+ else if (!desc->user_i[0].is_data) reason = 3;
+ else if (meta->crc32 || entry->crc32) reason = 4;
+ else if (entry->valid) reason = 5;
+ else if (ppdu->cur_rx_ppdu_cnt[band] != meta->ppdu_cnt ||
+          entry->rx_rate != meta->rx_rate ||
+          entry->ppdu_type != meta->ppdu_type) reason = 6;
+ sta = NULL;
+ if (!reason) {
+  sta=rtw_phl_get_stainfo_by_addr_ex(phl->phl_priv,entry->src_mac_addr);
+  if (!sta || !sta->wrole || sta->wrole->type!=PHL_RTYPE_NAN || !sta->hal_sta ||
+      !sta->hal_sta->ra_info.ra_registered) reason = 7;
+ }
+ if (reason == 2) {
+  if (desc->user_i[0].is_data && !meta->crc32 && !entry->crc32 &&
+      !entry->valid && ppdu->cur_rx_ppdu_cnt[band] == meta->ppdu_cnt &&
+      entry->rx_rate == meta->rx_rate && entry->ppdu_type == meta->ppdu_type) {
+   struct rtw_phl_stainfo_t *source =
+    rtw_phl_get_stainfo_by_addr_ex(phl->phl_priv, entry->src_mac_addr);
+   if (source && source->wrole && source->wrole->type == PHL_RTYPE_NAN &&
+       source->hal_sta && source->hal_sta->ra_info.ra_registered)
+    not_self_peer++;
+   else not_self_other++;
+  } else not_self_unmatched++;
+ }
+ reports++;
+ if (reason) rejected[reason]++;
+ else accepted++;
+ now = ktime_get_ns();
+ if (now - reported_ns >= 250000000) {
+  reported_ns = now;
+  pr_info("WA_PROBE ndi-phy-attribution reports=%llu accepted=%llu shape=%llu not_self=%llu not_data=%llu crc=%llu duplicate=%llu mismatch=%llu not_peer=%llu not_self_peer=%llu not_self_other=%llu not_self_unmatched=%llu\n",
+          reports, accepted, rejected[1], rejected[2], rejected[3],
+          rejected[4], rejected[5], rejected[6], rejected[7],
+          not_self_peer, not_self_other, not_self_unmatched);
+ }
+ if (reason) return false;
+ desc->macid_su=sta->macid;
+ desc->user_i[0].macid=sta->macid;
+ return true;
+}
+
+/* Count peer PPDU widths; report active bands at most four times per second. */
+static void wa_nan_phy_channel(const struct physts_rxd *desc,
+                               const struct physts_result *rpt)
+{
+ static u8 seen[2][3];
+ static unsigned long long count[2][3];
+ static u64 reported_ns[2][3];
+ u64 now;
+ if (!rpt->physts_rpt_valid || rpt->band>1 || rpt->rx_bw>2 || !rpt->ch_idx)
+  return;
+ count[rpt->band][rpt->rx_bw]++;
+ now=ktime_get_ns();
+ if (seen[rpt->band][rpt->rx_bw]==rpt->ch_idx &&
+     now-reported_ns[rpt->band][rpt->rx_bw]<250000000) return;
+ seen[rpt->band][rpt->rx_bw]=rpt->ch_idx;
+ reported_ns[rpt->band][rpt->rx_bw]=now;
+ pr_info("WA_PROBE ndi-phy-channel macid=%u band=%u channel=%u width=%u rxsc=%u rate=%u counts=%llu/%llu/%llu/%llu/%llu/%llu\n",
+         desc->macid_su,rpt->band,rpt->ch_idx,20U<<rpt->rx_bw,rpt->rxsc,desc->data_rate,
+         count[0][0],count[0][1],count[0][2],count[1][0],count[1][1],count[1][2]);
+}
