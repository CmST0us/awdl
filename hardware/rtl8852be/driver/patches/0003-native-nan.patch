+int rtw_hal_wa_nan_sdf_wait_ack(void *hal, u8 func, u32 timeout_ms)
+{
+	(void)hal;
+	return mac_wait_wa_nan_done_ack(func, timeout_ms);
+}
+
+int rtw_hal_wa_nan_sdf_tsf_ready(void *hal, const struct wa_nan_h2c_plan *plan)
+{
+	struct hal_info_t *info = (struct hal_info_t *)hal;
+	struct mac_ax_port_tsf a = {0}, b = {0};
+	u64 ta, tb;
+
+	if (!info || !info->mac || !plan)
+		return -EINVAL;
+	a.port = b.port = plan->port[0];
+	if (mac_get_tsf(info->mac, &a) != MACSUCCESS ||
+	    mac_get_tsf(info->mac, &b) != MACSUCCESS)
+		return -EIO;
+	ta = ((u64)a.tsf_h << 32) | a.tsf_l;
+	tb = ((u64)b.tsf_h << 32) | b.tsf_l;
+	return tb >= ta ? 0 : -EIO;
+}
+
+int rtw_hal_wa_nan_sdf_tx(void *hal, const struct wa_nan_h2c_plan *plan,
+			  const u8 *frame, u16 len, u64 *cookie)
+{
+	struct hal_info_t *info = (struct hal_info_t *)hal;
+	void *phl;
+	int ret;
+
+	if (!info || !info->phl_com || !plan || !frame || !cookie)
+		return -EINVAL;
+	if (len < 30 || len > 700)
+		return -EINVAL;
+	if (frame[0] != 0xd0 || frame[1] != 0x00 ||
+	    frame[24] != 0x04 || frame[25] != 0x09 ||
+	    memcmp(frame + 26, "\x50\x6f\x9a\x13", 4) != 0 ||
+	    memcmp(frame + 10, plan->nmi, 6) != 0 ||
+	    memcmp(frame + 16, plan->cluster, 6) != 0)
+		return -EINVAL;
+	phl = info->phl_com->phl_priv;
+	rtw_phl_wa_nan_sdf_set_macid(plan->macid_mgn);
+	ret = rtw_phl_wa_nan_sdf_tx(phl, frame, len, cookie);
+	pr_info("WA_PROBE sdf-hal-submit result=%d len=%u macid=%u port=%u channel=6 rate=6 retry=0 cookie=%llu\n",
+		ret, (unsigned int)len, (unsigned int)plan->macid_mgn,
+		(unsigned int)plan->port[0], (unsigned long long)*cookie);
+	return ret;
+}
+
+int rtw_hal_wa_nan_sdf_wait_done(void *hal, u64 cookie, u32 timeout_ms)
+{
+	struct hal_info_t *info = (struct hal_info_t *)hal;
+
+	if (!info || !info->phl_com)
+		return -EINVAL;
+	return rtw_phl_wa_nan_sdf_wait_done(info->phl_com->phl_priv, cookie,
+					    timeout_ms);
+}
