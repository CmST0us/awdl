+	u8 frame[WA_NAN_BCN_TEMPLATE_LEN];
+	u32 ret;
+
+	if (submitted)
+		*submitted = 0;
+	if (!mac || !mac->ops || !mac->ops->send_bcn_h2c)
+		return -EIO;
+	wa_nan_bcn_template_build(frame, plan->nmi, plan->cluster);
+	bcn.pld_buf = frame;
+	bcn.pld_len = WA_NAN_BCN_TEMPLATE_LEN;
+	bcn.band = band;
+	bcn.port = plan->template_port;
+	bcn.mbssid = 0;
+	bcn.macid = plan->macid_bcn;
+	ret = mac->ops->send_bcn_h2c(mac, &bcn);
+	pr_info("WA_PROBE nan-bcn-template op=%llu ns=%llu result=%u len=%u port=%u port_dw=%u template_port=%u interval=512 frame0=%02x nmi="
+		WA_NAN_ADDR_FMT " cluster=" WA_NAN_ADDR_FMT "\n",
+		(unsigned long long)ktime_get_ns(),
+		(unsigned long long)ktime_get_ns(), ret,
+		(unsigned int)WA_NAN_BCN_TEMPLATE_LEN,
+		(unsigned int)plan->template_port,
+		(unsigned int)plan->port[0],
+		(unsigned int)plan->template_port,
+		(unsigned int)frame[0],
+		WA_NAN_ADDR_ARGS(plan->nmi), WA_NAN_ADDR_ARGS(plan->cluster));
+	if (ret != MACSUCCESS)
+		return -EIO;
+	if (submitted)
+		*submitted = 1;
+	return 0;
+}
