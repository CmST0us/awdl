+/* SPDX-License-Identifier: GPL-2.0 */
+/* NAN management classification and diagnostic hand-off ring. */
+#ifndef WA_NAN_MGMT_RX_H
+#define WA_NAN_MGMT_RX_H
+
+#include <linux/types.h>
+#include <linux/string.h>
+#include <linux/errno.h>
+#include "wa_nan_uapi.h"
+
+#define WA_NAN_MGMT_RX_FRAMES		8
+#define WA_NAN_MGMT_RX_FRAME_MAX	WA_NAN_FRAME_MAX
+#define WA_NAN_MGMT_RX_FRAME_MIN	30
+
+#define WA_NAN_MGMT_RX_NAN_SDF		0x13
+#define WA_NAN_MGMT_RX_NAN_NAF		0x18
+
+struct wa_nan_mgmt_rx_frame {
+	u64 tsf;
+	u16 len;
+	u8 channel;
+	u8 rssi;
+	u8 data[WA_NAN_MGMT_RX_FRAME_MAX];
+};
+
+struct wa_nan_mgmt_rx_stats {
+	u32 matched;
+	u32 pushed;
+	u32 dropped_full;
+	u32 invalid;
+	u32 not_nan;
+};
+
+struct wa_nan_mgmt_rx_ring {
+	struct wa_nan_mgmt_rx_frame frame[WA_NAN_MGMT_RX_FRAMES];
+	u8 head;
+	u8 tail;
+	u8 count;
+	struct wa_nan_mgmt_rx_stats stats;
+};
+
+/*
+ * Classify an 802.11 management frame as SDF (1), NAF (2), PASN (3), or protected Action (4).
+ * Returns 0 for anything else, including malformed or short frames. The
+ * category may be Public Action (0x04) or Protected Dual (0x09); the latter
+ * is captured for diagnosis but is not expected during unpaired bootstrap.
+ */
+static inline int wa_nan_mgmt_rx_match(const u8 *frame, size_t len)
+{
+	if (!frame || len < WA_NAN_MGMT_RX_FRAME_MIN)
+		return 0;
+	/* Retry, power-management and protected bits do not change subtype. */
+	if (frame[0] == 0xb0 && !(frame[1] & 0x43) &&
+	    frame[24] == 7 && frame[25] == 0)
+		return 3; /* PASN Authentication */
+	if (frame[0] != 0xd0 || (frame[1] & 0x03))
+		return 0;
+	if (frame[1] & 0x40)
+		return 4; /* encrypted Action body; classify after verification */
+	if (frame[24] != 0x04 && frame[24] != 0x09)
+		return 0;
+	if (frame[25] != 0x09)
+		return 0;
+	if (memcmp(frame + 26, "\x50\x6f\x9a", 3) != 0)
+		return 0;
+	if (frame[29] == WA_NAN_MGMT_RX_NAN_SDF)
+		return 1;
+	if (frame[29] == WA_NAN_MGMT_RX_NAN_NAF)
+		return 2;
+	return 0;
+}
+
+/*
+ * Copy a matched frame into the ring. Returns the frame class (1..4) on
+ * success, -EPROTO when the frame is not NAN, -EMSGSIZE when it exceeds the
+ * copy budget, -ENOSPC when the ring is full. Never sleeps; the kernel hook
+ * calls this under its RX lock or with a per-CPU ring.
+ */
+static inline int wa_nan_mgmt_rx_push(struct wa_nan_mgmt_rx_ring *ring,
+				      const u8 *frame, size_t len, u64 tsf,
+				      u8 channel, u8 rssi)
+{
+	struct wa_nan_mgmt_rx_frame *slot;
+	int kind;
+
+	if (!ring)
+		return -EINVAL;
+	kind = wa_nan_mgmt_rx_match(frame, len);
+	if (!kind) {
+		ring->stats.not_nan++;
+		return -EPROTO;
+	}
+	ring->stats.matched++;
+	if (len > WA_NAN_MGMT_RX_FRAME_MAX) {
+		ring->stats.invalid++;
+		return -EMSGSIZE;
+	}
+	if (ring->count == WA_NAN_MGMT_RX_FRAMES) {
+		ring->stats.dropped_full++;
+		return -ENOSPC;
+	}
+	slot = &ring->frame[ring->tail];
+	slot->tsf = tsf;
+	slot->len = (u16)len;
+	slot->channel = channel;
+	slot->rssi = rssi;
+	memcpy(slot->data, frame, len);
+	ring->tail = (u8)((ring->tail + 1) % WA_NAN_MGMT_RX_FRAMES);
+	ring->count++;
+	ring->stats.pushed++;
+	return kind;
+}
+
+/* Drain the oldest frame. Returns 0, -ENODATA when empty. */
+static inline int wa_nan_mgmt_rx_pop(struct wa_nan_mgmt_rx_ring *ring,
+				     struct wa_nan_mgmt_rx_frame *out)
+{
+	if (!ring || !out)
+		return -EINVAL;
+	if (!ring->count)
+		return -ENODATA;
+	*out = ring->frame[ring->head];
+	ring->head = (u8)((ring->head + 1) % WA_NAN_MGMT_RX_FRAMES);
+	ring->count--;
+	return 0;
+}
+
+#endif /* WA_NAN_MGMT_RX_H */
