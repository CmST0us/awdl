+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef WA_NAN_IGTK_H
+#define WA_NAN_IGTK_H
+
+/* Local management CAM only; this does not initialize PN or protect frames. */
+int rtw_phl_wa_nan_igtk(void *phl, u8 index, const u8 *key, bool add)
+{
+	struct wa_nan_stageb_ctx *ctx = &wa_nan_stageb;
+	struct phl_sec_param_h crypt = {
+		.keyid = index, .enc_type = RTW_ENC_BIP_CCMP128,
+		.key_type = RTW_SEC_KEY_BIP, .key_len = 16,
+	};
+	enum rtw_phl_status status;
+	u8 temporary[16];
+	u32 sec_cam;
+
+	if (index != 4 && index != 5) return -EOPNOTSUPP;
+	if (!ctx->entered || ctx->phl != phl || !ctx->mgmt) return -ENETDOWN;
+	if (add && ctx->held) return -EUCLEAN;
+	if (ctx->igtk_attempted && ctx->igtk_index != index)
+		return add ? -ENOSPC : -ENOENT;
+	if (add) {
+		if (!ctx->mgmt_ready) return -EIO;
+		if (ctx->igtk_attempted) return ctx->igtk_ready ? -EEXIST : -EIO;
+		memcpy(temporary, key, sizeof(temporary));
+		ctx->igtk_attempted = true;
+		ctx->igtk_index = index;
+		status = rtw_phl_cmd_add_key(phl, ctx->mgmt, &crypt, temporary,
+			PHL_CMD_DIRECTLY, 0);
+		memzero_explicit(temporary, sizeof(temporary));
+		if (status == RTW_PHL_STATUS_SUCCESS) ctx->igtk_ready = true;
+		sec_cam = rtw_phl_get_sec_cam_idx(phl, ctx->mgmt, index, RTW_SEC_KEY_BIP);
+	} else {
+		if (!ctx->igtk_attempted) return 0;
+		sec_cam = rtw_phl_get_sec_cam_idx(phl, ctx->mgmt, index, RTW_SEC_KEY_BIP);
+		status = rtw_phl_cmd_del_key(phl, ctx->mgmt, &crypt, PHL_CMD_DIRECTLY, 0);
+		if (status == RTW_PHL_STATUS_SUCCESS) {
+			ctx->igtk_attempted = ctx->igtk_ready = false;
+			ctx->igtk_index = 0;
+		}
+	}
+	pr_info("WA_PROBE igtk-%s result=%d macid=%u index=%u sec_mode=%u sec_cam=%u attempted=%u ready=%u\n",
+		add ? "add" : "del", status == RTW_PHL_STATUS_SUCCESS ? 0 : -EIO,
+		ctx->mgmt->macid, index, ctx->mgmt->sec_mode, sec_cam, ctx->igtk_attempted, ctx->igtk_ready);
+	return status == RTW_PHL_STATUS_SUCCESS ? 0 : -EIO;
+}
+#endif
