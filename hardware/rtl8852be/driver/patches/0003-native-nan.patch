+/* SPDX-License-Identifier: GPL-2.0 */
+/* Bounded func8 bringup command; public snapshot excludes the key context. */
+#include "fwcmd.h"
+#include "wa_nan_command_api.h"
+static u32 cmd_wa_bigtk(struct mac_ax_adapter *adapter,
+		char input[][MAC_MAX_ARGV], u32 input_num,
+		char *output, u32 out_len, u32 *used)
+{
+	struct h2c_info info = {0};
+	u32 payload[8], value, i, ret = MACFUNCINPUT;
+	int begun = 0;
+	if (input_num != 9) goto report;
+	for (i = 0; i < 8; i++) {
+		if (kstrtou32(input[i+1], 16, &value)) goto report;
+		payload[i] = cpu_to_le32(value);
+	}
+	ret = wa_probe_ready(adapter);
+	if (ret != MACSUCCESS) goto report;
+	if (mac_wa_nan_command_begin(adapter)) { ret = MACPROCERR; goto report; }
+	begun = 1;
+	info.h2c_cat = FWCMD_H2C_CAT_MAC;
+	info.h2c_class = FWCMD_H2C_CL_NAN;
+	info.h2c_func = 8;
+	info.done_ack = 1;
+	info.content_len = sizeof(payload);
+	ret = mac_h2c_common(adapter, &info, payload);
+report:
+	memzero_explicit(payload, sizeof(payload));
+	if (begun) mac_wa_nan_command_end();
+	MAC_DBG_MSG(out_len, *used, output + *used, out_len - *used,
+		"WA_BIGTK completion=%u\n", ret);
+	return ret;
+}
