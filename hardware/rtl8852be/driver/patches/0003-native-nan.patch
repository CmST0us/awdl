+		if (tb[WA_NAN_ATTR_KEY_COOKIE] && !key_cookie) return -EINVAL;
+		if (!tb[WA_NAN_ATTR_KEY_CIPHER] || !tb[WA_NAN_ATTR_KEY_INDEX]) return -EINVAL;
+		if (op == WA_NAN_OP_KEY_ADD && (!tb[WA_NAN_ATTR_KEY_DATA] ||
+		    nla_len(tb[WA_NAN_ATTR_KEY_DATA]) != 16)) return -EINVAL;
+		if (op == WA_NAN_OP_KEY_DEL && tb[WA_NAN_ATTR_KEY_DATA]) return -EINVAL;
+		if (owner == WA_NAN_KEY_OWNER_LOCAL_NMI_BIGTK) {
+			u32 index = nla_get_u32(tb[WA_NAN_ATTR_KEY_INDEX]);
+			if (op != WA_NAN_OP_KEY_ADD) return -EOPNOTSUPP;
+			if (tb[WA_NAN_ATTR_PEER_ADDR] || tb[WA_NAN_ATTR_KEY_COOKIE] ||
+			    !tb[WA_NAN_ATTR_TX_PN] || nla_len(tb[WA_NAN_ATTR_TX_PN]) != 6)
+				return -EINVAL;
+			if (nla_get_u32(tb[WA_NAN_ATTR_KEY_CIPHER]) != 0x000fac06 ||
+			    (index != 6 && index != 7)) return -EOPNOTSUPP;
+			return rtw_phl_wa_nan_bigtk(phl, index, nla_data(tb[WA_NAN_ATTR_TX_PN]),
+				nla_data(tb[WA_NAN_ATTR_KEY_DATA]));
+		}
+		if (tb[WA_NAN_ATTR_TX_PN]) return -EOPNOTSUPP;
+		if (owner == WA_NAN_KEY_OWNER_LOCAL_NMI_IGTK) {
+			u32 index = nla_get_u32(tb[WA_NAN_ATTR_KEY_INDEX]);
+			if (tb[WA_NAN_ATTR_PEER_ADDR] || tb[WA_NAN_ATTR_KEY_COOKIE]) return -EINVAL;
+			if (nla_get_u32(tb[WA_NAN_ATTR_KEY_CIPHER]) != 0x000fac06 ||
+			    (index != 4 && index != 5)) return -EOPNOTSUPP;
+			return rtw_phl_wa_nan_igtk(phl, index,
+				op == WA_NAN_OP_KEY_ADD ? nla_data(tb[WA_NAN_ATTR_KEY_DATA]) : NULL,
+				op == WA_NAN_OP_KEY_ADD);
+		}
+		if (owner != WA_NAN_KEY_OWNER_PAIRWISE) return -EOPNOTSUPP;
+		if (!tb[WA_NAN_ATTR_PEER_ADDR] ||
+		    nla_len(tb[WA_NAN_ATTR_PEER_ADDR]) != 6) return -EINVAL;
+		if (nla_get_u32(tb[WA_NAN_ATTR_KEY_CIPHER]) != 0x000fac04 ||
+		    nla_get_u32(tb[WA_NAN_ATTR_KEY_INDEX]) != 0) return -EOPNOTSUPP;
+		return rtw_phl_wa_nan_key_owned(phl, nla_data(tb[WA_NAN_ATTR_PEER_ADDR]),
+			op == WA_NAN_OP_KEY_ADD ? nla_data(tb[WA_NAN_ATTR_KEY_DATA]) : NULL,
+			op == WA_NAN_OP_KEY_ADD, key_cookie);
+	}
+	if (op == WA_NAN_OP_PEER_ADD || op == WA_NAN_OP_PEER_DEL) {
+		if (!tb[WA_NAN_ATTR_PEER_ADDR] ||
+		    nla_len(tb[WA_NAN_ATTR_PEER_ADDR]) != 6) return -EINVAL;
+		return rtw_phl_wa_nan_peer(phl, nla_data(tb[WA_NAN_ATTR_PEER_ADDR]),
+			op == WA_NAN_OP_PEER_ADD);
+	}
+	if (op != WA_NAN_OP_START && op != WA_NAN_OP_TX)
+		return -EOPNOTSUPP;
+	if (!tb[WA_NAN_ATTR_FRAME]) return -EINVAL;
+	if (nla_len(tb[WA_NAN_ATTR_FRAME]) > WA_NAN_FRAME_MAX) return -EMSGSIZE;
+	if (nla_len(tb[WA_NAN_ATTR_FRAME]) < 30) return -EINVAL;
+	if (op == WA_NAN_OP_START)
+		return rtw_phl_wa_nan_host_start(phl, adapter->phl_role, link->wrlink,
+			nla_data(tb[WA_NAN_ATTR_FRAME]), nla_len(tb[WA_NAN_ATTR_FRAME]));
+	if (!tb[WA_NAN_ATTR_COOKIE] || !tb[WA_NAN_ATTR_FREQ] ||
+	    !nla_get_u64(tb[WA_NAN_ATTR_COOKIE])) return -EINVAL;
+	{
+		u32 protection = tb[WA_NAN_ATTR_TX_PROTECTION] ? nla_get_u32(tb[WA_NAN_ATTR_TX_PROTECTION]) : 0;
+		u64 key_cookie = tb[WA_NAN_ATTR_KEY_COOKIE] ? nla_get_u64(tb[WA_NAN_ATTR_KEY_COOKIE]) : 0;
+		if (protection > WA_NAN_TX_PAIRWISE_CCMP128) return -EOPNOTSUPP;
+		if (protection && (!tb[WA_NAN_ATTR_PEER_ADDR] ||
+		    nla_len(tb[WA_NAN_ATTR_PEER_ADDR]) != 6 || !tb[WA_NAN_ATTR_KEY_INDEX] ||
+		    nla_get_u32(tb[WA_NAN_ATTR_KEY_INDEX]) != 0 || !key_cookie)) return -EINVAL;
+		if (!protection && (tb[WA_NAN_ATTR_PEER_ADDR] || tb[WA_NAN_ATTR_KEY_INDEX] ||
+		    tb[WA_NAN_ATTR_KEY_COOKIE])) return -EINVAL;
+	return rtw_phl_wa_nan_mgmt_tx(phl, nla_data(tb[WA_NAN_ATTR_FRAME]),
+		nla_len(tb[WA_NAN_ATTR_FRAME]), nla_get_u32(tb[WA_NAN_ATTR_FREQ]),
+		nla_get_u64(tb[WA_NAN_ATTR_COOKIE]), protection,
+		protection ? nla_data(tb[WA_NAN_ATTR_PEER_ADDR]) : NULL, key_cookie);
+	}
+}
+
+void wa_nan_vendor_dw(void *drv, u32 tsf, u32 counter)
+{
+	struct dvobj_priv *dvobj = drv;
+	_adapter *adapter = dvobj_get_primary_adapter(dvobj);
+	if (adapter && adapter->phl_role &&
+	    adapter->phl_role->type == PHL_RTYPE_NAN)
+		wa_nan_emit(adapter, WA_NAN_EVENT_DW, 0, (const u8 *)&tsf, sizeof(tsf),
+			0, 0, counter, 0, WA_NAN_ACK_UNKNOWN, NULL);
+}
+
+void wa_nan_vendor_cluster(void *drv, const u8 *cluster)
+{
+	struct dvobj_priv *dvobj = drv;
+	_adapter *adapter = dvobj_get_primary_adapter(dvobj);
+	if (adapter && adapter->phl_role &&
+	    adapter->phl_role->type == PHL_RTYPE_NAN)
+		wa_nan_emit(adapter, WA_NAN_EVENT_CLUSTER, 0, cluster, 6,
+			0, 0, 0, 0, WA_NAN_ACK_UNKNOWN, NULL);
+}
+
+bool wa_nan_vendor_rx(void *drv, const u8 *frame, u32 len,
+		     u32 counter, u8 channel, u32 flags)
+{
+	struct dvobj_priv *dvobj = drv;
+	_adapter *adapter = dvobj_get_primary_adapter(dvobj);
+	if (adapter && adapter->phl_role && adapter->phl_role->type == PHL_RTYPE_NAN &&
+	    len >= 36 && len <= WA_NAN_FRAME_MAX && frame[0] == 0x80 &&
+	    !memcmp(frame+16, "\x50\x6f\x9a\x01", 4)) {
+		wa_nan_emit(adapter, WA_NAN_EVENT_RX, 0, frame, len,
+			wa_nan_frequency(channel), flags | WA_NAN_RX_RAW,
+			counter, 0, WA_NAN_ACK_UNKNOWN, NULL);
+		return false;
+	}
+	if (!adapter || !adapter->phl_role ||
+	    adapter->phl_role->type != PHL_RTYPE_NAN ||
+	    !wa_nan_mgmt_rx_match(frame, len)) return false;
+	if (!(frame[4] & 1) && memcmp(frame + 4,
+		GET_PRIMARY_LINK(adapter)->wrlink->mac_addr, 6)) return false;
+	if (len > WA_NAN_FRAME_MAX) {
+		atomic_inc(&wa_nan_rx_oversize); return true;
+	}
+	if (frame[1] & 0x40) {
+		struct wa_nan_verified_rx *verified = kzalloc(sizeof(*verified), GFP_ATOMIC);
+		int ret;
+		if (!verified) { atomic_inc(&wa_nan_event_drops); return true; }
+		ret = rtw_phl_wa_nan_ccmp_rx(GET_PHL_INFO(dvobj), frame, len, flags, verified);
+		pr_info_ratelimited("WA_PROBE ccmp-rx counter=%u len=%u flags=0x%x result=%d peer=%pM key_cookie=%llu plain=%*phC\n",
+			counter, len, flags, ret, frame + 10,
+			(unsigned long long)verified->key_cookie,
+			!ret || ret == -EPROTO ? 6 : 0, verified->frame + 24);
+		if (!ret) wa_nan_emit(adapter, WA_NAN_EVENT_RX, 0, verified->frame,
+			verified->len, wa_nan_frequency(channel),
+			(flags & ~WA_NAN_RX_RAW) | WA_NAN_RX_PROTECTED | WA_NAN_RX_CCMP_VERIFIED,
+			counter, 0, WA_NAN_ACK_UNKNOWN, verified);
+		else wa_nan_emit(adapter, WA_NAN_EVENT_RX, 0, frame, len,
+			wa_nan_frequency(channel), flags | WA_NAN_RX_RAW | WA_NAN_RX_PROTECTED,
+			counter, 0, WA_NAN_ACK_UNKNOWN, NULL);
+		memzero_explicit(verified, sizeof(*verified)); kfree(verified);
+		return true;
+	}
+	/* Protected Dual has no valid unprotected representation on the air. */
+	if (frame[0] == 0xd0 && frame[24] == 9) return true;
+	wa_nan_emit(adapter, WA_NAN_EVENT_RX, 0, frame, len,
+		wa_nan_frequency(channel), flags, counter, 0, WA_NAN_ACK_UNKNOWN, NULL);
+	return true;
+}
+
+void wa_nan_vendor_tx_done(void *drv, u64 cookie, u32 tx_status, u8 acked)
+{
+	struct dvobj_priv *dvobj = drv;
+	_adapter *adapter = dvobj_get_primary_adapter(dvobj);
+	if (adapter) wa_nan_emit(adapter, WA_NAN_EVENT_TX_DONE, cookie,
+		NULL, 0, 0, 0, 0, tx_status, acked, NULL);
+}
+
 static const struct wiphy_vendor_command rtw_vendor_cmds[] = {
+	{ .info = { .vendor_id = WA_NAN_VENDOR_ID, .subcmd = WA_NAN_VENDOR_SUBCMD },
+	  .flags = WIPHY_VENDOR_CMD_NEED_WDEV | WIPHY_VENDOR_CMD_NEED_NETDEV,
+	  .doit = wa_nan_vendor_command, .policy = wa_nan_policy,
+	  .maxattr = WA_NAN_ATTR_MAX },
 #if defined(GSCAN_SUPPORT) && 0
 	{
 		{
@@ -2131,7 +2520,49 @@
 	{ OUI_GOOGLE, GSCAN_EVENT_COMPLETE_SCAN },
 	{ OUI_GOOGLE, GSCAN_EVENT_HOTLIST_RESULTS_LOST }
 #endif /* GSCAN_SUPPORT */
+	{ WA_NAN_VENDOR_ID, WA_NAN_VENDOR_SUBCMD },
 };
+
+static void wa_nan_emit(_adapter *adapter, u32 event, u64 cookie,
+			const u8 *frame, u32 len, u32 freq, u32 flags,
+			u32 counter, u32 tx_status, u8 acked, const struct wa_nan_verified_rx *verified)
+{
+	struct sk_buff *skb;
+	int ret;
+	/* The NAN event is appended, preserving existing vendor event indices. */
+	skb = rtw_cfg80211_vendor_event_alloc(adapter_to_wiphy(adapter),
+		adapter->rtw_wdev, len + 192, ARRAY_SIZE(rtw_vendor_events) - 1,
+		GFP_ATOMIC);
+	if (!skb) goto dropped;
+	ret = nla_put_u32(skb, WA_NAN_ATTR_VERSION, WA_NAN_ABI_VERSION) ||
+	      nla_put_u32(skb, WA_NAN_ATTR_EVENT, event);
+	if (event == WA_NAN_EVENT_RX)
+		ret |= nla_put(skb, WA_NAN_ATTR_FRAME, len, frame) ||
+		       nla_put_u32(skb, WA_NAN_ATTR_FREQ, freq) ||
+		       nla_put_u32(skb, WA_NAN_ATTR_RX_FLAGS, flags) ||
+		       nla_put_u32(skb, WA_NAN_ATTR_RX_COUNTER, counter);
+	else if (event == WA_NAN_EVENT_CLUSTER)
+		ret |= nla_put(skb, WA_NAN_ATTR_CLUSTER_ID, 6, frame);
+	else if (event == WA_NAN_EVENT_DW)
+		ret |= nla_put(skb, WA_NAN_ATTR_DW_START, sizeof(u32), frame) ||
+		       nla_put_u32(skb, WA_NAN_ATTR_RX_COUNTER, counter);
+	else
+		ret |= nla_put_u64_64bit(skb, WA_NAN_ATTR_COOKIE, cookie, WA_NAN_ATTR_PAD) ||
+		       nla_put_s32(skb, WA_NAN_ATTR_STATUS,
+			 tx_status == TX_STATUS_TX_DONE ? 0 : -EIO) ||
+		       nla_put_u32(skb, WA_NAN_ATTR_TX_STATUS, tx_status) ||
+		       nla_put_u8(skb, WA_NAN_ATTR_ACKED, acked);
+	if (verified)
+		ret |= nla_put_u64_64bit(skb, WA_NAN_ATTR_KEY_COOKIE, verified->key_cookie, WA_NAN_ATTR_PAD) ||
+		       nla_put(skb, WA_NAN_ATTR_PEER_ADDR, 6, verified->peer) ||
+		       nla_put_u32(skb, WA_NAN_ATTR_KEY_INDEX, 0) ||
+		       nla_put(skb, WA_NAN_ATTR_RX_PN, 6, verified->pn);
+	if (ret) { kfree_skb(skb); goto dropped; }
+	rtw_cfg80211_vendor_event(skb, GFP_ATOMIC);
+	return;
+dropped:
+	atomic_inc(&wa_nan_event_drops);
+}
 
