+/* SPDX-License-Identifier: GPL-2.0 */
+/* Single-record native scheduling diagnostic, under the NAN owner lock. */
+#ifndef WA_NAN_SCHEDULE_H
+#define WA_NAN_SCHEDULE_H
+
+int rtw_phl_wa_nan_schedule_probe(void *phl, struct rtw_wifi_role_t *role,
+				struct rtw_wifi_role_link_t *link, u32 action)
+{
+	struct wa_nan_stageb_ctx *ctx = &wa_nan_stageb;
+	int ret, cleanup = 0;
+	u64 op = ktime_get_ns();
+
+	if (action < WA_NAN_SCHED_INIT || action > WA_NAN_SCHED_READ)
+		return -EINVAL;
+	if (!mutex_trylock(&wa_nan_lifecycle_lock)) return -EBUSY;
+	if (!wa_nan_host_owned || !ctx->entered || (ctx->held && action != WA_NAN_SCHED_READ) || ctx->phl != phl ||
+	    ctx->wrole != role || ctx->rlink != link || !ctx->mgmt_ready) {
+		ret = -ENODEV;
+		goto out;
+	}
+	if (ctx->band || ctx->rlink->hw_band || ctx->plan.macid_mgn >= 128) {
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+	if (action == WA_NAN_SCHED_READ) {
+		ret = rtw_hal_wa_nan_schedule_read(ctx->phl->hal, op, ctx->plan.macid_mgn);
+		goto out;
+	}
+	if ((action == WA_NAN_SCHED_INIT && ctx->schedule_touched) ||
+	    (action == WA_NAN_SCHED_ADD && ctx->schedule_record)) {
+		ret = -EALREADY;
+		goto out;
+	}
+	if ((action != WA_NAN_SCHED_INIT && !ctx->schedule_ready) ||
+	    (action == WA_NAN_SCHED_DELETE && !ctx->schedule_record)) {
+		ret = -ENOENT;
+		goto out;
+	}
+	if (action == WA_NAN_SCHED_INIT) {
+		ret = rtw_hal_wa_nan_schedule_clean(ctx->phl->hal, ctx->plan.macid_mgn, false);
+		if (ret) goto out;
+	}
+	ret = rtw_hal_wa_nan_command_begin(ctx->phl->hal);
+	if (ret) goto out;
+	ctx->schedule_touched = true;
+	ret = rtw_hal_wa_nan_schedule_step(ctx->phl->hal, action, ctx->plan.macid_mgn);
+	if (!ret) {
+		if (action == WA_NAN_SCHED_INIT) ctx->schedule_ready = true;
+		else ctx->schedule_record = action == WA_NAN_SCHED_ADD;
+	}
+	rtw_hal_wa_nan_command_end();
+	if (ret) {
+		/* A lost ACK may follow execution. STOP uses a fresh completion scope. */
+		cleanup = wa_nan_host_stop_locked(phl);
+		if (cleanup) ret = -EUCLEAN;
+	}
+out:
+	pr_info("WA_PROBE schedule-step op=%llu action=%u result=%d cleanup=%d module2=%u record=%u touched=%u macid=%u port=%u band=%u cluster=" WA_NAN_ADDR_FMT " ns=%llu\n",
+		(unsigned long long)op, action, ret, cleanup, ctx->schedule_ready,
+		ctx->schedule_record, ctx->schedule_touched, ctx->plan.macid_mgn,
+		ctx->plan.port[0], ctx->band, WA_NAN_ADDR_ARGS(ctx->plan.cluster),
+		(unsigned long long)ktime_get_ns());
+	mutex_unlock(&wa_nan_lifecycle_lock);
+	return ret;
+}
+int rtw_phl_wa_nan_get_cluster(void *phl, u8 *cluster)
+{
+ struct wa_nan_stageb_ctx *ctx = &wa_nan_stageb;
+ int ret = 0;
+ if (!mutex_trylock(&wa_nan_lifecycle_lock)) return -EBUSY;
+ if (wa_nan_host_owned && ctx->entered) {
+  if (ctx->phl != phl || ctx->held) ret = -ENODEV;
+  else ret = rtw_hal_wa_nan_get_cluster(ctx->phl->hal, cluster);
+ }
+ mutex_unlock(&wa_nan_lifecycle_lock);
+ return ret;
+}
+
+/* One local management schedule, retained until complete native STOP. */
+int rtw_phl_wa_nan_local_schedule(void *phl, struct rtw_wifi_role_t *role,
+		struct rtw_wifi_role_link_t *link, const u8 *cluster,
+		u32 slots, u8 length)
+{
+	struct wa_nan_stageb_ctx *ctx = &wa_nan_stageb;
+	struct rtw_chan_def channel = {0};
+	int ret, cleanup = 0;
+
+	if (!mutex_trylock(&wa_nan_lifecycle_lock)) return -EBUSY;
+	if (!wa_nan_host_owned || !ctx->entered || ctx->held || ctx->phl != phl ||
+	    ctx->wrole != role || ctx->rlink != link || !ctx->mgmt_ready) {
+		ret = -ENODEV;
+		goto out;
+	}
+	rtw_hal_get_cur_chdef(ctx->phl->hal, link->hw_band, &channel);
+	if (ctx->band || link->hw_band || channel.band != BAND_ON_24G ||
+	    channel.chan != 6 || channel.bw != CHANNEL_WIDTH_20 ||
+	    ctx->plan.macid_mgn >= 128) {
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+	ret = rtw_hal_wa_nan_schedule_cluster(ctx->phl->hal, cluster);
+	if (ret) goto out;
+	memcpy(ctx->plan.cluster, cluster, 6);
+	if (!ctx->schedule_ready) {
+		ret = rtw_hal_wa_nan_schedule_clean(ctx->phl->hal,
+			ctx->plan.macid_mgn, false);
+		if (ret) goto out;
+	}
+	ret = rtw_hal_wa_nan_command_begin(ctx->phl->hal);
+	if (ret) goto out;
+	ctx->schedule_touched = true;
+	if (!ctx->schedule_ready) {
+		ret = rtw_hal_wa_nan_schedule_step(ctx->phl->hal,
+			WA_NAN_SCHED_INIT, ctx->plan.macid_mgn);
+		if (!ret) ctx->schedule_ready = true;
+	}
+	if (!ret) {
+		ret = rtw_hal_wa_nan_auth_schedule(ctx->phl->hal,
+			ctx->plan.macid_mgn, slots, length);
+		if (!ret) ctx->schedule_record = true;
+	}
+	rtw_hal_wa_nan_command_end();
+	if (!ret) ret = rtw_hal_wa_nan_schedule_verify(ctx->phl->hal,
+		ctx->plan.macid_mgn, slots, length, cluster);
+	/* A verified record survives a cluster update; the event reinstalls it. */
+	if (ret && ret != -EAGAIN) {
+		cleanup = wa_nan_host_stop_locked(phl);
+		if (cleanup) ret = -EUCLEAN;
+	}
+out:
+	pr_info("WA_PROBE local-schedule result=%d cleanup=%d macid=%u channel=%u band=%u bw=%u slots=%08x length=%u cluster=" WA_NAN_ADDR_FMT " ns=%llu\n",
+		ret, cleanup, ctx->plan.macid_mgn, channel.chan, channel.band,
+		channel.bw, slots, length, WA_NAN_ADDR_ARGS(cluster),
+		(unsigned long long)ktime_get_ns());
+	mutex_unlock(&wa_nan_lifecycle_lock);
+	return ret;
+}
+#endif
--- /dev/null
+++ b/phl/wa_nan_sdf_tx.c
@@ -0,0 +1,366 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* M4-C: PHL/core bridge for one NAN SDF management frame. */
+#include <linux/spinlock.h>
+#include <linux/atomic.h>
+#include <linux/jiffies.h>
+#include <linux/wait.h>
+#include "wa_nan_vendor.h"
+#include "wa_nan_mgmt_rx.h"
+#include <linux/ktime.h>
+#include <linux/printk.h>
+#include <linux/string.h>
+#include <drv_types.h>
+#include "hal_g6/hal_api.h"
+
+#include "wa_nan_ccmp.c"
+
+struct wa_nan_sdf_tx_ctx {
+	struct rtw_txfb_t feedback;
+	u64 cookie;
+	u64 submitted_ns;
+	u16 len;
+	void *phl;
+	u64 request_cookie;
+	bool protected_tx;
+	bool unicast_ack;
+};
+
+struct wa_nan_sdf_tx_state {
+	spinlock_t lock;
+	atomic_t outstanding;
+	u64 next_cookie;
+	u64 active_cookie;
+	u64 active_ns;
+	u64 done_cookie;
+	u32 last_txsts;
+	u32 submitted;
+	u32 done;
+	u32 failed;
+	u32 timeout;
+};
+
+static u8 wa_sdf_macid;
+static bool wa_sdf_accepting;
+static DECLARE_WAIT_QUEUE_HEAD(wa_sdf_wait);
+
+void rtw_phl_wa_nan_sdf_set_macid(u8 macid)
+{
+	wa_sdf_macid = macid;
+}
+
+static struct wa_nan_sdf_tx_state wa_sdf_state = {
+	.lock = __SPIN_LOCK_UNLOCKED(wa_sdf_state.lock),
+	.outstanding = ATOMIC_INIT(0),
+};
+
+static void wa_nan_sdf_tx_feedback(struct rtw_txfb_t *feedback)
+{
+	struct wa_nan_sdf_tx_ctx *ctx = feedback->ctx;
+	struct wa_nan_sdf_tx_state *state = &wa_sdf_state;
+	unsigned long flags;
+	u32 txsts = feedback->txsts;
+	/* Same WP completion contract as CONFIG_XMIT_ACK_BY_REL_RPT. */
+	u8 acked = ctx->unicast_ack ?
+		(txsts == TX_STATUS_TX_DONE ? WA_NAN_ACK_YES : WA_NAN_ACK_NO) :
+		WA_NAN_ACK_UNKNOWN;
+	u64 elapsed = ktime_get_ns() - ctx->submitted_ns;
+
+	spin_lock_irqsave(&state->lock, flags);
+	pr_info("WA_PROBE sdf-txfb-entry cookie=%llu txsts=%u ns=%llu active=%llu done=%llu\n",
+		(unsigned long long)ctx->cookie, (unsigned int)txsts,
+		(unsigned long long)ktime_get_ns(),
+		(unsigned long long)state->active_cookie,
+		(unsigned long long)state->done_cookie);
+	state->last_txsts = txsts;
+	state->done_cookie = ctx->cookie;
+	if (txsts == TX_STATUS_TX_DONE)
+		state->done++;
+	else
+		state->failed++;
+	state->active_cookie = 0;
+	spin_unlock_irqrestore(&state->lock, flags);
+	pr_info("WA_PROBE sdf-done cookie=%llu len=%u txsts=%u elapsed_ns=%llu submitted=%u done=%u failed=%u timeout=%u\n",
+		(unsigned long long)ctx->cookie, (unsigned int)ctx->len,
+		(unsigned int)txsts, (unsigned long long)elapsed,
+		(unsigned int)state->submitted, (unsigned int)state->done,
+		(unsigned int)state->failed, (unsigned int)state->timeout);
+	if (ctx->protected_tx) wa_ccmp_put();
+	if (ctx->request_cookie)
+		wa_nan_vendor_tx_done(((struct phl_info_t *)ctx->phl)->phl_com->drv_priv,
+			ctx->request_cookie, txsts, acked);
+	kfree(ctx);
+	atomic_set(&state->outstanding, 0);
+	wake_up_all(&wa_sdf_wait);
+}
+
+static void wa_nan_sdf_open(void)
+{
+	spin_lock_irq(&wa_sdf_state.lock);
+	wa_sdf_accepting = true;
+	spin_unlock_irq(&wa_sdf_state.lock);
+}
+
+static int wa_nan_sdf_quiesce(void)
+{
+	wa_ccmp_suspend();
+	spin_lock_irq(&wa_sdf_state.lock);
+	wa_sdf_accepting = false;
+	spin_unlock_irq(&wa_sdf_state.lock);
+	return wait_event_timeout(wa_sdf_wait,
+		!atomic_read(&wa_sdf_state.outstanding), msecs_to_jiffies(1000)) ? 0 : -ETIMEDOUT;
+}
+
+static int wa_nan_tx(void *phl, const u8 *frame, u16 len, u64 *cookie,
+		     u64 request_cookie, u32 freq, u32 protection,
+		     const u8 *peer, u64 key_cookie)
+{
+	struct phl_info_t *phl_info = (struct phl_info_t *)phl;
+	struct dvobj_priv *dvobj;
+	_adapter *adapter;
+	struct _ADAPTER_LINK *link;
+	struct wa_nan_sdf_tx_ctx *ctx;
+	struct xmit_frame *xframe;
+	struct pkt_attrib *attr;
+	struct wa_nan_sdf_tx_state *state = &wa_sdf_state;
+	unsigned long flags;
+	u8 cur_ch, macid = wa_sdf_macid, cam = 0;
+	u64 pn = 0;
+	u8 *payload;
+	u8 aad[22], nonce[13];
+	int result = -EIO;
+	enum rtw_phl_status add_ret, notify_ret;
+	bool mapped = false;
+
+	if (!phl_info || !frame || !cookie || len < 30 || len > WA_NAN_FRAME_MAX)
+		return -EINVAL;
+	if (protection && len > WA_NAN_FRAME_MAX - 16) return -EMSGSIZE;
+	*cookie = 0;
+	dvobj = (struct dvobj_priv *)phl_info->phl_com->drv_priv;
+	if (!dvobj || RTW_CANNOT_RUN(dvobj))
+		return -ENETDOWN;
+	adapter = dvobj_get_primary_adapter(dvobj);
+	if (!adapter)
+		return -ENODEV;
+	link = GET_PRIMARY_LINK(adapter);
+	if (!link)
+		return -ENODEV;
+	cur_ch = link->mlmeextpriv.chandef.chan;
+	if (!adapter->phl_role || adapter->phl_role->type != PHL_RTYPE_NAN)
+		return -ENETDOWN;
+	if (freq && freq != (cur_ch == 14 ? 2484 :
+		(cur_ch <= 13 ? 2407 + cur_ch * 5 : 5000 + cur_ch * 5)))
+		return -EBUSY;
+	spin_lock_irqsave(&state->lock, flags);
+	if (!wa_sdf_accepting || atomic_cmpxchg(&state->outstanding, 0, 1) != 0) {
+		spin_unlock_irqrestore(&state->lock, flags);
+		return -EBUSY;
+	}
+	spin_unlock_irqrestore(&state->lock, flags);
+	if (!rtw_get_bcmc_stainfo(adapter, link)) {
+		atomic_set(&state->outstanding, 0);
+		return -ENODEV;
+	}
+	ctx = kzalloc(sizeof(*ctx), GFP_KERNEL);
+	if (!ctx) {
+		atomic_set(&state->outstanding, 0);
+		return -ENOMEM;
+	}
+	xframe = alloc_mgtxmitframe(&adapter->xmitpriv);
+	if (!xframe) {
+		kfree(ctx);
+		atomic_set(&state->outstanding, 0);
+		return -ENOMEM;
+	}
+	spin_lock_irqsave(&state->lock, flags);
+	ctx->cookie = ++state->next_cookie;
+	ctx->submitted_ns = ktime_get_ns();
+	ctx->len = len;
+	state->active_cookie = ctx->cookie;
+	state->active_ns = ctx->submitted_ns;
+	spin_unlock_irqrestore(&state->lock, flags);
+	ctx->phl = phl;
+	ctx->request_cookie = request_cookie;
+	ctx->unicast_ack = !(frame[4] & 1) &&
+		((frame[0] & 0xfc) == 0xd0 || (frame[0] & 0xfc) == 0xb0);
+	ctx->feedback.ctx = ctx;
+	ctx->feedback.txsts = TX_STATUS_TX_FAIL_SW_DROP;
+	ctx->feedback.txfb_cb = wa_nan_sdf_tx_feedback;
+	attr = &xframe->attrib;
+	update_mgntframe_attrib(adapter, link, attr);
+	if (protection) {
+		result = wa_ccmp_tx_get(phl, frame, len, peer, key_cookie, &pn, &macid, &cam);
+		if (result) goto release;
+		ctx->protected_tx = true;
+		/* Software CCMP retains the peer key owner; NMI traffic uses the
+		 * management MACID so data airtime can occupy another channel. */
+		macid = wa_sdf_macid;
+	}
+	attr->mac_id = macid;
+	pr_info("WA_PROBE sdf-prep macid=%u sdf_macid=%u len=%u ch=%u prot=%u role=%u\n",
+		(unsigned int)macid, (unsigned int)wa_sdf_macid, (unsigned int)len,
+		(unsigned int)cur_ch, (unsigned int)protection,
+		(unsigned int)(adapter->phl_role ? adapter->phl_role->type : 0xff));
+	attr->rate = MGN_6M;
+	attr->retry_ctrl = (frame[4] & 1) ? _FALSE : _TRUE;
+	attr->pktlen = attr->last_txcmdsz = len;
+	payload = xframe->buf_addr + TXDESC_OFFSET;
+	memcpy(payload, frame, 24);
+	if (protection) {
+		payload[1] |= 0x40;
+		wa_ccmp_iv(payload + 24, pn);
+		wa_ccmp_aad_nonce(payload, aad, nonce);
+		/* The TX reference holds this key until hardware completion. */
+		result = aes_ccm_ae(wa_ccmp.key, 16, nonce, 8, frame + 24,
+			len - 24, aad, sizeof(aad), payload + 32, payload + len + 8);
+		if (result) { result = -EIO; goto release; }
+		attr->pktlen = attr->last_txcmdsz = len + 16;
+	} else memcpy(payload + 24, frame + 24, len - 24);
+	attr->seqnum = adapter->mlmeextpriv.mgnt_seq++;
+	SetSeqNum(xframe->buf_addr + TXDESC_OFFSET, attr->seqnum);
+	update_mgntframe_attrib_addr(adapter, xframe);
+	xframe->xftype = RTW_TX_DRV_MGMT;
+	if (core_tx_prepare_phl(adapter, xframe) == FAIL) {
+		result = -EIO;
+		goto release;
+	}
+	mapped = true;
+	if (xframe->txreq_cnt != 1) {
+		result = -EUCLEAN;
+		goto release;
+	}
+	if (protection) {
+		xframe->phl_txreq->mdata.macid = macid;
+		xframe->phl_txreq->mdata.hw_sec_iv = 0;
+		xframe->phl_txreq->mdata.sw_sec_iv = 0;
+		xframe->phl_txreq->mdata.smh_en = 0;
+		xframe->phl_txreq->mdata.hdr_len = 12;
+		xframe->phl_txreq->mdata.sec_hw_enc = 0;
+		xframe->phl_txreq->mdata.sec_type = RTW_ENC_NONE;
+		xframe->phl_txreq->mdata.sec_cam_idx = 0;
+		pr_info("WA_PROBE ccmp-prepare cookie=%llu key_cookie=%llu pn=%llu macid=%u cam=%u len=%u\n",
+			(unsigned long long)request_cookie, (unsigned long long)key_cookie,
+			(unsigned long long)pn, macid, cam, attr->pktlen);
+	}
+	xframe->phl_txreq->txfb = &ctx->feedback;
+	if (!(frame[4] & 1)) {
+		/* Optional CCX diagnostics accompany the authoritative WP completion. */
+		xframe->phl_txreq->mdata.spe_rpt = 1;
+		xframe->phl_txreq->mdata.sw_define = ctx->cookie & 0xf;
+		pr_info("WA_PROBE sdf-report request=%llu cookie=%llu macid=%u seq=%u token=%u ra=%pM ta=%pM\n",
+			(unsigned long long)request_cookie,
+			(unsigned long long)ctx->cookie, macid, attr->seqnum,
+			xframe->phl_txreq->mdata.sw_define, frame + 4, frame + 10);
+	}
+	*cookie = ctx->cookie;
+	add_ret = rtw_phl_add_tx_req(GET_PHL_INFO(dvobj), xframe->phl_txreq);
+	pr_info("WA_PROBE sdf-add result=%d cookie=%llu txreq_cnt=%u macid=%u seq=%u\n",
+		(int)add_ret, (unsigned long long)*cookie,
+		(unsigned int)xframe->txreq_cnt, (unsigned int)macid,
+		(unsigned int)attr->seqnum);
+	if (add_ret != RTW_PHL_STATUS_SUCCESS) {
+		pr_info("WA_PROBE sdf-add result=%d cookie=%llu reason=sdf-notify-fail\n",
+			(int)add_ret, (unsigned long long)*cookie);
+		result = -ENOBUFS;
+		goto release;
+	}
+	notify_ret = rtw_phl_tx_req_notify(GET_PHL_INFO(dvobj));
+	pr_info("WA_PROBE sdf-notify result=%d cookie=%llu\n",
+		(int)notify_ret, (unsigned long long)*cookie);
+	if (notify_ret != RTW_PHL_STATUS_SUCCESS) {
+		pr_info("WA_PROBE sdf-notify-fail result=%d cookie=%llu reason=sdf-notify-fail\n",
+			(int)notify_ret, (unsigned long long)*cookie);
+		/* Queue owns this request. Completion still reports final status. */
+	}
+	spin_lock_irqsave(&state->lock, flags);
+	state->submitted++;
+	spin_unlock_irqrestore(&state->lock, flags);
+	pr_info("WA_PROBE sdf-submit result=0 cookie=%llu len=%u macid=%u channel=%u rate=%u retry=%u\n",
+		(unsigned long long)*cookie, (unsigned int)len,
+		(unsigned int)wa_sdf_macid, (unsigned int)cur_ch,
+		(unsigned int)MGN_6M, (unsigned int)!(frame[4] & 1));
+	return 0;
+release:
+	spin_lock_irqsave(&state->lock, flags);
+	state->active_cookie = 0;
+	state->failed++;
+	atomic_set(&state->outstanding, 0);
+	spin_unlock_irqrestore(&state->lock, flags);
+	if (mapped)
+		core_recycle_txreq_phyaddr(adapter, xframe->phl_txreq);
+	core_tx_free_xmitframe(adapter, xframe);
+	if (ctx->protected_tx) wa_ccmp_put();
+	kfree(ctx);
+	return result;
+}
+
+int rtw_phl_wa_nan_sdf_tx(void *phl, const u8 *frame, u16 len, u64 *cookie)
+{
+	return wa_nan_tx(phl, frame, len, cookie, 0, 0, WA_NAN_TX_NONE, NULL, 0);
+}
+
+int rtw_phl_wa_nan_mgmt_tx(void *phl, const u8 *frame, u16 len,
+			 u32 freq, u64 request_cookie, u32 protection,
+			 const u8 *peer, u64 key_cookie)
+{
+	u64 cookie;
+	if (len > WA_NAN_FRAME_MAX) return -EMSGSIZE;
+	if (!wa_nan_mgmt_rx_match(frame, len)) return -EINVAL;
+	if (protection > WA_NAN_TX_PAIRWISE_CCMP128) return -EOPNOTSUPP;
+	if (!protection && len >= 30 && frame[24] == 9) return -EACCES;
+	if (frame[1] & 0x40) return -EOPNOTSUPP;
+	return wa_nan_tx(phl, frame, len, &cookie, request_cookie, freq, protection, peer, key_cookie);
+}
+
+int rtw_phl_wa_nan_sdf_wait_done(void *phl, u64 cookie, u32 timeout_ms)
+{
+	struct wa_nan_sdf_tx_state *state = &wa_sdf_state;
+	int result;
+	(void)phl;
+	if (!cookie || !timeout_ms || timeout_ms > 5000) return -EINVAL;
+	if (!wait_event_timeout(wa_sdf_wait,
+		READ_ONCE(state->done_cookie) == cookie ||
+		!atomic_read(&state->outstanding), msecs_to_jiffies(timeout_ms))) {
+		spin_lock_irq(&state->lock);
+		state->timeout++;
+		spin_unlock_irq(&state->lock);
+		return -ETIMEDOUT;
+	}
+	spin_lock_irq(&state->lock);
+	result = state->done_cookie == cookie &&
+		state->last_txsts == TX_STATUS_TX_DONE ? 0 : -EIO;
+	spin_unlock_irq(&state->lock);
+	return result;
+}
+
+/* Initial discovery channel is configured once, before the NAN session. */
+static int wa_nan_discovery_channel(void *phl)
+{
+	struct phl_info_t *info = phl;
+	struct dvobj_priv *dvobj = info->phl_com->drv_priv;
+	_adapter *adapter = dvobj_get_primary_adapter(dvobj);
+	struct _ADAPTER_LINK *link = GET_PRIMARY_LINK(adapter);
+	struct rtw_chan_def ch = link->mlmeextpriv.chandef;
+	ch.band = BAND_ON_24G;
+	ch.chan = ch.center_ch = 6;
+	ch.bw = CHANNEL_WIDTH_20;
+	ch.offset = CHAN_OFFSET_NO_EXT;
+	ch.is_dfs = false;
+	if (rtw_hal_set_ch_bw(info->hal, link->wrlink->hw_band, &ch,
+		RFK_TYPE_CHG_OP, false, false) != RTW_HAL_STATUS_SUCCESS)
+		return -EIO;
+	link->mlmeextpriv.chandef = ch;
+	return 0;
+}
+
+static int wa_nan_restore_channel(void *phl, const struct rtw_chan_def *saved)
+{
+	struct phl_info_t *info = phl;
+	struct dvobj_priv *dvobj = info->phl_com->drv_priv;
+	struct _ADAPTER_LINK *link = GET_PRIMARY_LINK(dvobj_get_primary_adapter(dvobj));
+	struct rtw_chan_def ch = *saved;
+	if (rtw_hal_set_ch_bw(info->hal, link->wrlink->hw_band, &ch,
+		RFK_TYPE_CHG_OP, false, false) != RTW_HAL_STATUS_SUCCESS)
+		return -EIO;
+	link->mlmeextpriv.chandef = ch;
+	return 0;
+}
