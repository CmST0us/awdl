 * rtw_odm_proc:
 * init/deinit when register/unregister net_device, along with rtw_adapter_proc
 */
+static int proc_get_wa_nan_cycle(struct seq_file *m, void *v)
+{
+	(void)m;
+	(void)v;
+	return 0;
+}
+
+static ssize_t proc_set_wa_nan_cycle(struct file *file, const char __user *buffer,
+				     size_t count, loff_t *pos, void *data)
+{
+	struct net_device *netdev = (struct net_device *)data;
+	_adapter *padapter;
+	struct dvobj_priv *dvobj;
+	struct rtw_wifi_role_t *wrole;
+	struct rtw_wifi_role_link_t *rlink;
+	char cmd[8] = {0};
+	int ret;
+
+	(void)file;
+	(void)pos;
+	if (!netdev || count == 0 || count >= sizeof(cmd))
+		return -EINVAL;
+	if (copy_from_user(cmd, buffer, count))
+		return -EFAULT;
+	if (cmd[count - 1] == '\n')
+		cmd[count - 1] = 0;
+	padapter = (_adapter *)rtw_netdev_priv(netdev);
+	dvobj = adapter_to_dvobj(padapter);
+	if (!strcmp(cmd, "cap")) {
+		ret = rtw_phl_wa_nan_cycle_cap(GET_PHL_INFO(dvobj));
+		return ret ? ret : count;
+	}
+	if (!strcmp(cmd, "nan-rx")) {
+		char rxbuf[4096]; int rxret;
+		rxret = rtw_phl_wa_nan_rx_drain(GET_PHL_INFO(dvobj), rxbuf, sizeof(rxbuf));
+		if (rxret > 0) pr_info("%s", rxbuf);
+		return rxret < 0 ? rxret : count;
+	}
+	wrole = padapter->phl_role;
+	if (!wrole || !padapter->adapter_link[0] ||
+	    !padapter->adapter_link[0]->wrlink)
+		return -ENODEV;
+	rlink = padapter->adapter_link[0]->wrlink;
+	if (!strcmp(cmd, "start"))
+		ret = rtw_phl_wa_nan_cycle_start(GET_PHL_INFO(dvobj), wrole, rlink);
+	else if (!strcmp(cmd, "status"))
+		ret = rtw_phl_wa_nan_cycle_status(GET_PHL_INFO(dvobj), wrole, rlink);
+	else if (!strcmp(cmd, "stop")) {
+		rtw_phl_wa_nan_cycle_stop(GET_PHL_INFO(dvobj));
+		ret = 0;
+	}
+	else
+		return -EINVAL;
+	return ret ? ret : count;
+}
