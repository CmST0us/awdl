+/* Keep the next BA window queued while native completion reports return. */
+#define WA_NDI_TX_DEPTH 128
+/* Bound a batch's estimated payload airtime while leaving native RA in control. */
+#define WA_NDI_AGG_AIRTIME_US 4000
+static u8 wa_ndi_aggregate_count(const struct wa_nan_ndi *n, size_t mpdu)
+{
+ u32 rate=wa_ndi_phy_rate(n), usec, spacing;
+ u32 maximum=n->sta->asoc_cap.num_ampdu;
+ if (!rate) return 1;
+ /* rate is in 100 kbit/s; include delimiter and hardware CCMP MIC. */
+ usec=((mpdu+12)*80+rate-1)/rate;
+ /* MPDU spacing codes 1..7 are 0.25,0.5,1,2,4,8,16 us. */
+ spacing=n->config.ampdu_density ? (1U<<(min_t(u8,n->config.ampdu_density,7)-1)) : 0;
+ usec=max_t(u32,usec,(spacing+3)/4);
+ return min_t(u32,maximum,max_t(u32,1,WA_NDI_AGG_AIRTIME_US/max_t(u32,1,usec)));
+}
+/* Correlate failed wireless MPDUs with the NDI capture without payload logs.
+ * The bulk test uses IPv6 TCP without extension headers. */
+struct wa_ndi_tcp {
+ u32 sequence;
+ u16 source, destination, bytes;
+ bool valid;
+};
+static void wa_ndi_tcp_meta(struct wa_ndi_tcp *meta, const struct sk_buff *skb)
+{
+ const u8 *ip, *tcp;
+ u16 payload, header;
+ memset(meta,0,sizeof(*meta));
+ if (skb->len < ETH_HLEN+60 || skb->data[12]!=0x86 || skb->data[13]!=0xdd) return;
+ ip=skb->data+ETH_HLEN;
+ if ((ip[0]>>4)!=6 || ip[6]!=6) return;
+ payload=((u16)ip[4]<<8)|ip[5];
+ tcp=ip+40; header=(tcp[12]>>4)*4;
+ if (header<20 || payload<header || payload>skb->len-ETH_HLEN-40) return;
+ meta->source=((u16)tcp[0]<<8)|tcp[1];
+ meta->destination=((u16)tcp[2]<<8)|tcp[3];
+ meta->sequence=((u32)tcp[4]<<24)|((u32)tcp[5]<<16)|((u32)tcp[6]<<8)|tcp[7];
+ meta->bytes=payload-header; meta->valid=true;
+}
+struct wa_ndi_tx {
+ struct list_head live;
+ struct rtw_txfb_t feedback;
+ struct wa_nan_ndi *owner;
+ struct rtw_xmit_req *request;
+ u32 submitted_ms, txbd_ms;
+ bool txbd_valid;
+ u64 submitted_ns, pn;
+ u32 submit_phase;
+ bool phase_valid;
+ u8 packets;
+ u16 sequence;
+ u32 ba_generation;
+ u64 ba_ack_ns;
+ bool group;
+ struct wa_ndi_tcp tcp[WA_NDI_MSDUS_MAX];
+};
+/* Native tx_time marks pending-WD admission, not hardware transmission.
+ * All three timestamps use the vendor millisecond clock. */
+static void wa_ndi_tx_stages(struct wa_nan_ndi *n, u32 submitted,
+                             u32 pending, u32 completed)
+{
+ n->tx_stage_samples++;
+ n->tx_before_pending_ms += (u32)(pending-submitted);
+ n->tx_after_pending_ms += (u32)(completed-pending);
+}
+static void wa_ndi_feedback(struct rtw_txfb_t *f)
+{
+ struct wa_ndi_tx *tx = f->ctx;
+ struct wa_nan_ndi *n = tx->owner;
+ u64 completed_ns = ktime_get_ns();
+ u64 elapsed_us = (completed_ns - tx->submitted_ns) / 1000;
+ unsigned long flags;
+ spin_lock_irqsave(&wa_ndi_lock, flags);
+ list_del(&tx->live);
+ if (tx->ba_ack_ns) n->ba_completed_acks++;
+ else if (!tx->group && f->txsts == TX_STATUS_TX_DONE) n->ba_unobserved_done++;
+ spin_unlock_irqrestore(&wa_ndi_lock, flags);
+ if (tx->ba_ack_ns && (tx->pn & 63)==1)
+  pr_info("WA_PROBE ndi-ba-complete pn=%llu seq=%u generation=%u ack_ns=%llu completed_ns=%llu status=%u\n",
+          tx->pn,tx->sequence,tx->ba_generation,tx->ba_ack_ns,completed_ns,f->txsts);
+ /* Successful WP completion runs before the original request is recycled. */
+ if (f->txsts == TX_STATUS_TX_DONE) {
+  u32 completed_ms=_os_get_cur_time_ms();
+  wa_ndi_tx_stages(n,tx->submitted_ms,tx->request->tx_time,completed_ms);
+  if (tx->txbd_valid) {
+   n->txbd_samples++;
+   n->tx_pending_to_bd_ms += (u32)(tx->txbd_ms-tx->request->tx_time);
+   n->tx_bd_to_done_ms += (u32)(completed_ms-tx->txbd_ms);
+  }
+ }
+ if (f->txsts == TX_STATUS_TX_DONE) n->dev->stats.tx_packets+=tx->packets;
+ else n->dev->stats.tx_errors+=tx->packets;
+ if (elapsed_us > n->max_tx_us) n->max_tx_us = elapsed_us;
+ n->tx_wait_ns += elapsed_us * 1000;
+ n->tx_done_count++;
+ if (elapsed_us >= 100000) n->tx_slow_count++;
+ if (tx->phase_valid) {
+  u32 high=0, low=0;
+  if (rtw_hal_get_tsf(n->phl->hal,HW_BAND_0,wa_nan_stageb.plan.port[0],&high,&low)==RTW_HAL_STATUS_SUCCESS)
+   pr_info("WA_PROBE ndi-tx-phase pn=%llu submit=%u complete=%u elapsed_us=%llu macid=%u seq=%u submitted_ns=%llu completed_ns=%llu success=%u\n",
+           tx->pn,tx->submit_phase,low&0x7ffff,elapsed_us,n->sta->macid,
+           tx->sequence,tx->submitted_ns,completed_ns,f->txsts==TX_STATUS_TX_DONE);
+ }
+ if (f->txsts != TX_STATUS_TX_DONE) {
+  u32 high=0, low=0;
+  bool valid=rtw_hal_get_tsf(n->phl->hal,HW_BAND_0,wa_nan_stageb.plan.port[0],&high,&low)==RTW_HAL_STATUS_SUCCESS;
+  pr_info("WA_PROBE ndi-tx-failure pn=%llu seq=%u status=%u tsf_valid=%u tsf=%08x:%08x elapsed_us=%llu msdus=%u\n",
+          tx->pn,tx->sequence,f->txsts,valid,high,low,elapsed_us,tx->packets);
+  for (u8 i=0;i<tx->packets;i++) {
+   const struct wa_ndi_tcp *tcp=&tx->tcp[i];
+   if (tcp->valid)
+    pr_info("WA_PROBE ndi-tx-failure-tcp pn=%llu msdu=%u sport=%u dport=%u tcp_seq=%u bytes=%u\n",
+            tx->pn,i,tcp->source,tcp->destination,tcp->sequence,tcp->bytes);
+  }
+ }
+ atomic_dec(&n->outstanding);
+ pr_info_ratelimited("WA_PROBE ndi-tx-done ifindex=%u macid=%u status=%u pn=%llu inflight=%d elapsed_us=%llu\n",
+         n->dev->ifindex, n->sta->macid, f->txsts,
+         (unsigned long long)tx->pn, atomic_read(&n->outstanding),
+         (unsigned long long)elapsed_us);
+ kfree(tx);
+ if (READ_ONCE(n->ready)) schedule_work(&n->work);
+ wa_ndi_put(n);
+}
+/* BA observation never releases requests; WP owns their lifetime. */
+void rtw_phl_wa_nan_tx_ba_observe(struct rtw_phl_stainfo_t *sta, u16 tid,
+                                u16 ssn, u32 low, u32 high, u64 now)
+{
+ struct wa_nan_ndi *n;
+ struct wa_ndi_tx *tx;
+ unsigned long flags;
+ if (tid) return;
+ spin_lock_irqsave(&wa_ndi_lock,flags);
+ n=wa_ndi_rx_owner;
+ if (n && n->ready && n->sta==sta && n->tx_ba)
+  list_for_each_entry(tx,&n->tx_live,live) {
+   u16 offset=(tx->sequence-ssn)&4095;
+   if (!tx->group && tx->ba_generation==n->ba_generation &&
+       offset<64 && !tx->ba_ack_ns &&
+       ((offset<32 ? low : high) & BIT(offset&31))) {
+    tx->ba_ack_ns=now; n->ba_observed_acks++;
+   }
+  }
+ spin_unlock_irqrestore(&wa_ndi_lock,flags);
+}
+/* TXBD contents have been updated; the batch doorbell follows this hook. */
+void rtw_phl_wa_nan_txbd_ready(struct rtw_xmit_req *request)
+{
+ struct wa_ndi_tx *tx;
+ if (!request || !request->txfb || request->txfb->txfb_cb!=wa_ndi_feedback) return;
+ tx=request->txfb->ctx;
+ tx->txbd_ms=_os_get_cur_time_ms();
+ tx->txbd_valid=true;
+}
+/* Bound TX by the peer's receive capability and our supported aggregate size. */
+static size_t wa_ndi_amsdu_limit(const struct wa_nan_ndi *n)
+{
+ if (n->config.vht)
+  return (n->config.vht_info[0]&3) ? WA_NDI_AMSDU_MAX : 3839;
+ return (get_unaligned_le16(n->config.ht_info)&BIT(11)) ? WA_NDI_AMSDU_MAX : 3839;
+}
+
+static size_t wa_ndi_subframe(u8 *out, const struct sk_buff *skb)
+{
+ size_t payload=skb->len-ETH_HLEN+8;
+ memcpy(out,skb->data,12); out[12]=payload>>8; out[13]=payload;
+ memcpy(out+14,"\xaa\xaa\x03\0\0\0",6);
+ memcpy(out+20,skb->data+12,skb->len-12);
+ return 14+payload;
+}
+static int wa_ndi_send(struct wa_nan_ndi *n, struct sk_buff **packets, u8 count)
+{
+ struct sk_buff *skb=packets[0];
+ struct xmit_frame *x;
+ struct wa_ndi_tx *tx = NULL;
+ struct pkt_attrib *a;
+ u8 *f, *body;
+ u64 pn;
+ u64 prepare_start = ktime_get_ns();
+ bool group, mapped = false;
+ int ret = -EIO;
+ size_t payload;
+ if (skb->len < ETH_HLEN || skb->len > n->dev->mtu + ETH_HLEN ||
+     skb_linearize(skb)) return -EINVAL;
+ group = skb->data[0] & 1;
+ if (memcmp(skb->data + 6, n->config.local, 6) ||
+     (!group && memcmp(skb->data, n->config.peer, 6))) return -EHOSTUNREACH;
+ if (!count || count>WA_NDI_MSDUS_MAX || (count>1 && (group || !n->rate_ready)))
+  return -EINVAL;
+ payload=count>1 ? 0 : skb->len-ETH_HLEN+8;
