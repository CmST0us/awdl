@@ -0,0 +1,76 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef WA_NAN_CCMP_H
+#define WA_NAN_CCMP_H
+
+#define WA_NAN_PN_MAX 0xffffffffffffULL
+
+/* This slice supports unfragmented three-address management MPDUs only. */
+static bool wa_ccmp_header(const u8 *f, size_t len)
+{
+ return len >= 30 && f[0] == 0xd0 && !(f[1] & 0x87) &&
+        !(f[22] & 0x0f) && !(f[4] & 1);
+}
+
+static bool wa_ccmp_mgmt(const u8 *f, size_t len)
+{
+ static const u8 prefix[] = {9, 9, 0x50, 0x6f, 0x9a};
+ return len >= 31 && wa_ccmp_header(f, len) &&
+        !memcmp(f + 24, prefix, sizeof(prefix)) &&
+        (f[29] == 0x18 || f[29] == 0x13);
+}
+
+static u64 wa_ccmp_pn(const u8 *iv)
+{
+ return (u64)iv[0] | ((u64)iv[1] << 8) | ((u64)iv[4] << 16) |
+        ((u64)iv[5] << 24) | ((u64)iv[6] << 32) | ((u64)iv[7] << 40);
+}
+
+static void wa_ccmp_iv(u8 *iv, u64 pn)
+{
+ iv[0] = pn; iv[1] = pn >> 8; iv[2] = 0; iv[3] = 0x20;
+ iv[4] = pn >> 16; iv[5] = pn >> 24; iv[6] = pn >> 32; iv[7] = pn >> 40;
+}
+
+/* IEEE CCMP management nonce and AAD; cipher primitives are the driver's
+ * existing hostap-derived AES-CCM implementation. */
+static void wa_ccmp_aad_nonce(const u8 *f, u8 aad[22], u8 nonce[13])
+{
+ const u8 *iv = f + 24;
+ aad[0] = f[0]; aad[1] = (f[1] & ~0x38) | 0x40;
+ memcpy(aad + 2, f + 4, 18);
+ aad[20] = f[22] & 0x0f; aad[21] = 0;
+ nonce[0] = 0x10;
+ memcpy(nonce + 1, f + 10, 6);
+ nonce[7] = iv[7]; nonce[8] = iv[6]; nonce[9] = iv[5];
+ nonce[10] = iv[4]; nonce[11] = iv[1]; nonce[12] = iv[0];
+}
+
+/* scratch has len bytes. HW_DEC selects payload representation only;
+ * both representations require independent MIC verification. */
+static int wa_ccmp_verify(const u8 key[16], const u8 *f, size_t len,
+                         bool hw_plain, u8 *plain, u8 *scratch)
+{
+ u8 aad[22], nonce[13], mic[8], diff = 0;
+ size_t payload;
+ unsigned int i;
+ int ret;
+ if (len < 40 || !(f[1] & 0x40) ||
+     f[26] || f[27] != 0x20 || !wa_ccmp_pn(f + 24)) return -EINVAL;
+ payload = len - 40;
+ wa_ccmp_aad_nonce(f, aad, nonce);
+ memcpy(plain, f, 24);
+ if (hw_plain) {
+  ret = aes_ccm_ae(key, 16, nonce, 8, f + 32, payload,
+                   aad, sizeof(aad), scratch, mic);
+  if (ret) return -EIO;
+  for (i = 0; i < 8; i++) diff |= mic[i] ^ f[len - 8 + i];
+  if (diff) return -EBADMSG;
+  memcpy(plain + 24, f + 32, payload);
+ } else {
+  ret = aes_ccm_ad(key, 16, nonce, 8, f + 32, payload,
+                   aad, sizeof(aad), f + len - 8, plain + 24);
+  if (ret) return -EBADMSG;
+ }
+ return 0;
+}
+#endif
