+++ b/phl/wa_nan_ccmp.c
@@ -0,0 +1,137 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#include "aes_wrap.h"
+#include "wa_nan_ccmp.h"
+
+struct wa_nan_ccmp_state {
+ void *phl;
+ u64 cookie, tx_pn, rx_pn;
+ u8 key[16], nmi[6], peer[6], macid, cam;
+ unsigned int refs;
+ bool ready;
+};
+static struct wa_nan_ccmp_state wa_ccmp;
+static DEFINE_SPINLOCK(wa_ccmp_lock);
+static DECLARE_WAIT_QUEUE_HEAD(wa_ccmp_idle);
+
+static void wa_ccmp_install(void *phl, const u8 *nmi, const u8 *peer,
+                           const u8 *key, u64 cookie, u8 macid, u8 cam)
+{
+ unsigned long flags;
+ spin_lock_irqsave(&wa_ccmp_lock, flags);
+ memset(&wa_ccmp, 0, sizeof(wa_ccmp));
+ wa_ccmp.phl = phl; wa_ccmp.cookie = cookie;
+ wa_ccmp.macid = macid; wa_ccmp.cam = cam;
+ memcpy(wa_ccmp.key, key, 16); memcpy(wa_ccmp.nmi, nmi, 6);
+ memcpy(wa_ccmp.peer, peer, 6); wa_ccmp.ready = true;
+ spin_unlock_irqrestore(&wa_ccmp_lock, flags);
+}
+
+/* DEL disables admission before issuing hardware writes. A failed delete
+ * keeps identity/PN/key for an explicit retry but never resumes TX/RX. */
+static int wa_ccmp_delete_begin(u64 cookie, bool internal)
+{
+ unsigned long flags;
+ int ret = 0;
+ spin_lock_irqsave(&wa_ccmp_lock, flags);
+ if (wa_ccmp.cookie && !internal && cookie != wa_ccmp.cookie) ret = -ESTALE;
+ else wa_ccmp.ready = false;
+ spin_unlock_irqrestore(&wa_ccmp_lock, flags);
+ if (ret) return ret;
+ /* Management TX completes within a 512 TU cycle; allow three cycles.
+  * Keep key identity and PN if completion is missing. */
+ return wait_event_timeout(wa_ccmp_idle, !READ_ONCE(wa_ccmp.refs),
+                           msecs_to_jiffies(1600)) ? 0 : -ETIMEDOUT;
+}
+
+static void wa_ccmp_clear(void)
+{
+ unsigned long flags;
+ spin_lock_irqsave(&wa_ccmp_lock, flags);
+ memzero_explicit(&wa_ccmp, sizeof(wa_ccmp));
+ spin_unlock_irqrestore(&wa_ccmp_lock, flags);
+}
+
+static void wa_ccmp_suspend(void)
+{
+ unsigned long flags;
+ spin_lock_irqsave(&wa_ccmp_lock, flags);
+ wa_ccmp.ready = false;
+ spin_unlock_irqrestore(&wa_ccmp_lock, flags);
+}
+
+static void wa_ccmp_put(void)
+{
+ unsigned long flags;
+ spin_lock_irqsave(&wa_ccmp_lock, flags);
+ wa_ccmp.refs--;
+ spin_unlock_irqrestore(&wa_ccmp_lock, flags);
+ wake_up_all(&wa_ccmp_idle);
+}
+
+static int wa_ccmp_tx_get(void *phl, const u8 *f, size_t len,
+                         const u8 *peer, u64 cookie,
+                         u64 *pn, u8 *macid, u8 *cam)
+{
+ unsigned long flags;
+ int ret = 0;
+ if (!peer || !cookie || !wa_ccmp_mgmt(f, len) || (f[1] & 0x40)) return -EINVAL;
+ spin_lock_irqsave(&wa_ccmp_lock, flags);
+ if (!wa_ccmp.ready || wa_ccmp.phl != phl) ret = -ENOKEY;
+ else if (cookie != wa_ccmp.cookie) ret = -ESTALE;
+ else if (memcmp(peer, wa_ccmp.peer, 6) || memcmp(f + 4, peer, 6) ||
+          memcmp(f + 10, wa_ccmp.nmi, 6)) ret = -EOPNOTSUPP;
+ else if (wa_ccmp.tx_pn == WA_NAN_PN_MAX) ret = -EOVERFLOW;
+ else {
+  *pn = ++wa_ccmp.tx_pn;
+  *macid = wa_ccmp.macid; *cam = wa_ccmp.cam;
+  wa_ccmp.refs++;
+ }
+ spin_unlock_irqrestore(&wa_ccmp_lock, flags);
+ return ret;
+}
+
+int rtw_phl_wa_nan_ccmp_rx(void *phl, const u8 *f, u32 len,
+                         u32 rxflags, struct wa_nan_verified_rx *out)
+{
+ unsigned long flags;
+ u8 key[16], *scratch;
+ u64 pn;
+ int ret;
+ if (len > WA_NAN_FRAME_MAX || len < 46 || !wa_ccmp_header(f, len) ||
+     !(f[1] & 0x40) || f[26] || f[27] != 0x20 ||
+     (rxflags & (WA_NAN_RX_ICV_ERROR | WA_NAN_RX_CRC_ERROR)))
+  return -EINVAL;
+ pn = wa_ccmp_pn(f + 24);
+ spin_lock_irqsave(&wa_ccmp_lock, flags);
+ if (!wa_ccmp.ready || wa_ccmp.phl != phl) ret = -ENOKEY;
+ else if (memcmp(f + 4, wa_ccmp.nmi, 6) || memcmp(f + 10, wa_ccmp.peer, 6)) ret = -ENOENT;
+ else if (pn <= wa_ccmp.rx_pn) ret = -EALREADY;
+ else {
+  ret = 0; wa_ccmp.refs++;
+  memcpy(key, wa_ccmp.key, 16); memcpy(out->peer, wa_ccmp.peer, 6);
+  out->key_cookie = wa_ccmp.cookie;
+ }
+ spin_unlock_irqrestore(&wa_ccmp_lock, flags);
+ if (ret) return ret;
+ scratch = kmalloc(len, GFP_ATOMIC);
+ if (!scratch) { ret = -ENOMEM; goto done; }
+ ret = wa_ccmp_verify(key, f, len,
+                      (rxflags & WA_NAN_RX_HW_DEC) && !(rxflags & WA_NAN_RX_SW_DEC),
+                      out->frame, scratch);
+ memzero_explicit(scratch, len); kfree(scratch);
+ if (ret) goto done;
+ out->len = len - 16;
+ if (!wa_ccmp_mgmt(out->frame, out->len)) { ret = -EPROTO; goto done; }
+ spin_lock_irqsave(&wa_ccmp_lock, flags);
+ if (pn <= wa_ccmp.rx_pn) ret = -EALREADY;
+ else wa_ccmp.rx_pn = pn;
+ spin_unlock_irqrestore(&wa_ccmp_lock, flags);
+ if (!ret) {
+  unsigned int i;
+  for (i = 0; i < 6; i++) out->pn[i] = pn >> (8 * i);
+ }
+done:
+ memzero_explicit(key, sizeof(key));
+ wa_ccmp_put();
+ return ret;
+}
