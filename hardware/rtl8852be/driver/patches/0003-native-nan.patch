+/* SPDX-License-Identifier: GPL-2.0 */
+/* Raw NAN MPDUs use the regular core frame/txreq pools and PCIe recycler. */
+#ifndef WA_NAN_DATA_TX_H
+#define WA_NAN_DATA_TX_H
+
+struct xmit_frame *rtw_core_wa_nan_alloc(_adapter *adapter, u32 length)
+{
+ struct xmit_frame *x = NULL;
+ struct rtw_xmit_req *req;
+ struct rtw_pkt_buf_list *packet;
+ u8 *request, *list;
+ if (core_tx_alloc_xmitframe(adapter, &x, 0) == FAIL) return NULL;
+ x->pkt = NULL;
+ x->buf_need_free = 0;
+ x->xftype = RTW_TX_OS_MAC80211;
+ x->ptxreq_buf = (struct xmit_txreq_buf *)get_txreq_buffer(adapter,
+                                 &request, &list, NULL, NULL);
+ if (!x->ptxreq_buf) goto fail;
+ x->pkt = alloc_skb(length, GFP_KERNEL);
+ if (!x->pkt) goto fail;
+ x->buf_addr = skb_put(x->pkt, length);
+ req = (struct rtw_xmit_req *)request;
+ packet = (struct rtw_pkt_buf_list *)list;
+ memset(req, 0, sizeof(*req));
+ memset(packet, 0, sizeof(*packet));
+ req->os_priv = x;
+ req->pkt_list = list;
+ req->pkt_cnt = 1;
+ req->total_len = length;
+ req->cache = CACHE_ADDR;
+ req->treq_type = RTW_PHL_TREQ_TYPE_NORMAL;
+ packet->vir_addr = x->buf_addr;
+ packet->length = length;
+ x->phl_txreq = req;
+ x->txreq_cnt = 1;
+ return x;
+fail:
+ core_tx_free_xmitframe(adapter, x);
+ return NULL;
+}
+
+void rtw_core_wa_nan_map(_adapter *adapter, struct xmit_frame *x)
+{
+ /* All bytes are final before the regular PCIe DMA mapping. */
+ fill_txreq_phyaddr(adapter, x);
+}
+#endif
