@@ -0,0 +1,45 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Included after wa_native_probe.h by dbg_cmd.c. */
+static u32 cmd_wa_wd_read(struct mac_ax_adapter *adapter,
+		char input[][MAC_MAX_ARGV], u32 input_num,
+		char *output, u32 out_len, u32 *used)
+{
+	struct mac_ax_intf_ops *ops = adapter_to_intf_ops(adapter);
+	u32 pktid = 0, offset = 0, data[16];
+	u32 ret = MACFUNCINPUT, completed = 0, i;
+	u64 begin = ktime_get_ns();
+
+	/* WDE_DLE_NULL_PKTID is 0xfff; WD_PAGE_SEL has base zero. */
+	if (input_num != 2 || kstrtou32(input[1], 16, &pktid) ||
+	    pktid >= 0xfff)
+		goto report;
+	ret = wa_probe_ready(adapter);
+	if (ret != MACSUCCESS)
+		goto report;
+	if (adapter->hw_info->is_sec_ic) {
+		ret = MACIOERRINSEC;
+		goto report;
+	}
+	offset = pktid << 15;
+	PLTFM_MUTEX_LOCK(&adapter->hw_info->ind_access_lock);
+	adapter->hw_info->ind_aces_cnt++;
+	ret = wa_probe_ready(adapter);
+	if (ret == MACSUCCESS) {
+		for (i = 0; i < 16; i++) {
+			MAC_REG_W32(R_AX_FILTER_MODEL_ADDR, offset + i * 4);
+			data[i] = MAC_REG_R32(R_AX_INDIR_ACCESS_ENTRY);
+			completed++;
+		}
+	}
+	adapter->hw_info->ind_aces_cnt--;
+	PLTFM_MUTEX_UNLOCK(&adapter->hw_info->ind_access_lock);
+report:
+	MAC_DBG_MSG(out_len, *used, output + *used, out_len - *used,
+		"WA_WD domain=WD_PAGE_SEL pktid=%03x offset=%08x status=%u bytes=%u begin_ns=%llu end_ns=%llu\n",
+		pktid, offset, ret, completed * 4,
+		(unsigned long long)begin, (unsigned long long)ktime_get_ns());
+	for (i = 0; i < completed; i++)
+		MAC_DBG_MSG(out_len, *used, output + *used, out_len - *used,
+			"WA_WD offset=%08x value=%08x\n", offset + i * 4, data[i]);
+	return ret;
+}
