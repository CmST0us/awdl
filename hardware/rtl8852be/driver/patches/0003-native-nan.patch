+/* SPDX-License-Identifier: GPL-2.0 */
+/* Prepare both channels used by one NAN data schedule. */
+#ifndef WA_NAN_RF_HAL_H
+#define WA_NAN_RF_HAL_H
+
+#ifdef __KERNEL__
+#include "phy/rf/halrf_precomp.h"
+u32 rtw_hal_read_bbreg(void *hal, u32 offset, u32 bit_mask);
+#include "wa_nan_rf_snapshot.h"
+static void wa_nan_rfk_refusal(void *hal);
+
+static void wa_nan_dpk_snapshot(void *hal, const char *stage, u8 center)
+{
+	struct hal_info_t *h = hal;
+	struct rf_info *rf = h->rf;
+	struct halrf_dpk_info *dpk = &rf->dpk;
+	u8 path, index;
+
+	/* DPK bank selection is bit 8; IQK uses bit 0 of the same register. */
+	for (path = 0; path < 2; path++) {
+		for (index = 0; index < 2; index++) {
+			struct dpk_bkup_para *bp = &dpk->bp[path][index];
+			u32 offset = (path << 8) + (index << 2);
+			u32 control = rtw_hal_read_bbreg(hal, 0x81bc + offset, 0xffffffff);
+			u32 gain = rtw_hal_read_bbreg(hal, 0x81b4 + offset, 0xffffffff);
+
+			pr_info("WA_NAN_DPK_STATE stage=%s center=%u path=%u bank=%u selected=%u hw_selected=%u support=%u enabled=%u track=%u reload=%u cal=%u ok=%u channel=%u band=%u bw=%u path_ok=%u control=%08x gain=%08x\n",
+				stage, center, path, index, dpk->cur_idx[path],
+				rtw_hal_read_bbreg(hal, 0x8104 + (path << 8), BIT(8)),
+				!!(rf->support_ability & HAL_RF_DPK),
+				dpk->is_dpk_enable, dpk->is_dpk_track_en,
+				dpk->is_dpk_reload_en, dpk->dpk_cal_cnt,
+				dpk->dpk_ok_cnt, bp->ch, bp->band, bp->bw,
+				bp->path_ok, control, gain);
+		}
+	}
+}
+
+#endif
+
+static u8 wa_nan_rf_primary, wa_nan_rf_center, wa_nan_rf_width;
+static bool wa_nan_rf_ready;
+
+static void rtw_hal_wa_nan_rf_reset(void)
+{
+	wa_nan_rf_primary = wa_nan_rf_center = wa_nan_rf_width = 0;
+	wa_nan_rf_ready = false;
+}
+
+/* NAN func8 op6 carries one channel's two-chain IQC state; op7 suspends
+ * restoration before host RFK so the firmware cannot overwrite its work. */
+static int wa_nan_iqc_command(void *hal, u32 *words)
+{
+	struct mac_ax_adapter *mac = ((struct hal_info_t *)hal)->mac;
+	struct h2c_info info = {
+		.h2c_cat = FWCMD_H2C_CAT_MAC,
+		.h2c_class = FWCMD_H2C_CL_NAN,
+		.h2c_func = 8,
+		.done_ack = 1,
+		.content_len = 32,
+	};
+
+	return mac_h2c_common(mac, &info, words) == MACSUCCESS ? 0 : -EIO;
+}
+
+static void wa_nan_iqc_capture(void *hal, u32 *words, u8 index,
+			       u8 center, u8 width, u8 page)
+{
+	u8 path;
+
+	words[0] = 6 | ((u32)index << 8) | ((u32)center << 16) |
+		   ((u32)width << 24);
+	words[1] = page;
+	for (path = 0; path < 2; path++) {
+		u32 offset = path << 8;
+
+		words[2 + path] = rtw_hal_read_bbreg(hal, 0x8124 + offset, 0xffffffff);
+		words[4 + path] = rtw_hal_read_bbreg(hal, 0x8138 + offset, 0xffffffff);
+		words[6 + path] = rtw_hal_read_bbreg(hal, 0x813c + offset, 0xffffffff);
+	}
+}
+
+/* op9 supplements an IQC record with one chain's TSSI scan state. */
+static void wa_nan_tssi_capture(void *hal, u32 words[2][8], u8 index,
+                                u8 center, u8 width)
+{
+    u8 path;
+    for (path = 0; path < 2; path++) {
+        u32 offset = path << 13;
+        u32 enabled = !!(rtw_hal_read_bbreg(hal, 0x5820 + offset, 0xffffffff) & 0x80000000U);
+        u32 txagc = rtw_hal_read_bbreg(hal, 0x5818 + offset, 0xffffffff) & 0xff;
+        words[path][0] = 9 | ((u32)index << 8) | ((u32)center << 16) |
+                         ((u32)width << 24);
+        words[path][1] = path | (enabled << 8) | (txagc << 16);
+        words[path][2] = rtw_hal_read_bbreg(hal, 0x5630 + offset, 0xffffffff);
+        words[path][3] = rtw_hal_read_bbreg(hal, 0x5634 + offset, 0xffffffff);
+        words[path][4] = rtw_hal_read_bbreg(hal, 0x563c + offset, 0xffffffff);
+        words[path][5] = rtw_hal_read_bbreg(hal, 0x5640 + offset, 0xffffffff);
+        words[path][6] = rtw_hal_read_bbreg(hal, 0x5858 + offset, 0x003ff000);
+        words[path][7] = rtw_hal_read_bbreg(hal, 0x5838 + offset, 0x003ff000);
+    }
+}
+
+static int wa_nan_rf_barrier(void *hal)
+{
+	struct mac_ax_adapter *mac = ((struct hal_info_t *)hal)->mac;
+	struct h2c_info info = {
+		.h2c_cat = FWCMD_H2C_CAT_MAC,
+		.h2c_class = FWCMD_H2C_CL_NAN,
+		.h2c_func = 8,
+		.done_ack = 1,
+		.content_len = 32,
+	};
+	u32 words[8] = {5};
+
+	return mac_h2c_common(mac, &info, words) == MACSUCCESS ? 0 : -EIO;
+}
+
+static bool wa_nan_rf_mapped(struct rf_info *rf, u8 center)
+{
+	u8 path;
+
+	for (path = 0; path < 2; path++)
+		if (rf->iqk.iqk_mcc_ch[0][path] != center &&
+		    rf->iqk.iqk_mcc_ch[1][path] != center)
+			return false;
+	return true;
+}
+
+static int wa_nan_rf_notify(void *hal, u8 current_center, u8 source, u8 target)
+{
+	struct hal_info_t *h = hal;
+	struct rf_info *rf = h->rf;
+	struct rtw_g6_h2c_hdr hdr = {
+		.h2c_class = 10,
+		.h2c_func = 2,
+		.type = H2CB_TYPE_DATA,
+		.content_len = 20,
+	};
+	u32 value[5];
+
+	if (!rf || !wa_nan_rf_mapped(rf, source) ||
+	    !wa_nan_rf_mapped(rf, target))
+		return -EIO;
+	value[0] = rf->iqk.iqk_mcc_ch[0][0];
+	value[1] = rf->iqk.iqk_mcc_ch[0][1];
+	value[2] = rf->iqk.iqk_mcc_ch[1][0];
+	value[3] = rf->iqk.iqk_mcc_ch[1][1];
+	value[4] = current_center;
+
+	if (rtw_hal_mac_send_h2c(h->hal_com, &hdr, value))
+		return -EIO;
+	return wa_nan_rf_barrier(hal);
+}
+
+static int wa_nan_rf_table(void *hal, u8 center, u8 *slot)
+{
+	u32 value = rtw_hal_read_bbreg(hal, 0x9fe4, 0xffffffff);
+	u8 path0 = rtw_hal_read_bbreg(hal, 0x8104, 0xffffffff) & 1;
+	u8 path1 = rtw_hal_read_bbreg(hal, 0x8204, 0xffffffff) & 1;
+	u8 channel0 = (value >> 8) & 0xff;
+	u8 channel1 = value >> 24;
+
+	if (path0 != path1 || channel0 != center || channel1 != center)
+		return -EIO;
+	*slot = path0;
+	return 0;
+}
+
+static int rtw_hal_wa_nan_prepare_channel(
+	void *hal, const struct wa_nan_channel *channel)
+{
+	struct hal_info_t *h = hal;
+	struct rtw_chan_def saved, target;
+	u8 target_slot = 0, source_slot = 0;
+	u32 iqc_target[8], iqc_source[8], suspend[8] = {7}, resume[8] = {8};
+	u32 tssi_target[2][8], tssi_source[2][8];
+	u8 path;
+	int ret, release_ret;
+
+	if (!h || !channel || channel->width > 2)
+		return -EINVAL;
+	if (wa_nan_rf_ready && wa_nan_rf_primary == channel->primary &&
+	    wa_nan_rf_center == channel->center &&
+	    wa_nan_rf_width == channel->width)
+		return 0;
+
+	rtw_hal_get_cur_chdef(hal, HW_BAND_0, &saved);
+	target = saved;
+	target.band = channel->primary > 14 ? BAND_ON_5G : BAND_ON_24G;
+	target.chan = channel->primary;
+	target.center_ch = channel->center;
+	target.bw = channel->width;
+	target.is_dfs = false;
+	target.offset = CHAN_OFFSET_NO_EXT;
+	if (channel->width) {
+		u8 low = channel->center - (channel->width == 2 ? 6 : 2);
+
+		target.offset = ((channel->primary - low) / 4 & 1) ?
+			CHAN_OFFSET_LOWER : CHAN_OFFSET_UPPER;
+	}
+
+	if (target.band == saved.band && target.chan == saved.chan &&
+	    target.center_ch == saved.center_ch && target.bw == saved.bw &&
+	    target.offset == saved.offset) {
+		wa_nan_rf_primary = channel->primary;
+		wa_nan_rf_center = channel->center;
+		wa_nan_rf_width = channel->width;
+		wa_nan_rf_ready = true;
+		return 0;
+	}
+
+	ret = wa_nan_iqc_command(hal, suspend);
+	if (ret) {
+#ifdef __KERNEL__
+		wa_nan_rfk_refusal(hal);
+#endif
+		wa_nan_iqc_command(hal, resume);
+		return ret;
+	}
+	ret = rtw_hal_set_ch_bw(hal, HW_BAND_0, &target, RFK_TYPE_CHG_OP,
+			       false, false) == RTW_HAL_STATUS_SUCCESS ? 0 : -EIO;
+	if (!ret) {
+#ifdef __KERNEL__
+		wa_nan_rf_snapshot(hal, "target", channel->center);
+		wa_nan_dpk_snapshot(hal, "target", channel->center);
+#endif
+		wa_nan_tssi_capture(hal, tssi_target, 0, channel->center, channel->width);
+		ret = wa_nan_rf_table(hal, channel->center, &target_slot);
+		if (!ret)
+			wa_nan_iqc_capture(hal, iqc_target, 0, channel->center,
+					   channel->width, target_slot);
+	}
+
+	/*
+	 * Discovery continues on channel 6. Restore it even when the target
+	 * calibration failed so the existing NAN lifecycle remains valid.
+	 */
+	if (rtw_hal_set_ch_bw(hal, HW_BAND_0, &saved, RFK_TYPE_CHG_OP,
+			      false, false) != RTW_HAL_STATUS_SUCCESS)
+		ret = ret ? ret : -EIO;
+	else {
+#ifdef __KERNEL__
+		wa_nan_rf_snapshot(hal, "source", saved.center_ch);
+		wa_nan_dpk_snapshot(hal, "source", saved.center_ch);
+#endif
+		if (!ret)
+			wa_nan_tssi_capture(hal, tssi_source, 1, saved.center_ch, saved.bw);
+		if (!ret)
+			ret = wa_nan_rf_table(hal, saved.center_ch, &source_slot);
+		if (!ret)
+			wa_nan_iqc_capture(hal, iqc_source, 1, saved.center_ch,
+					   saved.bw, source_slot);
+	}
+	if (!ret && target_slot == source_slot)
+		ret = -EIO;
+	if (!ret)
+		ret = wa_nan_rf_notify(hal, saved.center_ch,
+				       saved.center_ch, channel->center);
+
+	if (!ret) ret = wa_nan_iqc_command(hal, iqc_target);
+	if (!ret) ret = wa_nan_iqc_command(hal, iqc_source);
+	for (path = 0; !ret && path < 2; path++) {
+		ret = wa_nan_iqc_command(hal, tssi_target[path]);
+		pr_info("WA_PROBE nan-tssi-record channel=%u path=%u state=%08x result=%d\n",
+			channel->center, path, tssi_target[path][1], ret);
+		if (!ret) {
+			ret = wa_nan_iqc_command(hal, tssi_source[path]);
+			pr_info("WA_PROBE nan-tssi-record channel=%u path=%u state=%08x result=%d\n",
+				saved.center_ch, path, tssi_source[path][1], ret);
+		}
+	}
+	release_ret = wa_nan_iqc_command(hal, resume);
+	if (!ret) ret = release_ret;
+
+	pr_info("WA_PROBE nan-rf-calibrate result=%d source=%u/%u/%u slot=%u target=%u/%u/%u slot=%u map=%u,%u,%u,%u mcc=%08x ready=%d\n",
+		ret, saved.chan, saved.center_ch, saved.bw,
+		source_slot, channel->primary, channel->center, channel->width,
+		target_slot, h->rf ? ((struct rf_info *)h->rf)->iqk.iqk_mcc_ch[0][0] : 0,
+		h->rf ? ((struct rf_info *)h->rf)->iqk.iqk_mcc_ch[0][1] : 0,
+		h->rf ? ((struct rf_info *)h->rf)->iqk.iqk_mcc_ch[1][0] : 0,
+		h->rf ? ((struct rf_info *)h->rf)->iqk.iqk_mcc_ch[1][1] : 0,
+		rtw_hal_read_bbreg(hal, 0x9fe4, 0xffffffff), !ret);
+	if (ret) {
+		rtw_hal_wa_nan_rf_reset();
+		return ret;
+	}
+	wa_nan_rf_primary = channel->primary;
+	wa_nan_rf_center = channel->center;
+	wa_nan_rf_width = channel->width;
+	wa_nan_rf_ready = true;
+	return 0;
+}
+
+#endif /* WA_NAN_RF_HAL_H */
--- /dev/null
+++ b/phl/hal_g6/wa_nan_rf_snapshot.h
@@ -0,0 +1,71 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef WA_NAN_RF_SNAPSHOT_H
+#define WA_NAN_RF_SNAPSHOT_H
+#include <linux/ktime.h>
+
+u32 rtw_hal_read_macreg(void *hal, u32 offset, u32 bit_mask);
+
+/* Compare completed RFK with native NAN residence without changing RF state. */
+static void wa_nan_rf_snapshot(void *hal, const char *stage, u8 center)
+{
+	u32 values[2][11], tssi[2][6], de[2][8], power[11];
+	static const u32 de_addr[8] = {
+		0x5858, 0x5860, 0x5838, 0x5840,
+		0x5848, 0x5850, 0x5828, 0x5830
+	};
+	u64 started = ktime_get_ns(), elapsed;
+	u8 path, index;
+
+	/* Native band-0 rate power table: 12 legacy and 2 x 16 MCS bytes. */
+	for (index = 0; index < 11; index++)
+		power[index] = rtw_hal_read_macreg(hal, 0xd2c0 + 4 * index, 0xffffffff);
+	for (path = 0; path < 2; path++) {
+		u32 offset = path << 8;
+
+		values[path][0] = rtw_hal_read_bbreg(hal, 0x8104 + offset, 0xffffffff);
+		values[path][1] = rtw_hal_read_bbreg(hal, 0x8154 + offset, 0xffffffff);
+		values[path][2] = rtw_hal_read_bbreg(hal, 0x8124 + offset, 0xffffffff);
+		values[path][3] = rtw_hal_read_bbreg(hal, 0x8138 + offset, 0xffffffff);
+		values[path][4] = rtw_hal_read_bbreg(hal, 0x813c + offset, 0xffffffff);
+		values[path][5] = rtw_hal_read_bbreg(hal, 0x81dc + offset, 0xffffffff);
+		values[path][6] = rtw_hal_read_rfreg(hal, path, 0x58, 0xfffff);
+		values[path][7] = rtw_hal_read_rfreg(hal, path, 0x0a, 0xfffff);
+		values[path][8] = rtw_hal_read_rfreg(hal, path, 0xdf, 0xfffff);
+		values[path][9] = rtw_hal_read_rfreg(hal, path, 0x00, 0xfffff);
+		values[path][10] = rtw_hal_read_rfreg(hal, path, 0x18, 0xfffff);
+		/* Native 8852B TSSI scan-channel restoration uses a 0x2000 path stride. */
+		tssi[path][0] = rtw_hal_read_bbreg(hal, 0x5630 + (path << 13), 0xffffffff);
+		tssi[path][1] = rtw_hal_read_bbreg(hal, 0x5634 + (path << 13), 0xffffffff);
+		tssi[path][2] = rtw_hal_read_bbreg(hal, 0x563c + (path << 13), 0xffffffff);
+		tssi[path][3] = rtw_hal_read_bbreg(hal, 0x5640 + (path << 13), 0xffffffff);
+		tssi[path][4] = rtw_hal_read_bbreg(hal, 0x5818 + (path << 13), 0xffffffff);
+		tssi[path][5] = rtw_hal_read_bbreg(hal, 0x5820 + (path << 13), 0xffffffff);
+		/* halrf_tssi_set_efuse_to_de_8852b selects DE by channel and path. */
+		for (index = 0; index < 8; index++)
+			de[path][index] = rtw_hal_read_bbreg(hal,
+				de_addr[index] + (path << 13), 0x003ff000);
+	}
+	elapsed = (ktime_get_ns() - started) / 1000;
+	pr_info("WA_NAN_TXPOWER stage=%s center=%u legacy=%08x/%08x/%08x mcs=%08x/%08x/%08x/%08x/%08x/%08x/%08x/%08x read_us=%llu\n",
+		stage, center, power[0], power[1], power[2], power[3],
+		power[4], power[5], power[6], power[7], power[8], power[9],
+		power[10], (unsigned long long)elapsed);
+	for (path = 0; path < 2; path++)
+		pr_info("WA_NAN_RF_STATE stage=%s center=%u path=%u page=%08x lut=%08x enable=%08x tx=%08x rx=%08x load=%08x lok=%05x vbuf=%05x lok_ctrl=%05x mode=%05x rf_ch=%05x read_us=%llu\n",
+			stage, center, path, values[path][0], values[path][1],
+			values[path][2], values[path][3], values[path][4],
+			values[path][5], values[path][6], values[path][7],
+			values[path][8], values[path][9], values[path][10],
+			(unsigned long long)elapsed);
+	for (path = 0; path < 2; path++)
+		pr_info("WA_NAN_TSSI_STATE stage=%s center=%u path=%u align=%08x/%08x/%08x/%08x txagc=%08x enable=%08x read_us=%llu\n",
+			stage, center, path, tssi[path][0], tssi[path][1],
+			tssi[path][2], tssi[path][3], tssi[path][4], tssi[path][5],
+			(unsigned long long)elapsed);
+	for (path = 0; path < 2; path++)
+		pr_info("WA_NAN_TSSI_DE stage=%s center=%u path=%u cck=%03x/%03x mcs=%03x/%03x/%03x/%03x/%03x/%03x read_us=%llu\n",
+			stage, center, path, de[path][0], de[path][1],
+			de[path][2], de[path][3], de[path][4], de[path][5],
+			de[path][6], de[path][7], (unsigned long long)elapsed);
+}
+#endif
--- /dev/null
+++ b/phl/hal_g6/wa_nan_schedule_hal.h
@@ -0,0 +1,244 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Native authentication and negotiated data availability records. */
+#ifndef WA_NAN_SCHEDULE_HAL_H
+#define WA_NAN_SCHEDULE_HAL_H
+
+#define WA_NAN_SCHEDULE_KEY 1
+#define WA_NAN_SCHEDULE_N 0xb8e16e08U
+#define WA_NAN_SCHEDULE_T 0xb8e16ae0U
+
+int rtw_hal_wa_nan_schedule_step(void *hal, u32 action, u8 macid)
+{
+	struct mac_ax_adapter *mac = ((struct hal_info_t *)hal)->mac;
+	struct mac_ax_nan_sched_info module = {0};
+	struct mac_ax_nan_avail_t_bitmap_info record = {0};
+	u32 ret;
+	if (macid >= 128) return -EINVAL;
+	if (action == WA_NAN_SCHED_INIT) {
+		/* U2 func0 module2 consumes only module_id and priority. */
+		module.module_id = 2;
+		module.priority = 15;
+		ret = mac_nan_act_schedule_req(mac, &module);
+	} else if (action == WA_NAN_SCHED_ADD) {
+		return rtw_hal_wa_nan_auth_schedule(hal, macid, 2, 1);
+	} else if (action == WA_NAN_SCHED_DELETE) {
+		record.module_id = WA_NAN_SCHEDULE_KEY;
+		record.option = true;
+		record.period_tu = 512;
+		record.bit_duration_tu = 16;
+		record.time_bitmap_len = 1;
+		record.time_bitmap_0_3 = 2;
+		record.channel = 6;
+		record.mac_id = macid;
+		ret = mac_nan_avail_t_bitmap(mac, &record);
+	} else return -EINVAL;
+	return ret == MACSUCCESS ? 0 : -EIO;
+}
+
+static u32 wa_schedule_word(struct mac_ax_adapter *mac, u32 address)
+{
+	return mac_sram_dbg_read(mac, (address & 0x1fffffff) - 0x18006000, AXIDMA_SEL);
+}
+
+int rtw_hal_wa_nan_get_cluster(void *hal, u8 *cluster)
+{
+ struct mac_ax_adapter *mac = ((struct hal_info_t *)hal)->mac;
+ u32 words[3], i;
+ u8 cluster_id[6];
+ for (i=0;i<3;i++) words[i]=wa_schedule_word(mac,0xb8e16db8+4*i);
+ for (i=0;i<6;i++) cluster_id[i]=(words[(i+3)/4] >> (8*((i+3)%4))) & 255;
+ if (memcmp(cluster_id, "\x50\x6f\x9a\x01", 4)) return -EIO;
+ memcpy(cluster, cluster_id, 6);
+ return 0;
+}
+
+int rtw_hal_wa_nan_schedule_cluster(void *hal, const u8 *cluster)
+{
+ u8 active[6];
+ int ret = rtw_hal_wa_nan_get_cluster(hal, active);
+ return ret ? ret : memcmp(active, cluster, 6) ? -EAGAIN : 0;
+}
+
+static int wa_schedule_verify_record(void *hal, u8 macid, u8 key,
+                                     u32 slots, u8 length,
+                                     const struct wa_nan_channel *channel) {
+ struct mac_ax_adapter *mac=((struct hal_info_t *)hal)->mac;
+ u32 table=wa_schedule_word(mac,WA_NAN_SCHEDULE_T), valid=table>>16;
+ u32 count=(table>>8)&255, i, address=0;
+ if (macid>=128 || !count || count>2 || !valid || valid>31 ||
+     (wa_schedule_word(mac,WA_NAN_SCHEDULE_N+36)&0xff00)!=0x700) return -EIO;
+ for (i=0;i<5;i++) if (valid & BIT(i)) {
+  u32 at=WA_NAN_SCHEDULE_T+4+108*i, id=wa_schedule_word(mac,at)&255;
+  if (id!=1 && id!=2) return -EIO;
+  if (id==key) address=at;
+ }
+ u32 phy=channel ? ((u32)channel->primary<<24) | ((u32)channel->width<<16) |
+                   ((u32)channel->center<<8) : 0x600U;
+ if (!address || wa_schedule_word(mac,address)!=(phy|key) ||
+     (wa_schedule_word(mac,address+4)&255)!=16 ||
+     wa_schedule_word(mac,address+8)!=512 ||
+     (wa_schedule_word(mac,address+12)&255)!=length ||
+     wa_schedule_word(mac,address+16)!=slots ||
+     wa_schedule_word(mac,address+20) || wa_schedule_word(mac,address+24) ||
+     wa_schedule_word(mac,address+28) || wa_schedule_word(mac,address+100) ||
+     (wa_schedule_word(mac,address+104)&0xffff)!=macid) return -EIO;
+ return 0;
+}
+int rtw_hal_wa_nan_auth_schedule(void *hal, u8 macid, u32 slots, u8 length)
+{
+	struct mac_ax_adapter *mac = ((struct hal_info_t *)hal)->mac;
+	struct mac_ax_nan_avail_t_bitmap_info record = {0};
+	if (macid >= 128 || !slots || (length != 1 && length != 4) ||
+	    (length == 1 && (slots & ~0xffU)) || slots == 0xffffffffU)
+		return -EINVAL;
+	record.module_id = WA_NAN_SCHEDULE_KEY;
+	record.period_tu = 512;
+	record.bit_duration_tu = 16;
+	record.time_bitmap_len = length;
+	record.time_bitmap_0_3 = slots;
+	record.channel = 6;
+	record.mac_id = macid;
+	if (mac_nan_avail_t_bitmap(mac, &record) != MACSUCCESS) return -EIO;
+	return wa_schedule_verify_record(hal, macid, WA_NAN_SCHEDULE_KEY,
+		slots, length, NULL);
+}
+int rtw_hal_wa_nan_schedule_verify(void *hal, u8 macid, u32 slots,
+				   u8 length, const u8 *cluster)
+{
+ int ret=wa_schedule_verify_record(hal,macid,WA_NAN_SCHEDULE_KEY,
+				   slots,length,NULL);
+ return ret ? ret : rtw_hal_wa_nan_schedule_cluster(hal,cluster);
+}
+int rtw_hal_wa_nan_data_schedule(void *hal, u8 macid, u32 slots,
+                                const struct wa_nan_channel *channel)
+{
+ struct mac_ax_adapter *mac=((struct hal_info_t *)hal)->mac;
+ struct mac_ax_nan_avail_t_bitmap_info record={0};
+ int ret;
+ /* Slot0 is DW; slot1 is retained in authentication record1. */
+ if (macid>=128 || (slots & 3) || !channel || channel->width>2) return -EINVAL;
+ /* The firmware must have both MCC backups before this record can switch. */
+ if (slots) {
+  ret=rtw_hal_wa_nan_prepare_channel(hal,channel);
+  if (ret) return ret;
+ }
+ record.module_id=2; record.option=!slots; record.period_tu=512;
+ record.bit_duration_tu=16; record.time_bitmap_len=4;
+ record.time_bitmap_0_3=slots; record.channel=channel->center;
+ record.bw=channel->width; record.primary_ch_idx=channel->primary;
+ record.mac_id=macid;
+ if (mac_nan_avail_t_bitmap(mac,&record)!=MACSUCCESS) return -EIO;
+ if (slots) return wa_schedule_verify_record(hal,macid,2,slots,4,channel);
+ /* A DELETE completion must also remove the keyed RAM record. */
+ {
+  u32 table=wa_schedule_word(mac,WA_NAN_SCHEDULE_T), i;
+  for (i=0;i<5;i++) if ((table & BIT(16+i)) &&
+      (wa_schedule_word(mac,WA_NAN_SCHEDULE_T+4+108*i)&255)==2) return -EIO;
+ }
+ return 0;
+}
+
+static void wa_schedule_dump(struct mac_ax_adapter *mac, u64 op,
+			     const char *object, u32 address, u32 length)
+{
+	u32 i;
+	for (i = 0; i < length; i += 4)
+		pr_info("WA_PROBE schedule-word op=%llu object=%s address=%08x value=%08x\n",
+			(unsigned long long)op, object, address+i, wa_schedule_word(mac,address+i));
+}
+
+/* Only dereference the allocated U2 module objects reached from N. */
+static bool wa_schedule_pointer(u32 p)
+{
+	return !(p & 3) && (p & 0xfff00000) == 0xb8e00000;
+}
+
+int rtw_hal_wa_nan_schedule_read(void *hal, u64 op, u8 macid)
+{
+	struct mac_ax_adapter *adapter = ((struct hal_info_t *)hal)->mac;
+	struct mac_ax_intf_ops *ops = adapter_to_intf_ops(adapter);
+	u32 modules[3], bitmap, table, valid, count, i, group = (macid / 32) * 4;
+	u64 begin = ktime_get_ns();
+	int ret = 0;
+	if (macid >= 128 || adapter->sm.fwdl != MAC_AX_FWDL_INIT_RDY ||
+	    adapter->sm.pwr != MAC_AX_PWR_ON || adapter->mac_pwr_info.pwr_in_lps ||
+	    adapter->sm.fw_rst != MAC_AX_FW_RESET_IDLE || adapter->hw_info->is_sec_ic)
+		return -ENODEV;
+	for (i=0;i<3;i++) modules[i]=wa_schedule_word(adapter,WA_NAN_SCHEDULE_N+4*i);
+	bitmap=wa_schedule_word(adapter,WA_NAN_SCHEDULE_N+36);
+	table=wa_schedule_word(adapter,WA_NAN_SCHEDULE_T);
+	pr_info("WA_PROBE schedule-root op=%llu n0=%08x n1=%08x n2=%08x allocation=%08x table=%08x macid=%u begin_ns=%llu\n",
+		(unsigned long long)op,modules[0],modules[1],modules[2],bitmap,table,macid,
+		(unsigned long long)begin);
+	/* Authentication and data records share the owned native scheduler. */
+	valid=table >> 16;count=(table >> 8)&255;
+	if (count > 2 || valid > 31 || (!!valid != !!count)) {ret=-EBUSY;goto done;}
+	for(i=0;i<5;i++) if (valid & BIT(i)) {
+		u32 key=wa_schedule_word(adapter,WA_NAN_SCHEDULE_T+4+108*i)&255;
+		if (key!=1 && key!=2) {ret=-EBUSY;goto done;}
+	}
+	for(i=0;i<5;i++) if (table & BIT(16+i))
+		wa_schedule_dump(adapter,op,"record",WA_NAN_SCHEDULE_T+4+108*i,108);
+	for(i=0;i<3;i++) {
+		if (!((bitmap >> 8) & BIT(i))) continue;
+		if (!wa_schedule_pointer(modules[i])) {ret=-EIO;goto done;}
+		if(i==0) wa_schedule_dump(adapter,op,"module0",modules[i]+76,48);
+		if(i==2) wa_schedule_dump(adapter,op,"module2",modules[i],128);
+	}
+	wa_schedule_dump(adapter,op,"anchor",0xb8e16de4,24);
+	wa_schedule_dump(adapter,op,"prepared-key",0xb8e16ad4,4);
+	wa_schedule_dump(adapter,op,"prepared-macid",0xb8e16aa8,4);
+	wa_schedule_dump(adapter,op,"executing",0xb8e168bc,4);
+	wa_schedule_dump(adapter,op,"channel-commit",0xb8e11fb4,16);
+	wa_schedule_dump(adapter,op,"channel-budget",0xb8e11fc0,56);
+	wa_schedule_dump(adapter,op,"sleep-firmware",0xb8e160d8+group,4);
+	wa_schedule_dump(adapter,op,"pause-firmware",0xb8e160e8+group,4);
+	wa_schedule_dump(adapter,op,"sleep-host",0xb8e160f8+group,4);
+	wa_schedule_dump(adapter,op,"pause-host",0xb8e16108+group,4);
+	pr_info("WA_PROBE schedule-register op=%llu sleep_addr=%04x sleep=%08x pause_addr=%04x pause=%08x\n",
+		(unsigned long long)op,R_AX_MACID_SLEEP_0+group,MAC_REG_R32(R_AX_MACID_SLEEP_0+group),
+		R_AX_SS_MACID_PAUSE_0+group,MAC_REG_R32(R_AX_SS_MACID_PAUSE_0+group));
+	for(i=0;i<3;i++) if(modules[i]!=wa_schedule_word(adapter,WA_NAN_SCHEDULE_N+4*i))ret=-EAGAIN;
+	if(bitmap!=wa_schedule_word(adapter,WA_NAN_SCHEDULE_N+36) ||
+	   table!=wa_schedule_word(adapter,WA_NAN_SCHEDULE_T))ret=-EAGAIN;
+done:
+	pr_info("WA_PROBE schedule-read op=%llu result=%d atomic=0 begin_ns=%llu end_ns=%llu\n",
+		(unsigned long long)op,ret,(unsigned long long)begin,(unsigned long long)ktime_get_ns());
+	return ret;
+}
+/* STOP must retire the owned MACID before it can be returned for reuse. */
+int rtw_hal_wa_nan_schedule_clean(void *hal, u8 macid, bool stopped)
+{
+ struct mac_ax_adapter *adapter = ((struct hal_info_t *)hal)->mac;
+ struct mac_ax_intf_ops *ops = adapter_to_intf_ops(adapter);
+ u32 group=(macid/32)*4, mask=BIT(macid%32), values[6], i;
+ if (macid>=128 || adapter->sm.fwdl!=MAC_AX_FWDL_INIT_RDY ||
+     adapter->sm.pwr!=MAC_AX_PWR_ON || adapter->mac_pwr_info.pwr_in_lps ||
+     adapter->sm.fw_rst!=MAC_AX_FW_RESET_IDLE || adapter->hw_info->is_sec_ic)
+  return -ENODEV;
+ if (!stopped) {
+  u32 allocation=wa_schedule_word(adapter,WA_NAN_SCHEDULE_N+36);
+  u32 table=wa_schedule_word(adapter,WA_NAN_SCHEDULE_T);
+  u32 owner=wa_schedule_word(adapter,0xb8e16dfc)>>16;
+  /* The owned DW legitimately holds the firmware gates between windows.
+   * INIT needs its live owner and an empty FAW module/table. */
+  if ((allocation&0xff00)!=0x300 || (table&0xffffff00) || owner!=macid ||
+      !wa_schedule_pointer(wa_schedule_word(adapter,WA_NAN_SCHEDULE_N)) ||
+      !wa_schedule_pointer(wa_schedule_word(adapter,WA_NAN_SCHEDULE_N+4)) ||
+      wa_schedule_word(adapter,WA_NAN_SCHEDULE_N+8)) return -EBUSY;
+  return 0;
+ }
+ if(stopped && ((wa_schedule_word(adapter,WA_NAN_SCHEDULE_N+36)&0xff00) ||
+    (wa_schedule_word(adapter,WA_NAN_SCHEDULE_T)&0xffffff00) ||
+    wa_schedule_word(adapter,WA_NAN_SCHEDULE_N) ||
+    wa_schedule_word(adapter,WA_NAN_SCHEDULE_N+4) ||
+    wa_schedule_word(adapter,WA_NAN_SCHEDULE_N+8))) return -EUCLEAN;
+ for(i=0;i<4;i++) values[i]=wa_schedule_word(adapter,0xb8e160d8+16*i+group);
+ values[4]=MAC_REG_R32(R_AX_MACID_SLEEP_0+group);
+ values[5]=MAC_REG_R32(R_AX_SS_MACID_PAUSE_0+group);
+ pr_info("WA_PROBE schedule-clean stopped=%u macid=%u sleep_firmware=%08x pause_firmware=%08x sleep_host=%08x pause_host=%08x sleep=%08x pause=%08x\n",
+  stopped,macid,values[0],values[1],values[2],values[3],values[4],values[5]);
+ for(i=0;i<6;i++) if(values[i]&mask) return stopped ? -EUCLEAN : -EBUSY;
+ return 0;
+}
