+ mapped = true;
+ atomic_inc(&n->refs);
+ atomic_inc(&n->outstanding);
+ {
+  unsigned long flags;
+  spin_lock_irqsave(&wa_ndi_lock,flags);
+  list_add_tail(&tx->live,&n->tx_live);
+  spin_unlock_irqrestore(&wa_ndi_lock,flags);
+ }
+ if (rtw_phl_add_tx_req(n->phl, x->phl_txreq) != RTW_PHL_STATUS_SUCCESS) {
+  unsigned long flags;
+  spin_lock_irqsave(&wa_ndi_lock,flags);
+  list_del(&tx->live);
+  spin_unlock_irqrestore(&wa_ndi_lock,flags);
+  atomic_dec(&n->outstanding); wa_ndi_put(n);
+  n->tx_enqueue_rejected++;
+  ret = -ENOBUFS; goto fail;
+ }
+ /* The serial worker consumes a QoS sequence only after PHL accepts the frame. */
+ if (group) n->group_sequence++;
+ else n->sequence++;
+ if (atomic_read(&n->outstanding) > n->peak_outstanding)
+  n->peak_outstanding = atomic_read(&n->outstanding);
+ for (u8 i=0;i<count;i++) n->dev->stats.tx_bytes+=packets[i]->len;
+ n->tx_msdus[count]++;
+ pr_info_ratelimited("WA_PROBE ndi-tx ifindex=%u macid=%u pn=%llu bytes=%u group=%u amsdu=%u\n",
+         n->dev->ifindex, n->sta->macid, (unsigned long long)pn, skb->len, group, count>1);
+ return 0;
+fail:
+ kfree(tx);
+ if (mapped) core_recycle_txreq_phyaddr(n->adapter, x->phl_txreq);
+ core_tx_free_xmitframe(n->adapter, x);
+ return ret;
+}
+/* A-MSDU requires an HT transmission. Configuration acceptance precedes
+ * the first firmware rate report; use single MSDUs while RA starts. */
+static bool wa_ndi_aggregate_ready(struct wa_nan_ndi *n)
+{
+ return n->rate_ready &&
+        READ_ONCE(n->sta->hal_sta->ra_info.rpt_rt_i.mode) >= RTW_HT_MODE;
+}
+/* Rate-control feedback bounds A-MSDU size as in rtw89. HE uses the
+ * reported GI; the peer receive limit remains independent. */
+static u32 wa_ndi_phy_rate(const struct wa_nan_ndi *n)
+{
+ const u16 coding[12]={6,12,18,24,36,48,54,60,72,80,90,100};
+ const u16 carriers[2][3]={{52,108,234},{234,468,980}};
+ u8 mode=READ_ONCE(n->sta->hal_sta->ra_info.rpt_rt_i.mode);
+ u8 bw=READ_ONCE(n->sta->hal_sta->ra_info.rpt_rt_i.bw);
+ u8 mcs=READ_ONCE(n->sta->hal_sta->ra_info.rpt_rt_i.mcs_idx);
+ u8 nss=READ_ONCE(n->sta->hal_sta->ra_info.rpt_rt_i.ss)+1;
+ u8 gi=READ_ONCE(n->sta->hal_sta->ra_info.rpt_rt_i.gi_ltf);
+ u16 symbol=mode==3 ? 160 : 40; /* Symbol duration in tenths of us. */
+ /* HT reports MCS0..15 including the stream index; VHT/HE report per stream. */
+ if (mode==RTW_HT_MODE) {
+  if (mcs>15) return 0;
+  mcs&=7;
+ }
+ if (mode<RTW_HT_MODE || mode>3 || bw>2 || mcs>11 || nss>2) return 0;
+ if (mode==3) {
+  switch (gi) {
+  case RTW_GILTF_SGI_4XHE08:
+  case RTW_GILTF_2XHE08:
+  case RTW_GILTF_1XHE08: symbol=136; break;
+  case RTW_GILTF_2XHE16:
+  case RTW_GILTF_1XHE16: symbol=144; break;
+  default: break;
+  }
+ }
+ return (u32)carriers[mode==3][bw]*coding[mcs]*nss*100/(12*symbol);
+}
+static size_t wa_ndi_amsdu_budget(const struct wa_nan_ndi *n)
+{
+ u32 rate=wa_ndi_phy_rate(n);
+ size_t limit=rate<550 ? 1 : rate<1800 ? 1200 : rate<4000 ? 2600 :
+       WA_NDI_AMSDU_MAX;
+ return min_t(size_t,limit,wa_ndi_amsdu_limit(n));
+}
+static void wa_ndi_work(struct work_struct *work)
+{
+ struct wa_nan_ndi *n = container_of(work, struct wa_nan_ndi, work);
+ struct sk_buff *skb;
+ u32 submitted = 0;
+ wa_ndi_ba_work(n);
+ if (n->ba_draining || n->ba_requested) return;
+ while (READ_ONCE(n->ready) && atomic_read(&n->outstanding) < WA_NDI_TX_DEPTH &&
+        (skb = skb_dequeue(&n->queue))) {
+  struct sk_buff *packets[WA_NDI_MSDUS_MAX]={skb};
+  u8 count=1;
+  size_t length=skb->len+8, limit=wa_ndi_amsdu_budget(n);
+  int ret;
+  if (wa_ndi_aggregate_ready(n) && (!n->tx_ba || n->tx_ba_amsdu) &&
+      skb->len>=ETH_HLEN && !(skb->data[0]&1)) {
+   while (count<WA_NDI_MSDUS_MAX) {
+    struct sk_buff *next=skb_dequeue(&n->queue);
+    size_t total;
+    if (!next) break;
+    total=((length+3)&~3U)+next->len+8;
+    if (next->len<ETH_HLEN || next->len>n->dev->mtu+ETH_HLEN ||
+        memcmp(skb->data,next->data,12) || total>limit) {
+     skb_queue_head(&n->queue,next); break;
+    }
+    packets[count++]=next; length=total;
+   }
+  }
+  ret = wa_ndi_send(n, packets, count);
+  if (!ret) submitted++;
+  if ((ret == -ENOMEM || ret == -ENOBUFS) && atomic_read(&n->outstanding)) {
+   while (count) skb_queue_head(&n->queue,packets[--count]);
+   break; /* A completion releases resources and schedules this work again. */
+  }
+  if (ret) n->dev->stats.tx_dropped+=count;
+  while (count) dev_kfree_skb(packets[--count]);
+ }
+ /* Queue and completion counts are sampled independently at worker exit. */
+ n->work_batches[!submitted ? 0 : submitted==1 ? 1 : submitted<8 ? 2 :
+                 submitted<32 ? 3 : submitted<64 ? 4 : 5]++;
+ n->work_mpdus += submitted;
+ if (!skb_queue_len(&n->queue)) n->work_queue_empty++;
+ else if (atomic_read(&n->outstanding) >= WA_NDI_TX_DEPTH) n->work_depth_full++;
+ else n->work_other++;
+ if (submitted) rtw_phl_tx_req_notify(n->phl);
+ if (READ_ONCE(n->ready) && skb_queue_len(&n->queue) < 128)
+  netif_wake_queue(n->dev);
+}
+static netdev_tx_t wa_ndi_xmit(struct sk_buff *skb, struct net_device *dev)
+{
+ struct wa_nan_ndi *n = netdev_priv(dev);
+ if (!READ_ONCE(n->ready)) {
+  dev->stats.tx_dropped++; dev_kfree_skb(skb); return NETDEV_TX_OK;
+ }
+ if (skb_queue_len(&n->queue) >= 256) {
+  netif_stop_queue(dev); return NETDEV_TX_BUSY;
+ }
+ skb_queue_tail(&n->queue, skb);
+ schedule_work(&n->work);
+ return NETDEV_TX_OK;
+}
+static int wa_ndi_open(struct net_device *dev)
+{
+ struct wa_nan_ndi *n = netdev_priv(dev);
+ if (READ_ONCE(n->ready)) netif_start_queue(dev);
+ return 0;
+}
+static int wa_ndi_close(struct net_device *dev)
+{
+ netif_stop_queue(dev);
+ return 0;
+}
+static const struct net_device_ops wa_ndi_ops = {
+ .ndo_open = wa_ndi_open, .ndo_stop = wa_ndi_close,
+ .ndo_start_xmit = wa_ndi_xmit,
+};
+
+static int wa_ndi_msdu(struct wa_nan_ndi *n, struct sk_buff_head *packets,
+                       const u8 *addresses, const u8 *body, size_t length)
+{
+ struct sk_buff *skb;
+ if (length<8 || length>n->dev->mtu+8 || memcmp(body,"\xaa\xaa\x03\0\0\0",6)) return -EINVAL;
+ if ((!(addresses[0]&1) && memcmp(addresses,n->config.local,6)) ||
+     memcmp(addresses+6,n->config.peer,6)) return -EHOSTUNREACH;
+ skb=netdev_alloc_skb_ip_align(n->dev,length+6);
+ if (!skb) return -ENOMEM;
+ memcpy(skb_put(skb,12),addresses,12);
+ memcpy(skb_put(skb,length-6),body+6,length-6);
+ skb_queue_tail(packets,skb);
+ return 0;
+}
+static int wa_ndi_payload(struct wa_nan_ndi *n, const u8 *f,
+                          const u8 *body, size_t length, struct sk_buff_head *packets)
+{
+ size_t offset=0;
+ int ret;
+ if (f[0]!=0x88 || !(f[24]&0x80)) return wa_ndi_msdu(n,packets,f+4,body,length);
+ /* VHT advertises the whole MPDU, including QoS header, CCMP and FCS. */
+ if (length>(n->config.vht ? WA_NDI_VHT_MPDU_MAX-46 : WA_NDI_AMSDU_MAX))
+  return -EMSGSIZE;
+ do {
+  size_t size, used;
+  if (length-offset<14) return -EINVAL;
+  size=((size_t)body[offset+12]<<8)|body[offset+13];
+  if (size>length-offset-14) return -EINVAL;
+  ret=wa_ndi_msdu(n,packets,body+offset,body+offset+14,size);
+  if (ret) return ret;
+  used=14+size;
+  if (offset+used==length) return 0;
+  offset+=(used+3)&~3U;
+ } while (offset<length);
+ return -EINVAL;
+}
+
+/* Snapshot only the active NDP's authenticated unicast QoS receive state. */
+bool rtw_phl_wa_nan_rx_delivered(void *phl, struct rtw_phl_stainfo_t *sta,
+                                u8 tid, u16 *seq)
+{
+ struct wa_nan_ndi *n;
+ unsigned long flags;
+ bool valid=false;
+ if (tid>=16) return false;
+ spin_lock_irqsave(&wa_ndi_lock,flags);
+ n=wa_ndi_rx_owner;
+ if (n && n->ready && n->phl==phl && n->sta==sta && n->rx_pn[tid]) {
+  *seq=n->rx_seq[tid];
+  valid=true;
+ }
+ spin_unlock_irqrestore(&wa_ndi_lock,flags);
+ return valid;
+}
+
+int rtw_phl_wa_nan_data_rx(void *phl, const u8 *f, u32 len, u32 flags,
+                           u8 macid, u8 cam, u8 cipher, u32 rx_counter, u8 rx_band, u8 deferred)
+{
+ struct wa_nan_ndi *n;
+ struct sk_buff *skb;
+ struct sk_buff_head packets;
+ unsigned long irq;
+ u8 key[16], *plain = NULL;
+ u64 pn=0, previous=0, *counter;
+ u64 entry_ns=ktime_get_ns(), previous_entry_ns;
+ u16 previous_seq=0, *rx_seq;
+ struct wa_ndi_rx_origin previous_origin={0}, *origin;
+ int h, ret = -EINVAL, tid=-1;
+ bool group;
+ if (len < 24 || ((f[0] & 0x0c) != 8 && f[0]!=0xd0)) return false;
+ spin_lock_irqsave(&wa_ndi_lock, irq);
+ n = wa_ndi_rx_owner;
+ if (!n || !n->ready || n->phl != phl ||
+     (!(f[4]&1) && memcmp(f+4, n->config.local, 6)) ||
+     memcmp(f+10, n->config.peer, 6)) {
+  spin_unlock_irqrestore(&wa_ndi_lock, irq); return false;
+ }
+ atomic_inc(&n->refs);
+ spin_unlock_irqrestore(&wa_ndi_lock, irq);
+ if (f[0]==0xd0) {
+  bool consumed=wa_ndi_ba_rx(n,f,len,flags);
+  wa_ndi_put(n);
+  return consumed;
+ }
+ skb_queue_head_init(&packets);
+ h = wa_data_header(f, len);
+ if (h < 0 || len > (n->config.vht ? WA_NDI_VHT_MPDU_MAX-4 : WA_NDI_AMSDU_MAX+42) || len < h+24 ||
+     (flags & (WA_NAN_RX_CRC_ERROR | WA_NAN_RX_ICV_ERROR)) ||
+     memcmp(f+16, wa_nan_stageb.plan.cluster, 6)) goto done;
+ if (!n->rx_hw_count && !n->rx_sw_count)
+  pr_info("WA_PROBE ndi-rx-meta flags=%x macid=%u cam=%u cipher=%u expected_macid=%u expected_cam=%u\n",
+          flags,macid,cam,cipher,n->sta->macid,n->pairwise_cam);
+ tid = h == 26 ? f[24] & 15 : 16;
+ group = f[4] & 1;
+ if ((f[h+3] >> 6) != (group ? n->config.peer_gtk_index : 0)) goto done;
+ pn = wa_ccmp_pn(f+h);
+ counter = group ? &n->group_rx_pn[tid] : &n->rx_pn[tid];
+ rx_seq = group ? &n->group_rx_seq[tid] : &n->rx_seq[tid];
+ origin = group ? &n->group_rx_origin[tid] : &n->rx_origin[tid];
+ spin_lock_irqsave(&wa_ndi_lock, irq);
+ previous=*counter;
+ previous_seq=*rx_seq;
+ previous_origin=*origin;
+ if (pn <= previous) { spin_unlock_irqrestore(&wa_ndi_lock, irq); ret = -EALREADY; goto done; }
+ memcpy(key, group ? n->config.peer_gtk : n->config.tk, 16);
+ spin_unlock_irqrestore(&wa_ndi_lock, irq);
+ if ((flags & WA_NAN_RX_HW_DEC) && !(flags & WA_NAN_RX_SW_DEC)) {
+  if (macid != n->sta->macid || cipher != RTW_ENC_CCMP ||
+      cam != (group ? n->peer_group_cam : n->pairwise_cam) ||
+      !(f[1] & 0x40) || f[h+2] || (f[h+3] & 0x3f) != 0x20 || !pn)
+   goto done;
+  /* RTL's ICVERR covers CCMP authentication; metadata must identify the
+   * installed key before consuming hardware plaintext. */
+  ret=wa_ndi_payload(n,f,f+h+8,len-h-16,&packets);
+  n->rx_hw_count++;
+ } else {
+  plain = kmalloc(len, GFP_ATOMIC);
+  if (!plain) { ret = -ENOMEM; goto done; }
+  ret = wa_data_decrypt(key, f, len, false, plain, NULL);
+  if (ret<0) goto done;
+  ret=wa_ndi_payload(n,f,plain,ret,&packets);
+  n->rx_sw_count++;
+ }
+ if (ret) goto done;
+ spin_lock_irqsave(&wa_ndi_lock, irq);
+ previous=*counter;
+ previous_seq=*rx_seq;
+ previous_origin=*origin;
+ if (pn <= previous || !n->ready) {
+  spin_unlock_irqrestore(&wa_ndi_lock, irq); ret = -EALREADY; goto done;
+ }
+ *counter = pn;
+ *rx_seq = get_unaligned_le16(f+22)>>4;
+ *origin=(struct wa_ndi_rx_origin){.entry_ns=entry_ns, .counter=rx_counter,
+          .flags=flags, .bytes=len, .band=rx_band, .deferred=deferred,
+          .retry=!!(f[1]&8)};
+ previous_entry_ns=n->rx_last_entry_ns;
+ n->rx_last_entry_ns=entry_ns;
+ n->rx_msdus[min_t(unsigned int,skb_queue_len(&packets),5)]++;
+ if (flags&WA_NAN_RX_AMPDU) n->rx_ampdu_count++;
+ spin_unlock_irqrestore(&wa_ndi_lock, irq);
+ while ((skb=skb_dequeue(&packets))) {
+  skb->protocol=eth_type_trans(skb,n->dev); skb->ip_summed=CHECKSUM_NONE;
+  n->dev->stats.rx_packets++; n->dev->stats.rx_bytes+=skb->len;
+  netif_rx(skb);
+ }
+ /* Observe the end of an RX gap, without delaying or scheduling delivery. */
+ if (previous_entry_ns && entry_ns-previous_entry_ns>=100000000ULL) {
+  u32 high=0, low=0, counter_high=0, counter_low=0;
+  /* This marks netif_rx submission, not TCP processing completion. */
+  u64 delivered_ns=ktime_get_ns(), tsf_sampled_ns, counter_sampled_ns;
+  bool valid=rtw_hal_get_tsf(n->phl->hal,HW_BAND_0,wa_nan_stageb.plan.port[0],&high,&low)==RTW_HAL_STATUS_SUCCESS;
+  bool counter_valid;
+  tsf_sampled_ns=ktime_get_ns();
+  /* RX descriptor and CMAC freerun share a counter, independent of TSF.
+   * Preserve raw ticks so resets and clock scaling remain observable. */
+  counter_valid=rtw_hal_get_freerun_counter(n->phl->hal,rx_band,&counter_high,&counter_low)==RTW_HAL_STATUS_SUCCESS;
+  counter_sampled_ns=ktime_get_ns();
+  pr_info("WA_PROBE ndi-rx-gap pn=%llu seq=%u gap_us=%llu entry_ns=%llu delivered_ns=%llu tsf_valid=%u tsf=%08x:%08x sampled_ns=%llu\n",
+          pn,get_unaligned_le16(f+22)>>4,(entry_ns-previous_entry_ns)/1000,
+          entry_ns,delivered_ns,valid,high,low,tsf_sampled_ns);
+  pr_info("WA_PROBE ndi-rx-age pn=%llu seq=%u band=%u deferred=%u descriptor=%08x counter_valid=%u counter=%08x:%08x age_ticks=%u sampled_ns=%llu\n",
+          pn,get_unaligned_le16(f+22)>>4,rx_band,deferred,rx_counter,
+          counter_valid,counter_high,counter_low,(u32)(counter_low-rx_counter),counter_sampled_ns);
+ }
+ pr_info_ratelimited("WA_PROBE ndi-rx ifindex=%u macid=%u pn=%llu tid=%u bytes=%u group=%u seq=%u deferred=%u entry_ns=%llu\n",
+         n->dev->ifindex, n->sta->macid, (unsigned long long)pn, tid, len, group,
+         get_unaligned_le16(f+22)>>4,deferred,entry_ns);
+ ret = 0;
+done:
+ if (ret) {
+  n->dev->stats.rx_dropped++;
+  pr_info_ratelimited("WA_PROBE ndi-rx-drop bytes=%u flags=%x result=%d tid=%d pn=%llu previous=%llu seq=%u previous_seq=%u retry=%u entry_ns=%llu descriptor=%08x band=%u deferred=%u previous_entry_ns=%llu previous_descriptor=%08x previous_band=%u previous_deferred=%u previous_retry=%u previous_flags=%x previous_bytes=%u\n",
+          len,flags,ret,tid,pn,previous,get_unaligned_le16(f+22)>>4,previous_seq,!!(f[1]&8),
+          entry_ns,rx_counter,rx_band,deferred,previous_origin.entry_ns,
+          previous_origin.counter,previous_origin.band,previous_origin.deferred,
+          previous_origin.retry,previous_origin.flags,previous_origin.bytes);
+ }
+ skb_queue_purge(&packets);
+ kfree_sensitive(plain); memzero_explicit(key, sizeof(key));
+ wa_ndi_put(n);
+ return ret ? ret : 1;
+}
+
+static int wa_ndi_members(struct wa_nan_stageb_ctx *ctx, bool data_ready)
+{
+ u8 members[2], count = 0;
+ int ret;
+ if (ctx->peer) members[count++] = ctx->peer->macid;
+ if (ctx->ndi && ctx->ndi->sta && ctx->ndi->sta != ctx->peer)
+  members[count++] = ctx->ndi->sta->macid;
+ ret = rtw_hal_wa_nan_faw_members(ctx->phl->hal, &ctx->plan,
+                                  ctx->bigtk_index, members, count,
+                                  data_ready && ctx->ndi ? ctx->ndi->sta->macid : 0xff);
+ if (!ret && ctx->data_slots && ctx->ndi && ctx->ndi->sta &&
+     ctx->data_macid != ctx->ndi->sta->macid) {
+  ret = rtw_hal_wa_nan_data_schedule(ctx->phl->hal, ctx->ndi->sta->macid,
+                                    ctx->data_slots, &ctx->data_channel);
+  if (!ret) ctx->data_macid = ctx->ndi->sta->macid;
+ }
+ return ret;
+}
+static int wa_ndi_quiesce(struct wa_nan_ndi *n)
+{
+ unsigned long flags;
+ if (!n) return 0;
+ spin_lock_irqsave(&wa_ndi_lock, flags);
+ n->ready = false;
+ if (wa_ndi_rx_owner == n) wa_ndi_rx_owner = NULL;
+ spin_unlock_irqrestore(&wa_ndi_lock, flags);
+ netif_tx_disable(n->dev); netif_carrier_off(n->dev);
+ cancel_delayed_work_sync(&n->ba_expiry);
+ cancel_work_sync(&n->work);
+ /* A worker already past its ready check may have armed the expiry. */
+ cancel_delayed_work_sync(&n->ba_expiry);
+ skb_queue_purge(&n->queue);
+ skb_queue_purge(&n->ba_queue);
+ if (atomic_read(&n->outstanding)) {
+  int ret=rtw_hal_wa_nan_data_drop(n->phl->hal,n->sta);
+  if (ret) return ret;
+ }
+ /* Drop acceptance is not completion; callbacks own the remaining refs. */
+ return wait_event_timeout(n->idle, !atomic_read(&n->refs),
+                           msecs_to_jiffies(1000)) ? 0 : -ETIMEDOUT;
+}
+static bool wa_ndi_has_session(struct wa_nan_stageb_ctx *ctx)
+{
+ return ctx->ndi && ctx->ndi->session;
+}
+static int wa_ndi_release(struct wa_nan_stageb_ctx *ctx, bool destroy)
+{
+ struct wa_nan_ndi *n = ctx->ndi;
+ struct phl_sec_param_h crypt = { .keyid=0, .enc_type=RTW_ENC_CCMP,
+   .key_type=RTW_SEC_KEY_UNICAST, .key_len=16 };
+ u8 member;
+ int ret;
+ if (!n) return 0;
+ ret = wa_ndi_quiesce(n);
+ if (ret) return ret;
+ wa_ndi_ba_stop(n);
+ if (n->mgmt_cam_hidden) {
+  ret=rtw_hal_wa_nan_mgmt_match(ctx->phl->hal,ctx->mgmt->macid,true);
+  if (ret) return ret;
+  n->mgmt_cam_hidden=false;
+ }
+ if (n->session && ctx->data_slots) {
+  ret = rtw_hal_wa_nan_data_schedule(ctx->phl->hal, ctx->data_macid, 0, &ctx->data_channel);
+  if (ret) return ret;
+  ctx->data_slots = 0; ctx->data_macid = 0;
+ }
+ if (n->session && ctx->fw_touched && ctx->bigtk_ready) {
+  member = ctx->peer ? ctx->peer->macid : 0;
+  ret = rtw_hal_wa_nan_faw_members(ctx->phl->hal, &ctx->plan,
+       ctx->bigtk_index, &member, ctx->peer ? 1 : 0, 0xff);
+  if (ret) return ret;
+ }
+ if (n->data_rx_bound) {
+  ret=rtw_hal_wa_nan_data_rx_mode(ctx->phl->hal,n->sta->macid,NULL);
+  if (ret) return ret;
+  n->data_rx_bound=false;
+ }
+ if (n->local_group_attempted) {
+  crypt.keyid=n->config.gtk_index; crypt.key_type=RTW_SEC_KEY_MULTICAST;
+  if (rtw_phl_cmd_del_key(ctx->phl,ctx->mgmt,&crypt,PHL_CMD_DIRECTLY,0)!=
+      RTW_PHL_STATUS_SUCCESS) return -EIO;
+  n->local_group_attempted=false;
+  crypt.keyid=0; crypt.key_type=RTW_SEC_KEY_UNICAST;
+ }
+ if (n->key_attempted) {
+  if (n->group_attempted) {
+   crypt.keyid=n->config.peer_gtk_index; crypt.key_type=RTW_SEC_KEY_MULTICAST;
+   if (rtw_phl_cmd_del_key(ctx->phl,n->sta,&crypt,PHL_CMD_DIRECTLY,0) !=
+       RTW_PHL_STATUS_SUCCESS) return -EIO;
+   n->group_attempted=false;
+   crypt.keyid=0; crypt.key_type=RTW_SEC_KEY_UNICAST;
+  }
+  if (!n->shared_peer &&
+      rtw_phl_cmd_del_key(ctx->phl, n->sta, &crypt, PHL_CMD_DIRECTLY, 0) !=
+      RTW_PHL_STATUS_SUCCESS) return -EIO;
+  n->key_attempted = false;
+ }
+ if (n->rate_ready) {
+  ret=rtw_hal_wa_nan_rate(ctx->phl->hal,n->sta,NULL,false);
+  if (ret) return ret;
+  n->rate_ready=false;
+ }
+ if (n->sta_ready) {
+  if (rtw_phl_cmd_alloc_stainfo(ctx->phl, &n->sta, NULL, ctx->wrole,
+      DEV_TYPE_LEGACY, 0, ctx->rlink, false, true, PHL_CMD_DIRECTLY, 0) !=
+      RTW_PHL_STATUS_SUCCESS) return -EIO;
+  n->sta_ready = false;
+ }
+ if (n->shared_peer) n->sta = NULL;
+ if (n->sta) {
+  if (rtw_phl_free_stainfo_sw(ctx->phl, n->sta) != RTW_PHL_STATUS_SUCCESS)
+   return -EIO;
+  n->sta = NULL;
+ }
+ if (destroy && n->registered) {
+  /* Vendor commands hold the wiphy mutex. Do not wait on inverse RTNL. */
+  if (!rtnl_trylock()) return -EBUSY;
+  unregister_netdevice(n->dev);
+  rtnl_unlock();
+  n->registered = false;
+ }
+ pr_info("WA_PROBE ndi-removed tx=%lu rx=%lu tx_error=%lu rx_drop=%lu tx_drop=%lu peak_inflight=%u max_tx_us=%llu\n",
+         n->dev->stats.tx_packets, n->dev->stats.rx_packets,
+         n->dev->stats.tx_errors, n->dev->stats.rx_dropped, n->dev->stats.tx_dropped,
+         n->peak_outstanding, (unsigned long long)n->max_tx_us);
+ pr_info("WA_PROBE ndi-cost prepare_us=%llu wait_us=%llu completed=%llu slow100ms=%llu rx_hw=%llu rx_sw=%llu\n",
+         n->prepare_ns/1000, n->tx_wait_ns/1000, n->tx_done_count,
+         n->tx_slow_count, n->rx_hw_count, n->rx_sw_count);
+ pr_info("WA_PROBE ndi-tx-stages samples=%llu before_pending_ms=%llu after_pending_ms=%llu\n",
+         n->tx_stage_samples,n->tx_before_pending_ms,n->tx_after_pending_ms);
+ pr_info("WA_PROBE ndi-txbd-stages samples=%llu pending_to_bd_ms=%llu bd_to_done_ms=%llu\n",
+         n->txbd_samples,n->tx_pending_to_bd_ms,n->tx_bd_to_done_ms);
+ pr_info("WA_PROBE ndi-work batches_0_1_2to7_8to31_32to63_64plus=%llu/%llu/%llu/%llu/%llu/%llu mpdus=%llu queue_empty=%llu queued_depth_full=%llu other=%llu\n",
+         n->work_batches[0],n->work_batches[1],n->work_batches[2],n->work_batches[3],
+         n->work_batches[4],n->work_batches[5],n->work_mpdus,
+         n->work_queue_empty,n->work_depth_full,n->work_other);
+ pr_info("WA_PROBE ndi-submit alloc_failed=%llu enqueue_rejected=%llu\n",
+         n->tx_alloc_failed,n->tx_enqueue_rejected);
+ pr_info("WA_PROBE ndi-ba-lifecycle observed=%llu completed_observed=%llu done_without_observation=%llu generation=%u\n",
+         n->ba_observed_acks,n->ba_completed_acks,n->ba_unobserved_done,n->ba_generation);
+ pr_info("WA_PROBE ndi-ampdu tx_submitted=%llu rx_received=%llu\n",n->tx_ampdu_count,n->rx_ampdu_count);
+ pr_info("WA_PROBE ndi-msdus tx=%llu/%llu/%llu/%llu/%llu rx=%llu/%llu/%llu/%llu/%llu tx_limit=%zu\n",
+         n->tx_msdus[1],n->tx_msdus[2],n->tx_msdus[3],n->tx_msdus[4],n->tx_msdus[5],
+         n->rx_msdus[1],n->rx_msdus[2],n->rx_msdus[3],n->rx_msdus[4],n->rx_msdus[5],wa_ndi_amsdu_limit(n));
+ memzero_explicit(&n->config, sizeof(n->config));
+ n->session = false;
+ if (!destroy) return 0;
+ ctx->ndi = NULL;
+ free_netdev(n->dev);
+ module_put(THIS_MODULE);
+ return 0;
+}
+static int wa_ndi_delete(struct wa_nan_stageb_ctx *ctx)
+{
+ return wa_ndi_release(ctx, true);
+}
+static int wa_ndi_create(struct wa_nan_stageb_ctx *ctx, bool persistent)
+{
+ struct net_device *dev;
+ struct wa_nan_ndi *n;
+ int ret;
+ if (ctx->ndi) return -EEXIST;
+ if (!try_module_get(THIS_MODULE)) return -ENODEV;
+ dev = alloc_etherdev(sizeof(*n));
+ if (!dev) { module_put(THIS_MODULE); return -ENOMEM; }
+ n = netdev_priv(dev);
+ n->dev = dev; n->phl = ctx->phl; n->persistent = persistent;
+ n->adapter = dvobj_get_primary_adapter((struct dvobj_priv *)ctx->phl->phl_com->drv_priv);
+ skb_queue_head_init(&n->queue); skb_queue_head_init(&n->ba_queue);
+ INIT_WORK(&n->work, wa_ndi_work);
+ INIT_DELAYED_WORK(&n->ba_expiry, wa_ndi_ba_expired);
+ INIT_LIST_HEAD(&n->tx_live);
+ init_waitqueue_head(&n->idle); atomic_set(&n->refs, 0); atomic_set(&n->outstanding, 0);
+ strscpy(dev->name, persistent ? "ndi0" : "aware%d", IFNAMSIZ);
+ dev->netdev_ops = &wa_ndi_ops; dev->min_mtu = 1280; dev->max_mtu = 1500;
+ dev->flags |= IFF_NOARP;
+ eth_hw_addr_set(dev, ctx->plan.nmi); netif_carrier_off(dev);
+ /* The persistent interface is visible before any peer or GTK exists. */
+ if (persistent) {
+  if (!rtnl_trylock()) { ret = -EBUSY; goto failed; }
+  ret = register_netdevice(dev);
+  rtnl_unlock();
+  if (ret) goto failed;
+  n->registered = true;
+ }
+ ctx->ndi = n;
+ return 0;
+failed:
+ free_netdev(dev); module_put(THIS_MODULE);
+ return ret;
+}
+static void wa_ndi_new_session(struct wa_nan_ndi *n,
+                               const struct wa_nan_ndi_config *config)
+{
+ n->config = *config;
+ memset(n->config.tk, 0, 16); memset(n->config.peer_gtk, 0, 16);
+ n->config.peer_gtk_index = 0xff;
+ n->tx_pn = n->gtk_pn = n->ba_tx_pn = n->ba_rx_pn = 0;
+ memset(n->rx_pn, 0, sizeof(n->rx_pn));
+ memset(n->group_rx_pn, 0, sizeof(n->group_rx_pn));
+ memset(n->rx_seq, 0, sizeof(n->rx_seq));
+ memset(n->group_rx_seq, 0, sizeof(n->group_rx_seq));
+ memset(n->rx_origin, 0, sizeof(n->rx_origin));
+ memset(n->group_rx_origin, 0, sizeof(n->group_rx_origin));
+ n->sequence = n->group_sequence = 0;
+ n->ba_requested = n->ba_draining = n->tx_ba_amsdu = false;
+ n->ba_attempts = n->ba_token = 0;
+ n->ba_requested_ns = 0;
+ n->session = true;
+}
+int rtw_phl_wa_nan_ndi(void *phl, u32 op,
+                      const struct wa_nan_ndi_config *p, u32 *ifindex)
+{
+ struct wa_nan_stageb_ctx *ctx = &wa_nan_stageb;
+ struct wa_nan_ndi *n;
+ struct net_device *dev;
+ struct phl_sec_param_h crypt = { .keyid=0, .enc_type=RTW_ENC_CCMP,
+   .key_type=RTW_SEC_KEY_UNICAST, .key_len=16 };
+ u8 temporary[16];
+ unsigned long flags;
+ int ret = 0, i;
+ if (!mutex_trylock(&wa_nan_lifecycle_lock)) return -EBUSY;
+ if (!ctx->entered || ctx->phl != phl || (ctx->held && op != WA_NAN_OP_NDI_DEL && op != WA_NAN_OP_NDI_IF_DEL)) {
+  ret = -ENODEV; goto out;
+ }
+ ret = rtw_hal_wa_nan_command_begin(ctx->phl->hal);
+ if (ret) goto out;
+ if (op == WA_NAN_OP_NDI_IF_ADD) {
+  if (!ifindex) { ret = -EINVAL; goto command_end; }
+  ret = wa_ndi_create(ctx, true);
+  if (!ret) *ifindex = ctx->ndi->dev->ifindex;
+  goto command_end;
+ }
+ if (op == WA_NAN_OP_NDI_IF_DEL) {
+  ret = wa_ndi_has_session(ctx) ? -EBUSY : wa_ndi_delete(ctx);
+  goto command_end;
+ }
+ if (op == WA_NAN_OP_NDI_DEL) {
+  ret = wa_ndi_release(ctx, !ctx->ndi || !ctx->ndi->persistent);
+  goto command_end;
+ }
+ if (!p || !ctx->key_ready || !ctx->bigtk_ready || !ctx->schedule_record ||
+     !ctx->peer || memcmp(p->peer_nmi, ctx->peer->mac_addr, 6) ||
+     memcmp(p->local, ctx->plan.nmi, 6) || !is_valid_ether_addr(p->peer) ||
+     p->gtk_index > 3 ||
+     !memcmp(p->peer, p->local, 6)) {
+  ret = -EINVAL; goto command_end;
+ }
+ if (op == WA_NAN_OP_NDI_ADD && (!is_valid_ether_addr(p->initiator) || !p->ndp_id)) {
+  ret = -EINVAL; goto command_end;
+ }
+ if (op == WA_NAN_OP_NDI_STA_ADD && (p->ndp_id || memcmp(p->initiator, "\0\0\0\0\0\0", 6) ||
+     !ctx->ndi || !ctx->ndi->persistent)) {
+  ret = -EINVAL; goto command_end;
+ }
+ if (op == WA_NAN_OP_NDI_ADD || op == WA_NAN_OP_NDI_STA_ADD) {
+  if (wa_ndi_has_session(ctx)) { ret = -EEXIST; goto command_end; }
+  if (!ctx->ndi) {
+   ret = wa_ndi_create(ctx, false);
+   if (ret) goto command_end;
+  }
+  n = ctx->ndi; dev = n->dev;
+  wa_ndi_new_session(n, p);
+  n->shared_peer = !memcmp(p->peer,p->peer_nmi,6);
+  if (n->shared_peer) n->sta = ctx->peer;
+  else {
+  n->sta = rtw_phl_alloc_stainfo_sw(phl, n->config.peer, ctx->wrole,
+                                  DEV_TYPE_LEGACY, 0, ctx->rlink);
+  if (!n->sta) { ret = -ENOMEM; goto command_end; }
+  n->sta->sec_mode = RTW_SEC_ENT_MODE_2;
+  n->sta_ready = true; /* DEL must also undo an uncertain hardware ADD. */
+  if (rtw_phl_cmd_alloc_stainfo(phl, &n->sta, n->config.peer, ctx->wrole,
+      DEV_TYPE_LEGACY, 0, ctx->rlink, true, true, PHL_CMD_DIRECTLY, 0) !=
+      RTW_PHL_STATUS_SUCCESS) { ret = -EIO; goto command_end; }
+  }
+  if (!n->shared_peer) n->sta->hal_sta->rssi_stat.assoc_rssi=ctx->peer->hal_sta->rssi_stat.assoc_rssi;
+  n->local_group_attempted=true;
+  crypt.keyid=p->gtk_index; crypt.key_type=RTW_SEC_KEY_MULTICAST;
+  memcpy(temporary,p->gtk,16);
+  ret=rtw_phl_cmd_add_key(phl,ctx->mgmt,&crypt,temporary,PHL_CMD_DIRECTLY,0)==
+      RTW_PHL_STATUS_SUCCESS ? 0 : -EIO;
+  memzero_explicit(temporary,sizeof(temporary));
+  if (ret) goto command_end;
+  n->local_group_cam=rtw_phl_get_sec_cam_idx(phl,ctx->mgmt,p->gtk_index,RTW_SEC_KEY_MULTICAST);
+  if (n->local_group_cam>=128) { ret=-EIO; goto command_end; }
+  ret = wa_ndi_members(ctx, false);
+  if (ret) goto command_end;
+  if (!n->registered) {
+   if (!rtnl_trylock()) { ret = -EBUSY; goto command_end; }
+   ret = register_netdevice(dev);
+   rtnl_unlock();
+   if (ret) goto command_end;
+   n->registered = true;
+  }
+  *ifindex = dev->ifindex;
+  pr_info("WA_PROBE ndi-reserved ifindex=%u local=%pM peer=%pM macid=%u ndp=%u\n",
+          *ifindex, p->local, p->peer, n->sta->macid, p->ndp_id);
+ } else if (op == WA_NAN_OP_NDI_CONNECT) {
+  n = ctx->ndi;
+  if (!n || !n->session || !n->registered || n->ready || n->key_attempted ||
+      memcmp(p, &n->config, offsetof(struct wa_nan_ndi_config, tk)) ||
+      (p->peer_gtk_index > 3 && p->peer_gtk_index != 0xff)) {
+   ret = -EINVAL; goto command_end;
+  }
+  if (memcmp(&p->channel, &n->config.channel, sizeof(p->channel)) ||
+      memcmp(&p->channel, &ctx->data_channel, sizeof(p->channel))) {
+   ret = -EINVAL; goto command_end;
+  }
+  if (n->shared_peer) {
+   u64 cookie;
+   /* Both endpoints use NMI as NDI: the latest equally strong NDP TK
+    * protects management and data (Wi-Fi Aware 4.0, section 7.4). */
+   spin_lock_irqsave(&wa_ccmp_lock, flags);
+   cookie = wa_ccmp.cookie;
+   spin_unlock_irqrestore(&wa_ccmp_lock, flags);
+   ret = wa_nan_key_change(phl,p->peer,NULL,false,cookie,false);
+   if (!ret) ret = wa_nan_key_change(phl,p->peer,p->tk,true,cookie,false);
+   if (ret) goto command_end;
+   n->key_attempted = true;
+  } else {
+   n->key_attempted = true; memcpy(temporary, p->tk, 16);
+   ret = rtw_phl_cmd_add_key(phl, n->sta, &crypt, temporary, PHL_CMD_DIRECTLY, 0) ==
+         RTW_PHL_STATUS_SUCCESS ? 0 : -EIO;
+   memzero_explicit(temporary, sizeof(temporary));
+   if (ret) goto command_end;
+  }
+  n->config = *p;
+  n->pairwise_cam=rtw_phl_get_sec_cam_idx(phl,n->sta,0,RTW_SEC_KEY_UNICAST);
+  if (n->pairwise_cam>=128) { ret=-EIO; goto command_end; }
+  n->peer_group_cam=0xff;
+  if (p->peer_gtk_index != 0xff) {
+   n->group_attempted=true;
+   crypt.keyid=p->peer_gtk_index; crypt.key_type=RTW_SEC_KEY_MULTICAST;
+   memcpy(temporary,p->peer_gtk,16);
+   ret=rtw_phl_cmd_add_key(phl,n->sta,&crypt,temporary,PHL_CMD_DIRECTLY,0)==
+       RTW_PHL_STATUS_SUCCESS ? 0 : -EIO;
+   memzero_explicit(temporary,sizeof(temporary));
+   if (ret) goto command_end;
+   n->peer_group_cam=rtw_phl_get_sec_cam_idx(phl,n->sta,p->peer_gtk_index,RTW_SEC_KEY_MULTICAST);
+   if (n->peer_group_cam>=128) { ret=-EIO; goto command_end; }
+  }
+  for (i=0; i<17; i++) {
+   int j;
+   for (j=0; j<6; j++) n->group_rx_pn[i] |= (u64)p->peer_pn[j] << (8*j);
+  }
+  ret = wa_ndi_members(ctx, true);
+  if (ret) goto command_end;
+  if (p->ht_mcs[0] || p->ht_mcs[1]) {
+   n->rate_ready=true;
+   ret=rtw_hal_wa_nan_rate(ctx->phl->hal,n->sta,p,true);
+   if (ret) goto command_end;
+  }
+  n->mgmt_cam_hidden=true;
+  n->data_rx_bound=true;
+  ret=rtw_hal_wa_nan_data_rx_mode(ctx->phl->hal,n->sta->macid,ctx->plan.cluster);
+  if (ret) goto command_end;
+  ret=rtw_hal_wa_nan_mgmt_match(ctx->phl->hal,ctx->mgmt->macid,false);
+  if (ret) goto command_end;
+  spin_lock_irqsave(&wa_ndi_lock, flags);
+  n->ready = true; wa_ndi_rx_owner = n;
+  spin_unlock_irqrestore(&wa_ndi_lock, flags);
+  netif_carrier_on(n->dev); netif_wake_queue(n->dev);
+  schedule_work(&n->work);
+  *ifindex = n->dev->ifindex;
+  pr_info("WA_PROBE ndi-ready ifindex=%u macid=%u ndp=%u\n", *ifindex, n->sta->macid, p->ndp_id);
+ } else ret = -EOPNOTSUPP;
+command_end:
+ rtw_hal_wa_nan_command_end();
+out:
+ mutex_unlock(&wa_nan_lifecycle_lock);
+ return ret;
+}
