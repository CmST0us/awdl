+/* SPDX-License-Identifier: GPL-2.0 */
+/* NAN management station: one MACID with the NMI address on the session queue. */
+#ifndef WA_NAN_MGMT_H
+#define WA_NAN_MGMT_H
+
+#include <linux/errno.h>
+
+struct rtw_phl_stainfo_t *wa_nan_mgmt_alloc(struct phl_info_t *phl,
+					    struct rtw_wifi_role_t *role,
+					    struct rtw_wifi_role_link_t *link, bool *ready)
+{
+	struct stainfo_ctl_t *ctl = phl_to_sta_ctrl(phl);
+	struct rtw_phl_stainfo_t *sta;
+	void *drv = phl_to_drvpriv(phl);
+
+	*ready = false;
+	if (role->type != PHL_RTYPE_NAN || link->wa_nan_sta_queue.cnt)
+		return NULL;
+	sta = phl_stainfo_dequeue(phl, &ctl->free_sta_queue);
+	if (!sta)
+		return NULL;
+	_os_mem_cpy(drv, sta->mac_addr, link->mac_addr, MAC_ALEN);
+	sta->wrole = role;
+	sta->rlink = link;
+	sta->link_id = link->id;
+	sta->tid_ul_map = sta->tid_dl_map = 0xff;
+	if (_phl_alloc_stainfo_sw(phl, DEV_TYPE_LEGACY, 0, sta) != RTW_PHL_STATUS_SUCCESS)
+		goto release_slot;
+	_phl_sta_set_default_value(phl, sta);
+	sta->sec_mode = RTW_SEC_ENT_MODE_2;
+	*ready = __phl_alloc_stainfo_hw(phl, role, link, sta) == RTW_PHL_STATUS_SUCCESS;
+	/* Hardware failure may follow submission; retain the MACID for explicit deletion. */
+	phl_stainfo_enqueue(phl, &link->wa_nan_sta_queue, sta);
+	return sta;
+
+release_slot:
+	phl_stainfo_enqueue(phl, &ctl->free_sta_queue, sta);
+	return NULL;
+}
+
+int wa_nan_mgmt_free(struct phl_info_t *phl, struct rtw_phl_stainfo_t *sta)
+{
+	struct stainfo_ctl_t *ctl = phl_to_sta_ctrl(phl);
+	int error = 0;
+
+	if (!sta)
+		return 0;
+	if (phl_free_stainfo_hw(phl, sta) != RTW_PHL_STATUS_SUCCESS)
+		return -EIO;
+	if (phl_stainfo_queue_del(phl, &sta->rlink->wa_nan_sta_queue, sta) !=
+	    RTW_PHL_STATUS_SUCCESS)
+		return -EIO;
+	if (phl_free_stainfo_sw(phl, sta) != RTW_PHL_STATUS_SUCCESS)
+		error = -EIO;
+	if (phl_stainfo_enqueue(phl, &ctl->free_sta_queue, sta) !=
+	    RTW_PHL_STATUS_SUCCESS)
+		error = -EIO;
+	return error;
+}
+
+#endif /* WA_NAN_MGMT_H */
