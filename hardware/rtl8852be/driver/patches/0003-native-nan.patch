+/* SPDX-License-Identifier: GPL-2.0 */
+/* HAL side of the STAGE-B NAN probe: port setup, RX filter and H2C submission. */
+#ifndef WA_NAN_HAL_H
+#define WA_NAN_HAL_H
+
+#include <linux/bitops.h>
+#include <linux/errno.h>
+#include <linux/printk.h>
+#include <linux/ktime.h>
+#include <linux/delay.h>
+#include <linux/jiffies.h>
+#include "../wa_nan_stageb_api.h"
+#include "wa_nan_command_api.h"
+#include "mac/mac_ax/wa_nan_h2c.h"
+#include "mac/mac_ax/fwcmd.h"
+#include "mac/mac_ax/dbg_cmd.h"
+#include "mac/mac_ax/addr_cam.h"
+#include "mac/mac_ax/role.h"
+#include "wa_nan_bcn_template.h"
+#include "wa_nan_sdf.h"
+#include "mac/mac_reg_ax.h"
