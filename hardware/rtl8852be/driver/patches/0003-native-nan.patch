+ pr_info("WA_NAN_RX_MAC he_ok=%u he_fail=%u he_ppdu=%u full=%u full_pkt=%u dma=%u filter=%u ofdm_ok=%u ofdm_fail=%u control_filter=%08x error=%08x sec_packets=%08x read_us=%llu\n",
+         values[0], values[1], values[2], values[3], values[4], values[5], values[6], values[7], values[8],
+         rtw_hal_read32(hal, R_AX_CTRL_FLTR),
+         rtw_hal_read32(hal, R_AX_RX_ERR_FLAG),
+         rtw_hal_read32(hal, R_AX_SEC_TRX_PKT_CNT),
+         (unsigned long long)((ktime_get_ns() - begin) / 1000));
+ pr_info("WA_NAN_RX_FILTER options=%08x plcp=%04x parser=%08x control_preserve=%04x rate_preserve=%04x break=%08x\n",
+         rtw_hal_read32(hal, R_AX_RX_FLTR_OPT),
+         rtw_hal_read16(hal, R_AX_PLCP_HDR_FLTR),
+         rtw_hal_read32(hal, R_AX_RXPSF_CTRL),
+         rtw_hal_read16(hal, R_AX_RXPSF_CTRL_TYPE),
+         rtw_hal_read16(hal, R_AX_RXPSF_RATE),
+         rtw_hal_read32(hal, R_AX_RX_TO_BRK_OPT));
+}
+
+/* Native tx_cnt_dump selectors; byte writes cannot assert reset bit12. */
+static void wa_nan_tx_ppdu_snapshot(void *hal)
+{
+ u8 saved = rtw_hal_read8(hal, R_AX_TX_PPDU_CNT);
+ u16 count[11];
+ unsigned int i;
+ u64 begin = ktime_get_ns();
+ for (i = 0; i < 11; i++) {
+  rtw_hal_write8(hal, R_AX_TX_PPDU_CNT, (saved & 0xf0) | i);
+  /* Native diagnostic selector settling requirement: TRX_CNT_READ_DLY_US. */
+  udelay(1);
+  count[i] = rtw_hal_read16(hal, R_AX_TX_PPDU_CNT + 2);
+ }
+ rtw_hal_write8(hal, R_AX_TX_PPDU_CNT, saved);
+ pr_info("WA_NAN_TX_PPDU lcck=%u scck=%u ofdm=%u ht=%u htgf=%u vhtsu=%u vhtmu=%u hesu=%u heersu=%u hemu=%u hetb=%u read_us=%llu\n",
+         count[0], count[1], count[2], count[3], count[4], count[5],
+         count[6], count[7], count[8], count[9], count[10],
+         (unsigned long long)((ktime_get_ns() - begin) / 1000));
+}
+
+/* 8852B DFI reads use the native 1 ms completion bound. */
+static int wa_nan_wde_read(void *hal, u32 target, u32 address, u32 *value)
+{
+ unsigned int remaining = 1000;
+ rtw_hal_write32(hal, R_AX_WDE_DBG_FUN_INTF_CTL,
+                 B_AX_WDE_DFI_ACTIVE | (target << B_AX_WDE_DFI_TRGSEL_SH) | address);
+ while (rtw_hal_read32(hal, R_AX_WDE_DBG_FUN_INTF_CTL) & B_AX_WDE_DFI_ACTIVE) {
+  if (!--remaining) return -ETIMEDOUT;
+  udelay(1);
+ }
+ *value = rtw_hal_read32(hal, R_AX_WDE_DBG_FUN_INTF_DATA);
+ return 0;
+}
+
+static void wa_nan_scheduler_length(void *hal, u8 macid, u8 ac)
+{
+ u32 value;
+ unsigned int remaining = 100;
+ int status = 0;
+ /* Native SS_CTRL1_R_TX_LEN reads the selected AC without changing its length. */
+ rtw_hal_write32(hal, R_AX_SS_SRAM_CTRL_1,
+                 B_AX_SS_OWN | (5U << B_AX_SS_CMD_SEL_SH) |
+                 ((u32)ac << B_AX_SS_AC_SH) | macid);
+ do {
+  value = rtw_hal_read32(hal, R_AX_SS_SRAM_CTRL_1);
+  if (!(value & B_AX_SS_OWN)) break;
+  udelay(1);
+ } while (--remaining);
+ if (!remaining) status = -ETIMEDOUT;
+ else if (value & (BIT(29) | BIT(30))) status = -EIO;
+ pr_info("WA_NAN_SS_LENGTH macid=%u ac=%u status=%d raw=%08x length=%u\n",
+         macid, ac, status, value, (value >> 8) & 0x1fffff);
+}
+
+/* Native SS_R_QUOTA_SETTING (0) and SS_R_QUOTA (2) are read commands. */
+static void wa_nan_scheduler_quota(void *hal, u8 macid, u8 ac)
+{
+ const u8 commands[] = {0, 2};
+ unsigned int i;
+ for (i = 0; i < ARRAY_SIZE(commands); i++) {
+  unsigned int remaining = 100;
+  u32 value;
+  int status = 0;
+  rtw_hal_write32(hal, R_AX_SS_SRAM_CTRL_1,
+                  B_AX_SS_OWN | ((u32)commands[i] << B_AX_SS_CMD_SEL_SH) |
+                  ((u32)ac << B_AX_SS_AC_SH) | macid);
+  do {
+   value = rtw_hal_read32(hal, R_AX_SS_SRAM_CTRL_1);
+   if (!(value & B_AX_SS_OWN)) break;
+   udelay(1);
+  } while (--remaining);
+  if (!remaining) status = -ETIMEDOUT;
+  else if (value & (BIT(29) | BIT(30))) status = -EIO;
+  pr_info("WA_NAN_SS_QUOTA macid=%u ac=%u command=%u status=%d raw=%08x\n",
+          macid, ac, commands[i], status, value);
+  if (status) return;
+ }
+}
+
+static void wa_nan_wde_macid(void *hal, u8 macid)
+{
+ u32 empty = 0, first, second;
+ unsigned int ac;
+ int ret = wa_nan_wde_read(hal, 7, macid / 8, &empty);
+ pr_info("WA_NAN_WDE macid=%u status=%d empty=%08x\n", macid, ret, empty);
+ if (ret) return;
+ for (ac = 0; ac < 4; ac++) {
+  u32 index = macid * 4 + ac;
+  if (empty & BIT((macid % 8) * 4 + ac)) continue;
+  wa_nan_scheduler_length(hal, macid, ac);
+  wa_nan_scheduler_quota(hal, macid, ac);
+  first = second = 0;
+  ret = wa_nan_wde_read(hal, 6, index * 2, &first);
+  if (!ret) ret = wa_nan_wde_read(hal, 6, index * 2 + 1, &second);
+  pr_info("WA_NAN_WDE_LINK macid=%u ac=%u index=%u status=%d raw0=%08x raw1=%08x\n",
+          macid, ac, index, ret, first, second);
+  if (ret) return;
+ }
+}
+
+/* Query native WMM/AC membership independently of per-MACID byte counts. */
+static void wa_nan_scheduler_links(void *hal)
+{
+ u32 empty = rtw_hal_read32(hal, R_AX_WMM_LINK_EMPTY);
+ unsigned int wmm, ac;
+ for (wmm = 0; wmm < 2; wmm++) {
+  for (ac = 0; ac < 4; ac++) {
+   unsigned int remaining = 100;
+   u32 value;
+   int status = 0;
+   if (empty & BIT(wmm * 4 + ac)) continue;
+   rtw_hal_write32(hal, R_AX_SS_LINK_INFO,
+                   B_AX_SS_OWN | (wmm << B_AX_SS_WMM_SH) |
+                   (ac << B_AX_SS_AC_SH));
+   do {
+    value = rtw_hal_read32(hal, R_AX_SS_LINK_INFO);
+    if (!(value & B_AX_SS_OWN)) break;
+    udelay(1);
+   } while (--remaining);
+   if (!remaining) status = -ETIMEDOUT;
+   else if (value & (BIT(29) | BIT(30))) status = -EIO;
+   pr_info("WA_NAN_SS_LINK wmm=%u ac=%u status=%d raw=%08x head=%u tail=%u count=%u\n",
+           wmm, ac, status, value, value & 0xff,
+           (value >> 8) & 0xff, (value >> 16) & 0xff);
+  }
+ }
+}
+
+static void wa_nan_access_snapshot(void *hal)
+{
+ const u8 selectors[] = {0, 1, 0x10};
+ u32 saved_sch = rtw_hal_read32(hal, R_AX_SCH_DBG_SEL);
+ u16 saved_ptcl = rtw_hal_read16(hal, R_AX_PTCL_DBG);
+ u32 sch[5], ptcl[3];
+ u32 sleep_before, pause_before, channel_before;
+ u32 sleep_after, pause_after, channel_after;
+ u64 read_us;
+ unsigned int i;
+ u64 begin = ktime_get_ns();
+ sleep_before = rtw_hal_read32(hal, R_AX_MACID_SLEEP_0);
+ pause_before = rtw_hal_read32(hal, R_AX_SS_MACID_PAUSE_0);
+ channel_before = rtw_hal_read_bbreg(hal, 0x0734, 0xffffffff);
+ /* Use the 8852B native TX-flow diagnostic selectors. */
+ for (i = 0; i < 5; i++) {
+  rtw_hal_write32(hal, R_AX_SCH_DBG_SEL,
+                  (saved_sch & ~0xffU) | B_AX_SCH_DBG_EN | (i + 3));
+  sch[i] = rtw_hal_read32(hal, R_AX_SCH_DBG);
+ }
+ rtw_hal_write32(hal, R_AX_SCH_DBG_SEL, saved_sch);
+ for (i = 0; i < 3; i++) {
+  rtw_hal_write16(hal, R_AX_PTCL_DBG,
+                  (saved_ptcl & ~0xffU) | B_AX_PTCL_DBG_EN | selectors[i]);
+  ptcl[i] = rtw_hal_read32(hal, R_AX_PTCL_DBG_INFO);
+ }
+ rtw_hal_write16(hal, R_AX_PTCL_DBG, saved_ptcl);
+ channel_after = rtw_hal_read_bbreg(hal, 0x0734, 0xffffffff);
+ pause_after = rtw_hal_read32(hal, R_AX_SS_MACID_PAUSE_0);
+ sleep_after = rtw_hal_read32(hal, R_AX_MACID_SLEEP_0);
+ read_us = (ktime_get_ns() - begin) / 1000;
+ pr_info("WA_NAN_ACCESS sch3=%08x sch4=%08x sch5=%08x sch6=%08x sch7=%08x ptcl0=%08x ptcl1=%08x phy=%08x read_us=%llu\n",
+         sch[0], sch[1], sch[2], sch[3], sch[4], ptcl[0], ptcl[1], ptcl[2],
+         (unsigned long long)read_us);
+ /* Endpoint agreement brackets this read; it is not an atomic snapshot. */
+ pr_info("WA_NAN_ACCESS_CONTEXT sleep=%08x/%08x pause=%08x/%08x channel=%08x/%08x read_us=%llu\n",
+         sleep_before, sleep_after, pause_before, pause_after,
+         channel_before, channel_after, (unsigned long long)read_us);
+ pr_info("WA_NAN_CCA cfg=%08x control=%08x nav_control=%08x nav_update=%08x\n",
+         rtw_hal_read32(hal, R_AX_CCA_CFG_0),
+         rtw_hal_read32(hal, R_AX_CCA_CONTROL),
+         rtw_hal_read32(hal, R_AX_WMAC_NAV_CTL),
+         rtw_hal_read32(hal, R_AX_WMAC_NAV_UP_INFO));
+}
+
+/* Sample the native queues at watchdog cadence while NAN owns the radio. */
+static void wa_nan_queue_snapshot(struct phl_info_t *phl)
+{
+	struct hci_info_t *hci = phl->hci;
+	struct rtw_hal_com_t *hal = rtw_hal_get_halcom(phl->hal);
+	struct rtw_wd_page_ring *wd = hci->wd_ring;
+	struct rtw_wp_rpt_stats *rpt = hal->trx_stat.wp_rpt_stats;
+	struct rtw_hal_stat_info *stat = &hal->band[HW_BAND_0].stat_info;
+	struct rtw_phl_tring_list *sta, *next;
+	void *priv = phl_to_drvpriv(phl);
+	u16 host, hw, available;
+	u8 ch;
+	u32 sampled_macids = 0;
+	u32 high0 = 0, low0 = 0, high2 = 0, low2 = 0;
+
+	if (!READ_ONCE(phl->wa_nan_radio_owned))
+		return;
+	rtw_phl_wa_nan_ba_snapshot();
+	wa_nan_rx_mac_snapshot(phl->hal);
+	wa_nan_tx_ppdu_snapshot(phl->hal);
+	wa_nan_access_snapshot(phl->hal);
+	wa_nan_scheduler_links(phl->hal);
+ pr_info("WA_NAN_SS_CONFIG control=%08x dl_quota=%08x dl_report=%08x prebkf0=%08x prebkf1=%08x airtime=%08x\n",
+         rtw_hal_read32(phl->hal, R_AX_SS_CTRL),
+         rtw_hal_read32(phl->hal, R_AX_SS_DL_QUOTA_CTRL),
+         rtw_hal_read32(phl->hal, R_AX_SS_DL_RPT_CRTL),
+         rtw_hal_read32(phl->hal, R_AX_PREBKF_CFG_0),
+         rtw_hal_read32(phl->hal, R_AX_PREBKF_CFG_1),
+         rtw_hal_read32(phl->hal, R_AX_PTCL_ATM));
+	pr_info("WA_NAN_DLE empty0=%08x empty1=%08x sta_error=%08x schedule_error=%08x\n",
+		rtw_hal_read32(phl->hal, R_AX_DLE_EMPTY0),
+		rtw_hal_read32(phl->hal, R_AX_DLE_EMPTY1),
+		rtw_hal_read32(phl->hal, R_AX_STA_SCHEDULER_ERR_ISR),
+		rtw_hal_read32(phl->hal, R_AX_SCHEDULE_ERR_ISR));
+	pr_info("WA_NAN_SCHED ctrl=%08x links=%08x dbg0=%08x dbg1=%08x dbg2=%08x dbg3=%08x\n",
+		rtw_hal_read32(phl->hal, R_AX_SS_CTRL),
+		rtw_hal_read32(phl->hal, R_AX_WMM_LINK_EMPTY),
+		rtw_hal_read32(phl->hal, R_AX_SS_DBG_0),
+		rtw_hal_read32(phl->hal, R_AX_SS_DBG_1),
+		rtw_hal_read32(phl->hal, R_AX_SS_DBG_2),
+		rtw_hal_read32(phl->hal, R_AX_SS_DBG_3));
+	pr_info("WA_NAN_TXCFG common=%08x aggregate_break=%08x control=%08x aggregate_limit=%08x\n",
+		rtw_hal_read32(phl->hal, R_AX_PTCL_COMMON_SETTING_0),
+		rtw_hal_read32(phl->hal, R_AX_AGG_BK_0),
+		rtw_hal_read32(phl->hal, R_AX_TX_CTRL),
+		rtw_hal_read32(phl->hal, R_AX_AMPDU_AGG_LIMIT));
+	/* Native release-report batching and PCIe interrupt mitigation controls. */
+	pr_info("WA_NAN_COMPLETION release_batch=%08x rx_mit=%08x tx_mit=%08x\n",
+		rtw_hal_read32(phl->hal, R_AX_RLSRPT0_CFG1),
+		rtw_hal_read32(phl->hal, R_AX_INT_MIT_RX),
+		rtw_hal_read32(phl->hal, R_AX_INT_MIT_TX));
+	pr_info("WA_NAN_RETRY count=%08x lifetime0=%08x lifetime1=%08x release=%08x release_error=%08x\n",
+		rtw_hal_read32(phl->hal, R_AX_TXCNT),
+		rtw_hal_read32(phl->hal, R_AX_LIFETIME_0),
+		rtw_hal_read32(phl->hal, R_AX_LIFETIME_1),
+		rtw_hal_read32(phl->hal, R_AX_RLSRPT0_CFG0),
+		rtw_hal_read32(phl->hal, R_AX_WDRLS_ERR_ISR));
+	pr_info("WA_NAN_TXCOND txen=%08x ptcl=%08x macids=%08x b0=%08x pkt_error=%08x ddrop=%08x cdrop=%08x delay=%08x threshold=%08x\n",
+		rtw_hal_read32(phl->hal, R_AX_CTN_TXEN),
+		rtw_hal_read32(phl->hal, R_AX_PTCL_TX_CTN_SEL),
+		rtw_hal_read32(phl->hal, R_AX_PTCL_TX_MACID_0),
+		rtw_hal_read32(phl->hal, R_AX_B0_CTL),
+		rtw_hal_read32(phl->hal, R_AX_TXPKTCTL_ERR_IMR_ISR),
+		rtw_hal_read32(phl->hal, R_AX_DMAC_MACID_DROP_0),
+		rtw_hal_read32(phl->hal, R_AX_CMAC_MACID_DROP_0),
+		rtw_hal_read32(phl->hal, R_AX_SS_DELAYTX_TO),
+		rtw_hal_read32(phl->hal, R_AX_SS_DELAYTX_LEN_THR));
+	rtw_hal_get_tsf(phl->hal, HW_BAND_0, 0, &high0, &low0);
+	rtw_hal_get_tsf(phl->hal, HW_BAND_0, 2, &high2, &low2);
+	pr_info("WA_NAN_BB_CONTEXT band=%u channel=%u width=%u pd=%08x btg=%08x wrc=%08x\n",
+		hal->band[HW_BAND_0].cur_chandef.band,
+		hal->band[HW_BAND_0].cur_chandef.chan,
+		hal->band[HW_BAND_0].cur_chandef.bw,
+		rtw_hal_read_bbreg(phl->hal, 0x4860, 0xffffffff),
+		rtw_hal_read_bbreg(phl->hal, 0x4aa4, 0xffffffff),
+		rtw_hal_read_bbreg(phl->hal, 0x4408, 0xffffffff));
+	/* 8852B channel report encoding and RF bandwidth/primary-subchannel. */
+	pr_info("WA_NAN_RADIO tsf0=%08x:%08x tsf2=%08x:%08x channel=%08x bw=%08x primary=%08x\n",
+		high0, low0, high2, low2,
+		rtw_hal_read_bbreg(phl->hal, 0x0734, 0xffffffff),
+		rtw_hal_read_bbreg(phl->hal, 0x49c0, 0xffffffff),
+		rtw_hal_read_bbreg(phl->hal, 0x49c4, 0xffffffff));
+	pr_info("WA_NAN_RESPONSE check=%08x policy=%08x nav=%08x cca=%08x secondary=%08x\n",
+		rtw_hal_read32(phl->hal, R_AX_RSP_CHK_SIG),
+		rtw_hal_read32(phl->hal, R_AX_TRXPTCL_RESP_0),
+		rtw_hal_read32(phl->hal, R_AX_RESP_TX_NAV_ABORT_COUNTER),
+		rtw_hal_read32(phl->hal, R_AX_RESP_TX_CCA_ABORT_COUNTER),
+		rtw_hal_read32(phl->hal, R_AX_TRXPTCL_RESP_TX_ABORT_COUNTER));
+	/* IQK records the calibrated band, bandwidth and center channel per path. */
+	pr_info("WA_NAN_RF_CAL channel=%08x version=%08x page_a=%08x page_b=%08x\n",
+		rtw_hal_read_bbreg(phl->hal, 0x9fe4, 0xffffffff), rtw_hal_read_bbreg(phl->hal, 0x9fe0, 0xffffffff),
+		rtw_hal_read_bbreg(phl->hal, 0x8104, 0xffffffff), rtw_hal_read_bbreg(phl->hal, 0x8204, 0xffffffff));
+	wa_nan_rf_snapshot(phl->hal, "runtime", 0);
+	/* Last completed native BB watchdog interval, before its hardware reset.
+	 * This includes all received traffic and both NAN residence channels. */
+	pr_info("WA_NAN_RX_STATS cca=%u fail=%u he=%u/%u vht=%u/%u ht=%u/%u ofdm=%u/%u cck=%u/%u\n",
+		stat->cnt_cca_all, stat->cnt_fail_all,
+		stat->cnt_he_crc32_ok, stat->cnt_he_crc32_error,
+		stat->cnt_vht_crc32_ok, stat->cnt_vht_crc32_error,
+		stat->cnt_ht_crc32_ok, stat->cnt_ht_crc32_error,
+		stat->cnt_ofdm_crc32_ok, stat->cnt_ofdm_crc32_error,
+		stat->cnt_cck_crc32_ok, stat->cnt_cck_crc32_error);
+	_os_spinlock(priv, &phl->t_ring_list_lock, _bh, NULL);
+	phl_list_for_loop_safe(sta, next, struct rtw_phl_tring_list,
+			       &phl->t_ring_list, list) {
+		struct rtw_phl_tx_ring *ring = &sta->phl_ring[0];
+
+		if (ring->core_idx || _os_atomic_read(priv, &ring->phl_idx)) {
+			if (sta->macid < 32) sampled_macids |= BIT(sta->macid);
+			pr_info("WA_NAN_QUEUE macid=%u dma=%u core=%u phl=%u next=%u sleep=%u\n",
+				sta->macid, ring->dma_ch, ring->core_idx,
+				_os_atomic_read(priv, &ring->phl_idx),
+				_os_atomic_read(priv, &ring->phl_next_idx),
+				sta->tx_plan.sleep);
+			pr_info("WA_NAN_GATE macid=%u sleep=%08x pause=%08x\n",
+				sta->macid,
+				rtw_hal_read32(phl->hal, 0xc2c0 + (sta->macid / 32) * 4),
+				rtw_hal_read32(phl->hal, 0x9eb0 + (sta->macid / 32) * 4));
+		}
+	}
+	_os_spinunlock(priv, &phl->t_ring_list_lock, _bh, NULL);
+	for (ch = 0; ch < 32; ch++)
+		if (sampled_macids & BIT(ch)) wa_nan_wde_macid(phl->hal, ch);
+	for (ch = 0; ch < hci->total_txch_num; ch++) {
+		if (!rpt[ch].busy_cnt && !rpt[ch].tx_ok_cnt && !rpt[ch].tx_fail_cnt)
+			continue;
+		available = rtw_hal_tx_res_query(phl->hal, ch, &host, &hw);
+		pr_info("WA_NAN_DMA ch=%u host=%u hw=%u free=%u wd_idle=%u wd_busy=%u wd_pending=%u seq=%u pending=%u ok=%u fail=%u recycle_fail=%u\n",
+			ch, host, hw, available, wd[ch].idle_wd_page_cnt,
+			wd[ch].busy_wd_page_cnt, wd[ch].pending_wd_page_cnt,
+			wd[ch].wp_seq, rpt[ch].busy_cnt, rpt[ch].tx_ok_cnt,
+			rpt[ch].tx_fail_cnt, rpt[ch].recycle_fail_cnt);
+	}
+	for (ch = 0; ch < hci->total_rxch_num; ch++) {
+		available = rtw_hal_rx_res_query(phl->hal, ch, &host, &hw);
+		pr_info("WA_NAN_RXDMA ch=%u host=%u hw=%u pending=%u\n",
+			ch, host, hw, available);
+	}
+}
