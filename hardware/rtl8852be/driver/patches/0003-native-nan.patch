+++ b/phl/hal_g6/mac/mac_ax/wa_nan_command.h
@@ -0,0 +1,163 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Firmware completion lane for NAN peer, key and rate operations. */
+#ifndef WA_NAN_COMMAND_H
+#define WA_NAN_COMMAND_H
+#include <linux/completion.h>
+#include <linux/interrupt.h>
+#include <linux/mutex.h>
+#include <linux/jiffies.h>
+#include <linux/sched.h>
+#include <linux/spinlock.h>
+
+static DEFINE_MUTEX(wa_command_mutex);
+static DEFINE_SPINLOCK(wa_command_lock);
+static DECLARE_COMPLETION(wa_command_done);
+static DECLARE_COMPLETION(wa_rfk_done);
+static bool wa_rfk_requested, wa_rfk_armed;
+static u8 wa_rfk_seq;
+static u32 wa_rfk_result;
+static struct task_struct *wa_command_owner;
+static struct mac_ax_adapter *wa_command_adapter;
+static u8 wa_command_cat, wa_command_class, wa_command_func, wa_command_seq;
+static u32 wa_command_result;
+static bool wa_command_armed;
+static unsigned int wa_command_depth;
+static unsigned long wa_command_deadline;
+
+int mac_wa_nan_command_begin(struct mac_ax_adapter *adapter)
+{
+	if (adapter->sm.fwdl != MAC_AX_FWDL_INIT_RDY) return -ENODEV;
+	if (READ_ONCE(wa_command_owner) == current && wa_command_adapter == adapter) {
+		wa_command_depth++;
+		return 0;
+	}
+	if (!mutex_trylock(&wa_command_mutex)) return -EBUSY;
+	wa_command_depth = 1;
+	wa_command_deadline = jiffies + msecs_to_jiffies(2000);
+	wa_command_adapter = adapter;
+	WRITE_ONCE(wa_command_owner, current);
+	return 0;
+}
+
+void mac_wa_nan_command_end(void)
+{
+	unsigned long flags;
+	if (--wa_command_depth) return;
+	spin_lock_irqsave(&wa_command_lock, flags);
+	wa_command_armed = false;
+	wa_rfk_requested = wa_rfk_armed = false;
+	WRITE_ONCE(wa_command_owner, NULL);
+	wa_command_adapter = NULL;
+	spin_unlock_irqrestore(&wa_command_lock, flags);
+	mutex_unlock(&wa_command_mutex);
+}
+
+static bool wa_command_selected(struct mac_ax_adapter *adapter,
+			       struct h2c_info *info)
+{
+	return !in_interrupt() && READ_ONCE(wa_command_owner) == current &&
+		wa_command_adapter == adapter &&
+		((info->h2c_cat == FWCMD_H2C_CAT_OUTSRC &&
+		  info->h2c_class == 1 && info->h2c_func == 0) ||
+		 (info->h2c_cat == FWCMD_H2C_CAT_MAC &&
+		(info->h2c_class == FWCMD_H2C_CL_MEDIA_RPT ||
+		 info->h2c_class == FWCMD_H2C_CL_ADDR_CAM_UPDATE ||
+		 info->h2c_class == FWCMD_H2C_CL_SEC_CAM ||
+		 (info->h2c_class == FWCMD_H2C_CL_NAN && (info->h2c_func <= 2 ||
+			info->h2c_func == 7 || info->h2c_func == 8)))));
+}
+
+static void wa_command_arm(struct mac_ax_adapter *adapter,
+			   struct h2c_info *info, u8 seq)
+{
+	unsigned long flags;
+	if (!wa_command_selected(adapter, info)) return;
+	reinit_completion(&wa_command_done);
+	spin_lock_irqsave(&wa_command_lock, flags);
+	wa_command_cat = info->h2c_cat;
+	wa_command_class = info->h2c_class;
+	wa_command_func = info->h2c_func;
+	wa_command_seq = seq;
+	wa_command_result = MACPROCERR;
+	wa_command_deadline = jiffies + msecs_to_jiffies(2000);
+	wa_command_armed = true;
+	if (wa_rfk_requested) {
+		reinit_completion(&wa_rfk_done);
+		wa_rfk_seq = seq;
+		wa_rfk_result = MACPROCERR;
+		wa_rfk_armed = true;
+	}
+	spin_unlock_irqrestore(&wa_command_lock, flags);
+}
+
+static void wa_command_ack(struct mac_ax_adapter *adapter,
+			   struct rtw_c2h_info *info)
+{
+	unsigned long flags;
+	spin_lock_irqsave(&wa_command_lock, flags);
+	if (wa_command_armed && wa_command_adapter == adapter &&
+	    info->c2h_cat == wa_command_cat &&
+	    info->c2h_class == wa_command_class &&
+	    info->c2h_func == wa_command_func && info->h2c_seq == wa_command_seq) {
+		wa_command_result = info->h2c_return;
+		wa_command_armed = false;
+		complete(&wa_command_done);
+	}
+	spin_unlock_irqrestore(&wa_command_lock, flags);
+}
+
+/* NAN func9 is independent of the command ACK and may arrive first. */
+static u32 wa_rfk_grant(struct mac_ax_adapter *adapter, u8 *buf, u32 len,
+                       struct rtw_c2h_info *info)
+{
+    unsigned long flags;
+    (void)info;
+    if (len < FWCMD_HDR_LEN + 4) return MACBUFSZ;
+    spin_lock_irqsave(&wa_command_lock, flags);
+    if (wa_rfk_armed && wa_command_adapter == adapter &&
+        buf[FWCMD_HDR_LEN] == wa_rfk_seq) {
+        wa_rfk_result = buf[FWCMD_HDR_LEN + 1];
+        wa_rfk_armed = false;
+        complete(&wa_rfk_done);
+    }
+    spin_unlock_irqrestore(&wa_command_lock, flags);
+    return MACSUCCESS;
+}
+
+static u32 wa_command_wait(struct mac_ax_adapter *adapter,
+			   struct h2c_info *info, u32 submitted)
+{
+	unsigned long flags;
+	u32 result = submitted;
+	bool acknowledged = false;
+	if (!wa_command_selected(adapter, info)) return submitted;
+	if (submitted == MACSUCCESS) {
+		if (time_after_eq(jiffies, wa_command_deadline) ||
+		    !wait_for_completion_timeout(&wa_command_done,
+			min(msecs_to_jiffies(1000), wa_command_deadline - jiffies)))
+			result = MACPOLLTO;
+		else {
+			result = READ_ONCE(wa_command_result);
+			acknowledged = true;
+		}
+	}
+    if (wa_rfk_requested && result == MACSUCCESS) {
+        if (time_after_eq(jiffies, wa_command_deadline) ||
+            !wait_for_completion_timeout(&wa_rfk_done,
+                min(msecs_to_jiffies(1000), wa_command_deadline - jiffies)))
+            result = MACPOLLTO;
+        else
+            result = READ_ONCE(wa_rfk_result);
+        pr_info("WA_PROBE rfk-grant seq=%u result=%u\n", wa_rfk_seq, result);
+    }
+	spin_lock_irqsave(&wa_command_lock, flags);
+	wa_command_armed = false;
+    wa_rfk_armed = wa_rfk_requested = false;
+	spin_unlock_irqrestore(&wa_command_lock, flags);
+	if (submitted == MACSUCCESS)
+		pr_info("WA_PROBE command-done cat=%u class=%u func=%u seq=%u fw_ack=%u result=%u\n",
+			info->h2c_cat, info->h2c_class, info->h2c_func,
+			wa_command_seq, acknowledged, result);
+	return result;
+}
+#endif
