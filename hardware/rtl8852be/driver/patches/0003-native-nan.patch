+		(unsigned long long)ktime_get_ns(), state,
+		atomic_read(&wa_nan_gate_gen));
+	if (state == WA_NAN_GATE_STARTED)
+		atomic_set(&wa_nan_p3_stop, 1);
+#if WA_NAN_M5_PAIR
+	wa_nan_pair_expire(ktime_get_ns());
+	wa_nan_pair_clear("cancelled");
+#endif
+}
+
+static u32 wa_nan_gate_on(u64 op, const char *mode)
+{
+	u32 gen = (u32)atomic_inc_return(&wa_nan_gate_gen);
+
+	atomic_set(&wa_nan_gate_state, WA_NAN_GATE_STARTED);
+	pr_info("WA_PROBE nan-cycle phase=gate-on op=%llu ns=%llu gen=%u mode=%s\n",
+		(unsigned long long)op, (unsigned long long)ktime_get_ns(),
+		(unsigned int)gen, mode);
+	return gen;
+}
+
+static void wa_nan_gate_off(u64 op, u32 gen, int result)
+{
+	atomic_set(&wa_nan_gate_state, result ? WA_NAN_GATE_HELD : WA_NAN_GATE_STOPPED);
+	pr_info("WA_PROBE nan-cycle phase=gate-off op=%llu ns=%llu gen=%u result=%d\n",
+		(unsigned long long)op, (unsigned long long)ktime_get_ns(),
+		(unsigned int)gen, result);
+}
+#endif
+
+static int wa_nan_stageb_rollback(struct wa_nan_stageb_ctx *ctx, u64 op)
+{
+	struct hw_band_ctl_t *band;
+	int cleanup = 0;
+
+	if (!cleanup && ctx->mgmt_allocated) {
+		if (wa_nan_mgmt_free(ctx->phl, ctx->mgmt))
+			cleanup = -EIO;
+		else
+			ctx->mgmt_allocated = false;
+	}
+	if (!cleanup && ctx->rx_changed) {
+		if (rtw_hal_set_rxfltr_opt_by_mode(ctx->phl->hal, ctx->band,
+						   ctx->rx_before) !=
+		    RTW_HAL_STATUS_SUCCESS)
+			cleanup = -EIO;
+		else
+			ctx->rx_changed = false;
+	}
+	if (!cleanup && ctx->role_changed) {
+		enum role_type before = (enum role_type)ctx->role_before;
+
+		if (ctx->wrole->type == before ||
+		    phl_wifi_role_change(ctx->phl, ctx->wrole, ctx->rlink,
+					 WR_CHG_TYPE, &before) !=
+		    RTW_PHL_STATUS_SUCCESS)
+			cleanup = -EIO;
+		else
+			ctx->role_changed = false;
+	}
+	if (!cleanup && ctx->port_owned) {
+		band = get_band_ctrl(ctx->phl, ctx->band);
+		_os_spinlock(phl_to_drvpriv(ctx->phl), &band->lock, _bh, NULL);
+		band->port_map &= ~BIT(ctx->port);
+		_os_spinunlock(phl_to_drvpriv(ctx->phl), &band->lock, _bh, NULL);
+		ctx->port_owned = false;
+	}
+	pr_info("WA_PROBE nan-cycle phase=stageb-rollback op=%llu ns=%llu result=%d mgmt=%u rx=%u role=%u port=%u\n",
+		(unsigned long long)op, (unsigned long long)ktime_get_ns(), cleanup,
+		(unsigned int)ctx->mgmt_allocated,
+		(unsigned int)ctx->rx_changed,
+		(unsigned int)ctx->role_changed,
+		(unsigned int)ctx->port_owned);
+	return cleanup;
+}
+
+static int wa_nan_stageb_precondition(struct wa_nan_stageb_ctx *ctx,
+				      struct rtw_wifi_role_t *wrole,
+				      struct rtw_wifi_role_link_t *rlink)
+{
+	struct rtw_phl_stainfo_t *self;
+	struct hal_spec_t *spec;
+
+	if (!ctx->phl || !wrole || !rlink) {
+		ctx->precondition_reason = "arg";
+		return -EINVAL;
+	}
+	if (!ctx->phl->phl_com->dev_cap.nan_sup) {
+		ctx->precondition_reason = "cap";
+		return -EOPNOTSUPP;
+	}
+	if (!wrole->active || wrole->type != PHL_RTYPE_STATION ||
+	    wrole->rlink_num != 1 || wrole->mstate != MLME_NO_LINK ||
+	    rlink->id != RTW_RLINK_PRIMARY || rlink->mstate != MLME_NO_LINK ||
+	    rlink->assoc_sta_queue.cnt != 1) {
+		ctx->precondition_reason = "busy";
+		return -EBUSY;
+	}
+	if (rlink->hw_band >= MAX_BAND_NUM) {
+		ctx->precondition_reason = "band";
+		return -EINVAL;
+	}
+	spec = phl_get_ic_spec(ctx->phl->phl_com);
+	if (rlink->hw_port >= spec->port_num) {
+		ctx->precondition_reason = "port";
+		return -EINVAL;
+	}
+	self = rtw_phl_get_stainfo_self(ctx->phl, rlink);
+	if (!self) {
+		ctx->precondition_reason = "self";
+		return -ENODEV;
+	}
+	if (self->macid >= WA_NAN_STAGEB_MACID_MAX) {
+		ctx->precondition_reason = "macid";
+		return -ENODEV;
+	}
+	ctx->wrole = wrole;
+	ctx->rlink = rlink;
+	ctx->band = rlink->hw_band;
+	ctx->role_before = wrole->type;
+	ctx->plan.macid_bcn = (u8)self->macid;
+	return 0;
+}
+
+static int wa_nan_stageb_ports(struct wa_nan_stageb_ctx *ctx)
+{
+	struct hal_spec_t *spec = phl_get_ic_spec(ctx->phl->phl_com);
+	struct hw_band_ctl_t *band = get_band_ctrl(ctx->phl, ctx->band);
+	u8 port;
+
+	_os_spinlock(phl_to_drvpriv(ctx->phl), &band->lock, _bh, NULL);
+	ctx->port_before = band->port_map;
+	for (port = 0; port < spec->port_num && port < 8; port++) {
+		if (port == ctx->rlink->hw_port || (band->port_map & BIT(port)))
+			continue;
+		band->port_map |= BIT(port);
+		ctx->port = port;
+		ctx->port_owned = true;
+		break;
+	}
+	ctx->port_map_after = band->port_map;
+	_os_spinunlock(phl_to_drvpriv(ctx->phl), &band->lock, _bh, NULL);
+	if (!ctx->port_owned)
+		return -ENOSPC;
+	ctx->plan.port[0] = ctx->rlink->hw_port;
+	ctx->plan.port[1] = ctx->port;
+	return 0;
+}
+
+#if WA_NAN_P3
+static int wa_nan_p3_loop(struct wa_nan_stageb_ctx *ctx, u64 op, u32 sent)
+{
+	u8 frame[WA_NAN_SDF_MAX_LEN];
+	u64 cookie;
+	int len, ret;
+	(void)op;
+	(void)sent;
+	len = wa_nan_stageb_build_sdf(ctx, frame, sizeof(frame));
+	if (len < 0) return len;
+	ret = rtw_hal_wa_nan_sdf_tx(ctx->phl->hal, &ctx->plan, frame, len, &cookie);
+	return ret ? ret : rtw_hal_wa_nan_sdf_wait_done(ctx->phl->hal, cookie, 3000);
+}
+#endif
+
+int rtw_phl_wa_nan_cycle_resume(void *phl)
+{
+	struct wa_nan_stageb_ctx *ctx = &wa_nan_stageb;
+	u64 op = ktime_get_ns();
+	u32 gen;
+	int ret;
+
+	if (!phl || ctx->phl != phl) {
+		pr_info("WA_PROBE nan-cycle phase=resume-reject op=%llu ns=%llu reason=phl\n",
+			(unsigned long long)op, (unsigned long long)ktime_get_ns());
+		return -EINVAL;
+	}
+	if (!ctx->entered) {
+		pr_info("WA_PROBE nan-cycle phase=resume-reject op=%llu ns=%llu reason=role-not-established\n",
+			(unsigned long long)op, (unsigned long long)ktime_get_ns());
+		return -ENODEV;
+	}
+	if (atomic_read(&wa_nan_gate_state) != WA_NAN_GATE_STOPPED) {
+		pr_info("WA_PROBE nan-cycle phase=resume-reject op=%llu ns=%llu reason=not-stopped state=%d\n",
+			(unsigned long long)op, (unsigned long long)ktime_get_ns(),
+			atomic_read(&wa_nan_gate_state));
+		return -EALREADY;
+	}
+	gen = wa_nan_gate_on(op, "resume");
+	ret = wa_nan_p3_loop(ctx, op, 0);
+	wa_nan_gate_off(op, gen, ret);
+	return ret;
+}
+
+static int wa_nan_cycle_enter(void *phl, struct rtw_wifi_role_t *wrole,
+			       struct rtw_wifi_role_link_t *rlink, const u8 *cluster)
+{
+	struct wa_nan_stageb_ctx *ctx = &wa_nan_stageb;
+	enum role_type nan_role = PHL_RTYPE_NAN;
+	enum rtw_rx_fltr_opt_mode rx_mode;
+	u32 before = 0, after = 0, fail_step = 0;
+	int ret;
+	u64 op = ktime_get_ns(), enable_ns = 0;
+	u8 dw_submitted = 0, disc_submitted = 0;
+	int err;
+
+	if (atomic_cmpxchg(&wa_nan_stageb_state, 0, 1) != 0) {
+		pr_info("WA_PROBE nan-cycle phase=stageb-reject op=%llu ns=%llu reason=already-started\n",
+			(unsigned long long)op, (unsigned long long)ktime_get_ns());
+		return -EALREADY;
+	}
+	err = rtw_phl_wa_nan_radio_acquire(phl);
+	if (err) {
+		atomic_set(&wa_nan_stageb_state, 0);
+		return err;
+	}
+	memset(ctx, 0, sizeof(*ctx));
+	ctx->phl = (struct phl_info_t *)phl;
+	err = wa_nan_stageb_precondition(ctx, wrole, rlink);
+	if (err) {
+		pr_info("WA_PROBE nan-cycle phase=stageb-precondition op=%llu ns=%llu status=%d reason=%s\n",
+			(unsigned long long)op, (unsigned long long)ktime_get_ns(), err,
+			ctx->precondition_reason ? ctx->precondition_reason : "unknown");
+		return err;
+	}
+	ctx->channel_before = GET_PRIMARY_LINK(dvobj_get_primary_adapter(
+		(struct dvobj_priv *)ctx->phl->phl_com->drv_priv))->mlmeextpriv.chandef;
+	ctx->channel_changed = true;
+	err = wa_nan_discovery_channel(phl);
+	if (err) return err;
+	rx_mode = rtw_hal_get_rxfltr_opt_mode(ctx->phl->hal, ctx->band);
+	ctx->rx_before = rx_mode;
+	pr_info("WA_PROBE nan-cycle phase=stageb-ready op=%llu ns=%llu nan_sup=%u role=%u rlink_num=%u queue=%u self_macid=%u hw_band=%u hw_port=%u port_num=%u rx_mode=%u\n",
+		(unsigned long long)op, (unsigned long long)ktime_get_ns(),
+		(unsigned int)ctx->phl->phl_com->dev_cap.nan_sup,
+		(unsigned int)ctx->wrole->type,
+		(unsigned int)ctx->wrole->rlink_num,
+		(unsigned int)ctx->rlink->assoc_sta_queue.cnt,
+		(unsigned int)ctx->plan.macid_bcn,
+		(unsigned int)ctx->band, (unsigned int)ctx->rlink->hw_port,
+		(unsigned int)phl_get_ic_spec(ctx->phl->phl_com)->port_num,
+		(unsigned int)rx_mode);
+	if (rx_mode != RX_FLTR_OPT_MODE_STA_NORMAL) {
+		pr_info("WA_PROBE nan-cycle phase=stageb-precondition op=%llu ns=%llu status=%d reason=busy mode=%u\n",
+			(unsigned long long)op, (unsigned long long)ktime_get_ns(),
+			-EBUSY, (unsigned int)rx_mode);
+		return -EBUSY;
+	}
+	err = wa_nan_stageb_ports(ctx);
+	if (err) {
+		pr_info("WA_PROBE nan-cycle phase=stageb-precondition op=%llu ns=%llu status=%d reason=port port_map=%u\n",
+			(unsigned long long)op, (unsigned long long)ktime_get_ns(),
+			err, (unsigned int)ctx->port_before);
+		return err;
+	}
+	pr_info("WA_PROBE nan-cycle phase=stageb-port op=%llu ns=%llu dw_port=%u disc_port=%u port_map_before=%u port_map_after=%u\n",
+		(unsigned long long)op, (unsigned long long)ktime_get_ns(),
+		(unsigned int)ctx->plan.port[0], (unsigned int)ctx->plan.port[1],
+		(unsigned int)ctx->port_before, (unsigned int)ctx->port_map_after);
+
+	ret = phl_wifi_role_change(ctx->phl, ctx->wrole, ctx->rlink,
+				   WR_CHG_TYPE, &nan_role);
+	if (ctx->wrole->type == PHL_RTYPE_NAN)
+		ctx->role_changed = true;
+	pr_info("WA_PROBE nan-cycle phase=stageb-role op=%llu ns=%llu result=%d before=%u after=%u\n",
+		(unsigned long long)op, (unsigned long long)ktime_get_ns(), ret,
+		(unsigned int)ctx->role_before, (unsigned int)ctx->wrole->type);
+	if (ret != RTW_PHL_STATUS_SUCCESS) {
+		wa_nan_stageb_rollback(ctx, op);
+		return -EIO;
+	}
+
+	ret = rtw_hal_wa_nan_rx_filter(ctx->phl->hal, ctx->band, 1, &before, &after);
+	ctx->rx_changed = true;
+	pr_info("WA_PROBE nan-cycle phase=stageb-rxfilter op=%llu ns=%llu band=%u nan=1 before=%08x after=%08x result=%d\n",
+		(unsigned long long)op, (unsigned long long)ktime_get_ns(),
+		(unsigned int)ctx->band, before, after, ret);
+	if (ret != 0) {
+		wa_nan_stageb_rollback(ctx, op);
+		return -EIO;
+	}
+	rtw_hal_wa_nan_logcfg(ctx->phl->hal, op);
+
+	ctx->mgmt = wa_nan_mgmt_alloc(ctx->phl, ctx->wrole, ctx->rlink, &ctx->mgmt_ready);
+	if (!ctx->mgmt) {
+		pr_info("WA_PROBE nan-cycle phase=stageb-precondition op=%llu ns=%llu status=%d reason=macid role=%u\n",
+			(unsigned long long)op, (unsigned long long)ktime_get_ns(),
+			-ENOMEM, (unsigned int)ctx->wrole->type);
+		wa_nan_stageb_rollback(ctx, op);
+		return -ENOMEM;
+	}
+	ctx->mgmt_allocated = true;
+	if (!ctx->mgmt_ready) return -EIO;
+	ctx->plan.macid_mgn = (u8)ctx->mgmt->macid;
+	rtw_phl_wa_nan_sdf_set_macid(ctx->plan.macid_mgn);
+	memcpy(ctx->plan.nmi, ctx->rlink->mac_addr, 6);
+	memcpy(ctx->plan.cluster, cluster, 6);
+	ctx->plan.random_factor = ctx->plan.nmi[5] ^ 0x5a;
+	pr_info("WA_PROBE nan-cycle phase=stageb-macid op=%llu ns=%llu macid_bcn=%u macid_mgn=%u nmi="
+		WA_NAN_ADDR_FMT "\n",
+		(unsigned long long)op, (unsigned long long)ktime_get_ns(),
+		(unsigned int)ctx->plan.macid_bcn,
+		(unsigned int)ctx->plan.macid_mgn,
+		WA_NAN_ADDR_ARGS(ctx->plan.nmi));
+
+	ctx->ports_touched = true;
+	ret = rtw_hal_wa_nan_port_init(ctx->phl->hal, ctx->plan.port[1], ctx->band);
+	pr_info("WA_PROBE nan-cycle phase=stageb-portinit op=%llu ns=%llu port=%u result=%d\n",
+		(unsigned long long)op, (unsigned long long)ktime_get_ns(),
+		(unsigned int)ctx->plan.port[1], ret);
+	if (ret != 0) {
+		ctx->held = true;
+		pr_info("WA_PROBE nan-cycle phase=stageb-held op=%llu ns=%llu reason=port-init port=%u port_map=%u\n",
+			(unsigned long long)op, (unsigned long long)ktime_get_ns(),
+			(unsigned int)ctx->plan.port[1],
+			(unsigned int)get_band_ctrl(ctx->phl, ctx->band)->port_map);
+		return -EIO;
+	}
+
+	ret = rtw_hal_wa_nan_port_enable(ctx->phl->hal, ctx->plan.port[0], ctx->band);
+	pr_info("WA_PROBE nan-cycle phase=stageb-portenable op=%llu ns=%llu port=%u result=%d\n",
+		(unsigned long long)op, (unsigned long long)ktime_get_ns(),
+		(unsigned int)ctx->plan.port[0], ret);
+	if (ret != 0) {
+		ctx->held = true;
+		pr_info("WA_PROBE nan-cycle phase=stageb-held op=%llu ns=%llu reason=port-enable port=%u port_map=%u\n",
+			(unsigned long long)op, (unsigned long long)ktime_get_ns(),
+			(unsigned int)ctx->plan.port[0],
+			(unsigned int)get_band_ctrl(ctx->phl, ctx->band)->port_map);
+		return -EIO;
+	}
+
+	ctx->plan.template_port = ctx->plan.port[0];
+	if (ctx->plan.template_port != ctx->plan.port[0]) {
+		ctx->held = true;
+		pr_info("WA_PROBE nan-cycle phase=stageb-held op=%llu ns=%llu reason=template-port template_port=%u port_dw=%u\n",
+			(unsigned long long)op, (unsigned long long)ktime_get_ns(),
+			(unsigned int)ctx->plan.template_port,
+			(unsigned int)ctx->plan.port[0]);
+		return -EIO;
+	}
+	ctx->fw_touched = true;
+	ret = rtw_hal_wa_nan_bcn_template(ctx->phl->hal, &ctx->plan, ctx->band,
+					  &dw_submitted);
+	ctx->bcn_template_count = dw_submitted;
+	pr_info("WA_PROBE nan-cycle phase=stageb-bcn-template-dw op=%llu ns=%llu result=%d submitted_dw=%u template_port_dw=%u port_dw=%u len=63 interval_dw=512\n",
+		(unsigned long long)op, (unsigned long long)ktime_get_ns(), ret,
+		(unsigned int)dw_submitted, (unsigned int)ctx->plan.template_port,
+		(unsigned int)ctx->plan.port[0]);
+	if (ret != 0) {
+		ctx->held = true;
+		pr_info("WA_PROBE nan-cycle phase=stageb-held op=%llu ns=%llu reason=bcn-template-dw template_port_dw=%u port_dw=%u port_map=%u\n",
+			(unsigned long long)op, (unsigned long long)ktime_get_ns(),
+			(unsigned int)ctx->plan.template_port,
+			(unsigned int)ctx->plan.port[0],
+			(unsigned int)get_band_ctrl(ctx->phl, ctx->band)->port_map);
+		return -EIO;
+	}
+	ctx->plan.template_port_disc = ctx->plan.port[1];
+	if (ctx->plan.template_port_disc != ctx->plan.port[1]) {
+		ctx->held = true;
+		pr_info("WA_PROBE nan-cycle phase=stageb-held op=%llu ns=%llu reason=template-port-disc template_port_disc=%u port_disc=%u\n",
+			(unsigned long long)op, (unsigned long long)ktime_get_ns(),
+			(unsigned int)ctx->plan.template_port_disc,
+			(unsigned int)ctx->plan.port[1]);
+		return -EIO;
+	}
+	ret = rtw_hal_wa_nan_bcn_template_disc(ctx->phl->hal, &ctx->plan, ctx->band,
+					       ctx->plan.template_port_disc, 100,
+					       &disc_submitted);
+	ctx->bcn_template_count = dw_submitted + disc_submitted;
+	pr_info("WA_PROBE nan-cycle phase=stageb-bcn-template op=%llu ns=%llu result=%d submitted_dw=%u submitted_disc=%u template_port_dw=%u template_port_disc=%u port_dw=%u port_disc=%u len=63 interval_dw=512 interval_disc=100\n",
+		(unsigned long long)op, (unsigned long long)ktime_get_ns(), ret,
+		(unsigned int)dw_submitted, (unsigned int)disc_submitted,
+		(unsigned int)ctx->plan.template_port,
+		(unsigned int)ctx->plan.template_port_disc,
+		(unsigned int)ctx->plan.port[0],
+		(unsigned int)ctx->plan.port[1]);
+	if (ret != 0) {
+		ctx->held = true;
+		pr_info("WA_PROBE nan-cycle phase=stageb-held op=%llu ns=%llu reason=bcn-template-disc template_port_disc=%u port_disc=%u port_map=%u\n",
+			(unsigned long long)op, (unsigned long long)ktime_get_ns(),
+			(unsigned int)ctx->plan.template_port_disc,
+			(unsigned int)ctx->plan.port[1],
+			(unsigned int)get_band_ctrl(ctx->phl, ctx->band)->port_map);
+		return -EIO;
+	}
+	rtw_hal_wa_nan_bcn_snapshot(ctx->phl->hal, &ctx->plan, op, "pre-func0");
+	pr_info("WA_PROBE nan-cycle phase=stageb-start op=%llu ns=%llu port_dw=%u port_disc=%u macid_bcn=%u macid_mgn=%u random_factor=%u nmi="
+		WA_NAN_ADDR_FMT " cluster=" WA_NAN_ADDR_FMT "\n",
+		(unsigned long long)op, (unsigned long long)ktime_get_ns(),
+		(unsigned int)ctx->plan.port[0], (unsigned int)ctx->plan.port[1],
+		(unsigned int)ctx->plan.macid_bcn,
+		(unsigned int)ctx->plan.macid_mgn,
+		(unsigned int)ctx->plan.random_factor,
+		WA_NAN_ADDR_ARGS(ctx->plan.nmi),
+		WA_NAN_ADDR_ARGS(ctx->plan.cluster));
+	rtw_hal_wa_nan_sdf_reset_ack(ctx->phl->hal);
+	ctx->fw_touched = true;
+	ret = rtw_hal_wa_nan_h2c(ctx->phl->hal, &ctx->plan, &enable_ns,
+				 &fail_step);
+	rtw_hal_wa_nan_bcn_snapshot(ctx->phl->hal, &ctx->plan, op, "post-func2");
+	if (ret != 0) {
+		ctx->held = true;
+		pr_info("WA_PROBE nan-cycle phase=stageb-abort op=%llu ns=%llu step=%u host_result=%d held=1 remaining=0\n",
+			(unsigned long long)op, (unsigned long long)ktime_get_ns(),
+			(unsigned int)fail_step, ret);
+		rtw_hal_wa_nan_status(ctx->phl->hal, &ctx->plan, "stageb-abort");
+		return -EIO;
+	}
+	wa_nan_sdf_open();
+#if WA_NAN_M4B
+	if (!wa_nan_host_owned) {
+		u8 sdf_frame[WA_NAN_SDF_MAX_LEN];
+		u64 sdf_cookie = 0;
+		int sdf_len, sdf_ret, sdf_submit_ret;
+
+		if (rtw_hal_wa_nan_sdf_wait_ack(ctx->phl->hal, 2, 3000) != 0) {
+			ctx->held = true;
+			pr_info("WA_PROBE nan-cycle phase=stageb-held op=%llu ns=%llu reason=sdf-func2-ack-timeout\n",
+				(unsigned long long)op, (unsigned long long)ktime_get_ns());
+			return -ETIMEDOUT;
+		}
+#if WA_NAN_M5_PAIR
+		/* PIN is armed by the NAN-enable completion event, before the first
+		 * SDF submit and before this start write returns.
+		 */
+		if (wa_nan_pair_arm(ktime_get_ns()) != 0) {
+			ctx->held = true;
+			pr_info("WA_PROBE nan-cycle phase=stageb-held op=%llu ns=%llu reason=pin-arm-fail\n",
+				(unsigned long long)op, (unsigned long long)ktime_get_ns());
+			return -EIO;
+		}
+#endif
+		if (rtw_hal_wa_nan_sdf_tsf_ready(ctx->phl->hal, &ctx->plan) != 0) {
+			ctx->held = true;
+			pr_info("WA_PROBE nan-cycle phase=stageb-held op=%llu ns=%llu reason=sdf-tsf\n",
+				(unsigned long long)op, (unsigned long long)ktime_get_ns());
+			return -EIO;
+		}
+		sdf_len = wa_nan_stageb_build_sdf(ctx, sdf_frame, sizeof(sdf_frame));
+		if (sdf_len < 0) {
+			ctx->held = true;
+			pr_info("WA_PROBE nan-cycle phase=stageb-held op=%llu ns=%llu reason=sdf-build result=%d\n",
+				(unsigned long long)op, (unsigned long long)ktime_get_ns(), sdf_len);
+			return -EINVAL;
+		}
+		sdf_ret = rtw_hal_wa_nan_sdf_tx(ctx->phl->hal, &ctx->plan,
+					       sdf_frame, (u16)sdf_len, &sdf_cookie);
+		sdf_submit_ret = sdf_ret;
+		pr_info("WA_PROBE nan-cycle phase=sdf-submit op=%llu ns=%llu result=%d len=%d cookie=%llu macid=%u port=%u channel=6 rate=6 retry=0\n",
+			(unsigned long long)op, (unsigned long long)ktime_get_ns(),
+			sdf_ret, sdf_len, (unsigned long long)sdf_cookie,
+			(unsigned int)ctx->plan.macid_mgn,
+			(unsigned int)ctx->plan.port[0]);
+		if (sdf_ret == 0)
+			sdf_ret = rtw_hal_wa_nan_sdf_wait_done(ctx->phl->hal,
+							      sdf_cookie, 3000);
+		pr_info("WA_PROBE nan-cycle phase=sdf-done op=%llu ns=%llu result=%d cookie=%llu\n",
+			(unsigned long long)op, (unsigned long long)ktime_get_ns(),
+			sdf_ret, (unsigned long long)sdf_cookie);
+		if (sdf_ret != 0) {
+			const char *reason;
+
+			if (sdf_submit_ret < 0)
+				reason = "sdf-submit";
+			else if (sdf_ret == -ETIMEDOUT)
+				reason = "sdf-completion-timeout";
+			else if (sdf_ret == -EIO)
+				reason = "sdf-tx-status";
+			else
+				reason = "sdf-other";
+			ctx->held = true;
+#if WA_NAN_M5_PAIR
+			wa_nan_pair_clear("failed");
+#endif
+			pr_info("WA_PROBE nan-cycle phase=stageb-held op=%llu ns=%llu reason=%s submit_ok=%u result=%d\n",
+				(unsigned long long)op, (unsigned long long)ktime_get_ns(),
+				reason, sdf_submit_ret == 0, sdf_ret);
+			return sdf_ret;
+		}
+	}
+#if WA_NAN_P3 && !WA_NAN_M5_PAIR
+	/* One explicit discovery request completes on TX feedback. */
+	{
+		u32 gate_gen = wa_nan_gate_on(op, "start");
+		int loop_ret = wa_nan_p3_loop(ctx, op, 1);
+
+		wa_nan_gate_off(op, gate_gen, loop_ret);
+	}
+#endif
+#endif
+	ctx->entered = true;
+	pr_info("WA_PROBE nan-cycle phase=stageb-done op=%llu ns=%llu enable_ns=%llu steps=5 host_result=0\n",
+		(unsigned long long)op, (unsigned long long)ktime_get_ns(),
+		(unsigned long long)enable_ns);
+	rtw_hal_wa_nan_status(ctx->phl->hal, &ctx->plan, "stageb-done");
+	return 0;
+}
+
+int rtw_phl_wa_nan_cycle_start(void *phl, struct rtw_wifi_role_t *role,
+			       struct rtw_wifi_role_link_t *link)
+{
+	int ret;
+	u8 cluster[6];
+	if (!mutex_trylock(&wa_nan_lifecycle_lock)) return -EBUSY;
+	memcpy(cluster, wa_nan_cluster_prefix, sizeof(wa_nan_cluster_prefix));
+	get_random_bytes(cluster + 4, 2);
+	ret = wa_nan_cycle_enter(phl, role, link, cluster);
+	mutex_unlock(&wa_nan_lifecycle_lock);
+	return ret;
+}
+
+int rtw_phl_wa_nan_cycle_status(void *phl, struct rtw_wifi_role_t *wrole,
+				struct rtw_wifi_role_link_t *rlink)
+{
+	struct wa_nan_stageb_ctx *ctx = &wa_nan_stageb;
+
+	if (!phl || !wrole || !rlink)
+		return -EINVAL;
+	if (!ctx->entered || wrole->type != PHL_RTYPE_NAN ||
+	    ctx->wrole != wrole || ctx->rlink != rlink)
+		return -ENODEV;
+	pr_info("WA_PROBE nan-cycle phase=stageb-status op=%llu ns=%llu state=%d port_dw=%u port_disc=%u macid_bcn=%u macid_mgn=%u\n",
+		(unsigned long long)ktime_get_ns(),
+		(unsigned long long)ktime_get_ns(),
+		atomic_read(&wa_nan_stageb_state),
+		(unsigned int)ctx->plan.port[0], (unsigned int)ctx->plan.port[1],
+		(unsigned int)ctx->plan.macid_bcn,
+		(unsigned int)ctx->plan.macid_mgn);
+	return rtw_hal_wa_nan_status(ctx->phl->hal, &ctx->plan,
+				     "stageb-status") == 0 ? 0 : -EIO;
+}
+
+int rtw_phl_wa_nan_cycle_cap(void *phl)
+{
+	struct phl_info_t *phl_info = (struct phl_info_t *)phl;
+	struct rtw_phl_com_t *com;
+
+	if (!phl_info || !phl_info->phl_com)
+		return -EINVAL;
+	com = phl_info->phl_com;
+	pr_info("WA_PROBE nan-cap-debug phase=phl dev_cap_nan=%u sw_nan=%u fw_nan=%u fw_valid=%u\n",
+		(unsigned int)com->dev_cap.nan_sup,
+		(unsigned int)com->dev_sw_cap.nan_sup,
+		(unsigned int)com->dev_cap.wcpu_cap.mac_ofld_cap.nan,
+		(unsigned int)com->dev_cap.wcpu_cap.valid);
+	return rtw_hal_wa_nan_cap_dump(phl_info->hal);
+}
+
+static bool wa_ndi_has_session(struct wa_nan_stageb_ctx *ctx);
+#include "wa_nan_peer.h"
+#include "wa_nan_igtk.h"
+#include "wa_nan_ndi.h"
+
+/* No successful stop is reported while firmware or host resources remain. */
+static int wa_nan_host_cleanup(void *phl)
+{
+	struct wa_nan_stageb_ctx *ctx = &wa_nan_stageb;
+	int ret = wa_nan_sdf_quiesce();
+	if (ret) return ret;
+	ret = wa_ndi_quiesce(ctx->ndi);
+	if (ret) return ret;
+	if (ctx->fw_touched) {
+		ret = rtw_hal_wa_nan_disable(ctx->phl->hal, &ctx->plan);
+		if (ret) return ret;
+		ctx->fw_touched = false;
+	}
+	if (ctx->bigtk_attempted) {
+		ret = rtw_hal_wa_nan_bigtk_clean(ctx->phl->hal);
+		if (ret) return ret;
+		ctx->bigtk_attempted = ctx->bigtk_ready = false;
+		ctx->bigtk_index = 0;
+	}
+	if (ctx->schedule_touched) {
+		ret = rtw_hal_wa_nan_schedule_clean(ctx->phl->hal, ctx->plan.macid_mgn, true);
+		if (ret) return ret;
+		ctx->schedule_touched = ctx->schedule_ready = ctx->schedule_record = false;
+		ctx->data_slots = 0;
+		ctx->data_macid = 0;
+	}
+	if (ctx->igtk_attempted) {
+		ret = rtw_phl_wa_nan_igtk(phl, ctx->igtk_index, NULL, false);
+		if (ret) return ret;
+	}
+	ret = wa_ndi_delete(ctx);
+	if (ret) return ret;
+	if (ctx->peer) {
+		u8 address[6];
+		memcpy(address, ctx->peer->mac_addr, sizeof(address));
+		ret = rtw_phl_wa_nan_peer(phl, address, false);
+		if (ret) return ret;
+	}
+	if (ctx->ports_touched) {
+		ret = rtw_hal_wa_nan_port_disable(ctx->phl->hal, ctx->plan.port[1], ctx->band);
+		if (ret) return ret;
+		ctx->ports_touched = false;
+	}
+	ret = wa_nan_stageb_rollback(ctx, ktime_get_ns());
+	if (ret) return ret;
+	if (ctx->channel_changed) {
+		ret = wa_nan_restore_channel(phl, &ctx->channel_before);
+		if (ret) return ret;
+		ctx->channel_changed = false;
+	}
+	ctx->entered = ctx->held = false;
+	wa_nan_host_owned = false;
+	atomic_set(&wa_nan_stageb_state, 0);
+	rtw_phl_wa_nan_radio_release(phl);
+	return 0;
+}
+
+static int wa_nan_host_stop_locked(void *phl)
+{
+	struct wa_nan_stageb_ctx *ctx = &wa_nan_stageb;
+	int ret;
+	if (!atomic_read(&wa_nan_stageb_state)) return 0;
+	if (ctx->phl != phl) return -ENODEV;
+	ret = rtw_hal_wa_nan_command_begin(ctx->phl->hal);
+	if (ret) return ret;
+	ret = wa_nan_host_cleanup(phl);
+	rtw_hal_wa_nan_command_end();
+	if (ret) ctx->held = true;
+	pr_info("WA_PROBE host-stop result=%d held=%u fw=%u ports=%u mgmt=%u role=%u channel=%u ns=%llu\n",
+		ret, ctx->held, ctx->fw_touched, ctx->ports_touched,
+		ctx->mgmt_allocated, ctx->role_changed, ctx->channel_changed,
+		(unsigned long long)ktime_get_ns());
+	return ret;
+}
+
+int rtw_phl_wa_nan_host_stop(void *phl)
+{
+	int ret;
+	if (!mutex_trylock(&wa_nan_lifecycle_lock)) return -EBUSY;
+	ret = wa_nan_host_stop_locked(phl);
+	mutex_unlock(&wa_nan_lifecycle_lock);
+	return ret;
+}
+
+int rtw_phl_wa_nan_host_start(void *phl, struct rtw_wifi_role_t *role,
+			    struct rtw_wifi_role_link_t *link,
+			    const u8 *frame, u16 len)
+{
+	struct wa_nan_stageb_ctx *ctx = &wa_nan_stageb;
+	u64 cookie = 0;
+	int ret, cleanup = 0;
+	if (len > WA_NAN_FRAME_MAX) return -EMSGSIZE;
+	if (wa_nan_mgmt_rx_match(frame, len) != 1 ||
+	    memcmp(frame + 10, link->mac_addr, 6) ||
+	    memcmp(frame + 16, wa_nan_cluster_prefix, 4)) return -EINVAL;
+	if (!mutex_trylock(&wa_nan_lifecycle_lock)) return -EBUSY;
+	if (atomic_read(&wa_nan_stageb_state)) {
+		mutex_unlock(&wa_nan_lifecycle_lock);
+		return -EALREADY;
+	}
+	ret = rtw_hal_wa_nan_command_begin(((struct phl_info_t *)phl)->hal);
+	if (ret) {
+		mutex_unlock(&wa_nan_lifecycle_lock);
+		return ret;
+	}
+	wa_nan_host_owned = true;
+	ret = wa_nan_cycle_enter(phl, role, link, frame + 16);
+	if (!ret) {
+		ret = rtw_phl_wa_nan_sdf_tx(phl, frame, len, &cookie);
+		if (!ret) ret = rtw_phl_wa_nan_sdf_wait_done(phl, cookie, 1000);
+	}
+	if (ret) {
+		if (!atomic_read(&wa_nan_stageb_state)) wa_nan_host_owned = false;
+		cleanup = wa_nan_host_stop_locked(phl);
+		if (cleanup) ctx->held = true;
+	}
+	rtw_hal_wa_nan_command_end();
+	pr_info("WA_PROBE host-start result=%d cookie=%llu cleanup=%d held=%u channel=6 ns=%llu\n",
+		ret, (unsigned long long)cookie, cleanup, ctx->held,
+		(unsigned long long)ktime_get_ns());
+	/* EUCLEAN distinguishes retained state from a fully rolled-back failure. */
+	mutex_unlock(&wa_nan_lifecycle_lock);
+	return cleanup ? -EUCLEAN : ret;
+}
