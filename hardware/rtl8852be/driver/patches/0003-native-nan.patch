+/* Called with tid_rx_lock held. All TIDs share this station timer. */
+static u32 wa_nan_rx_reorder_delay(struct phl_info_t *phl_info,
+                                 struct rtw_phl_stainfo_t *sta)
+{
+ u32 now, delay = HT_RX_REORDER_BUF_TIMEOUT_MS;
+ unsigned int tid;
+
+ if (!READ_ONCE(phl_info->wa_nan_radio_owned))
+  return delay;
+ now = _os_get_cur_time_ms();
+ for (tid = 0; tid < ARRAY_SIZE(sta->tid_rx); tid++) {
+  struct phl_tid_ampdu_rx *r = sta->tid_rx[tid];
+  unsigned int offset, index;
+  s32 remaining;
+
+  if (!r || r->removed || !r->stored_mpdu_num)
+   continue;
+  for (offset = 0; offset < r->buf_size; offset++) {
+   index = (reorder_index(r, r->head_seq_num) + offset) % r->buf_size;
+   if (!r->reorder_buf[index])
+    continue;
+   remaining = (s32)(r->reorder_time[index] +
+                     HT_RX_REORDER_BUF_TIMEOUT_MS - now);
+   if (remaining <= 0)
+    return 1;
+   if ((u32)remaining < delay)
+    delay = remaining;
+   /* This is the next buffered frame in sequence order for this TID. */
+   break;
+  }
+ }
+ return delay;
+}
 
