+/* PCIe MMIO gate: no firmware command or sleep in the hrtimer path. */
+u32 rtw_hal_awdl_pause(void *hal,u16 macid,bool pause)
+{
+ struct hal_info_t *h=hal;
+ u32 reg=R_AX_SS_MACID_PAUSE_0+(macid/32)*4,bit=BIT(macid%32);
+ u32 value=hal_read32(h->hal_com,reg);
+ hal_write32(h->hal_com,reg,pause ? value|bit:value&~bit);
+ return hal_read32(h->hal_com,reg)&bit;
+}
+void rtw_hal_awdl_aggregate(void *hal,u8 band,bool enable,u32 *saved)
+{
+ struct hal_info_t *h=hal;
+ u32 regs[2]={band ? R_AX_AGG_LEN_VHT_0_C1:R_AX_AGG_LEN_VHT_0,
+              band ? R_AX_AGG_LEN_HE_0_C1:R_AX_AGG_LEN_HE_0};
+ for(u8 i=0;i<2;i++) {
+  u32 value=hal_read32(h->hal_com,regs[i]);
+  if(enable) {saved[i]=value;value=(value&~(i ? B_AX_AMPDU_MAX_LEN_HE_MSK:B_AX_AMPDU_MAX_LEN_VHT_MSK))|524288;}
+  else value=saved[i];
+  hal_write32(h->hal_com,regs[i],value);
+ }
+ pr_info("AWDL_AGG_LIMIT enabled=%u vht=%08x he=%08x saved=%08x/%08x\n",enable,
+  hal_read32(h->hal_com,regs[0]),hal_read32(h->hal_com,regs[1]),saved[0],saved[1]);
+}
+int rtw_hal_awdl_agg_descriptor(void *hal,struct rtw_phl_stainfo_t *sta)
+{
+ struct rtw_hal_mac_ax_cctl_info c={0},mask={0};
+ /* Select each WD's aggregate count so the tail deadline can shorten a PPDU. */
+ c.max_agg_num_sel=0;mask.max_agg_num_sel=1;
+ return rtw_hal_cmc_tbl_cfg(hal,&c,&mask,sta->macid)==RTW_HAL_STATUS_SUCCESS ? 0:-EIO;
+}
