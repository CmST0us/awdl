+/* Counters at DMA, reorder entry and stack delivery separate PHY-status
+ * waiting from missing-MPDU waiting. Only unicast AWDL data is counted. */
+struct wa_awdl_rx_accounting {
+ u64 packets[3], bytes[3], wait_us[2][8], max_us[2];
+ u64 retry, crc, no_cam, ampdu, old, duplicate, buffered, timed_out;
+ u64 by_channel[2], channel_bytes[2];
+ u64 seq_gap, seq_late, seq_repeat;
+ u16 last_seq[16], seen;
+ u8 peer[6];
+};
+static struct wa_awdl_rx_accounting wa_awdl_rx_stats;
+static DEFINE_SPINLOCK(wa_awdl_rx_stats_lock);
+
+static bool wa_awdl_rx_countable(struct phl_info_t *phl, struct rtw_phl_rx_pkt *pkt)
+{
+ const u8 *f = pkt->r.pkt_list[0].vir_addr;
+ return rtw_phl_awdl_probe_active(phl) && pkt->r.pkt_cnt && f &&
+        pkt->r.pkt_list[0].length >= 26 && f[0] == 0x88 &&
+        !(f[4] & 1) && pkt->r.mdata.a1_match &&
+        !memcmp(f + 16, "\x00\x25\x00\xff\x94\x73", 6);
+}
+
+void rtw_phl_awdl_rx_account(void *context, struct rtw_phl_rx_pkt *pkt, u8 stage)
+{
+ struct phl_info_t *phl = context;
+ struct wa_awdl_rx_accounting *s = &wa_awdl_rx_stats;
+ const u8 *f = pkt->r.pkt_list[0].vir_addr;
+ unsigned long flags;
+ u64 us;
+ u16 seq, delta;
+ u8 bucket, tid, channel;
+ if (!wa_awdl_rx_countable(phl, pkt)) return;
+ spin_lock_irqsave(&wa_awdl_rx_stats_lock, flags);
+ if (stage < 3) {
+  s->packets[stage]++;s->bytes[stage] += pkt->r.pkt_list[0].length;
+  if (stage) {
+   us = (ktime_get_ns() - pkt->r.wa_rx_monotonic_ns) / 1000;
+   bucket = us < 100 ? 0 : us < 1000 ? 1 : us < 4000 ? 2 :
+            us < 16000 ? 3 : us < 64000 ? 4 : us < 128000 ? 5 :
+            us < 512000 ? 6 : 7;
+   s->wait_us[stage-1][bucket]++;
+   s->max_us[stage-1] = max(s->max_us[stage-1], us);
+  } else {
+   s->retry += !!(f[1]&8);s->crc += !!pkt->r.mdata.crc32;
+   s->no_cam += !pkt->r.mdata.addr_cam_vld;s->ampdu += !!pkt->r.mdata.ampdu;
+   channel = rtw_hal_get_cur_ch(phl->hal,pkt->r.mdata.bb_sel) == 161;
+   s->by_channel[channel]++;s->channel_bytes[channel] += pkt->r.pkt_list[0].length;
+   if (memcmp(s->peer,f+10,6)) {memcpy(s->peer,f+10,6);s->seen=0;}
+   tid=f[24]&15;seq=get_unaligned_le16(f+22)>>4;
+   if (s->seen&BIT(tid)) {
+    delta=(seq-s->last_seq[tid])&4095;
+    if (!delta)s->seq_repeat++;
+    else if (delta<2048) {s->seq_gap+=delta-1;s->last_seq[tid]=seq;}
+    else s->seq_late++;
+   } else {s->seen|=BIT(tid);s->last_seq[tid]=seq;}
+  }
+ } else if(stage==3)s->old++;
+ else if(stage==4)s->duplicate++;
+ else if(stage==5)s->buffered++;
+ else if(stage==6)s->timed_out++;
+ spin_unlock_irqrestore(&wa_awdl_rx_stats_lock, flags);
+}
+
+void rtw_phl_awdl_rx_snapshot(void)
+{
+ struct wa_awdl_rx_accounting s;
+ unsigned long flags;
+ spin_lock_irqsave(&wa_awdl_rx_stats_lock,flags);s=wa_awdl_rx_stats;spin_unlock_irqrestore(&wa_awdl_rx_stats_lock,flags);
+ pr_info("AWDL_RX_TOTAL dma=%llu reorder=%llu delivered=%llu dma_bytes=%llu delivered_bytes=%llu retry=%llu crc=%llu no_cam=%llu ampdu=%llu old=%llu duplicate=%llu buffered=%llu timed_out=%llu gap=%llu late=%llu repeat=%llu rx149=%llu rx161=%llu bytes149=%llu bytes161=%llu\n",
+  s.packets[0],s.packets[1],s.packets[2],s.bytes[0],s.bytes[2],s.retry,s.crc,s.no_cam,s.ampdu,s.old,s.duplicate,s.buffered,s.timed_out,s.seq_gap,s.seq_late,s.seq_repeat,s.by_channel[0],s.by_channel[1],s.channel_bytes[0],s.channel_bytes[1]);
+ for(u8 i=0;i<2;i++)
+  pr_info("AWDL_RX_WAIT stage=%s max_us=%llu us_100_1000_4000_16000_64000_128000_512000_over=%llu/%llu/%llu/%llu/%llu/%llu/%llu/%llu\n",
+   i ? "delivery":"reorder",s.max_us[i],s.wait_us[i][0],s.wait_us[i][1],s.wait_us[i][2],s.wait_us[i][3],s.wait_us[i][4],s.wait_us[i][5],s.wait_us[i][6],s.wait_us[i][7]);
+}
