--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt76/mt7925/awdl.c
@@ -0,0 +1,351 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/* Native AWDL on an owned NAN_DATA netdev; IP remains in mac80211. */
+#include <linux/unaligned.h>
+#include <net/awdl.h>
+#include "mt7925.h"
+#include "mcu.h"
+
+#define MT7925_AWDL_OUI 0x000ce7
+#define MT7925_AWDL_CMD 0x4157444c
+
+static void mt7925_awdl_ndp_iter(void *data, struct ieee80211_sta *sta)
+{
+	struct mt792x_sta *msta = (void *)sta->drv_priv;
+	struct ieee80211_vif *vif = container_of((void *)msta->vif, struct ieee80211_vif, drv_priv);
+	if (vif->type == NL80211_IFTYPE_NAN_DATA && !vif->nan_data_awdl)
+		*(bool *)data = true;
+}
+
+static u8 mt7925_awdl_home(struct mt792x_dev *dev)
+{
+	struct ieee80211_nan_channel **slots;
+	int i;
+
+	if (!dev->nan_vif)
+		return 0;
+	slots = dev->nan_vif->cfg.nan_sched.schedule;
+	for (i = 0; i < CFG80211_NAN_SCHED_NUM_TIME_SLOTS; i++) {
+		if (slots[i] && !IS_ERR(slots[i]) && slots[i]->chanctx_conf &&
+		    slots[i]->chanctx_conf->def.chan->band == NL80211_BAND_5GHZ)
+			return slots[i]->chanctx_conf->def.chan->hw_value;
+	}
+	return 0;
+}
+
+/* CNM reports committed BSS channel state. A running firmware AP BSS is
+ * permanent until BSS deactivation; it does not need a temporary ROC lease.
+ * Confirm the BSS bitmap, bandwidth and primary channel in the query reply. */
+static int mt7925_awdl_confirm_channel(struct mt792x_dev *dev, u8 channel)
+{
+	struct mt792x_vif *mvif = (void *)dev->awdl_vif->drv_priv;
+	const u8 request[] = {0, 0, 0, 0, 2, 0, 4, 0};
+	struct sk_buff *skb;
+	const u8 *p;
+	size_t left;
+	bool found = false;
+	int ret;
+
+	ret = mt76_mcu_send_and_get_msg(&dev->mt76, MCU_WM_UNI_CMD_QUERY(ROC),
+		request, sizeof(request), true, &skb);
+	if (ret)
+		return ret;
+	if (skb->len < 4) {
+		ret = -EPROTO;
+		goto out;
+	}
+	p = skb->data + 4;
+	left = skb->len - 4;
+	ret = -ENOLINK;
+	while (left >= 4) {
+		u16 tag = get_unaligned_le16(p);
+		u16 len = get_unaligned_le16(p + 2);
+		unsigned int i;
+
+		if (len < 4 || len > left) {
+			ret = -EPROTO;
+			goto out;
+		}
+		if (tag == 1 && len >= 8 && len >= 8 + p[6] * 8) {
+			for (i = 0; i < p[6]; i++) {
+				const u8 *ch = p + 8 + i * 8;
+				if (ch[0] == channel && ch[1] == CMD_CBW_80MHZ &&
+				    ch[3] == 155 &&
+				    (get_unaligned_le16(ch + 6) & BIT(mvif->bss_conf.mt76.idx))) {
+					mvif->bss_conf.mt76.band_idx = p[4];
+					found = true;
+				}
+			}
+		}
+		p += len;
+		left -= len;
+	}
+	if (!left && found)
+		ret = 0;
+out:
+	dev_kfree_skb(skb);
+	return ret;
+}
+
+static int mt7925_awdl_channel(struct mt792x_dev *dev, u8 channel)
+{
+	struct mt792x_vif *mvif = (void *)dev->awdl_vif->drv_priv;
+	struct ieee80211_channel *chan;
+	int ret;
+	bool ndp = false;
+
+	ieee80211_iterate_stations_atomic(dev->mt76.hw, mt7925_awdl_ndp_iter, &ndp);
+	if (ndp && channel != mt7925_awdl_home(dev))
+		return -EBUSY;
+	if (channel != 149 && channel != 161)
+		return -EINVAL;
+	chan = ieee80211_get_channel(dev->mt76.hw->wiphy, 5000 + 5 * channel);
+	if (!chan || chan->flags & (IEEE80211_CHAN_DISABLED | IEEE80211_CHAN_NO_IR))
+		return -EPERM;
+	if (dev->awdl_channel == channel)
+		return 0;
+	if (!wait_event_timeout(dev->mt76.awdl_drain,
+		!atomic_read(&dev->mt76.awdl_pending_bytes), HZ / 5))
+		return -ETIMEDOUT;
+	dev->awdl_ctx->def.chan = chan;
+	ret = mt7925_mcu_set_chctx(&dev->mphy, &mvif->bss_conf.mt76,
+		&dev->awdl_vif->bss_conf, dev->awdl_ctx);
+	if (!ret)
+		ret = mt7925_awdl_confirm_channel(dev, channel);
+	if (!ret)
+		dev->awdl_channel = channel;
+	return ret;
+}
+
+static int mt7925_awdl_release(struct mt792x_dev *dev)
+{
+	struct ieee80211_vif *vif = dev->awdl_vif;
+	int ret;
+
+	WRITE_ONCE(vif->awdl_closes_ns, 0);
+	if (!wait_event_timeout(dev->mt76.awdl_drain,
+		!atomic_read(&dev->mt76.awdl_pending_bytes), HZ))
+		return -ETIMEDOUT;
+	if (dev->awdl_bss_held) {
+		ret = mt7925_mcu_set_bss_pm(dev, &vif->bss_conf, false);
+		if (ret)
+			return ret;
+		ret = mt7925_mcu_add_bss_info(&dev->phy, dev->awdl_ctx,
+			&vif->bss_conf, NULL, false);
+		if (ret)
+			return ret;
+		dev->awdl_bss_held = false;
+		dev->awdl_channel = 0;
+	}
+	ret = mt7925_mcu_set_sniffer(dev, vif, false);
+	if (ret)
+		return ret;
+	return mt7925_mcu_set_rxfilter(dev, dev->phy.rxfilter, 0, 0);
+}
+
+int mt7925_awdl_start(struct mt792x_dev *dev, struct ieee80211_vif *vif)
+{
+	struct mt792x_vif *mvif = (void *)vif->drv_priv;
+	u8 home = mt7925_awdl_home(dev);
+	int ret;
+
+	if (home != 149 && home != 161)
+		return -EINVAL;
+	if (dev->awdl_vif)
+		return -EBUSY;
+	dev->awdl_ctx = kzalloc(sizeof(*dev->awdl_ctx), GFP_KERNEL);
+	if (!dev->awdl_ctx)
+		return -ENOMEM;
+	WRITE_ONCE(dev->mt76.awdl_absent, false);
+	WRITE_ONCE(dev->awdl_absent_since_ns, 0);
+	WRITE_ONCE(dev->awdl_vif, vif);
+	mvif->bss_conf.mt76.ctx = dev->awdl_ctx;
+	dev->awdl_ctx->def.chan = ieee80211_get_channel(dev->mt76.hw->wiphy, 5000 + 5 * home);
+	dev->awdl_ctx->def.width = NL80211_CHAN_WIDTH_80;
+	dev->awdl_ctx->def.center_freq1 = 5775;
+	mvif->bss_conf.mt76.basic_rates_idx = MT792x_BASIC_RATES_TBL + 4;
+	vif->bss_conf.qos = true;
+	vif->bss_conf.beacon_int = 100;
+	vif->bss_conf.dtim_period = 1;
+	dev->awdl_bss_held = true;
+	ret = mt7925_mcu_add_bss_info(&dev->phy, dev->awdl_ctx,
+					    &vif->bss_conf, NULL, true);
+	if (!ret)
+		ret = mt7925_mcu_set_bss_pm(dev, &vif->bss_conf, true);
+	if (!ret)
+		ret = mt7925_mcu_sta_update(dev, NULL, vif, &mvif->sta.deflink,
+				true, MT76_STA_INFO_STATE_NONE, NULL);
+	if (!ret)
+		ret = mt7925_awdl_channel(dev, home);
+	/* The firmware otherwise consumes vendor Action frames even when
+	 * OTHER_BSS is accepted. Enable raw RX delivery while retaining the
+	 * native BSS, station ACK/aggregation and mac80211 data path. */
+	if (!ret)
+		ret = mt7925_mcu_set_sniffer(dev, vif, true);
+	if (!ret)
+		ret = mt7925_mcu_set_rxfilter(dev, dev->phy.rxfilter |
+					    MT7925_FILTER_OTHER_BSS, 0, 0);
+	if (ret) {
+		int cleanup = mt7925_awdl_release(dev);
+		if (cleanup) {
+			dev_err(dev->mt76.dev, "AWDL startup rollback failed: %d; resetting hardware\n", cleanup);
+			mt792x_reset(&dev->mt76);
+		}
+		WRITE_ONCE(dev->awdl_vif, NULL);
+		mvif->bss_conf.mt76.ctx = NULL;
+		kfree(dev->awdl_ctx);
+		dev->awdl_ctx = NULL;
+	}
+	return ret;
+}
+
+void mt7925_awdl_stop(struct mt792x_dev *dev, struct ieee80211_vif *vif)
+{
+	struct mt792x_vif *mvif = (void *)vif->drv_priv;
+	int ret;
+
+	if (dev->awdl_vif != vif)
+		return;
+	ret = mt7925_awdl_release(dev);
+	if (ret) {
+		dev_err(dev->mt76.dev, "AWDL forced interface removal, release=%d; resetting hardware\n", ret);
+		mt792x_reset(&dev->mt76);
+	}
+	WRITE_ONCE(dev->awdl_vif, NULL);
+	synchronize_net();
+	mvif->bss_conf.mt76.ctx = NULL;
+	kfree(dev->awdl_ctx);
+	dev->awdl_ctx = NULL;
+}
+
+static int mt7925_awdl_command(struct wiphy *wiphy, struct wireless_dev *wdev,
+			      const void *data, int len)
+{
+	struct ieee80211_hw *hw = wiphy_to_ieee80211_hw(wiphy);
+	struct mt792x_dev *dev = mt792x_hw_dev(hw);
+	struct ieee80211_vif *vif = wdev_to_ieee80211_vif(wdev);
+	const u8 *cmd = data;
+	int ret;
+
+	if (!len)
+		return -EINVAL;
+	if (len == 1 && cmd[0] == 1)
+		return ieee80211_nan_data_set_awdl(wdev);
+	if (!vif || !vif->nan_data_awdl || dev->awdl_vif != vif)
+		return -ENOLINK;
+	if (len == 7 && cmd[0] == 2)
+		return ieee80211_awdl_add_peer(wdev, cmd + 1);
+	if (len == 17 && cmd[0] == 3)
+		return ieee80211_awdl_set_window(wdev, get_unaligned_le64(cmd + 1),
+						get_unaligned_le64(cmd + 9));
+	mt792x_mutex_acquire(dev);
+	if (len == 18 && cmd[0] == 4) {
+		WRITE_ONCE(vif->awdl_closes_ns, 0);
+		ret = mt7925_awdl_channel(dev, cmd[1]);
+		if (!ret)
+			ret = ieee80211_awdl_set_window(wdev, get_unaligned_le64(cmd + 2),
+						get_unaligned_le64(cmd + 10));
+	} else if (len == 1 && cmd[0] == 5) {
+		ret = mt7925_awdl_release(dev);
+	} else {
+		ret = -EINVAL;
+	}
+	mt792x_mutex_release(dev);
+	return ret;
+}
+
+static const struct wiphy_vendor_command mt7925_awdl_commands[] = {{
+	.info = { .vendor_id = MT7925_AWDL_OUI, .subcmd = MT7925_AWDL_CMD },
+	.flags = WIPHY_VENDOR_CMD_NEED_NETDEV,
+	.doit = mt7925_awdl_command,
+	.policy = VENDOR_CMD_RAW_DATA,
+}};
+
+static const struct nl80211_vendor_cmd_info mt7925_awdl_events[] = {{
+	.vendor_id = MT7925_AWDL_OUI, .subcmd = MT7925_AWDL_CMD,
+}};
+
+void mt7925_awdl_event(struct mt792x_dev *dev, u8 kind, const struct sk_buff *frame)
+{
+	struct sk_buff *msg;
+	u8 *data;
+	u64 received = ktime_get_ns();
+	size_t len = frame ? frame->len : 0;
+
+	if (!READ_ONCE(dev->awdl_vif))
+		return;
+	msg = cfg80211_vendor_event_alloc(dev->mt76.hw->wiphy, NULL, 9 + len, 0, GFP_ATOMIC);
+	if (!msg)
+		return;
+	data = skb_put(msg, 9 + len);
+	data[0] = kind;
+	put_unaligned_le64(received, data + 1);
+	if (frame && skb_copy_bits(frame, 0, data + 9, len)) {
+		kfree_skb(msg);
+		return;
+	}
+	cfg80211_vendor_event(msg, GFP_ATOMIC);
+}
+
+void mt7925_awdl_absence(struct mt792x_dev *dev, struct sk_buff *skb)
+{
+	struct ieee80211_vif *vif = READ_ONCE(dev->awdl_vif);
+	struct mt792x_vif *mvif;
+	const u8 *p;
+	u64 now = ktime_get_ns(), begin;
+	size_t left;
+
+	if (!vif || skb->len < sizeof(struct mt7925_mcu_rxd) + 4)
+		return;
+	mvif = (void *)vif->drv_priv;
+	p = skb->data + sizeof(struct mt7925_mcu_rxd);
+	if (p[0] != mvif->bss_conf.mt76.idx)
+		return;
+	p += 4;
+	left = skb->len - sizeof(struct mt7925_mcu_rxd) - 4;
+	while (left >= 4) {
+		u16 tag = get_unaligned_le16(p), len = get_unaligned_le16(p + 2);
+		if (len < 4 || len > left)
+			return;
+		if (tag == 0 && len >= 8) {
+			if (p[4]) {
+				if (!READ_ONCE(dev->mt76.awdl_absent))
+					WRITE_ONCE(dev->awdl_absent_since_ns, now);
+				WRITE_ONCE(dev->mt76.awdl_absent, true);
+			} else {
+				struct sk_buff *msg;
+				u8 *data;
+
+				begin = READ_ONCE(dev->awdl_absent_since_ns);
+				WRITE_ONCE(dev->awdl_absent_since_ns, 0);
+				WRITE_ONCE(dev->mt76.awdl_absent, false);
+				mt76_worker_schedule(&dev->mt76.tx_worker);
+				/* Short channel switches are already covered by the
+				 * scheduler's measured switch margin. Publish DW gaps. */
+				if (!begin || now <= begin + 8 * 1024 * 1000)
+					return;
+				msg = cfg80211_vendor_event_alloc(dev->mt76.hw->wiphy, NULL, 17, 0, GFP_ATOMIC);
+				if (!msg)
+					return;
+				data = skb_put(msg, 17);
+				data[0] = 3;
+				put_unaligned_le64(now, data + 1);
+				put_unaligned_le64(begin, data + 9);
+				cfg80211_vendor_event(msg, GFP_ATOMIC);
+			}
+		}
+		p += len;
+		left -= len;
+	}
+}
+
+void mt7925_awdl_register(struct mt792x_dev *dev)
+{
+	struct wiphy *wiphy = dev->mt76.hw->wiphy;
+
+	init_waitqueue_head(&dev->mt76.awdl_drain);
+	atomic_set(&dev->mt76.awdl_pending_bytes, 0);
+	wiphy->vendor_commands = mt7925_awdl_commands;
+	wiphy->n_vendor_commands = ARRAY_SIZE(mt7925_awdl_commands);
+	wiphy->vendor_events = mt7925_awdl_events;
+	wiphy->n_vendor_events = ARRAY_SIZE(mt7925_awdl_events);
+}
