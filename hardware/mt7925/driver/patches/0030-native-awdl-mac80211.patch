+static bool ieee80211_awdl_decap(struct sk_buff *skb)
+{
+	struct ethhdr header;
+
+	if (!pskb_may_pull(skb, ETH_HLEN + 16) ||
+	    memcmp(skb->data + ETH_HLEN, awdl_snap, sizeof(awdl_snap)))
+		return false;
+	memcpy(&header, skb->data, 2 * ETH_ALEN);
+	memcpy(&header.h_proto, skb->data + ETH_HLEN + 14, 2);
+	skb_pull(skb, 16);
+	memcpy(skb->data, &header, ETH_HLEN);
+	skb->ip_summed = CHECKSUM_NONE;
+	return true;
+}
