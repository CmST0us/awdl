Subject: [PATCH] 在 NAN 组站点销毁前回收密钥

--- a/net/mac80211/cfg.c
+++ b/net/mac80211/cfg.c
@@ -339,6 +339,10 @@
 	if (!sdata->u.nan.started)
 		return;
 
+	/* The driver removes NAN group stations in stop_nan. Release their
+	 * keys while those stations still exist in hardware.
+	 */
+	ieee80211_free_keys(sdata, true);
 	drv_stop_nan(sdata->local, sdata);
 	sdata->u.nan.started = false;
 
