Subject: [PATCH] mac80211: native AWDL data on owned NAN_DATA interfaces

Keep IP traffic in the kernel. Couple the AWDL NMI peer to the data
interface, convert AWDL framing, and dequeue within peer windows.

--- a/drivers/net/wireless/intel/iwlwifi/mld/tx.c
+++ b/drivers/net/wireless/intel/iwlwifi/mld/tx.c
@@ -1057,6 +1057,9 @@
 	rcu_read_lock();
 	do {
 		while (likely(!mld_txq->status.stop_full) &&
+		       (!txq->vif->nan_data_awdl || txq->tid >= IEEE80211_NUM_TIDS ||
+		        (ktime_get_ns() >= READ_ONCE(txq->vif->awdl_opens_ns) &&
+		         ktime_get_ns() + 1000000 < READ_ONCE(txq->vif->awdl_closes_ns))) &&
 		       (skb = ieee80211_tx_dequeue(mld->hw, txq)))
 			iwl_mld_tx_skb(mld, skb, txq);
 	} while (atomic_dec_return(&mld_txq->tx_request));
--- a/drivers/net/wireless/intel/iwlwifi/mld/vendor-cmd.c
