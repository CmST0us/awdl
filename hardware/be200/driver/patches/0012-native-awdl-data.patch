+int ieee80211_awdl_add_peer(struct wireless_dev *wdev, const u8 *addr)
+{
+	struct ieee80211_sub_if_data *sdata = IEEE80211_WDEV_TO_SUB_IF(wdev);
+	struct ieee80211_sub_if_data *nmi;
+	struct station_parameters params = {
+		.listen_interval = -1,
+		.support_p2p_ps = -1,
+		.link_sta_params.link_id = -1,
+		.sta_flags_mask = BIT(NL80211_STA_FLAG_AUTHENTICATED) |
+			BIT(NL80211_STA_FLAG_ASSOCIATED) | BIT(NL80211_STA_FLAG_AUTHORIZED),
+	};
+	int ret;
+
+	lockdep_assert_wiphy(wdev->wiphy);
+	if (!sdata->vif.nan_data_awdl || !ieee80211_sdata_running(sdata))
+		return -EINVAL;
+	if (!is_zero_ether_addr(sdata->u.nan_data.awdl_peer))
+		return -EBUSY;
+	nmi = wiphy_dereference(wdev->wiphy, sdata->u.nan_data.nmi);
+	if (!nmi)
+		return -ENOLINK;
+	params.sta_flags_set = params.sta_flags_mask;
+	ret = ieee80211_add_station(wdev->wiphy, &nmi->wdev, addr, &params);
+	if (!ret)
+		ether_addr_copy(sdata->u.nan_data.awdl_peer, addr);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(ieee80211_awdl_add_peer);
 
