+static enum hrtimer_restart ieee80211_awdl_wake(struct hrtimer *timer)
+{
+	struct ieee80211_if_nan_data *nan = container_of(timer, struct ieee80211_if_nan_data, awdl_timer);
+	struct ieee80211_sub_if_data *sdata = container_of(nan, struct ieee80211_sub_if_data, u.nan_data);
+	struct sta_info *sta;
+
+	local_bh_disable();
+	rcu_read_lock();
+	list_for_each_entry_rcu(sta, &sdata->local->sta_list, list) {
+		if (sta->sdata != sdata)
+			continue;
+		for (int i = 0; i < IEEE80211_NUM_TIDS; i++)
+			if (sta->sta.txq[i])
+				drv_wake_tx_queue(sdata->local, to_txq_info(sta->sta.txq[i]));
+	}
+	if (sdata->vif.txq)
+		drv_wake_tx_queue(sdata->local, to_txq_info(sdata->vif.txq));
+	rcu_read_unlock();
+	local_bh_enable();
+	return HRTIMER_NORESTART;
+}
+
+int ieee80211_awdl_set_window(struct wireless_dev *wdev, u64 opens, u64 closes)
+{
+	struct ieee80211_sub_if_data *sdata = IEEE80211_WDEV_TO_SUB_IF(wdev);
+
+	lockdep_assert_wiphy(wdev->wiphy);
+	if (!sdata->vif.nan_data_awdl || !ieee80211_sdata_running(sdata) ||
+	    (closes && opens >= closes))
+		return -EINVAL;
+	hrtimer_cancel(&sdata->u.nan_data.awdl_timer);
+	WRITE_ONCE(sdata->vif.awdl_closes_ns, 0);
+	WRITE_ONCE(sdata->vif.awdl_opens_ns, opens);
+	WRITE_ONCE(sdata->vif.awdl_closes_ns, closes);
+	if (closes > ktime_get_ns())
+		hrtimer_start(&sdata->u.nan_data.awdl_timer, ns_to_ktime(opens), HRTIMER_MODE_ABS_SOFT);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(ieee80211_awdl_set_window);
+
+int ieee80211_nan_data_set_awdl(struct wireless_dev *wdev)
+{
+	struct ieee80211_sub_if_data *sdata = IEEE80211_WDEV_TO_SUB_IF(wdev);
+
+	if (wdev->iftype != NL80211_IFTYPE_NAN_DATA)
+		return -EINVAL;
+	if (ieee80211_sdata_running(sdata))
+		return -EBUSY;
+	if (sdata->vif.nan_data_awdl)
+		return -EALREADY;
+	hrtimer_init(&sdata->u.nan_data.awdl_timer, CLOCK_MONOTONIC, HRTIMER_MODE_ABS_SOFT);
+	sdata->u.nan_data.awdl_timer.function = ieee80211_awdl_wake;
+	sdata->vif.nan_data_awdl = true;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(ieee80211_nan_data_set_awdl);
 
