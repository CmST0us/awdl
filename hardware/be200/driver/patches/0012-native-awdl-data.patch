 }
 
+static int iwl_mld_awdl_data(struct wiphy *wiphy, struct wireless_dev *wdev,
+			     const void *data, int len)
+{
+	if (len == 1 && *(const u8 *)data == 1)
+		return ieee80211_nan_data_set_awdl(wdev);
+	if (len == 7 && *(const u8 *)data == 2)
+		return ieee80211_awdl_add_peer(wdev, (const u8 *)data + 1);
+	if (len == 17 && *(const u8 *)data == 3)
+		return ieee80211_awdl_set_window(wdev, get_unaligned_le64((const u8 *)data + 1),
+			get_unaligned_le64((const u8 *)data + 9));
+	return -EINVAL;
+}
+
 static const struct wiphy_vendor_command iwl_mld_vendor_commands[] = {
+	{
+		.info = { .vendor_id = INTEL_OUI, .subcmd = 0x4157444c },
+		.flags = WIPHY_VENDOR_CMD_NEED_NETDEV,
+		.doit = iwl_mld_awdl_data,
+		.policy = VENDOR_CMD_RAW_DATA,
+	},
 	{
 		.info = {
 			.vendor_id = INTEL_OUI,
