@@ -3104,6 +3105,24 @@
  * maintained if any of the TX path checks change.
  */
 
+static unsigned int ieee80211_awdl_encap_len(struct ieee80211_sub_if_data *sdata)
+{
+	return sdata->vif.nan_data_awdl ? 14 : sizeof(rfc1042_header);
+}
+
+static void ieee80211_awdl_encap(struct ieee80211_sub_if_data *sdata, void *data, unsigned int count)
+{
+	u8 *bytes = data;
+
+	if (!sdata->vif.nan_data_awdl) {
+		memcpy(bytes, rfc1042_header, sizeof(rfc1042_header));
+		return;
+	}
+	memcpy(bytes, awdl_snap, sizeof(awdl_snap));
+	put_unaligned_le16(atomic_add_return(count, &sdata->u.nan_data.awdl_seq) - count + 1, bytes + 10);
+	put_unaligned_le16(0, bytes + 12);
+}
