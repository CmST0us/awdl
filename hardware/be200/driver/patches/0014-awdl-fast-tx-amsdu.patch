 		memcpy(awdl, awdl_snap, sizeof(awdl_snap));
-		put_unaligned_le16(atomic_inc_return(&sdata->u.nan_data.awdl_seq), awdl + 10);
+		unsigned int count = max_t(unsigned int, 1, skb_shinfo(skb)->gso_segs);
+		put_unaligned_le16(atomic_add_return(count, &sdata->u.nan_data.awdl_seq) - count + 1, awdl + 10);
 		put_unaligned_le16(0, awdl + 12);
 	} else if (encaps_data)
