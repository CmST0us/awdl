Subject: NAN：跳过未变化的 TLC 配置并启用受限聚合快速发送

--- /dev/null
+++ b/drivers/net/wireless/intel/iwlwifi/mld/nan-tlc-cache.h
@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: GPL-2.0 OR BSD-3-Clause */
+#ifndef __iwl_mld_nan_tlc_cache_h__
+#define __iwl_mld_nan_tlc_cache_h__
+
+/* A schedule bitmap/sequence change alone must not restart rate learning. */
+struct iwl_mld_nan_tlc_cache {
+	bool valid;
+	struct cfg80211_chan_def chandef;
+	struct iwl_tlc_config_cmd cmd;
+};
+
+static inline bool
+iwl_mld_nan_tlc_unchanged(const struct iwl_mld_nan_tlc_cache *cache,
+                          const struct cfg80211_chan_def *chandef,
+                          const struct iwl_tlc_config_cmd *cmd)
+{
+	return cache->valid &&
+		cfg80211_chandef_identical(&cache->chandef, chandef) &&
+		!memcmp(&cache->cmd, cmd, sizeof(*cmd));
+}
+
+static inline void
+iwl_mld_nan_tlc_remember(struct iwl_mld_nan_tlc_cache *cache,
+                         const struct cfg80211_chan_def *chandef,
+                         const struct iwl_tlc_config_cmd *cmd, int result)
+{
+	cache->valid = !result;
+	if (!result) {
+		cache->chandef = *chandef;
+		cache->cmd = *cmd;
+	}
+}
+
+#endif /* __iwl_mld_nan_tlc_cache_h__ */
