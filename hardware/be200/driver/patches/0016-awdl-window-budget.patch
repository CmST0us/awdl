+/* NAN management and multicast queues have no AWDL peer budget. */
+static bool iwl_mld_awdl_data_queue(struct ieee80211_txq *txq)
+{
+	return txq && txq->sta && txq->vif->nan_data_awdl &&
+	       txq->tid < IEEE80211_NUM_TIDS;
+}
+
+/* Rate feedback remains useful even when BA cannot yet reclaim a TFD. */
+static void iwl_mld_awdl_rate_feedback(struct iwl_mld *mld, u8 sta_id, u32 rate)
+{
+	struct ieee80211_link_sta *link_sta;
+	struct rate_info info = {};
+	u32 bitrate, cost;
+
+	if (sta_id >= mld->fw->ucode_capa.num_stations)
+		return;
+	rcu_read_lock();
+	link_sta = rcu_dereference(mld->fw_id_to_link_sta[sta_id]);
+	if (IS_ERR_OR_NULL(link_sta) ||
+	    !iwl_mld_sta_from_mac80211(link_sta->sta)->vif->nan_data_awdl)
+		goto out;
+	iwl_mld_rate_to_info(rate, &info);
+	bitrate = cfg80211_calculate_bitrate(&info);
+	if (!bitrate)
+		goto out;
+	/* cfg80211 reports units of 100 kbit/s. */
+	cost = DIV_ROUND_UP(80000U * 256, bitrate);
+	for (int tid = 0; tid < IEEE80211_NUM_TIDS; tid++) {
+		struct ieee80211_txq *txq = link_sta->sta->txq[tid];
+
+		if (iwl_mld_awdl_data_queue(txq))
+			WRITE_ONCE(iwl_mld_txq_from_mac80211(txq)->awdl_phy_ns_per_byte_q8,
+				   cost);
+	}
+out:
+	rcu_read_unlock();
+}
+
+/* Reserve airtime for the next complete MPDU, including queued data. */
+static bool iwl_mld_awdl_can_submit(struct ieee80211_txq *txq,
+				  unsigned int length)
+{
+	struct iwl_mld_txq *q = iwl_mld_txq_from_mac80211(txq);
+	u64 now = ktime_get_ns();
+	u64 opens = READ_ONCE(txq->vif->awdl_opens_ns);
+	u64 closes = READ_ONCE(txq->vif->awdl_closes_ns);
+	u32 rate = READ_ONCE(q->awdl_ns_per_byte_q8);
+	u32 phy_cost = READ_ONCE(q->awdl_phy_ns_per_byte_q8);
+	u32 pending = atomic_read(&q->awdl_pending_bytes);
+	u64 bytes = (u64)pending + length;
+	u64 cost;
+
+	if (now < opens || closes <= now + 1000000)
+		return false;
+	/* Learn the initial rate from one completed MPDU before expanding
+	 * the queue; firmware may still be using its low-rate startup mode.
+	 */
+	if (!rate)
+		return !pending;
+	cost = div_u64(bytes * max(rate, phy_cost) * 5, 4 * 256);
+	/* An empty queue can sample one MPDU in the first half-window,
+	 * so a slower previous window cannot prevent rate recovery.
+	 */
+	if (!pending && now < opens + (closes - opens) / 2)
+		return true;
+
+	/* Bound in-flight payload airtime to two maximum 5484-us PPDUs.
+	 * Keep the remaining MPDUs on the host when firmware probes a lower
+	 * PHY rate; a long hardware queue could otherwise outlive the window.
+	 */
+	return (!phy_cost || div_u64(bytes * phy_cost * 5, 4 * 256) <=
+		2 * 5484 * 1000) && closes > now + 1000000 + cost;
+}
+
+/* Only transport completion releases the bytes owned by firmware. */
+static void iwl_mld_awdl_completed(struct iwl_mld *mld, int id,
+				   unsigned int bytes, bool sample, bool wake)
+{
+	struct ieee80211_txq *txq;
+
+	rcu_read_lock();
+	txq = rcu_dereference(mld->fw_id_to_txq[id]);
+	if (iwl_mld_awdl_data_queue(txq)) {
+		struct iwl_mld_txq *q = iwl_mld_txq_from_mac80211(txq);
+		u64 now = ktime_get_ns();
+		u64 opens = READ_ONCE(txq->vif->awdl_opens_ns);
+		u64 closes = READ_ONCE(txq->vif->awdl_closes_ns);
+		u64 previous = READ_ONCE(q->awdl_last_completion_ns);
+
+		/* Ignore short control frames; exclude scheduled off-channel time. */
+		if ((sample || !q->awdl_sample_bytes) && bytes >= 1500 && previous &&
+		    now >= opens && now < closes) {
+			u64 elapsed = now - max(previous, opens);
+			/* Smooth time and volume together: a short completion must
+			 * not weigh as much as a full aggregate in the byte cost.
+			 */
+			if (q->awdl_sample_bytes) {
+				q->awdl_sample_ns = (q->awdl_sample_ns * 3 + elapsed) / 4;
+				q->awdl_sample_bytes = (q->awdl_sample_bytes * 3 + bytes) / 4;
+			} else {
+				q->awdl_sample_ns = elapsed;
+				q->awdl_sample_bytes = bytes;
+			}
+			WRITE_ONCE(q->awdl_ns_per_byte_q8,
+				   DIV_ROUND_UP_ULL(q->awdl_sample_ns * 256,
+						    q->awdl_sample_bytes));
+		}
+		WRITE_ONCE(q->awdl_last_completion_ns, now);
+		atomic_sub(bytes, &q->awdl_pending_bytes);
+		if (wake) {
+			local_bh_disable();
+			iwl_mld_tx_from_txq(mld, txq);
+			local_bh_enable();
+		}
+	}
+	rcu_read_unlock();
+}
 
