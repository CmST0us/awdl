+void iwl_mld_awdl_purge_txq(struct iwl_mld *mld, struct ieee80211_txq *txq)
+{
+	struct sk_buff *skb;
+	struct iwl_mld_txq *q = iwl_mld_txq_from_mac80211(txq);
+
+	if (!iwl_mld_awdl_data_queue(txq))
+		return;
+	while ((skb = __skb_dequeue(&q->awdl_ready)))
+		ieee80211_free_txskb(mld->hw, skb);
+}
