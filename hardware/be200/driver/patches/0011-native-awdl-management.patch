--- /dev/null
+++ b/include/net/awdl.h
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __NET_AWDL_H
+#define __NET_AWDL_H
+
+#include <linux/ieee80211.h>
+#include <linux/etherdevice.h>
+
+static inline bool ieee80211_is_awdl_action(const void *frame, size_t len)
+{
+	const struct ieee80211_mgmt *mgmt = frame;
+	static const u8 bssid[ETH_ALEN] = { 0x00, 0x25, 0x00, 0xff, 0x94, 0x73 };
+	static const u8 action[] = { 0x7f, 0x00, 0x17, 0xf2, 0x08 };
+
+	return len >= 24 + sizeof(action) &&
+	       ieee80211_is_action(mgmt->frame_control) &&
+	       !ieee80211_has_order(mgmt->frame_control) &&
+	       ether_addr_equal(mgmt->bssid, bssid) &&
+	       !memcmp(&mgmt->u.action, action, sizeof(action));
+}
+
+#endif
