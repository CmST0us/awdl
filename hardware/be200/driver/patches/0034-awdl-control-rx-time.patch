 #include "hcmd.h"
 #include "iface.h"
 #include "time_sync.h"
@@ -2775,6 +2777,13 @@
 				 rxb, &mpdu_desc))
 		goto drop;
 
+	if (mld->nan_device_vif &&
+	    !(rx_status->flag & RX_FLAG_FAILED_FCS_CRC) &&
