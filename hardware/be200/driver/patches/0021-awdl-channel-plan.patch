Subject: [PATCH] 在共享 NAN PHY 上应用 AWDL 主信道与窗口

--- a/drivers/net/wireless/intel/iwlwifi/mld/phy.c
+++ b/drivers/net/wireless/intel/iwlwifi/mld/phy.c
@@ -5,6 +5,9 @@
 #include <net/mac80211.h>
 
 #include "phy.h"
+#include "iface.h"
+#include "sta.h"
+#include "tx.h"
 #include "hcmd.h"
 #include "fw/api/phy-ctxt.h"
 
@@ -223,3 +226,102 @@
 	phy->chandef = *chandef;
 	iwl_mld_phy_fw_action(mld, ctx, FW_CTXT_ACTION_MODIFY);
 }
+
+/* NAN discovery keeps its committed schedule. Only the shared data PHY's
+ * primary is overridden, and native NDP stations require the home primary.
+ */
+int iwl_mld_awdl_primary(struct iwl_mld *mld, struct ieee80211_vif *vif,
+			 u8 primary)
+{
+	struct ieee80211_chanctx_conf *ctx = NULL;
+	struct iwl_mld_vif *mld_vif = iwl_mld_vif_from_mac80211(vif);
+	struct iwl_mld_phy *phy;
+	struct ieee80211_sta *sta;
+	struct cfg80211_chan_def saved;
+	struct ieee80211_channel *channel;
+	u64 began, synced, drained;
+	bool restore = !primary;
+	int ret;
+
+	lockdep_assert_wiphy(mld->wiphy);
+	if (!vif->nan_data_awdl || !mld->nan_device_vif)
+		return -EINVAL;
+	for (int i = 0; i < IEEE80211_NAN_MAX_CHANNELS; i++) {
+		struct ieee80211_nan_channel *c =
+			&mld->nan_device_vif->cfg.nan_sched.channels[i];
+
+		if (c->chanctx_conf &&
+		    c->chanreq.oper.width == NL80211_CHAN_WIDTH_80 &&
+		    c->chanreq.oper.center_freq1 == 5775) {
+			ctx = c->chanctx_conf;
+			break;
+		}
+	}
+	if (!ctx)
+		return -ENOLINK;
+	phy = iwl_mld_phy_from_mac80211(ctx);
+	if (!primary)
+		primary = ctx->def.chan->hw_value;
+	if (primary != 149 && primary != 161)
+		return -EINVAL;
+	for_each_station(sta, mld->hw) {
+		struct iwl_mld_sta *s = iwl_mld_sta_from_mac80211(sta);
+
+		if (s->vif->type == NL80211_IFTYPE_NAN_DATA &&
+		    !s->vif->nan_data_awdl && primary != ctx->def.chan->hw_value)
+			return -EBUSY;
+	}
+	if (primary == phy->chandef.chan->hw_value)
+		return 0;
+	channel = ieee80211_get_channel(mld->wiphy, 5000 + 5 * primary);
+	if (!channel)
+		return -EINVAL;
+
+	WRITE_ONCE(vif->awdl_opens_ns, 0);
+	WRITE_ONCE(vif->awdl_closes_ns, 0);
+	began = ktime_get_ns();
+	synchronize_rcu_expedited();
+	synced = ktime_get_ns();
+	/* PHY_CONTEXT MODIFY serializes the live radio change in firmware,
+	 * just as a native bandwidth update does. Keep descriptors owned by
+	 * firmware across AWDL hops; waiting on the old channel after the
+	 * peer leaves would spend the next window retrying on that channel.
+	 * Returning the shared PHY to NAN requires full transport completion.
+	 */
+	if (restore) {
+		for_each_station(sta, mld->hw) {
+			if (iwl_mld_sta_from_mac80211(sta)->vif != vif)
+				continue;
+			for (int tid = 0; tid < ARRAY_SIZE(sta->txq); tid++) {
+				struct iwl_mld_txq *q;
+
+				if (!sta->txq[tid])
+					continue;
+				q = iwl_mld_txq_from_mac80211(sta->txq[tid]);
+				if (!q->status.allocated)
+					continue;
+				ret = iwl_trans_wait_txq_idle(mld->trans, q->fw_id);
+				if (ret)
+					return ret;
+			}
+		}
+		if (mld_vif->nan.mcast_data_sta.sta_id != IWL_INVALID_STA) {
+			ret = iwl_trans_wait_txq_idle(mld->trans,
+					       mld_vif->nan.mcast_data_sta.queue_id);
+			if (ret)
+				return ret;
+		}
+	}
+	drained = ktime_get_ns();
+	saved = phy->chandef;
+	phy->chandef.chan = channel;
+	ret = iwl_mld_phy_fw_action(mld, ctx, FW_CTXT_ACTION_MODIFY);
+	IWL_DEBUG_RATE(mld,
+		       "AWDL_PHY primary=%u sync_us=%llu drain_us=%llu command_us=%llu ret=%d\n",
+		       primary, (synced - began) / 1000,
+		       (drained - synced) / 1000,
+		       (ktime_get_ns() - drained) / 1000, ret);
+	if (ret)
+		phy->chandef = saved;
+	return ret;
+}
--- a/drivers/net/wireless/intel/iwlwifi/mld/phy.h
+++ b/drivers/net/wireless/intel/iwlwifi/mld/phy.h
@@ -57,4 +57,7 @@
 void iwl_mld_update_phy_chandef(struct iwl_mld *mld,
 				struct ieee80211_chanctx_conf *ctx);
 
+int iwl_mld_awdl_primary(struct iwl_mld *mld, struct ieee80211_vif *vif,
+			 u8 primary);
+
 #endif /* __iwl_mld_phy_h__ */
--- a/drivers/net/wireless/intel/iwlwifi/mld/vendor-cmd.c
+++ b/drivers/net/wireless/intel/iwlwifi/mld/vendor-cmd.c
@@ -14,6 +14,7 @@
 #include "fw/api/rfi.h"
 #include "rfi.h"
 #include "iface.h"
+#include "phy.h"
 #include "mlo.h"
 #include "ftm-initiator.h"
 #include "ftm-responder.h"
@@ -1011,6 +1012,20 @@
 static int iwl_mld_awdl_data(struct wiphy *wiphy, struct wireless_dev *wdev,
 			     const void *data, int len)
 {
+	/* One wiphy-locked operation prevents NDP admission between the
+	 * primary change and reopening the AWDL data window.
+	 */
+	if (len == 18 && *(const u8 *)data == 4) {
+		struct ieee80211_vif *vif = wdev_to_ieee80211_vif(wdev);
+		struct iwl_mld *mld = iwl_mld_vif_from_mac80211(vif)->mld;
+		int ret = iwl_mld_awdl_primary(mld, vif, ((const u8 *)data)[1]);
+
+		if (ret)
+			return ret;
+		return ieee80211_awdl_set_window(wdev,
+			get_unaligned_le64((const u8 *)data + 2),
+			get_unaligned_le64((const u8 *)data + 10));
+	}
 	if (len == 1 && *(const u8 *)data == 1)
 		return ieee80211_nan_data_set_awdl(wdev);
 	if (len == 7 && *(const u8 *)data == 2)
--- a/drivers/net/wireless/intel/iwlwifi/mld/mac80211.c
+++ b/drivers/net/wireless/intel/iwlwifi/mld/mac80211.c
@@ -896,6 +896,8 @@
 		struct iwl_mld_vif *mld_vif = iwl_mld_vif_from_mac80211(vif);
 		struct iwl_mld_int_sta *sta = &mld_vif->nan.mcast_data_sta;
 
+		if (vif->nan_data_awdl && iwl_mld_awdl_primary(mld, vif, 0))
+			IWL_ERR(mld, "AWDL home channel restore failed\n");
 		if (sta->sta_id != IWL_INVALID_STA)
 			iwl_mld_remove_nan_mcast_data_sta(mld, sta);
 	}
@@ -1947,6 +1949,24 @@
 			tdls_count = iwl_mld_tdls_sta_count(mld);
 			if (tdls_count >= IWL_TDLS_STA_COUNT)
 				return -EBUSY;
+		}
+
+		if (vif->type == NL80211_IFTYPE_NAN_DATA && !vif->nan_data_awdl) {
+			struct ieee80211_sta *other;
+
+			/* Finish the temporary AWDL primary override before an NDP
+			 * can submit data on its negotiated home channel.
+			 */
+			for_each_station(other, mld->hw) {
+				struct ieee80211_vif *awdl =
+					iwl_mld_sta_from_mac80211(other)->vif;
+
+				if (!awdl->nan_data_awdl)
+					continue;
+				ret = iwl_mld_awdl_primary(mld, awdl, 0);
+				if (ret)
+					return ret;
+			}
 		}
 
 		ret = iwl_mld_add_sta(mld, sta, vif);
