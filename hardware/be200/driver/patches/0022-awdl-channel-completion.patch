+}
+
+static bool iwl_pcie_txq_idle(struct iwl_txq *txq)
+{
+	bool idle;
+
+	spin_lock_bh(&txq->lock);
+	idle = txq->read_ptr == txq->write_ptr && !txq->overflow_tx &&
+	       skb_queue_empty(&txq->overflow_q);
+	spin_unlock_bh(&txq->lock);
+	return idle;
+}
+
+/* The caller has stopped producers. Completion owns descriptor release;
+ * the timeout reports a failed drain without changing queue ownership.
+ */
+int iwl_trans_pcie_wait_txq_idle(struct iwl_trans *trans, int txq_idx)
+{
+	struct iwl_trans_pcie *pcie = IWL_TRANS_GET_PCIE_TRANS(trans);
+	struct iwl_txq *txq;
+
+	if (test_bit(STATUS_TRANS_DEAD, &trans->status))
+		return -ENODEV;
+	if (!test_bit(txq_idx, pcie->txqs.queue_used))
+		return -EINVAL;
+	txq = pcie->txqs.txq[txq_idx];
+	if (!wait_event_timeout(txq->drain_wait, iwl_pcie_txq_idle(txq),
+				msecs_to_jiffies(IWL_FLUSH_WAIT_MS)))
+		return -ETIMEDOUT;
 	return 0;
 }
 
